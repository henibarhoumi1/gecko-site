---
import '../styles/brand.css';
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, other, type Locale } from '../i18n/strings';
import { swapLang } from '../i18n/paths';
interface Props { lang: Locale; title?: string; description?: string; noindex?: boolean }
const { lang, title, description, noindex } = Astro.props;
const s = t(lang);
const fullTitle = title ? `${title} · Gecko` : `Gecko · ${s.line}`;
const desc = description ?? s.meta.description;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#FFFFFF" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" hreflang={other(lang)} href={swapLang(path, other(lang))} />
    <link rel="preload" href="/fonts/familjen-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content="/brand/og.png" />
  </head>
  <body>
    <Header lang={lang} />
    <main><slot /></main>
    <Footer lang={lang} />
    <script>
      const onScroll = () => document.documentElement.classList.toggle('scrolled', scrollY > 8);
      addEventListener('scroll', onScroll, { passive: true }); onScroll();
      // Ads play on hover with a mouse, and while on screen on touch devices. Muted always.
      const hover = matchMedia('(hover: hover)').matches;
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll<HTMLElement>('[data-ad]').forEach((frame) => {
        const v = frame.querySelector('video');
        if (!v || still) return;
        const play = () => { v.preload = 'auto'; v.play().catch(() => {}); };
        if (hover) {
          frame.addEventListener('mouseenter', play);
          frame.addEventListener('mouseleave', () => v.pause());
        } else {
          new IntersectionObserver((es) => es.forEach((e) => (e.isIntersecting ? play() : v.pause())), { threshold: 0.6 }).observe(frame);
        }
      });
      // The hero ad loops on its own.
      document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((v) => { if (!still) v.play().catch(() => {}); });
    </script>
  </body>
</html>
