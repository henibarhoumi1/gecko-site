---
import '../styles/brand.css';
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, type Locale } from '../i18n/strings';
import { swapLang } from '../i18n/paths';
import { m, type Page } from '../i18n/meta';
interface Props { lang: Locale; title?: string; page?: Page; description?: string; noindex?: boolean; footerCta?: boolean }
const { lang, title, page, description, noindex, footerCta = true } = Astro.props;
const s = t(lang);
const fullTitle = title ? `${title.replace(/\.$/, '')} · Gecko` : `Gecko · ${m(lang).home}`;
const desc = description ?? (page ? m(lang).desc[page] : s.meta.description);
const path = Astro.url.pathname;
// Full addresses for Google: this page, and the same page in each language (English is the default).
const abs = (p: string) => new URL(p, Astro.site).href;
const localised = /^\/(en|fr)(\/|$)/.test(path);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#FFFFFF" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {!noindex && <link rel="canonical" href={abs(path)} />}
    {!noindex && localised && (
      <>
        <link rel="alternate" hreflang="en" href={abs(swapLang(path, 'en'))} />
        <link rel="alternate" hreflang="fr" href={abs(swapLang(path, 'fr'))} />
        <link rel="alternate" hreflang="x-default" href={abs(swapLang(path, 'en'))} />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Gecko" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_US' : 'fr_FR'} />
    <meta property="og:url" content={abs(path)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={abs(lang === 'fr' ? '/brand/og-fr.png' : '/brand/og.png')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('pre'); if ('scrollRestoration' in history) history.scrollRestoration = 'manual';</script>
  </head>
  <body>
    <Header lang={lang} />
    <main><slot /></main>
    <Footer lang={lang} cta={footerCta} />
    <script>
      import Lenis from 'lenis';
      // A new page always opens at the top (unless the link points to a section).
      // Inside a frame (the preview link), the page around it is brought back up too after an internal click.
      const framed = window !== window.top && !!document.referrer && new URL(document.referrer).origin === location.origin;
      const toTop = () => {
        if (location.hash) return;
        scrollTo(0, 0);
        if (framed) document.body.scrollIntoView({ block: 'start' });
      };
      toTop();
      let touched = false;
      ['wheel', 'touchstart', 'keydown'].forEach((ev) => addEventListener(ev, () => (touched = true), { once: true, passive: true }));
      addEventListener('load', () => { if (!touched) toTop(); }, { once: true });
      addEventListener('pageshow', (e) => { if (!(e as PageTransitionEvent).persisted) toTop(); });
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      // Smooth, weighted scrolling. Paused while a dialog or the menu is open.
      if (!still) {
        const lenis = new Lenis({ lerp: 0.1, wheelMultiplier: 0.9, touchMultiplier: 1 });
        (window as any).lenis = lenis;
        const raf = (t: number) => { lenis.raf(t); requestAnimationFrame(raf); };
        requestAnimationFrame(raf);
        if (!location.hash) lenis.scrollTo(0, { immediate: true, force: true });
        new MutationObserver(() => (document.documentElement.classList.contains('locked') ? lenis.stop() : lenis.start()))
          .observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
        document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => a.addEventListener('click', (e) => {
          const el = document.querySelector(a.getAttribute('href')!); if (!el) return;
          e.preventDefault(); lenis.scrollTo(el as HTMLElement, { offset: -88, duration: 1.2, easing: (t) => 1 - Math.pow(1 - t, 4) });
        }));
      }
      // Things marked .rv rise into place the first time they come into view.
      // A page loaded ahead of time (on hover) waits until it is actually shown before anything rises.
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
      const reveal = () => document.querySelectorAll('.rv').forEach((el) => io.observe(el));
      if ((document as any).prerendering) document.addEventListener('prerenderingchange', reveal, { once: true });
      else reveal();
      // Swipe rows on phones: the card nearest the middle sits full size, the ones beside it shrink and fade a little.
      const phone = matchMedia('(max-width: 760px)');
      document.querySelectorAll<HTMLElement>('[data-swipe]').forEach((row) => {
        const items = [...row.children] as HTMLElement[];
        let ticking = false;
        const tick = () => {
          ticking = false;
          if (!phone.matches || still) { items.forEach((el) => el.style.removeProperty('--near')); return; }
          const r = row.getBoundingClientRect(); const mid = r.left + r.width * .4;
          items.forEach((el) => {
            const b = el.getBoundingClientRect();
            const d = Math.min(1, Math.abs(b.left + b.width / 2 - mid) / b.width);
            el.style.setProperty('--near', (1 - d).toFixed(3));
          });
        };
        const ask = () => { if (!ticking) { ticking = true; requestAnimationFrame(tick); } };
        row.addEventListener('scroll', ask, { passive: true });
        addEventListener('resize', ask);
        tick();
      });
    </script>
  </body>
</html>
