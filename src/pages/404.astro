---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/strings';
const s = t('en');
---
<Base lang="en" title="404" noindex>
  <section class="on-white page-head body">
    <div class="wrap stack" style="--gap:32px">
      <h1 class="h1">{s.notFound.title}</h1>
      <div class="actions"><a class="btn primary" href="/en/">{s.notFound.back}</a></div>
    </div>
  </section>
</Base>
<style>.body { min-height: 70vh; }</style>
