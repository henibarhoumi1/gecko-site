---
// The Brand World: one team for market study, brand, first campaign, product photos and a website with its own back
// office. Blue first screen, everything on filled blocks, price on quote.
import Base from '../../layouts/Base.astro';
import { type Locale } from '../../i18n/strings';
import { launch } from '../../i18n/launch';
import { langPaths } from '../../i18n/static';
import { href } from '../../i18n/paths';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const L = launch(lang).bw;
const quote = `${href(lang, 'apply')}?plan=brandworld`;
---
<Base lang={lang} title={L.metaTitle} page="brandworld">
  <section class="first">
    <div class="wrap wide">
      <p class="tape flat rv">{L.label}</p>
      <h1 class="h1 rv" style="--d:60ms">{L.title.split(' ').slice(0, -3).join(' ')} <span class="hl">{L.title.split(' ').slice(-3).join(' ')}</span></h1>
      <p class="text-l lead rv" style="--d:100ms">{L.lead}</p>
      <div class="actions rv" style="--d:140ms">
        <a class="btn primary lg" href={quote}>{L.quote} <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap wide">
      <h2 class="h2 mid-t rv">{L.insideTitle}</h2>
      <ul class="six">
        {L.inside.map((x, i) => <li class={`rv c${i % 3}`} style={`--d:${i * 60}ms`}><span class="n">{String(i + 1).padStart(2, '0')}</span><p>{x}</p></li>)}
      </ul>
      <p class="value rv">{L.value}</p>
    </div>
  </section>

  <section class="section start-sec">
    <div class="wrap wide">
      <h2 class="h2 mid-t rv">{L.startTitle}</h2>
      <ol class="four">
        {L.start.map((x, i) => <li class="rv" style={`--d:${i * 60}ms`}><span class="n">{i + 1}</span><p>{x}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap wide two">
      <div class="rv">
        <h2 class="h2">{L.holdTitle}</h2>
        <ul class="hold">{L.hold.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div class="rv" style="--d:80ms">
        <h2 class="h2">{L.forTitle}</h2>
        <ul class="who">{L.who.map(([t, d]) => <li><b>{t}</b><p>{d}</p></li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section buy-sec">
    <div class="wrap wide buy">
      <div class="rv">
        <h2 class="h2">{L.priceTitle}</h2>
        <p class="text-l">{L.price}</p>
      </div>
      <a class="btn primary lg rv" style="--d:80ms" href={quote}>{L.quote} <span class="arr" aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>

<style>
  /* The first screen and the section titles sit in the middle; the lists under them keep their own grids. */
  .first { padding-top: calc(var(--header) + clamp(48px, 7vw, 104px)); padding-bottom: clamp(56px, 7vw, 112px); text-align: center; }
  .first .h1 { max-width: 14ch; margin: 18px auto 0; text-wrap: balance; }
  .lead { margin: 22px auto 28px; max-width: 40rem; font-weight: 500; text-wrap: balance; }
  .first .actions { justify-content: center; }
  .mid-t { text-align: center; margin-inline: auto; }
  .six { list-style: none; margin: clamp(28px, 3.4vw, 48px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(12px, 1.4vw, 20px); }
  .six li { display: grid; align-content: space-between; gap: 40px; min-height: 240px; padding: clamp(22px, 2.2vw, 32px); border-radius: var(--r-lg); color: #000; }
  .c0, .c1, .c2 { background: var(--blue); }
  .six .n, .four .n { font-weight: 800; font-size: 44px; line-height: 1; }
  .six p { margin: 0; font-weight: 700; font-size: clamp(18px, 1.5vw, 22px); line-height: 1.3; }
  .value { margin: clamp(32px, 4vw, 56px) auto 0; max-width: 46rem; text-align: center; text-wrap: balance; font-weight: 800; font-size: clamp(24px, 2.4vw, 36px); line-height: 1.12; letter-spacing: -0.02em; }
  .four { list-style: none; margin: clamp(28px, 3.4vw, 48px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(12px, 1.4vw, 20px); }
  .four li { display: grid; align-content: space-between; gap: 28px; min-height: 220px; padding: clamp(20px, 2vw, 28px); border-radius: var(--r); background: #fff; box-shadow: inset 0 0 0 1.5px #000; color: #000; }
  .four p { margin: 0; font-weight: 700; font-size: clamp(18px, 1.5vw, 22px); line-height: 1.25; }
  .two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(32px, 5vw, 96px); }
  .hold, .who { list-style: none; margin: 24px 0 0; padding: 0; display: grid; gap: 14px; }
  .hold li { padding: 18px 22px; border-radius: var(--r); background: #fff; box-shadow: inset 0 0 0 1.5px #000; font-weight: 700; font-size: 19px; }
  .who li { padding: 22px; border-radius: var(--r); background: #fff; box-shadow: inset 0 0 0 1.5px #000; }
  .who b { font-weight: 800; font-size: 26px; letter-spacing: -0.02em; }
  .who p { margin: 6px 0 0; font-weight: 500; font-size: 18px; }
  .buy { padding: clamp(36px, 4.4vw, 72px); border-radius: 32px; background: var(--blue); display: grid; justify-items: center; gap: 28px; text-align: center; }
  .buy .h2 { margin: 0; }
  .buy .text-l { margin: 14px auto 0; max-width: 34rem; font-weight: 500; text-wrap: balance; }
  @media (max-width: 1100px) { .six { grid-template-columns: repeat(2, minmax(0, 1fr)); } .four { grid-template-columns: repeat(2, minmax(0, 1fr)); } .two { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .six, .four { grid-template-columns: 1fr; } }
</style>
