---
import Base from "../../layouts/Base.astro";
import { t, type Locale } from "../../i18n/strings";
import { href } from "../../i18n/paths";
import { langPaths } from "../../i18n/static";
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const s = t(lang);
import { site } from '../../data/site';
---
<Base lang={lang} title={s.partner.title} noindex>
  <section class="wrap page-head stack">
    <h1 class="display d-xl">{s.partner.title}</h1>
    <p class="text text-l measure">{s.partner.intro}</p>
    <p class="pill glass">{s.partner.slots}: {site.partnerSlots} / 3</p>
  </section>
  <section class="wrap section tight grid g2">
    <div class="card glass stack" style="--gap:14px"><h2 class="display d-m">{s.partner.youGet}</h2><ul class="list">{s.partner.get.map((x) => <li>{x}</li>)}</ul></div>
    <div class="card glass stack" style="--gap:14px"><h2 class="display d-m">{s.partner.youAgree}</h2><ul class="list">{s.partner.agree.map((x) => <li>{x}</li>)}</ul></div>
  </section>
  <section class="wrap section tight stack center">
    <p class="text measure center">{s.partner.note}</p>
    <div class="actions center"><a class="pill primary lg" href={href(lang, 'contact') + '?offer=partner'}>{s.partner.apply}</a></div>
  </section>
</Base>
