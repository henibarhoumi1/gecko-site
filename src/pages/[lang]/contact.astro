---
import Wa from '../../components/Wa.astro';
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import { type Locale } from '../../i18n/strings';
import { c } from '../../i18n/copy';
import { href } from '../../i18n/paths';
import { langPaths } from '../../i18n/static';
import { site } from '../../data/site';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const k = c(lang).contact;
const n = c(lang).nav;
// Line icons drawn in SVG, so they look the same on every phone and computer (emoji differ a lot on Windows).
const icons = {
  call: '<path d="M6.6 3.5h2.6l1.5 4-2 1.3a10.5 10.5 0 0 0 6.5 6.5l1.3-2 4 1.5v2.6a2.1 2.1 0 0 1-2.3 2.1A16.5 16.5 0 0 1 4.5 5.8a2.1 2.1 0 0 1 2.1-2.3z"/>',
  mail: '<rect x="3.5" y="5.5" width="17" height="13" rx="2.5"/><path d="M4.5 7l7.5 6 7.5-6"/>',
  insta: '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17 7h.01" stroke-width="2.4"/>',
};
const ways = [
  { e: '', wa: true, name: k.whatsapp, value: site.phone, url: site.whatsapp },
  { e: icons.call, name: k.call, value: site.phone, url: `tel:${site.phone.replace(/\s/g, '')}` },
  { e: icons.mail, name: k.email, value: site.email, url: `mailto:${site.email}` },
  ...site.socials.map((x) => ({ e: icons.insta, name: x.name, value: x.handle, url: x.url })),
];
---
<Base lang={lang} footerCta={false} title={n.contact} darkHead>
  <section class="page-head lit">
    <div class="wrap wide stack" style="--gap:20px">
      <h1 class="h1 rv">{k.title}</h1>
    </div>
  </section>

  <section class="on-white section">
    <div class="wrap grid-c">
      <div class="stack" style="--gap:22px">
        <h2 class="h3 rv">{k.ways}</h2>
        <ul class="ways">
          {ways.map((w, i) => (
            <li class="rv" style={`--d:${i * 70}ms`}>
              <a href={w.url} rel="noopener">
                <span class={`em ${w.wa ? 'is-wa' : ''}`} aria-hidden="true">{w.wa ? <Wa /> : <svg viewBox="0 0 24 24" set:html={w.e} />}</span>
                <span class="who"><span class="label">{w.name}</span><span class="val">{w.value}</span></span>
                <span class="go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="text soft rv"><span class="label">{k.based}</span> {k.place}</p>
        <a class="proj rv" href={href(lang, 'apply')}>
          <span class="pt">{k.project}</span>
          <span class="text">{k.projectCta} <span aria-hidden="true">→</span></span>
        </a>
      </div>
      <div class="rv" style="--d:120ms"><ContactForm lang={lang} /></div>
    </div>
  </section>
</Base>
<style>
  .page-head .h1 { max-width: 17ch; }
  .grid-c { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .ways { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .ways a { display: grid; grid-template-columns: 44px 1fr auto; align-items: center; gap: 16px; padding: 16px 18px; text-decoration: none; background: var(--white); border: var(--line) solid var(--ink); border-radius: var(--r); transition: transform 240ms var(--ease), box-shadow 240ms var(--ease), background 200ms var(--ease); }
  .ways a:hover { transform: translateY(-3px); box-shadow: var(--lift); background: var(--pink-soft); }
  .em { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 12px; background: var(--pink-soft); border: var(--line) solid var(--ink); transition: background 200ms var(--ease), transform 300ms var(--ease); }
  .em svg { width: 22px; height: 22px; fill: none; stroke: var(--ink); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .ways a:hover .em { background: var(--yellow); transform: rotate(-6deg); }
  .em.is-wa { background: #E3F8EA; }
  .em :global(.wa) { width: 28px; height: 28px; }
  .who { display: grid; gap: 2px; min-width: 0; }
  .val { font-weight: 700; font-size: 17px; overflow-wrap: anywhere; }
  @media (max-width: 420px) { .val { font-size: 15px; } }
  .go { font-weight: 700; transition: transform 240ms var(--ease); }
  .ways a:hover .go { transform: translateX(4px); }
  .proj { display: grid; gap: 6px; padding: 22px 24px; text-decoration: none; background: var(--yellow); border: var(--line) solid var(--ink); border-radius: var(--r); box-shadow: var(--lift); transition: transform 240ms var(--ease), box-shadow 240ms var(--ease); }
  .proj:hover { transform: translateY(-3px); box-shadow: var(--lift-l); }
  .proj .pt { font-weight: 700; font-size: 20px; letter-spacing: -.01em; }
  .proj .text { font-weight: 600; }
  @media (max-width: 860px) { .grid-c { grid-template-columns: 1fr; } }
</style>
