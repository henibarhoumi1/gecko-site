---
import Base from '../../layouts/Base.astro';
import { t, type Locale } from '../../i18n/strings';
import { href } from '../../i18n/paths';
import { langPaths } from '../../i18n/static';
import { photos, portrait } from '../../data/work';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const s = t(lang);
const a = s.about;
---
<Base lang={lang} title={a.title}>
  <section class="on-white page-head">
    <div class="wrap stack" style="--gap:24px">
      <h1 class="h1">{a.title}</h1>
      <p class="text text-l measure">{a.intro}</p>
    </div>
  </section>
  <section class="on-white section top0">
    <div class="wrap heni">
      {portrait.src && (
        <div class="frame r45">{portrait.src ? <img src={portrait.src} alt={a.heniTitle} /> : <div class="empty"><span class="label muted">{s.sample} · {a.heniEmpty}</span></div>}</div>
      )}
      <div class="stack" style="--gap:16px">
        <h2 class="h3">{a.heniTitle}</h2>
        <p class="text text-l measure">{a.heniText}</p>
      </div>
    </div>
  </section>
  {photos.length > 0 && (
    <section class="on-black section">
      <div class="wrap">
        <div class="head"><p class="label">{a.crewTitle}</p></div>
        <div class="grid g3 scroll-row">
          {photos.map((p) => <div class="frame r45">{p.src ? <img src={p.src} alt={p.alt[lang]} loading="lazy" /> : <div class="empty"><span class="label muted">{s.sample} · {a.crewEmpty}</span></div>}</div>)}
        </div>
      </div>
    </section>
  )}
  <section class="on-blue section">
    <div class="wrap cta">
      <h2 class="h2">{s.work.next}</h2>
      <a class="btn primary" href={href(lang, 'apply')}>{s.nav.apply} <span class="arr" aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>
<style>
  .top0 { padding-top: 0; }
  .heni { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: clamp(32px, 6vw, 96px); align-items: end; border-top: var(--line) solid var(--black); padding-top: 32px; }
  .heni .frame { max-width: 440px; }
  .cta { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; }
  @media (max-width: 760px) { .heni { grid-template-columns: 1fr; } }
</style>
