---
import Base from '../../layouts/Base.astro';
import Compare from '../../components/Compare.astro';
import WhatWeDo from '../../components/WhatWeDo.astro';
import { type Locale } from '../../i18n/strings';
import { c } from '../../i18n/copy';
import { langPaths } from '../../i18n/static';
import { href } from '../../i18n/paths';
import { mark } from '../../i18n/mark';
import { photos, portrait } from '../../data/work';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const a = c(lang).about;
const n = c(lang).nav;
const [t0, t1] = mark(a.title);
---
<Base lang={lang} title={n.about} page="about">
  <section class="page-head lit mid">
    <div class="wrap wide">
      <h1 class="h1 rv">{t0}<span class="hl">{t1}</span></h1>
      <p class="text-l lede rv" style="--d:60ms">{a.lede}</p>
      <dl class="facts">
        {a.facts.map((f, i) => (
          <div class="fact rv" style={`--d:${80 + i * 70}ms`}>
            <dt class="label">{f.k}</dt>
            <dd><span class="v">{f.v}</span><span class="d">{f.d}</span></dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- The founder: his real portrait (public/team/heni.jpg), who he is and why Gecko exists. -->
  <section class="section founder-sec" aria-labelledby="heni-t">
    <div class="wrap wide founder">
      {portrait.src && <img class="face rv" src={portrait.src} alt={a.heniTitle} width="576" height="576" loading="lazy" decoding="async" />}
      <div class="who rv" style="--d:80ms">
        <p class="tape flat">{a.heniLabel}</p>
        <h2 class="h2" id="heni-t">{a.heniTitle}</h2>
        <p class="role">{a.heniRole}</p>
        <p class="text-l">{a.heniText}</p>
      </div>
    </div>
  </section>

  <section class="section answers-sec" aria-labelledby="ans-t">
    <div class="wrap wide">
      <h2 class="h2 ans-t rv" id="ans-t">{a.answersTitle}</h2>
      <ol class="answers">
        {a.answers.map((x, i) => (
          <li class="rv" style={`--d:${i * 60}ms`}><h3 class="h3">{x.t}</h3><p>{x.d}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <WhatWeDo lang={lang} />

  <Compare lang={lang} />

  {photos.length > 0 && (
    <section class="section on-mat shots-sec">
      <div class="wrap wide">
        <h2 class="h2 rv">{a.photos}</h2>
        <ul class="shots">{photos.map((ph, i) => <li class="rv" style={`--d:${i * 60}ms`}><img src={ph.src} alt={ph.alt[lang]} loading="lazy" /></li>)}</ul>
      </div>
    </section>
  )}

  <section class="section hire-sec">
    <div class="wrap wide">
      <a class="hire rv" href={href(lang, 'join')}><span class="lb">{a.hire}</span> <span class="ar" aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>

<style>
  .page-head .lede { margin: clamp(20px, 2.4vw, 32px) auto 0; max-width: 40rem; }
  .shots-sec .h2 { margin: 0 0 clamp(28px, 3vw, 44px); text-align: center; }
  .shots { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(10px, 1.4vw, 20px); }
  .shots img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .hire-sec .wrap { display: flex; justify-content: center; }
  .hire { display: inline-flex; align-items: baseline; gap: .35em; font-weight: 700; font-size: clamp(26px, 3.4vw, 52px); line-height: 1.05; letter-spacing: -0.045em; color: var(--fg); text-decoration: none; }
  .lb { padding-inline: .04em; margin-inline: -.04em; background: linear-gradient(var(--pink), var(--pink)) 0 80% / 0 38% no-repeat; transition: background-size 520ms var(--ease); }
  .ar { transition: transform 360ms var(--ease); }
  .hire:hover .lb { background-size: 100% 38%; }
  .hire:hover .ar { transform: translateX(12px); }
  @media (max-width: 760px) { .shots { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .page-head .h1 { max-width: 13ch; }
  /* The founder: portrait on the left, who he is on the right. */
  .founder { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(28px, 5vw, 96px); align-items: center; }
  .face { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: var(--r-lg); background: var(--blue); }
  .who { display: grid; gap: 14px; justify-items: start; }
  .who .h2 { margin: 0; }
  .role { margin: 0; font-weight: 800; font-size: clamp(18px, 1.5vw, 22px); }
  .who .text-l { margin: 8px 0 0; max-width: 38rem; font-weight: 500; }
  /* Six short answers, white cards with a black edge. */
  .ans-t { margin: 0 0 clamp(28px, 3.6vw, 52px); text-align: center; }
  .answers { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(12px, 1.4vw, 20px); }
  .answers li { display: grid; align-content: start; gap: 12px; padding: clamp(22px, 2.2vw, 32px); border-radius: var(--r-lg); background: #fff; box-shadow: inset 0 0 0 1.5px #000; }
  .answers .h3 { margin: 0; }
  .answers p { margin: 0; font-weight: 500; font-size: clamp(17px, 1.3vw, 20px); line-height: 1.4; }
  @media (max-width: 1000px) { .founder { grid-template-columns: 1fr; } .face { max-width: 420px; } .answers { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .answers { grid-template-columns: 1fr; } }
  .facts { margin: clamp(40px, 5vw, 72px) 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(12px, 1.4vw, 20px); }
  .fact { padding: clamp(22px, 2.4vw, 36px); border-radius: var(--r-lg); background: var(--blue); color: #000; }
  .fact dd { margin: 12px 0 0; display: grid; gap: 10px; }
  .fact .v { font-weight: 700; font-size: clamp(28px, 3vw, 44px); letter-spacing: -0.04em; line-height: 1; }
  .fact .d { font-size: 17px; line-height: 1.45; max-width: 24rem; color: var(--fg-2); }
  @media (max-width: 860px) {
    .facts { grid-template-columns: 1fr; }
    .fact, .fact + .fact { padding: 22px 0; border-left: 0; }
  }
</style>
