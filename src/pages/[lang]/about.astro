---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import Compare from '../../components/Compare.astro';
import { type Locale } from '../../i18n/strings';
import { c } from '../../i18n/copy';
import { langPaths } from '../../i18n/static';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const a = c(lang).about;
const n = c(lang).nav;
---
<Base lang={lang} footerCta={false} title={n.about} darkHead>
  <section class="page-head lit">
    <div class="wrap wide">
      <h1 class="h1 rv">{a.title}</h1>
      <dl class="facts">
        {a.facts.map((f, i) => (
          <div class="fact rv" style={`--d:${80 + i * 70}ms`}>
            <dt class="label">{f.k}</dt>
            <dd><span class="v">{f.v}</span><span class="d">{f.d}</span></dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <Compare lang={lang} />

  <Cta lang={lang} title={a.cta} />
</Base>

<style>
  .page-head .h1 { max-width: 13ch; }
  .facts { margin: clamp(40px, 5vw, 72px) 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid rgba(255, 255, 255, .25); }
  .fact { padding: 24px clamp(16px, 2.4vw, 32px) 0 0; }
  .fact + .fact { padding-left: clamp(16px, 2.4vw, 32px); border-left: 1px solid rgba(255, 255, 255, .25); }
  .fact dd { margin: 12px 0 0; display: grid; gap: 10px; }
  .fact .v { font-weight: 700; font-size: clamp(28px, 3vw, 44px); letter-spacing: -0.04em; line-height: 1; }
  .fact .d { font-size: 17px; line-height: 1.45; max-width: 24rem; color: rgba(255, 255, 255, .78); }
  @media (max-width: 860px) {
    .facts { grid-template-columns: 1fr; }
    .fact, .fact + .fact { padding: 22px 0; border-left: 0; border-bottom: 1px solid rgba(255, 255, 255, .25); }
  }
</style>
