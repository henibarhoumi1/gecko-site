---
import Base from '../../layouts/Base.astro';
import MatCta from '../../components/MatCta.astro';
import { type Locale } from '../../i18n/strings';
import { c } from '../../i18n/copy';
import { langPaths } from '../../i18n/static';
import { portrait } from '../../data/work';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const a = c(lang).about;
const n = c(lang).nav;
---
<Base lang={lang} title={n.about}>
  <section class="page-head">
    <div class="wrap stack center" style="--gap:22px">
      <h1 class="h1 rv">{a.title}</h1>
      <p class="text text-l soft measure rv" style="--d:100ms">{a.sub}</p>
    </div>
  </section>

  <section class="heni-sec">
    <div class="wrap heni">
      <figure class="photo rv">
        {portrait.src ? <img src={portrait.src} alt={a.heniTitle} /> : <div class="mono">g.</div>}
      </figure>
      <div class="stack rv" style="--gap:18px; --d:120ms">
        <p class="label">{a.heniLabel}</p>
        <h2 class="h2">{a.heniTitle}</h2>
        <p class="role">{a.heniRole}</p>
        <p class="text text-l soft measure">{a.heniText}</p>
      </div>
    </div>
  </section>

  <section class="on-paper section">
    <div class="wrap">
      <div class="head rv"><h2 class="h2">{a.whyLabel}</h2></div>
      <ol class="why">
        {a.why.map((w, i) => (
          <li class="rv" style={`--d:${i * 80}ms`}>
            <span class={`dot ${['p', 'y', 'g', 'i'][i]}`} aria-hidden="true">{i + 1}</span>
            <h3 class="h3">{w.t}</h3>
            <p class="text soft">{w.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap feel">
      <div class="stack rv" style="--gap:16px">
        <h2 class="h2">{a.feelLabel}</h2>
        <p class="text soft">{a.baseLabel}. {a.base}</p>
      </div>
      <ul class="ticks-list big-ticks rv" style="--d:100ms">{a.feel.map((f) => <li>{f}</li>)}</ul>
    </div>
  </section>

  <MatCta lang={lang} title={a.cta} />
</Base>

<style>
  .page-head .h1 { max-width: 15ch; }
  .heni-sec { padding-bottom: var(--section); }
  .heni { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(40px, 7vw, 112px); align-items: center; }
  .photo { margin: 0; aspect-ratio: 4 / 5; border-radius: var(--r-lg); overflow: hidden; background: #F2F2F0; box-shadow: var(--shadow-2); }
  .photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; transition: transform 1200ms var(--ease); }
  .photo:hover img { transform: scale(1.03); }
  .mono { height: 100%; display: grid; place-items: center; font-weight: 700; font-size: 160px; letter-spacing: -0.06em; }
  .role { margin: -6px 0 0; font-weight: 600; }
  .why { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(14px, 1.6vw, 22px); }
  .why li { display: grid; gap: 12px; align-content: start; padding: clamp(26px, 3vw, 40px); background: var(--white); border-radius: var(--r-lg); border: 1px solid var(--hair); box-shadow: var(--shadow-1); transition: transform 500ms var(--ease), box-shadow 500ms var(--ease), opacity 900ms var(--ease), filter 900ms var(--ease); }
  .why li.in:hover { transform: translateY(-6px); box-shadow: var(--shadow-2); }
  .dot { width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; font-weight: 700; margin-bottom: 12px; }
  .dot.p { background: var(--pink); } .dot.y { background: var(--yellow); } .dot.g { background: var(--mat); color: #fff; } .dot.i { background: var(--ink); color: #fff; }
  .why .text { max-width: 30rem; }
  .feel { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .big-ticks { gap: 18px; font-size: var(--body-l); font-weight: 500; }
  @media (max-width: 860px) { .heni, .why, .feel { grid-template-columns: 1fr; } .photo { max-width: 420px; } }
</style>
