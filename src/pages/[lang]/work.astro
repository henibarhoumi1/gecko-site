---
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';
import ReelCard from '../../components/ReelCard.astro';
import ReelViewer from '../../components/ReelViewer.astro';
import Cta from '../../components/Cta.astro';
import { t, type Locale } from '../../i18n/strings';
import { c } from '../../i18n/copy';
import { langPaths } from '../../i18n/static';
import { cases, ads } from '../../data/work';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const s = t(lang);
const w = c(lang).work;
---
<Base lang={lang} title={w.title}>
  <section class="page-head">
    <div class="wrap stack center" style="--gap:18px">
      <h1 class="h1 rv">{w.title}</h1>
      <p class="text text-l soft rv" style="--d:100ms">{w.sub}</p>
    </div>
  </section>

  <section class="reels-sec">
    <div class="wrap">
      <div class="reels">
        {ads.map((a, i) => <div class="rv" style={`--d:${i * 80}ms`}><ReelCard ad={a} i={i} lang={lang} eager={i < 4} /></div>)}
      </div>
    </div>
  </section>

  {cases.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="head"><h2 class="h2">{s.home.casesTitle}</h2></div>
        <div class="grid g3">{cases.map((cs) => <CaseCard c={cs} lang={lang} />)}</div>
      </div>
    </section>
  )}

  <Cta lang={lang} title={w.next} />
  <ReelViewer lang={lang} />
</Base>
<style>
  .reels-sec { padding-bottom: clamp(24px, 4vw, 48px); }
  .reels { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(14px, 2vw, 28px); }
  @media (max-width: 960px) { .reels { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
