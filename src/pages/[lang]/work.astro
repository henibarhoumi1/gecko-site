---
import Base from '../../layouts/Base.astro';
import Reel from '../../components/Reel.astro';
import CaseCard from '../../components/CaseCard.astro';
import AdDemo from '../../components/AdDemo.astro';
import { t, type Locale } from '../../i18n/strings';
import { href } from '../../i18n/paths';
import { langPaths } from '../../i18n/static';
import { cases, ads } from '../../data/work';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const s = t(lang);
---
<Base lang={lang} title={s.work.title}>
  <section class="on-pink page-head">
    <div class="wrap stack" style="--gap:24px">
      <h1 class="h1">{s.work.title}</h1>
      <p class="text text-l measure">{s.work.intro}</p>
    </div>
  </section>
  {ads.length > 0 && (
    <section class="on-pink section" style="padding-top:0">
      <div class="wrap">
        <div class="head"><p class="label">{s.home.grid}</p><div class="side"><h2 class="h2">{s.home.gridTitle}</h2><p class="small">{s.home.gridHint}</p></div></div>
        <div class="grid g4 pieces">
          {ads.map((a, i) => (
            <article class="stack" style="--gap:14px">
              <Reel ad={a} lang={lang} n={i + 1} />
              <h3 class="h3">{a.idea?.[lang]}</h3>
              <p class="text small">{a.how?.[lang]}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
  {cases.length > 0 && (
    <section class="on-white section">
      <div class="wrap">
        <div class="head"><p class="label">{s.home.cases}</p><div class="side"><h2 class="h2">{s.home.casesTitle}</h2></div></div>
        <div class="grid g3">{cases.map((c) => <CaseCard c={c} lang={lang} />)}</div>
      </div>
    </section>
  )}
  {ads.length === 0 && cases.length === 0 && (
    <section class="on-pink section" style="padding-top:0"><div class="wrap empty-state"><p class="h3 measure">{s.work.empty}</p><AdDemo lang={lang} /></div></section>
  )}
  <section class="on-yellow section">
    <div class="wrap cta">
      <h2 class="h2">{s.work.next}</h2>
      <a class="btn primary" href={href(lang, 'apply')}>{s.nav.apply} <span class="arr" aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>
<style>
  .empty-state { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 40px; align-items: end; background: linear-gradient(var(--ink), var(--ink)) no-repeat center top / calc(100% - 2 * var(--gutter)) var(--line); padding-top: 32px; }
  @media (max-width: 760px) { .empty-state { grid-template-columns: 1fr; } }
  .cta { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; }
  @media (max-width: 600px) { .grid.g4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
