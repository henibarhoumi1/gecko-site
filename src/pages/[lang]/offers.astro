---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import Plans from '../../components/Plans.astro';
import { t, type Locale } from '../../i18n/strings';
import { c } from '../../i18n/copy';
import { href } from '../../i18n/paths';
import { langPaths } from '../../i18n/static';
import { campaign, audit, fmt } from '../../data/offers';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const s = t(lang);
const o = s.offers;
const k = c(lang).offers;
const p = c(lang).plans;
const cta = c(lang).nav.apply;
const h = c(lang).home;
const oneOffs = [
  { key: 'campaign', name: campaign.name, text: campaign.items[lang].join('. ') + '.', price: campaign.launch },
  { key: 'audit', name: audit.name, text: audit.text[lang], price: audit.price },
];
---
<Base lang={lang} title={o.title}>
  <section class="page-head">
    <div class="wrap stack" style="--gap:22px">
      <h1 class="h1 rv">{k.title}</h1>
      <p class="text text-l lede rv" style="--d:80ms">{k.sub}</p>
    </div>
  </section>

  <section class="plans-sec">
    <div class="wrap">
      <Plans lang={lang} />
      <p class="note rv">{o.launchNote} {o.monthlyNote}</p>
    </div>
  </section>

  <section class="on-mat section">
    <div class="wrap">
      <div class="head rv"><h2 class="h2">{k.splitTitle}</h2></div>
      <div class="split">
        {[k.make, k.run, k.costs].map((x, i) => (
          <article class={`part rv ${i === 1 ? 'run' : ''}`} style={`--d:${i * 70}ms`}>
            <p class="tag-pill">{x.tag}</p>
            <h3 class="h3">{x.t}</h3>
            <p class="text">{x.d}</p>
          </article>
        ))}
      </div>
      <div class="every rv">
        <p class="label">{k.every}</p>
        <ul class="ticks-list">{o.allInList.map((i) => <li>{i}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head rv"><div class="stack" style="--gap:16px"><h2 class="h2">{k.oneOff}</h2><p class="text text-l sub-l">{k.oneOffSub}</p></div></div>
      <div class="ones">
        {oneOffs.map((x, i) => (
          <article class="one rv" style={`--d:${i * 70}ms`}>
            <h3 class="h3">{x.name}</h3>
            <div class="foot">
              <p><span class="num">{fmt(x.price, lang)}</span> {o.currency}</p>
              {x.standard && <p class="was">{p.usually} {fmt(x.standard, lang)} {o.currency}</p>}
            </div>
            <p class="text">{x.text}</p>
            <a class="link" href={`${href(lang, 'apply')}?plan=${x.key}`}>{cta} →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="on-black section beyond-sec">
    <div class="wrap beyond">
      <div class="stack rv" style="--gap:24px">
        <h2 class="h2">{k.beyond.title}</h2>
        <p class="text text-l">{k.beyond.text}</p>
        <p class="quote">{k.beyond.quote}</p>
        <a class="btn primary" href={`${href(lang, 'apply')}?plan=bespoke`}>{k.beyond.cta} <span class="arr" aria-hidden="true">→</span></a>
      </div>
      <ol class="kinds">
        {k.beyond.items.map((it, i) => (
          <li class="rv" style={`--d:${i * 70}ms`}>
            <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div><h3 class="h3">{it.t}</h3><p class="text">{it.d}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap faq-grid">
      <div class="faq-lead rv">
        <h2 class="h2">{k.faqTitle}</h2>
        <a class="btn" href={href(lang, 'faq')}>{h.faqAll} <span class="arr" aria-hidden="true">→</span></a>
      </div>
      <div class="stack rv" style="--gap:10px">
        <div class="faq">
          <details>
            <summary><span>{k.terms}</span><span class="pm" aria-hidden="true"></span></summary>
            <ul class="terms text">{o.terms.map((i) => <li>{i}</li>)}</ul>
          </details>
          <details>
            <summary><span>{o.intlTitle}</span><span class="pm" aria-hidden="true"></span></summary>
            <p class="text a">{o.intl}</p>
          </details>
        </div>
        <Faq items={s.faq} scroll hint={h.faqHint} />
      </div>
    </div>
  </section>
</Base>
<style>
  .lede { max-width: 44rem; }
  .plans-sec { padding-bottom: clamp(8px, 2vw, 24px); }
  .note { margin: 24px 0 0; max-width: 52rem; font-size: 15px; color: var(--ink-2); }
  .split { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(14px, 1.6vw, 22px); }
  .part { display: grid; gap: 14px; align-content: start; padding: clamp(24px, 2.4vw, 32px); background: var(--white); color: var(--ink); border: var(--line) solid var(--ink); border-radius: var(--r-lg); box-shadow: 6px 6px 0 var(--ink); }
  .part.run { background: var(--ink); color: #fff; box-shadow: 6px 6px 0 var(--yellow); }
  .tag-pill { margin: 0; justify-self: start; padding: 5px 12px; border-radius: 999px; background: var(--yellow); color: var(--ink); font-size: 13px; font-weight: 700; }
  .part:first-child .tag-pill { background: var(--pink); }
  .every { margin-top: clamp(28px, 3vw, 40px); display: grid; grid-template-columns: auto 1fr; gap: 16px 40px; align-items: start; }
  .every .ticks-list { display: flex; flex-wrap: wrap; gap: 12px 32px; }
  .every .ticks-list li { white-space: nowrap; }
  .every .label { padding-top: 2px; }
  .sub-l { max-width: 34rem; margin: 0; }
  .ones { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(14px, 1.6vw, 22px); }
  .one { display: grid; grid-template-rows: auto auto 1fr auto; gap: 16px; padding: clamp(24px, 2.4vw, 32px); background: var(--white); border-radius: var(--r-lg); border: var(--line) solid var(--ink); transition: transform 300ms var(--ease), box-shadow 300ms var(--ease), opacity 600ms var(--ease); }
  .one.in:hover { transform: translate(-4px, -4px); box-shadow: var(--shadow-2); }
  .one .foot { padding-bottom: 14px; border-bottom: var(--line) solid var(--ink); }
  .one .foot p { margin: 0; }
  .was { font-size: 14px; color: var(--ink-2); }
  .num { font-weight: 700; font-size: 32px; letter-spacing: -0.03em; }
  .beyond-sec { border-block: var(--line) solid var(--ink); }
  .beyond { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(40px, 7vw, 112px); align-items: start; }
  .beyond .h2 { max-width: 13ch; }
  .beyond .stack { justify-items: start; }
  .quote { margin: 0; padding-left: 16px; border-left: 3px solid var(--pink); font-weight: 600; font-size: 18px; line-height: 1.4; max-width: 30rem; }
  .kinds { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(255, 255, 255, .4); }
  .kinds li { display: grid; grid-template-columns: 56px 1fr; gap: 16px; padding: clamp(20px, 2vw, 28px) 0; border-bottom: 1px solid rgba(255, 255, 255, .4); }
  .kinds .text { color: rgba(255, 255, 255, .82); }
  .kinds .n { color: var(--yellow); }
  .kinds .n { font-weight: 700; font-size: 15px; padding-top: 4px; }
  .kinds .h3 { margin-bottom: 6px; }
  .kinds .text { margin: 0; }
  .terms { margin: 0; padding: 0 64px 22px 40px; display: grid; gap: 10px; color: var(--ink-2); }
  .faq-grid { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .faq-lead { display: grid; gap: 28px; justify-items: start; }
  @media (max-width: 960px) { .split, .ones { grid-template-columns: 1fr; } .beyond { grid-template-columns: 1fr; } }
  @media (max-width: 860px) { .faq-grid, .every { grid-template-columns: 1fr; } }
</style>
