---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import { t, type Locale } from '../../i18n/strings';
import { href } from '../../i18n/paths';
import { langPaths } from '../../i18n/static';
import { test, monthly, campaign, audit, addons, fmt, type Offer } from '../../data/offers';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const s = t(lang);
const o = s.offers;
const price = (x: Offer) => ({ launch: fmt(x.launch, lang), standard: fmt(x.standard, lang), per: x.monthly ? ` ${o.month}` : '' });
---
<Base lang={lang} title={o.title}>
  <section class="on-white page-head">
    <div class="wrap stack" style="--gap:24px">
      <h1 class="h1">{o.title}</h1>
      <p class="text text-l measure">{o.intro}</p>
    </div>
  </section>

  <section class="on-white section top0">
    <div class="wrap">
      <div class="head"><p class="label">{o.startTitle}</p></div>
      <div class="start">
        <div class="stack" style="--gap:16px">
          <h2 class="h2">{test.name}</h2>
          <ul class="list">{test.items[lang].map((i) => <li class="text">{i}</li>)}</ul>
        </div>
        <div class="price-block">
          <p class="label">{o.launch}</p>
          <p class="p-big">{price(test).launch} <span class="cur">{o.currency}</span></p>
          <p class="small"><s>{price(test).standard} {o.currency}</s> {o.standard}</p>
          <a class="btn primary" href={href(lang, 'apply')}>{o.apply} <span class="arr" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="on-black section">
    <div class="wrap">
      <div class="head"><p class="label">{o.monthlyTitle}</p><div class="side"><p class="text muted">{o.monthlyNote}</p></div></div>
      <div class="plans">
        {monthly.map((p) => (
          <article class="plan">
            <h3 class="h2">{p.name}</h3>
            <p class="reels"><span class="n">{p.reels}</span> <span class="label">{o.reels}</span></p>
            <ul class="list">{p.items[lang].map((i) => <li class="text">{i}</li>)}</ul>
            <div class="foot">
              <p class="label muted">{o.fits}</p>
              <p class="text">{p.fits?.[lang]}</p>
              <p class="p-mid">{price(p).launch} <span class="cur">{o.currency}{price(p).per}</span></p>
              <p class="small muted"><s>{price(p).standard} {o.currency}</s> {o.standard}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="small muted note">{o.launchNote}</p>
    </div>
  </section>

  <section class="on-white section">
    <div class="wrap">
      <div class="head"><p class="label">{o.oneOffTitle}</p></div>
      <div class="rows table">
        <div class="row">
          <h3 class="h3">{campaign.name}</h3>
          <p class="text">{campaign.items[lang].join('. ')}.</p>
          <p class="text right"><strong>{price(campaign).launch} {o.currency}</strong><br /><s class="small">{price(campaign).standard}</s></p>
        </div>
        <div class="row">
          <h3 class="h3">{audit.name}</h3>
          <p class="text">{audit.text[lang]}</p>
          <p class="text right"><strong>{fmt(audit.price, lang)} {o.currency}</strong></p>
        </div>
      </div>
    </div>
  </section>

  <section class="on-white section">
    <div class="wrap two">
      <div class="stack">
        <p class="label">{o.allIn}</p>
        <ul class="list">{o.allInList.map((i) => <li class="text">{i}</li>)}</ul>
        <p class="label" style="margin-top:24px">{o.termsTitle}</p>
        <ul class="list">{o.terms.map((i) => <li class="text">{i}</li>)}</ul>
      </div>
      <div class="stack">
        <p class="label">{o.addonsTitle}</p>
        <div class="rows">
          {addons.map((a) => <div class="addon"><span class="text">{a.name[lang]}</span><span class="text">{a.price[lang]}</span></div>)}
        </div>
        <p class="label" style="margin-top:24px">{o.intlTitle}</p>
        <p class="text">{o.intl}</p>
      </div>
    </div>
  </section>

  <section class="on-white section">
    <div class="wrap">
      <div class="head"><p class="label">{s.home.faqTitle}</p></div>
      <div class="faq-wrap"><Faq items={s.faq} /></div>
    </div>
  </section>
</Base>
<style>
  .top0 { padding-top: 0; }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; align-content: start; }
  .list li { padding-left: 20px; position: relative; }
  .list li::before { content: ''; position: absolute; left: 0; top: .72em; width: 10px; height: 1px; background: currentColor; }
  .start { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 40px; align-items: start; }
  .price-block { display: grid; gap: 8px; justify-items: start; }
  .price-block .btn { margin-top: 16px; }
  .p-big { margin: 0; font-weight: 600; font-size: clamp(56px, 7vw, 104px); line-height: .95; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  .p-mid { margin: 12px 0 0; font-weight: 600; font-size: clamp(32px, 3vw, 44px); line-height: 1; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .cur { font-size: .36em; letter-spacing: 0; font-weight: 500; }
  .plans { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: var(--line) solid rgba(255,255,255,.35); }
  .plan { display: grid; grid-template-rows: auto auto 1fr auto; gap: 20px; padding: 28px 28px 32px 0; }
  .plan + .plan { border-left: var(--line) solid rgba(255,255,255,.35); padding-left: 28px; }
  .reels { margin: 0; display: flex; align-items: baseline; gap: 10px; }
  .reels .n { font-weight: 600; font-size: 44px; line-height: 1; letter-spacing: -0.03em; }
  .foot { display: grid; gap: 4px; border-top: var(--line) solid rgba(255,255,255,.35); padding-top: 20px; }
  .foot p { margin: 0; }
  .note { margin-top: 32px; max-width: 46rem; }
  .table .row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr) minmax(0, .8fr); gap: 24px; padding-block: 28px; align-items: baseline; }
  .right { text-align: right; }
  .two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(40px, 6vw, 96px); }
  .addon { display: flex; justify-content: space-between; gap: 16px; padding-block: 14px; }
  .addon span:last-child { white-space: nowrap; }
  .faq-wrap { margin-left: calc(25% + 6px); }
  @media (max-width: 960px) {
    .plans { grid-template-columns: 1fr; }
    .plan, .plan + .plan { padding: 28px 0; border-left: 0; }
    .plan + .plan { border-top: var(--line) solid rgba(255,255,255,.35); }
  }
  @media (max-width: 760px) {
    .start, .two { grid-template-columns: 1fr; }
    .table .row { grid-template-columns: 1fr; gap: 8px; }
    .right { text-align: left; }
    .faq-wrap { margin-left: 0; }
  }
</style>
