---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import Plans from '../../components/Plans.astro';
import { t, type Locale } from '../../i18n/strings';
import { c } from '../../i18n/copy';
import { href } from '../../i18n/paths';
import { langPaths } from '../../i18n/static';
import { mark } from '../../i18n/mark';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const s = t(lang);
const o = s.offers;
const k = c(lang).offers;
const p = c(lang).plans;
const h = c(lang).home;
const [t0, t1] = mark(k.title);
---
<Base lang={lang} title={o.title} page="offers">
  <section class="page-head lit">
    <div class="wrap wide stack" style="--gap:22px">
      <h1 class="h1 rv">{t0}<span class="hl">{t1}</span></h1>
      <p class="text text-l lede rv" style="--d:80ms">{k.sub}</p>
    </div>
  </section>

  <section class="section plans-sec">
    <div class="wrap wide">
      <h2 class="sr">{h.plansTitle}</h2>
      <Plans lang={lang} />
      <p class="note rv">{p.spec.out} {o.launchNote} {o.monthlyNote}</p>
    </div>
  </section>

  <section class="section pay-sec">
    <div class="wrap wide">
      <h2 class="h2 rv">{k.splitTitle}</h2>
      <div class="split">
        {[k.make, k.run, k.costs].map((x, i) => (
          <article class="part rv" style={`--d:${i * 70}ms`}>
            <p class="tag-l"><span class="tape flat">{x.tag}</span></p>
            <h3 class="h3">{x.t}</h3>
            <p class="text">{x.d}</p>
          </article>
        ))}
      </div>
      <div class="every rv">
        <p class="label">{k.every}</p>
        <ul class="ticks-list">{o.allInList.map((i) => <li>{i}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section beyond-sec">
    <div class="wrap wide beyond">
      <div class="stack rv" style="--gap:24px">
        <h2 class="h2">{k.beyond.title}</h2>
        <p class="text text-l soft">{k.beyond.text}</p>
        <p class="quote">{k.beyond.quote}</p>
        <a class="btn primary" href={`${href(lang, 'apply')}?plan=bespoke`}>{k.beyond.cta} <span class="arr" aria-hidden="true">→</span></a>
      </div>
      <ol class="kinds">
        {k.beyond.items.map((it, i) => (
          <li class="rv" style={`--d:${i * 70}ms`}>
            <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div><h3 class="h3">{it.t}</h3><p class="text">{it.d}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section paying-sec">
    <div class="wrap wide paying">
      <h2 class="h2 rv">{k.pay.title}</h2>
      <dl class="rows">
        {k.pay.rows.map(([a, b], i) => <div class="rv" style={`--d:${i * 50}ms`}><dt>{a}</dt><dd>{b}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="section faq-sec">
    <div class="wrap wide faq-grid">
      <div class="faq-lead rv">
        <h2 class="h2">{k.faqTitle}</h2>
      </div>
      <div class="stack faq-col rv" style="--gap:0px">
        <div class="faq lead-faq">
          <details>
            <summary><span>{k.terms}</span><span class="pm" aria-hidden="true"></span></summary>
            <ul class="terms text">{o.terms.map((i) => <li>{i}</li>)}</ul>
          </details>
        </div>
        <Faq items={s.faq} limit={6} more={{ href: href(lang, 'faq'), label: h.faqAll }} />
      </div>
    </div>
  </section>
</Base>
<style>
  .lede { max-width: 44rem; }
  .plans-sec { padding-top: clamp(40px, 5vw, 72px); }
  .note { margin: 24px 0 0; max-width: 56rem; font-size: 14px; line-height: 1.5; color: var(--fg-3); }

  /* What the fee covers: three columns on hairlines, no boxes. */
  .pay-sec, .beyond-sec, .faq-sec { border-top: 1px solid var(--hair); }
  .pay-sec .h2 { max-width: 12ch; margin-bottom: clamp(32px, 4vw, 56px); }
  .split { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(20px, 3vw, 48px); }
  .part { display: grid; gap: 12px; align-content: start; padding-top: 22px; border-top: 1px solid var(--hair-2); }
  .part .text { margin: 0; color: var(--fg-2); }
  .tag-l { margin: 0 0 4px; }
  .paying-sec { border-top: 1px solid var(--hair); }
  .paying { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .paying .h2 { max-width: 10ch; }
  .rows { margin: 0; border-top: 1px solid var(--hair-2); }
  .rows > div { display: grid; grid-template-columns: minmax(140px, .5fr) minmax(0, 1fr); gap: 8px 32px; padding: clamp(16px, 1.6vw, 22px) 0; border-bottom: 1px solid var(--hair); }
  .rows dt { font-weight: 700; letter-spacing: -0.01em; }
  .rows dd { margin: 0; color: var(--fg-2); }
  @media (max-width: 860px) { .paying, .rows > div { grid-template-columns: 1fr; } }
  .every { margin-top: clamp(40px, 4.4vw, 64px); padding-top: 22px; display: grid; grid-template-columns: auto 1fr; gap: 16px 40px; align-items: baseline; border-top: 1px solid var(--hair); }
  .every .ticks-list { display: flex; flex-wrap: wrap; gap: 12px 32px; }
  .every .ticks-list li { white-space: nowrap; font-size: 15px; }
  .every .label { margin: 0; }

  .beyond { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(40px, 7vw, 112px); align-items: start; }
  .beyond .h2 { max-width: 13ch; }
  .beyond .stack { justify-items: start; }
  .beyond .text { margin: 0; }
  .quote { margin: 0; padding-left: 16px; border-left: 2px solid var(--pink); font-weight: 600; font-size: 18px; line-height: 1.4; max-width: 30rem; }
  .kinds { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--hair); }
  .kinds li { display: grid; grid-template-columns: 56px 1fr; gap: 16px; padding: clamp(20px, 2vw, 28px) 0; border-bottom: 1px solid var(--hair); }
  .kinds .n { font-weight: 700; font-size: 14px; padding-top: 5px; color: var(--fg-3); font-variant-numeric: tabular-nums; }
  .kinds .h3 { margin-bottom: 6px; }
  .kinds .text { margin: 0; color: var(--fg-2); }

  .faq-col > :global(div > .faq) { border-top: 0; }
  .terms { margin: 0; padding: 0 48px 24px 20px; display: grid; gap: 10px; color: var(--fg-2); }
  .faq-grid { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .faq-lead { display: grid; gap: 28px; justify-items: start; }
  @media (max-width: 960px) { .split { grid-template-columns: 1fr; } .beyond { grid-template-columns: 1fr; } }
  @media (max-width: 860px) { .faq-grid, .every { grid-template-columns: 1fr; } .every .ticks-list li { white-space: normal; } }
</style>
