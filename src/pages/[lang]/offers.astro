---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import PlanPanels from '../../components/PlanPanels.astro';
import { launch } from '../../i18n/launch';
import { t, type Locale } from '../../i18n/strings';
import { c } from '../../i18n/copy';
import { href } from '../../i18n/paths';
import { langPaths } from '../../i18n/static';
import { mark } from '../../i18n/mark';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const s = t(lang);
const o = s.offers;
const k = c(lang).offers;
const p = c(lang).plans;
const h = c(lang).home;
const [t0, t1] = mark(k.title);
const L = launch(lang);
---
<Base lang={lang} title={o.title} page="offers">
  <section class="page-head lit mid">
    <div class="wrap wide stack" style="--gap:22px">
      <h1 class="h1 rv">{t0}<span class="hl">{t1}</span></h1>
      <p class="text text-l lede rv" style="--d:80ms">{k.sub}</p>
    </div>
  </section>

  <section class="section bw-block" id="brand-world">
    <div class="wrap wide bwo">
      <div class="rv">
        <p class="tape flat">{L.bw.label}</p>
        <h2 class="h2 bw-t">{L.bw.name}</h2>
        <p class="text-l bw-l">{L.bw.title}</p>
      </div>
      <div class="rv bw-r" style="--d:80ms">
        <p class="text">{L.bw.price}</p>
        <div class="actions">
          <a class="btn primary lg" href={`${href(lang, 'apply')}?plan=brandworld`}>{L.bw.quote} <span class="arr" aria-hidden="true">→</span></a>
          <a class="btn lg" href={href(lang, 'brand-world')}>{L.bw.see} <span class="arr" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section plans-sec">
    <div class="wrap wide">
      <h2 class="sr">{h.plansTitle}</h2>
      <div class="every-p rv">
        <h3 class="every-t">{L.plans.everyTitle}</h3>
        <ul>{L.plans.every.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div class="panels">
        <PlanPanels lang={lang} part="test" />
        <div class="m"><PlanPanels lang={lang} part="monthly" /></div>
      </div>
      <p class="note rv">{p.spec.out} {o.launchNote} {o.monthlyNote}</p>
    </div>
  </section>

  <section class="section pay-sec">
    <div class="wrap wide">
      <h2 class="h2 rv">{k.splitTitle}</h2>
      <div class="split">
        {[k.make, k.run, k.costs].map((x, i) => (
          <article class="part rv" style={`--d:${i * 70}ms`}>
            <p class="tag-l"><span class="tape flat">{x.tag}</span></p>
            <h3 class="h3">{x.t}</h3>
            <p class="text">{x.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section beyond-sec">
    <div class="wrap wide beyond">
      <div class="stack rv" style="--gap:24px">
        <h2 class="h2">{k.beyond.title}</h2>
        <p class="text text-l soft">{k.beyond.text}</p>
        <p class="quote">{k.beyond.quote}</p>
        <a class="btn primary" href={`${href(lang, 'apply')}?plan=bespoke`}>{k.beyond.cta} <span class="arr" aria-hidden="true">→</span></a>
      </div>
      <ol class="kinds">
        {k.beyond.items.map((it, i) => (
          <li class="rv" style={`--d:${i * 70}ms`}>
            <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div><h3 class="h3">{it.t}</h3><p class="text">{it.d}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section paying-sec">
    <div class="wrap wide paying">
      <h2 class="h2 rv">{k.pay.title}</h2>
      <dl class="rows">
        {k.pay.rows.map(([a, b], i) => <div class="rv" style={`--d:${i * 50}ms`}><dt>{a}</dt><dd>{b}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="section faq-sec">
    <div class="wrap wide faq-grid">
      <div class="faq-lead rv">
        <h2 class="h2">{k.faqTitle}</h2>
      </div>
      <div class="stack faq-col rv" style="--gap:0px">
        <div class="faq lead-faq">
          <details>
            <summary><span>{k.terms}</span><span class="pm" aria-hidden="true"></span></summary>
            <ul class="terms text">{o.terms.map((i) => <li>{i}</li>)}</ul>
          </details>
        </div>
        <Faq items={s.faq} limit={6} more={{ href: href(lang, 'faq'), label: h.faqAll }} />
      </div>
    </div>
  </section>
</Base>
<style>
  .lede { max-width: 44rem; }
  .plans-sec { padding-top: clamp(40px, 5vw, 72px); }
  .note { margin: 24px auto 0; max-width: 56rem; text-align: center; font-size: 15px; font-weight: 500; line-height: 1.5; }
  .bw-block { padding-block: clamp(40px, 5vw, 72px); }
  .bwo { padding: clamp(28px, 3.4vw, 56px); border-radius: 32px; background: var(--blue); display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(24px, 5vw, 96px); align-items: end; }
  .bw-t { margin-top: 14px; }
  .bw-l { margin: 12px 0 0; max-width: 34rem; font-weight: 700; }
  .bw-r { display: grid; gap: 20px; }
  .bw-r .text { margin: 0; font-weight: 500; }
  .every-p { display: grid; justify-items: center; gap: 14px; margin-bottom: clamp(32px, 3.6vw, 52px); text-align: center; }
  .every-t { margin: 0; font-weight: 800; font-size: 15px; letter-spacing: .02em; text-transform: uppercase; }
  .every-p ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 30px; max-width: 64rem; font-weight: 600; font-size: clamp(16px, 1.2vw, 19px); }
  .every-p li { position: relative; padding-left: 18px; }
  .every-p li::before { content: ''; position: absolute; left: 0; top: .45em; width: 8px; height: 8px; border-radius: 50%; background: #000; }
  .panels { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: clamp(16px, 1.6vw, 24px); align-items: stretch; }
  .panels :global(.pp.k-test) { height: 100%; }
  .m { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(16px, 1.6vw, 24px); }
  .m :global(.k-partner) { grid-column: 1 / -1; }
  @media (max-width: 1000px) { .panels, .m, .bwo { grid-template-columns: 1fr; } }

  /* What the fee covers: three filled blocks. */
  .pay-sec .h2 { max-width: 14ch; margin: 0 auto clamp(32px, 4vw, 56px); text-align: center; text-wrap: balance; }
  .split { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(20px, 3vw, 48px); }
  .part { display: grid; gap: 12px; align-content: start; padding: clamp(22px, 2.2vw, 32px); border-radius: var(--r-lg); background: var(--blue); }
  .part .text { margin: 0; font-weight: 500; }
  .tag-l { margin: 0 0 4px; }
  .paying { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .paying .h2 { max-width: 10ch; }
  .rows { margin: 0; display: grid; gap: 12px; }
  .rows > div { display: grid; grid-template-columns: minmax(140px, .5fr) minmax(0, 1fr); gap: 8px 32px; padding: clamp(16px, 1.6vw, 22px) clamp(18px, 2vw, 28px); border-radius: var(--r); background: #fff; box-shadow: inset 0 0 0 1.5px #000; }
  .rows dt { font-weight: 800; }
  .rows dd { margin: 0; font-weight: 500; }
  @media (max-width: 860px) { .paying, .rows > div { grid-template-columns: 1fr; } }

  .beyond { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(40px, 7vw, 112px); align-items: start; }
  .beyond .h2 { max-width: 13ch; }
  .beyond .stack { justify-items: start; }
  .beyond .text { margin: 0; }
  .quote { margin: 0; padding: 12px 18px; border-radius: var(--r); background: var(--blue); font-weight: 700; font-size: 18px; line-height: 1.4; max-width: 30rem; }
  .kinds { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .kinds li { display: grid; grid-template-columns: 56px 1fr; gap: 16px; padding: clamp(18px, 2vw, 26px); border-radius: var(--r); background: #fff; box-shadow: inset 0 0 0 1.5px #000; }
  .kinds .n { font-weight: 800; font-size: 18px; padding-top: 3px; font-variant-numeric: tabular-nums; }
  .kinds .h3 { margin-bottom: 6px; }
  .kinds .text { margin: 0; font-weight: 500; }

  .terms { margin: 0; padding: 0 48px 24px 20px; display: grid; gap: 10px; font-weight: 500; }
  .faq-grid { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .faq-lead { display: grid; gap: 28px; justify-items: start; }
  @media (max-width: 960px) { .split { grid-template-columns: 1fr; } .beyond { grid-template-columns: 1fr; } }
  @media (max-width: 860px) { .faq-grid { grid-template-columns: 1fr; } }
</style>
