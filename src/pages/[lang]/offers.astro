---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import Plans from '../../components/Plans.astro';
import { t, type Locale } from '../../i18n/strings';
import { c } from '../../i18n/copy';
import { href } from '../../i18n/paths';
import { langPaths } from '../../i18n/static';
import { test, campaign, audit, fmt } from '../../data/offers';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const s = t(lang);
const o = s.offers;
const k = c(lang).offers;
const p = c(lang).plans;
const cta = c(lang).nav.apply;
const oneOffs = [
  { name: test.name, text: test.items[lang].join('. ') + '.', price: test.launch, standard: test.standard },
  { name: campaign.name, text: campaign.items[lang].join('. ') + '.', price: campaign.launch },
  { name: audit.name, text: audit.text[lang], price: audit.price },
];
---
<Base lang={lang} title={o.title}>
  <section class="page-head">
    <div class="wrap stack center" style="--gap:20px">
      <h1 class="h1 rv">{k.title} <span class="soft">{k.title2}</span></h1>
      <p class="text text-l soft measure rv" style="--d:100ms">{k.sub}</p>
    </div>
  </section>

  <section class="plans-sec">
    <div class="wrap"><Plans lang={lang} /></div>
    <p class="wrap small soft note rv">{o.launchNote} {o.monthlyNote}</p>
  </section>

  <section class="on-paper section">
    <div class="wrap">
      <div class="head rv"><div class="stack" style="--gap:14px"><h2 class="h2">{k.oneOff}</h2><p class="text sub">{k.oneOffSub}</p></div></div>
      <div class="ones">
        {oneOffs.map((x, i) => (
          <article class="one rv" style={`--d:${i * 80}ms`}>
            <h3 class="h3">{x.name}</h3>
            <p class="text soft">{x.text}</p>
            <div class="foot">
              <p><span class="num">{fmt(x.price, lang)}</span> <span class="soft">{o.currency}</span></p>
              {x.standard && <p class="small soft">{p.usually} {fmt(x.standard, lang)} {o.currency}</p>}
            </div>
            <a class="link" href={href(lang, 'apply')}>{cta} →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap every">
      <div class="stack rv" style="--gap:24px">
        <h2 class="h2">{k.every}</h2>
        <ul class="ticks-list text-l">{o.allInList.map((i) => <li>{i}</li>)}</ul>
      </div>
      <div class="rv" style="--d:100ms">
        <div class="faq">
          <details>
            <summary><span>{k.terms}</span><span class="pm" aria-hidden="true"></span></summary>
            <ul class="terms text">{o.terms.map((i) => <li>{i}</li>)}</ul>
          </details>
          <details>
            <summary><span>{o.intlTitle}</span><span class="pm" aria-hidden="true"></span></summary>
            <p class="text a">{o.intl}</p>
          </details>
        </div>
      </div>
    </div>
  </section>

  <section class="on-paper section">
    <div class="wrap faq-grid">
      <div class="head rv"><h2 class="h2">{c(lang).home.faqTitle}</h2></div>
      <div class="rv"><Faq items={s.faq} /></div>
    </div>
  </section>
</Base>
<style>
  .page-head .h1 { max-width: 16ch; }
  .plans-sec { padding-bottom: var(--section); }
  .note { margin-top: 24px; text-align: center; max-width: 52rem; }
  .ones { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(14px, 1.6vw, 22px); }
  .one { display: grid; grid-template-rows: auto 1fr auto auto; gap: 16px; padding: clamp(24px, 2.4vw, 32px); background: var(--white); border-radius: var(--r-lg); border: var(--line) solid var(--ink); transition: transform 500ms var(--ease), box-shadow 500ms var(--ease), opacity 900ms var(--ease), filter 900ms var(--ease); }
  .one.in:hover { transform: translate(-4px, -4px); box-shadow: var(--shadow-2); }
  .one .foot { padding-top: 16px; border-top: 1px solid var(--hair); }
  .one .foot p { margin: 0; }
  .num { font-weight: 700; font-size: 30px; letter-spacing: -0.03em; }
  .every { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .terms { margin: 0; padding: 0 64px 22px 40px; display: grid; gap: 10px; color: var(--ink-2); }
  .faq-grid { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .faq-grid .head { margin-bottom: 0; }
  @media (max-width: 860px) { .ones, .every, .faq-grid { grid-template-columns: 1fr; } }
</style>
