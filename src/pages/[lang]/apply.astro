---
import Base from '../../layouts/Base.astro';
import ApplyBlock from '../../components/ApplyBlock.astro';
import { t, type Locale } from '../../i18n/strings';
import { langPaths } from '../../i18n/static';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const s = t(lang);
---
<Base lang={lang} title={s.nav.apply}>
  <section class="on-yellow page-head section-apply">
    <div class="wrap"><ApplyBlock lang={lang} heading="h1" /></div>
  </section>
</Base>
<style>.section-apply { padding-bottom: var(--section); }</style>
