---
import { mark } from '../../i18n/mark';
import Base from '../../layouts/Base.astro';
import Workspace from '../../components/Workspace.astro';
import { type Locale } from '../../i18n/strings';
import { c } from '../../i18n/copy';
import { langPaths } from '../../i18n/static';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const p = c(lang).process;
const [t0, t1] = mark(p.title);
---
<Base lang={lang} title={p.title} page="process">
  <section class="page-head lit">
    <div class="wrap wide stack" style="--gap:22px">
      <h1 class="h1 rv">{t0}<span class="hl">{t1}</span></h1>
      <p class="text text-l lede rv" style="--d:80ms">{p.sub}</p>
    </div>
  </section>

  <section class="road-sec">
    <div class="wrap wide">
      <ol class="steps" data-road>
        {p.steps.map((st, i) => (
          <li class="step rv">
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="t">{st.t}{st.pay && <span class="pay">{p.pay}</span>}</h2>
            <div class="body">
              <p class="text">{st.d}</p>
              <p class="yours"><span class="k">{p.yours}</span>{st.you}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="monthly rv">{p.monthly}</p>
    </div>
  </section>

  <Workspace lang={lang} cta={false} />
</Base>

<script>
  // Each step's big number fills in once the step has scrolled past the middle of the screen.
  document.querySelectorAll<HTMLElement>('[data-road]').forEach((road) => {
    const steps = [...road.querySelectorAll<HTMLElement>('.step')];
    let ticking = false;
    const tick = () => {
      const mid = innerHeight * 0.62;
      steps.forEach((s) => s.classList.toggle('passed', s.getBoundingClientRect().top < mid));
      ticking = false;
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(tick); } }, { passive: true });
    tick();
  });
</script>

<style>
  .lede { max-width: 40rem; }
  .road-sec { padding-block: clamp(40px, 5vw, 72px) var(--section); }
  .steps { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--hair-2); }
  .step { display: grid; grid-template-columns: minmax(0, .45fr) minmax(0, 1fr) minmax(0, 1.3fr); grid-template-areas: 'num t body'; gap: clamp(16px, 3vw, 56px); align-items: start;
    padding-block: clamp(28px, 3.4vw, 52px); border-bottom: 1px solid var(--hair); }
  /* The big numbers are drawn in outline and fill in black once the step has scrolled past the middle of the screen. */
  .num { grid-area: num; font-weight: 700; font-size: clamp(56px, 6.4vw, 112px); line-height: .8; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; color: transparent; -webkit-text-stroke: 1.5px var(--fg); transition: color 600ms var(--ease); }
  .passed .num { color: var(--fg); }
  .t { grid-area: t; margin: 0; font-weight: 700; font-size: clamp(26px, 2.6vw, 42px); line-height: 1.05; letter-spacing: -0.04em; text-wrap: balance; }
  /* The two steps where you pay carry a small word on the pink marker. */
  .pay { display: inline-block; margin-left: 12px; padding: 0 .2em; vertical-align: .4em; font-size: 14px; line-height: 1.3; letter-spacing: 0;
    background: linear-gradient(var(--pink), var(--pink)) 0 80% / 100% 55% no-repeat; }
  .body { grid-area: body; display: grid; gap: 16px; }
  .body .text { margin: 0; max-width: 36rem; color: var(--fg-2); }
  .yours { margin: 0; font-size: 16px; line-height: 1.45; font-weight: 600; }
  .yours .k { display: block; margin-bottom: 4px; font-size: 13px; font-weight: 700; color: var(--fg-3); }
  .monthly { margin: clamp(28px, 3vw, 40px) 0 0; max-width: 40rem; font-size: 16px; color: var(--fg-2); }
  @media (max-width: 1000px) and (min-width: 761px) {
    .step { grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); grid-template-areas: 'num body' 't body'; row-gap: 20px; }
  }
  @media (max-width: 760px) {
    .step { grid-template-columns: auto minmax(0, 1fr); grid-template-areas: 'num t' 'body body'; gap: 16px 18px; align-items: end; padding-block: 28px; }
    .num { font-size: 56px; -webkit-text-stroke-width: 1px; }
    .t { font-size: clamp(24px, 7vw, 30px); }
  }
  @media (prefers-reduced-motion: reduce) { .num { color: var(--fg); transition: none; } }
</style>
