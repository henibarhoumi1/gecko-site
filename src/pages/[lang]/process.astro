---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { type Locale } from '../../i18n/strings';
import { c } from '../../i18n/copy';
import { langPaths } from '../../i18n/static';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const p = c(lang).process;
---
<Base lang={lang} footerCta={false} title={p.title}>
  <section class="page-head">
    <div class="wrap stack" style="--gap:22px">
      <h1 class="h1 rv">{p.title}</h1>
      <p class="text text-l lede rv" style="--d:80ms">{p.sub}</p>
    </div>
  </section>

  <section class="road-sec">
    <div class="wrap journey">
      <aside class="legend rv">
        <p class="key"><span class="chip ok">{p.tags.ok}</span> {p.legend.ok}</p>
        <p class="key"><span class="chip pay">{p.tags.pay}</span> {p.legend.pay}</p>
        <p class="text monthly">{p.monthly}</p>
      </aside>
      <div class="road" data-road>
        <span class="rail" aria-hidden="true"><i data-fill></i></span>
        <ol class="steps">
          {p.steps.map((st, i) => (
            <li class="step rv">
              <span class="dot" aria-hidden="true">{i + 1}</span>
              <div class="card">
                <div class="top">
                  <h2 class="h3 t">{st.t}</h2>
                  {st.tag && <span class={`chip ${st.tag}`}>{p.tags[st.tag as 'ok' | 'pay']}</span>}
                </div>
                <p class="text">{st.d}</p>
                <p class="yours"><span>{p.yours}</span> {st.you}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="on-paper section portal-sec">
    <div class="wrap portal">
      <div class="stack rv" style="--gap:24px">
        <h2 class="h2">{p.portal.title}</h2>
        <p class="text text-l">{p.portal.text}</p>
        <p class="status"><span class="pulse" aria-hidden="true"></span>{p.portal.status}</p>
      </div>
      <div class="room rv" style="--d:100ms">
        <p class="label">{p.portal.list}</p>
        <ul class="ticks-list">{p.portal.items.map((it) => <li>{it}</li>)}</ul>
      </div>
    </div>
  </section>

  <Cta lang={lang} title={p.cta} />
</Base>

<script>
  // The rail fills as you scroll down the steps; each step's dot lights up when passed.
  document.querySelectorAll<HTMLElement>('[data-road]').forEach((road) => {
    const fill = road.querySelector<HTMLElement>('[data-fill]')!;
    const steps = [...road.querySelectorAll<HTMLElement>('.step')];
    let ticking = false;
    const tick = () => {
      const r = road.getBoundingClientRect(); const mid = innerHeight * 0.55;
      fill.style.transform = `scaleY(${Math.min(1, Math.max(0, (mid - r.top) / r.height))})`;
      steps.forEach((s) => s.classList.toggle('passed', s.getBoundingClientRect().top < mid));
      ticking = false;
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(tick); } }, { passive: true });
    tick();
  });
</script>

<style>
  .lede { max-width: 44rem; }
  .road-sec { padding-bottom: var(--section); }
  .journey { display: grid; grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .legend { position: sticky; top: 120px; display: grid; gap: 12px; justify-items: start; }
  .key { margin: 0; display: grid; gap: 8px; justify-items: start; font-size: 17px; line-height: 1.4; }
  .key + .key { margin-top: 10px; }
  .monthly { margin: 12px 0 0; max-width: 24rem; padding-top: 18px; border-top: var(--line) solid var(--ink); }
  .road { position: relative; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .rail { position: absolute; left: 19px; top: 22px; bottom: 22px; width: 2px; border-radius: 2px; background: rgba(0, 0, 0, .1); }
  .rail i { position: absolute; inset: 0; background: var(--ink); transform-origin: top; transform: scaleY(0); border-radius: 2px; }
  .step { position: relative; padding-left: 64px; }
  .dot { position: absolute; left: 0; top: 20px; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; font-weight: 700; font-size: 15px; background: var(--white); border: var(--line) solid var(--ink); transition: background 300ms var(--ease), color 300ms var(--ease); }
  .passed .dot { background: var(--ink); color: #fff; }
  .card { display: grid; gap: 10px; padding: clamp(20px, 2.2vw, 28px); background: var(--white); border-radius: var(--r-lg); border: var(--line) solid var(--ink); }
  .top { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .t { font-size: clamp(22px, 2vw, 28px); letter-spacing: -0.03em; }
  .chip { display: inline-block; padding: 5px 12px; border-radius: 999px; font-size: 13px; font-weight: 700; border: var(--line) solid var(--ink); }
  .chip.ok { background: var(--yellow); }
  .chip.pay { background: var(--pink); }
  .card .text { margin: 0; }
  .yours { margin: 0; padding: 12px 14px; border-radius: var(--r-sm); background: var(--yellow-soft); font-size: 16px; }
  .yours span { font-weight: 700; margin-right: 6px; }
  .portal-sec { border-top: var(--line) solid var(--ink); }
  .portal { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: clamp(40px, 7vw, 112px); align-items: center; }
  .portal .h2 { max-width: 14ch; }
  .status { margin: 0; display: inline-flex; align-items: center; gap: 10px; justify-self: start; padding: 8px 14px; border-radius: 999px; border: var(--line) solid var(--ink); background: var(--white); font-size: 15px; font-weight: 600; }
  .pulse { width: 9px; height: 9px; border-radius: 50%; background: var(--ink); animation: pulse 2s infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(0, 0, 0, .4); } 70% { box-shadow: 0 0 0 9px rgba(0, 0, 0, 0); } 100% { box-shadow: 0 0 0 0 rgba(0, 0, 0, 0); } }
  .room { display: grid; gap: 18px; padding: clamp(26px, 3vw, 40px); background: var(--white); border: var(--line) solid var(--ink); border-radius: var(--r-lg); box-shadow: 8px 8px 0 var(--ink); }
  .room .ticks-list { gap: 14px; font-size: 18px; }
  @media (max-width: 900px) {
    .journey, .portal { grid-template-columns: 1fr; }
    .legend { position: static; display: flex; flex-wrap: wrap; align-items: center; }
    .monthly { flex-basis: 100%; }
  }
  @media (max-width: 560px) { .step { padding-left: 52px; } .rail { left: 15px; } .dot { width: 32px; height: 32px; font-size: 13px; } }
  @media (prefers-reduced-motion: reduce) { .pulse { animation: none; } }
</style>
