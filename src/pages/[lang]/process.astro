---
import Base from '../../layouts/Base.astro';
import Stamp from '../../components/Stamp.astro';
import Mark from '../../components/Mark.astro';
import { type Locale } from '../../i18n/strings';
import { c } from '../../i18n/copy';
import { href } from '../../i18n/paths';
import { langPaths } from '../../i18n/static';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const p = c(lang).process;
---
<Base lang={lang} title={p.title}>
  <section class="on-yellow page-head">
    <div class="wrap head-in">
      <h1 class="h1 rv">{p.title}</h1>
      <p class="text text-l measure rv" style="--d:120ms">{p.sub}</p>
      <Stamp kind="rect" tilt={6} class="ok" />
    </div>
  </section>

  <section class="on-white section">
    <div class="wrap">
      <div class="road" data-road>
        <span class="rail" aria-hidden="true"><i data-fill></i></span>
        <ol class="steps">
        {p.steps.map((st, i) => (
          <li class="step rv">
            <span class="dot" aria-hidden="true">{i + 1}</span>
            <div class="when label">{p.label} {i + 1} · {st.when}</div>
            <h2 class="h2">{st.t}</h2>
            <p class="text text-l">{st.d}</p>
            <div class="yours"><span class="label">{p.yours}</span><p class="text">{st.you}</p></div>
          </li>
        ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="on-pink section">
    <div class="wrap">
      <div class="head rv"><p class="label">{p.promiseLabel}</p></div>
      <ul class="promises">
        {p.promises.map((pr, i) => (
          <li class="rv" style={`--d:${i * 90}ms`}>
            <Mark kind="tick" class="tick" />
            <h3 class="h3">{pr.t}</h3>
            <p class="text">{pr.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="on-yellow section">
    <div class="wrap cta">
      <h2 class="h2 rv">{p.cta}</h2>
      <a class="btn primary rv" href={href(lang, 'apply')}>{c(lang).nav.apply} <span class="arr" aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>

<script>
  // The rail fills as you scroll down the steps; each step's dot lights up when passed.
  document.querySelectorAll<HTMLElement>('[data-road]').forEach((road) => {
    const fill = road.querySelector<HTMLElement>('[data-fill]')!;
    const steps = [...road.querySelectorAll<HTMLElement>('.step')];
    const tick = () => {
      const r = road.getBoundingClientRect(); const mid = innerHeight * 0.55;
      const q = Math.min(1, Math.max(0, (mid - r.top) / r.height));
      fill.style.transform = `scaleY(${q})`;
      steps.forEach((s) => s.classList.toggle('passed', s.getBoundingClientRect().top < mid));
    };
    addEventListener('scroll', tick, { passive: true }); tick();
  });
</script>

<style>
  .head-in { position: relative; display: grid; gap: 24px; }
  .head-in :global(.ok) { position: absolute; right: 0; bottom: 0; width: clamp(120px, 14vw, 190px); }
  .road { margin: 0 auto; position: relative; max-width: 980px; }
  .steps { list-style: none; margin: 0; padding: 0; }
  .rail { position: absolute; left: 23px; top: 8px; bottom: 8px; width: 2px; background: var(--pink); }
  .rail i { position: absolute; inset: 0; background: var(--ink); transform-origin: top; transform: scaleY(0); }
  .step { position: relative; padding: 0 0 clamp(64px, 9vw, 120px) 96px; display: grid; gap: 16px; }
  .dot { position: absolute; left: 0; top: 0; width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; font-weight: 700; background: var(--white); border: var(--line) solid var(--ink); transition: background 300ms var(--ease), transform 300ms var(--ease); }
  .passed .dot { background: var(--yellow); transform: scale(1.08); }
  .step .h2 { font-size: clamp(36px, 5vw, 72px); }
  .yours { display: grid; gap: 6px; padding: 16px 18px; background: var(--pink); border: var(--line) solid var(--ink); max-width: 36rem; }
  .yours p { margin: 0; }
  .promises { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(24px, 4vw, 56px); }
  .promises li { display: grid; gap: 12px; align-content: start; }
  .promises :global(.tick) { width: 44px; }
  .cta { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; }
  .cta .h2 { max-width: 14ch; }
  @media (max-width: 760px) {
    .head-in :global(.ok) { position: static; width: 120px; }
    .rail { left: 17px; } .dot { width: 36px; height: 36px; font-size: 14px; }
    .step { padding-left: 60px; }
    .promises { grid-template-columns: 1fr; }
  }
</style>
