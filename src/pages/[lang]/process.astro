---
import Base from '../../layouts/Base.astro';
import Workspace from '../../components/Workspace.astro';
import Cta from '../../components/Cta.astro';
import { type Locale } from '../../i18n/strings';
import { c } from '../../i18n/copy';
import { langPaths } from '../../i18n/static';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const p = c(lang).process;
---
<Base lang={lang} footerCta={false} title={p.title} page="process">
  <section class="page-head lit">
    <div class="wrap wide stack" style="--gap:22px">
      <h1 class="h1 rv">{p.title}</h1>
      <p class="text text-l lede rv" style="--d:80ms">{p.sub}</p>
    </div>
  </section>

  <section class="road-sec">
    <div class="wrap journey">
      <aside class="legend rv">
        <p class="key"><span class="chip ok">{p.tags.ok}</span> {p.legend.ok}</p>
        <p class="key"><span class="chip pay">{p.tags.pay}</span> {p.legend.pay}</p>
        <p class="text monthly">{p.monthly}</p>
      </aside>
      <div class="road" data-road>
        <span class="rail" aria-hidden="true"><i data-fill></i></span>
        <ol class="steps">
          {p.steps.map((st, i) => (
            <li class="step rv">
              <span class="dot" aria-hidden="true">{i + 1}</span>
              <div class="card">
                <div class="top">
                  <h2 class="h3 t">{st.t}</h2>
                  {st.tag && <span class={`chip ${st.tag}`}>{p.tags[st.tag as 'ok' | 'pay']}</span>}
                </div>
                <p class="text">{st.d}</p>
                <p class="yours"><span>{p.yours}</span> {st.you}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <Workspace lang={lang} cta={false} />

  <Cta lang={lang} title={p.cta} />
</Base>

<script>
  // The rail fills as you scroll down the steps; each step's dot lights up when passed.
  document.querySelectorAll<HTMLElement>('[data-road]').forEach((road) => {
    const fill = road.querySelector<HTMLElement>('[data-fill]')!;
    const steps = [...road.querySelectorAll<HTMLElement>('.step')];
    let ticking = false;
    const tick = () => {
      const r = road.getBoundingClientRect(); const mid = innerHeight * 0.55;
      fill.style.transform = `scaleY(${Math.min(1, Math.max(0, (mid - r.top) / r.height))})`;
      steps.forEach((s) => s.classList.toggle('passed', s.getBoundingClientRect().top < mid));
      ticking = false;
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(tick); } }, { passive: true });
    tick();
  });
</script>

<style>
  .lede { max-width: 44rem; }
  .road-sec { padding-block: clamp(48px, 6vw, 88px) var(--section); }
  .journey { display: grid; grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .legend { position: sticky; top: 120px; display: grid; gap: 12px; justify-items: start; }
  .key { margin: 0; display: grid; gap: 8px; justify-items: start; font-size: 16px; line-height: 1.45; color: var(--fg-2); }
  .key + .key { margin-top: 10px; }
  .monthly { margin: 12px 0 0; max-width: 24rem; padding-top: 18px; border-top: 1px solid var(--hair); color: var(--fg-2); font-size: 16px; }
  .road { position: relative; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .rail { position: absolute; left: 19px; top: 22px; bottom: 22px; width: 2px; border-radius: 2px; background: var(--hair); }
  .rail i { position: absolute; inset: 0; background: var(--fg); transform-origin: top; transform: scaleY(0); border-radius: 2px; }
  .step { position: relative; padding-left: 64px; }
  .dot { position: absolute; left: 0; top: 16px; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; font-weight: 700; font-size: 15px; background: var(--bg); color: var(--fg-2); border: 1px solid var(--hair-2); transition: background 300ms var(--ease), color 300ms var(--ease), border-color 300ms var(--ease); }
  .passed .dot { background: var(--fg); border-color: var(--fg); color: var(--bg); }
  .card { display: grid; gap: 8px; padding: clamp(16px, 1.7vw, 22px) clamp(18px, 2vw, 26px); background: var(--surface); border-radius: 20px; border: 1px solid var(--edge); }
  .top { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .t { font-size: clamp(19px, 1.6vw, 23px); letter-spacing: -0.025em; }
  .chip { display: inline-block; padding: 5px 11px; border-radius: 999px; font-size: 12px; font-weight: 700; color: var(--ink); }
  .chip.ok { background: var(--yellow); }
  .chip.pay { background: var(--pink); }
  .card .text { margin: 0; color: var(--fg-2); }
  .yours { margin: 4px 0 0; padding: 9px 12px; border-radius: 12px; background: var(--yellow-soft); font-size: 15px; }
  .yours span { font-weight: 700; margin-right: 6px; }
  @media (max-width: 900px) {
    .journey { grid-template-columns: 1fr; }
    .legend { position: static; display: flex; flex-wrap: wrap; align-items: center; }
    .monthly { flex-basis: 100%; }
  }
  @media (max-width: 560px) { .step { padding-left: 52px; } .rail { left: 15px; } .dot { width: 32px; height: 32px; font-size: 13px; } }
  @media (prefers-reduced-motion: reduce) { .pulse { animation: none; } }
</style>
