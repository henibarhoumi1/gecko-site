---
import Base from '../../layouts/Base.astro';
import LeadForm from '../../components/LeadForm.astro';
import { t, type Locale } from '../../i18n/strings';
import { langPaths } from '../../i18n/static';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const s = t(lang);
const c = s.creators;
const fields = [
  { name: 'name', label: c.name, required: true, auto: 'name' },
  { name: 'age', label: c.age, type: 'number', required: true },
  { name: 'city', label: c.city, required: true, auto: 'address-level2' },
  { name: 'instagram', label: c.instagram },
  { name: 'video', label: c.video, type: 'url', required: true },
  { name: 'phone', label: c.phone, type: 'tel', required: true, auto: 'tel' },
];
---
<Base lang={lang} title={c.title}>
  <section class="on-yellow page-head body">
    <div class="wrap split">
      <div class="stack" style="--gap:24px">
        <h1 class="h1">{c.title}</h1>
        <p class="text text-l measure">{c.intro}</p>
      </div>
      <LeadForm id="creators" subject="New creator from the Gecko website" fields={fields} send={c.send} waIntro={c.waIntro} sent={s.apply.sent} error={s.apply.error} />
    </div>
  </section>
</Base>
<style>
  .body { padding-bottom: var(--section); }
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(40px, 7vw, 120px); align-items: start; }
  @media (max-width: 860px) { .split { grid-template-columns: 1fr; } }
</style>
