---
// Solutions: every direction Gecko works in, as one index. Each row is a link to its page: the number, the name set big,
// its line and what it includes. A row fills with its colour on hover. The brief closes the page for anyone unsure.
import Base from '../../../layouts/Base.astro';
import { type Locale } from '../../../i18n/strings';
import { href } from '../../../i18n/paths';
import { langPaths } from '../../../i18n/static';
import { mark } from '../../../i18n/mark';
import { solutions, sc } from '../../../data/solutions';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const S = sc(lang);
const [t0, t1] = mark(S.pageTitle);
const pad = (n: number) => String(n).padStart(2, '0');
const arrow = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>';
---
<Base lang={lang} title={S.nav} page="solutions">
  <section class="page-head lit mid">
    <div class="wrap wide stack" style="--gap:22px">
      <p class="tape flat rv">{S.label}</p>
      <h1 class="h1 rv">{t0}<span class="hl">{t1}</span></h1>
      <p class="text text-l lede rv" style="--d:80ms">{S.pageLead}</p>
    </div>
  </section>

  <section class="section idx-sec">
    <div class="wrap wide">
      <ol class="idx">
        {solutions.map((s, i) => (
          <li class="rv" style={`--d:${Math.min(i, 3) * 50}ms`}>
            <a href={href(lang, s.page)} data-tone={s.tone} class:list={[{ flag: s.flagship }]}>
              <span class="i-n">{pad(i + 1)}</span>
              <span class="i-name">{s.name[lang]}{s.flagship && <em>{S.flag}</em>}</span>
              <span class="i-line">{s.line[lang]}</span>
              <ul class="i-chips">{s.chips[lang].map((x) => <li>{x}</li>)}</ul>
              <span class="i-go" set:html={arrow} />
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap wide">
      <div class="unsure rv">
        <div><h2 class="h2">{S.notSure}</h2><p class="text-l">{S.notSureLine}</p></div>
        <a class="btn primary lg" href={href(lang, 'apply')}>{S.brief} <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .lede { max-width: 44rem; }
  .idx-sec { padding-top: 0; }
  .idx { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .idx a { position: relative; display: grid; grid-template-columns: 64px minmax(0, 1.1fr) minmax(0, 1fr) minmax(0, .9fr) 52px; gap: 16px clamp(20px, 3vw, 48px); align-items: center;
    padding: clamp(22px, 2.4vw, 36px) clamp(22px, 2.6vw, 40px); border-radius: 28px; background: #fff; color: #000; box-shadow: inset 0 0 0 1.5px #000; text-decoration: none;
    transition: background 320ms var(--ease), color 320ms var(--ease), transform 400ms var(--ease); }
  .idx a:hover { transform: translateX(6px); }
  .idx a[data-tone='pink']:hover { background: var(--pink); } .idx a[data-tone='yellow']:hover { background: var(--yellow); } .idx a[data-tone='blue']:hover { background: var(--blue); }
  .idx a.flag { background: #000; color: #fff; box-shadow: none; }
  .i-n { font-weight: 700; font-size: 14px; font-variant-numeric: tabular-nums; }
  .i-name { display: grid; gap: 8px; font-weight: 800; font-size: clamp(32px, 3.4vw, 60px); line-height: .95; letter-spacing: -0.045em; font-stretch: 92%; }
  .i-name em { justify-self: start; padding: 6px 11px; border-radius: 999px; background: var(--pink); color: #000; font-style: normal; font-weight: 700; font-size: 13px; letter-spacing: 0; font-stretch: 100%; }
  .i-line { font-weight: 500; font-size: clamp(16px, 1.2vw, 19px); line-height: 1.45; }
  .i-chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .i-chips li { padding: 7px 12px; border-radius: 999px; background: #000; color: #fff; font-weight: 700; font-size: 13px; }
  .flag .i-chips li { background: #fff; color: #000; }
  .i-go { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: #000; }
  .flag .i-go { background: var(--pink); }
  .i-go :global(svg) { width: 22px; height: 22px; fill: none; stroke: #fff; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transform: rotate(-45deg); transition: transform 300ms var(--ease); }
  .flag .i-go :global(svg) { stroke: #000; }
  .idx a:hover .i-go :global(svg) { transform: none; }
  .unsure { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 28px 48px; align-items: end; padding: clamp(32px, 4vw, 64px); border-radius: 32px; background: var(--yellow); }
  .unsure .h2 { margin: 0; max-width: 16ch; }
  .unsure .text-l { margin: 14px 0 0; font-weight: 500; }
  @media (max-width: 1100px) { .idx a { grid-template-columns: 48px minmax(0, 1fr) 52px; } .i-line, .i-chips { grid-column: 2 / 3; } .i-go { grid-row: 1; grid-column: 3; } }
  @media (max-width: 760px) { .unsure { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .idx a:hover { transform: none; } }
</style>
