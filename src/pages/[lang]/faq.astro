---
import { mark } from '../../i18n/mark';
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import { t, type Locale } from '../../i18n/strings';
import { c } from '../../i18n/copy';
import { href } from '../../i18n/paths';
import { langPaths } from '../../i18n/static';
import { site } from '../../data/site';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const s = t(lang);
const f = c(lang).faqPage;
const n = c(lang).nav;
const [t0, t1] = mark(f.title);
---
<Base lang={lang} title={n.faq} page="faq">
  <section class="page-head lit">
    <div class="wrap wide qa">
      <div class="lead rv">
        <h1 class="h1">{t0}<span class="hl">{t1}</span></h1>
        <div class="more">
          <p class="text text-l lede">{f.more}</p>
          <div class="actions">
            <a class="btn primary" href={site.whatsapp} rel="noopener">{f.moreCta} <span class="arr" aria-hidden="true">→</span></a>
            <a class="btn" href={href(lang, 'offers')}>{n.offers}</a>
          </div>
        </div>
      </div>
      <div class="groups">
        {f.groups.map((g, i) => (
          <div class="group rv" style={`--d:${80 + i * 60}ms`}>
            <h2 class="g-t">{g.t}</h2>
            <Faq items={g.ids.map((x) => s.faq[x])} />
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .groups { display: grid; gap: clamp(36px, 4vw, 56px); }
  .g-t { margin: 0 0 6px; font-weight: 700; font-size: 14px; letter-spacing: 0; color: var(--fg-3); }
  .page-head { padding-bottom: var(--section); }
  .qa { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .lead { position: sticky; top: 120px; display: grid; gap: clamp(28px, 4vw, 48px); }
  .lead .h1 { max-width: 9ch; font-size: clamp(46px, 6vw, 96px); }
  .more { display: grid; gap: 16px; }
  .more .text { margin: 0; }
  @media (max-width: 860px) { .qa { grid-template-columns: 1fr; } .lead { position: static; } }
</style>
