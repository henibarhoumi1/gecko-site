---
import Wa from '../../components/Wa.astro';
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import { t, type Locale } from '../../i18n/strings';
import { c } from '../../i18n/copy';
import { href } from '../../i18n/paths';
import { langPaths } from '../../i18n/static';
import { site } from '../../data/site';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const s = t(lang);
const f = c(lang).faqPage;
const n = c(lang).nav;
---
<Base lang={lang} title={n.faq}>
  <section class="page-head">
    <div class="wrap wide qa">
      <div class="lead rv">
        <h1 class="h1">{f.title}</h1>
        <div class="more">
          <p class="text text-l">{f.more}</p>
          <div class="actions">
            <a class="btn primary" href={site.whatsapp} rel="noopener"><Wa /> {f.moreCta} <span class="arr" aria-hidden="true">→</span></a>
            <a class="btn" href={href(lang, 'offers')}>{n.offers}</a>
          </div>
        </div>
      </div>
      <div class="rv" style="--d:80ms"><Faq items={s.faq} /></div>
    </div>
  </section>
</Base>
<style>
  .page-head { padding-bottom: var(--section); }
  .qa { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .lead { position: sticky; top: 120px; display: grid; gap: clamp(28px, 4vw, 48px); }
  .lead .h1 { max-width: 9ch; font-size: clamp(46px, 6vw, 96px); }
  .more { display: grid; gap: 16px; }
  .more .text { margin: 0; }
  @media (max-width: 860px) { .qa { grid-template-columns: 1fr; } .lead { position: static; } }
</style>
