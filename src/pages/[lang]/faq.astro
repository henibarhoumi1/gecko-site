---
import { mark } from '../../i18n/mark';
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import { t, type Locale } from '../../i18n/strings';
import { c } from '../../i18n/copy';
import { href } from '../../i18n/paths';
import { langPaths } from '../../i18n/static';
import { site } from '../../data/site';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const s = t(lang);
const f = c(lang).faqPage;
const n = c(lang).nav;
const [t0, t1] = mark(f.title);
---
<Base lang={lang} title={n.faq} page="faq">
  <section class="page-head lit mid">
    <div class="wrap wide">
      <h1 class="h1 rv">{t0}<span class="hl">{t1}</span></h1>
      <div class="more rv" style="--d:60ms">
        <p class="text text-l">{f.more}</p>
        <div class="actions">
          <a class="btn primary" href={site.whatsapp} rel="noopener">{f.moreCta} <span class="arr" aria-hidden="true">→</span></a>
          <a class="btn" href={href(lang, 'offers')}>{n.offers}</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section qa-sec">
    <div class="wrap groups">
      {f.groups.map((g, i) => (
        <div class="group rv" style={`--d:${i * 60}ms`}>
          <h2 class="g-t">{g.t}</h2>
          <Faq items={g.ids.map((x) => s.faq[x])} />
        </div>
      ))}
    </div>
  </section>
</Base>
<style>
  /* The title, one line and the two ways to ask, centred; then the questions in one column under it. */
  .more { display: grid; justify-items: center; gap: 16px; margin-top: clamp(24px, 3vw, 36px); }
  .more .text { margin: 0; }
  .more .actions { justify-content: center; }
  .qa-sec { padding-top: 0; }
  .groups { display: grid; gap: clamp(36px, 4vw, 56px); max-width: 860px; }
  .g-t { margin: 0 0 6px; font-weight: 800; font-size: 15px; letter-spacing: .02em; text-transform: uppercase; }
</style>
