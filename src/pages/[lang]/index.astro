---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import ApplyFlow from '../../components/ApplyFlow.astro';
import PlanPicker from '../../components/PlanPicker.astro';
import Workspace from '../../components/Workspace.astro';
import Bands from '../../components/Bands.astro';
import Choices from '../../components/Choices.astro';
import { t, type Locale } from '../../i18n/strings';
import { c } from '../../i18n/copy';
import { href } from '../../i18n/paths';
import { langPaths } from '../../i18n/static';
import { ads } from '../../data/work';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const s = t(lang);
const k = c(lang);
const h = k.home;
const hx = h.hero;
// The landing headline is three lines in turn, each cut away to show the next. Each ends on a dot, which is where
// the landing opens onto the work. Wide screens and phones each get their own line breaks, so the type can be as big as the screen allows.
const dot = (t: string[]) => t.map((l, i) => (i === t.length - 1 ? l.replace(/\.$/, '') : l));
const scenes = h.scenes.slice(0, 1).map((sc) => [{ k: 'd', lines: dot(sc.d) }, { k: 'm', lines: dot(sc.m) }]);
const said = h.scenes[0].d.join(' ');
// The headline's widest line and its height, in ems, measured in Inter for each language and for the wide (d) and
// phone (m) line breaks (tools/title-ratio.mjs, 4 Nov 2026). With them the stylesheet sets the final size from the first
// frame, so nothing jumps when the script checks it. Re-measure if the headline's words change.
const ratios: Record<string, [number, number, number, number]> = { en: [5.957, 2.7713, 3.7762, 4.6477], fr: [4.3161, 2.768, 4.3236, 3.7059] };
const [kwd, khd, kwm, khm] = ratios[lang] ?? ratios.en!;
const fit = `--kwd:${kwd};--khd:${khd};--kwm:${kwm};--khm:${khm}`;
// Every letter is its own piece, so letters can rise one after another and change weight on their own.
const split = (t: string) => [...t].map((ch, i) => ({ ch, i }));
// The work stage plays a short silent loop of each reel; a click opens the full reel with sound.
const clips = ads.slice(0, 4).map((a, i) => ({ i, src: a.clip ?? a.src!, full: a.src ?? a.clip!, poster: a.poster!, cap: a.angle[lang], fmt: a.format?.[lang] ?? '' }));
const pad = (n: number) => String(n).padStart(2, '0');
// Right under the prices, the questions a first-time client is really asking: can we try you, what if an ad doesn't
// perform, how long are we tied in, how we pay, how fast, and do I have to be on camera.
const faqs = [1, 10, 3, 5, 4, 14].map((i) => s.faq[i]);
const mute = '<path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" /><path class="off" d="M16 10l4 4M20 10l-4 4" /><path class="on" d="M15.5 9.5a3.5 3.5 0 0 1 0 5M17.8 7.2a7 7 0 0 1 0 9.6" />';
---
<Base lang={lang} page="home">
  <div class="intro" data-intro>
    <script is:inline>document.currentScript.parentElement.classList.toggle('slide', !matchMedia('(prefers-reduced-motion: reduce)').matches);</script>
    <div class="stage">
      <section class="hero" data-hero aria-labelledby="h-title">
        <div class="wrap wide h-in">
          <p class="h-sub up" style="--d:900ms"><strong>{h.sub}</strong> <span>{h.line}</span></p>
          <div class="h-tbox">
            <h1 class="h-title" id="h-title" aria-label={said} data-title style={fit}>
              {scenes.map((sets, n) => (
                <span class={n ? 'scene' : 'scene on first'} aria-hidden="true" data-scene>
                  {sets.map(({ k: set, lines }) => lines.map((line, i) => (
                    <span class={`ln ${set}`} style={`--l:${i}`}><span class={i === lines.length - 1 ? 'mark' : ''}>{split(line).map(({ ch, i: q }) => (ch === ' ' ? ' ' : <span class="ch" style={`--i:${q}`}>{ch}</span>))}</span>{i === lines.length - 1 && <span class="stop" data-stop></span>}</span>
                  )))}
                </span>
              ))}
            </h1>
          </div>
        </div>
        <div class="ticker" aria-hidden="true">
          <div class="track" data-marquee="45">
            {[0, 1, 2].map(() => <ul>{s.home.formats.map((f) => <li>{f}<svg viewBox="0 0 16 16"><path d="M8 1v14M1 8h14M3 3l10 10M13 3L3 13" /></svg></li>)}</ul>)}
          </div>
        </div>
        <button type="button" class="stop-hit" data-stop-hit aria-label={hx.dive}></button>
      </section>

      <section class="work on-black" id="work" data-work data-dark="1" aria-labelledby="w-title">
        <div class="wrap wide w-in">
          <div class="w-head" data-w-head>
            <h2 class="w-title" id="w-title" tabindex="-1" style={`--n:${k.nav.work.length}`}>{k.nav.work}</h2>
            <div class="w-meta">
              <p class="w-kick">{h.kicks.work} · 2026</p>
              <a class="w-all" href={href(lang, 'work')}>{hx.cta} <span aria-hidden="true">→</span></a>
            </div>
          </div>
          <ol class="deck" data-deck>
            {clips.map((cl) => (
              <li class="card" style={`--k:${cl.i}`}>
                <button type="button" class="c-media" data-cut={cl.i} data-full={cl.full} aria-pressed="false" aria-label={`${k.work.sound}: ${cl.cap}`} data-on={`${k.work.sound}: ${cl.cap}`} data-off={`${k.work.mute}: ${cl.cap}`}>
                  <img src={cl.poster} alt="" width="540" height="960" decoding="async" />
                  <video muted playsinline loop preload="none" tabindex="-1" aria-hidden="true" data-src={cl.src}></video>
                  <svg class="c-mute" viewBox="0 0 24 24" aria-hidden="true" set:html={mute} />
                </button>
                <p class="c-cap" aria-hidden="true"><b>{pad(cl.i + 1)}</b><span>{cl.cap}</span>{cl.fmt && <i>{cl.fmt}</i>}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    </div>
  </div>

  <section class="section think-sec" id="method">
    <div class="wrap"><Choices title={h.method.title} items={h.method.items} links={[{ href: href(lang, 'work'), label: hx.cta }, { href: href(lang, 'process'), label: h.method.process }]} /></div>
  </section>

  <Workspace lang={lang} story />

  <Bands lang={lang} />

  <section class="section apply-sec" id="apply">
    <div class="wrap"><ApplyFlow lang={lang} /></div>
  </section>

  <section class="section plans-sec" id="plans">
    <div class="wrap">
      <PlanPicker lang={lang} />
    </div>
  </section>

  <section class="section faq-sec" id="faq">
    <div class="wrap faq-grid">
      <div class="faq-lead rv">
        <h2 class="h1 faq-h">{h.faqTitle}</h2>
      </div>
      <div class="rv"><Faq items={faqs} more={{ href: href(lang, 'faq'), label: h.faqAll }} /></div>
    </div>
  </section>

</Base>

<script>
  import '../../scripts/marquee';
  // The landing is type only: the headline on white, its full stop drawn as a green dot, the formats we make running
  // along the bottom. Scrolling brings the green mat up over it, one to one with the finger, with the four reels
  // rising onto it and already playing. With reduced motion the work simply follows the landing.
  const intro = document.querySelector<HTMLElement>('[data-intro]');
  const work = document.querySelector<HTMLElement>('[data-work]');
  if (intro && work) {
    const hero = intro.querySelector<HTMLElement>('[data-hero]')!;
    // Two versions of the headline exist (wide and phone); the dot that counts is the one on screen.
    const stops = [...hero.querySelectorAll<HTMLElement>('[data-stop]')];
    let stop = stops[0];
    const hit = hero.querySelector<HTMLButtonElement>('[data-stop-hit]')!;
    const head = work.querySelector<HTMLElement>('[data-w-head]')!;
    const title = head.querySelector<HTMLElement>('h2')!;
    const deck = work.querySelector<HTMLElement>('[data-deck]')!;
    const cards = [...deck.querySelectorAll<HTMLElement>('.card')];
    const media = cards.map((el) => el.querySelector<HTMLButtonElement>('[data-cut]')!);
    const vids = media.map((m) => m.querySelector('video')!);
    const slide = intro.classList.contains('slide');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const save = !!(navigator as any).connection?.saveData;
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    const span = (a: number, b: number, v: number) => clamp((v - a) / (b - a));
    const ease = (v: number) => v * v * (3 - 2 * v);

    // The reels play, silent and looping, while the work is in view. Nothing plays before the page has loaded, while a
    // dialog or the menu is open, with reduced motion, with data saver on or after the pause button.
    let wanted = !still && !save, ready = false, seen = false, blocked = false, shown = true, warm = false, loud = -1;
    const load = (v: HTMLVideoElement) => { if (!v.getAttribute('src')) { v.preload = 'auto'; v.src = v.dataset.src!; } };
    const go = () => {
      const on = ready && seen && shown && !blocked && !document.hidden && wanted;
      vids.forEach((v, j) => { if (on || (j === loud && seen && !document.hidden && !blocked)) { load(v); v.play().catch(() => {}); } else v.pause(); });
    };
    vids.forEach((v, j) => v.addEventListener('playing', () => cards[j].classList.add('live')));
    // A click turns the sound on for that reel, in place: it switches to the full cut, starts it from the beginning
    // and fades the sound in. Another click turns it off again. Only one reel plays with sound at a time.
    const fade = (v: HTMLVideoElement, to: number, ms: number, then?: () => void) => {
      const from = v.volume, t0 = performance.now();
      const step = (t: number) => { const k = Math.min(1, (t - t0) / ms); v.volume = Math.min(1, Math.max(0, from + (to - from) * k)); if (k < 1) requestAnimationFrame(step); else then?.(); };
      requestAnimationFrame(step);
    };
    const quiet = (j: number) => {
      const v = vids[j];
      media[j].setAttribute('aria-pressed', 'false');
      media[j].setAttribute('aria-label', media[j].dataset.on!);
      cards[j].classList.remove('loud');
      fade(v, 0, 250, () => { v.muted = true; });
      if (loud === j) loud = -1;
    };
    const sound = (j: number) => {
      if (loud > -1 && loud !== j) quiet(loud);
      loud = j;
      const v = vids[j], m = media[j];
      m.setAttribute('aria-pressed', 'true');
      m.setAttribute('aria-label', m.dataset.off!);
      cards[j].classList.add('loud', 'live');
      // Everything happens inside the click itself, so phones (iPhone above all) allow the sound.
      if (v.getAttribute('src') !== m.dataset.full) { v.preload = 'auto'; v.src = m.dataset.full!; } else v.currentTime = 0;
      v.muted = false;
      v.volume = 0;
      v.play().then(() => fade(v, 1, 600)).catch(() => { v.muted = true; quiet(j); });
    };
    media.forEach((m, j) => m.addEventListener('click', () => (loud === j ? quiet(j) : sound(j))));
    new IntersectionObserver(([e]) => { seen = e.isIntersecting; go(); }, { threshold: 0.15 }).observe(deck);
    new MutationObserver(() => { blocked = document.documentElement.classList.contains('locked'); go(); })
      .observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    document.addEventListener('visibilitychange', go);
    const start = () => { ready = true; go(); };
    const idle = () => ('requestIdleCallback' in window ? (window as any).requestIdleCallback(start, { timeout: 1200 }) : setTimeout(start, 300));
    if (document.readyState === 'complete') idle(); else addEventListener('load', idle, { once: true });

    // The dot is a button too: it takes you straight through to the work.
    const through = () => {
      const to = work.getBoundingClientRect().top + scrollY;
      const done = () => title.focus({ preventScroll: true });
      scrollTo({ top: to, behavior: still ? 'auto' : 'smooth' }); setTimeout(done, still ? 0 : 900);
    };
    hit.addEventListener('click', through);

    if (slide) {
      // The black work section slides up over the landing with the scroll. The landing is simply held in place (sticky):
      // no script runs while you scroll, so nothing can make the scroll stutter. The clips start loading as soon as the
      // work comes within a screen of view.
      new IntersectionObserver(([e]) => { if (e.isIntersecting && !warm && wanted) { warm = true; vids.forEach(load); } }, { rootMargin: '0px 0px 100% 0px' }).observe(work);
      new IntersectionObserver(([e]) => { intro.classList.toggle('moving', e.isIntersecting); }).observe(work);
      // The dot is a button that goes straight to the work: keep the button on the dot.
      const measure = () => {
        stop = stops.find((el) => el.offsetWidth && el.closest('.on')) ?? stops.find((el) => el.offsetWidth) ?? stops[0];
        let x = stop.offsetWidth / 2, y = stop.offsetHeight / 2;
        for (let el: HTMLElement | null = stop; el && el !== hero; el = el.offsetParent as HTMLElement | null) { x += el.offsetLeft; y += el.offsetTop; }
        hit.style.left = `${x}px`;
        hit.style.top = `${y}px`;
      };
      hero.addEventListener('rot', measure);
      addEventListener('resize', measure);
      addEventListener('load', measure, { once: true });
      measure();
      // The title and the reels rise onto the mat the first time it comes into view.
      new IntersectionObserver(([e], o) => { if (e.isIntersecting) { work.classList.add('in'); o.disconnect(); } }, { threshold: .12 }).observe(work);
      // No brake and no snapping: the work arrives with the scroll and the page always moves with the hand.

      // With a mouse the dot leans towards the pointer and swells as it comes close, like a button waiting to be pressed.
      if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
        let x = 0, y = 0, z = 1, tx = 0, ty = 0, tz = 1, raf = 0;
        const step = () => {
          x += (tx - x) * .16; y += (ty - y) * .16; z += (tz - z) * .16;
          stop.style.translate = `${x.toFixed(2)}px ${y.toFixed(2)}px`;
          stop.style.scale = z.toFixed(3);
          raf = Math.abs(tx - x) + Math.abs(ty - y) + Math.abs(tz - z) > .02 ? requestAnimationFrame(step) : 0;
        };
        const aim = (e?: PointerEvent) => {
          tx = ty = 0; tz = 1;
          if (e && !intro.classList.contains('moving')) {
            const r = hero.getBoundingClientRect();
            const hx0 = parseFloat(hit.style.left), hy0 = parseFloat(hit.style.top);
            const dx = e.clientX - r.left - hx0, dy = e.clientY - r.top - hy0, d = Math.hypot(dx, dy), reach = 170;
            const pull = d < reach ? 1 - d / reach : 0;
            tx = dx * .3 * pull; ty = dy * .3 * pull; tz = 1 + pull * .8;
          }
          if (!raf) raf = requestAnimationFrame(step);
        };
        hero.addEventListener('pointermove', aim);
        hero.addEventListener('pointerleave', () => aim());
      }
    }

    // The headline is set as big as its box allows: the widest line of any beat meets the box's width, or the tallest
    // beat meets its height. All beats share one cell, so the box never jumps between them.
    const htl = hero.querySelector<HTMLElement>('[data-title]')!;
    const beats = [...htl.querySelectorAll<HTMLElement>('[data-scene]')];
    const tbox = hero.querySelector<HTMLElement>('.h-tbox')!;
    const fitTitle = () => {
      htl.style.fontSize = '';
      // Measured at full weight, whatever the letters are doing at that moment.
      htl.classList.add('measure');
      const lines = [...htl.querySelectorAll<HTMLElement>('.ln')].filter((l) => l.offsetWidth);
      if (lines.length) {
        const wide = Math.max(...lines.map((l) => l.offsetWidth));
        const tall = Math.max(...beats.map((b) => b.offsetHeight));
        const bw = tbox.clientWidth, bh = tbox.clientHeight - parseFloat(getComputedStyle(tbox).paddingTop);
        const css = parseFloat(getComputedStyle(htl).fontSize), want = css * Math.min(bw / wide, bh / tall) * .995;
        // The stylesheet already sets the right size for Inter. Correct it only if this screen's letters really differ
        // (more than 1.5%), and never before Inter has loaded, so the headline doesn't jump while the page opens.
        const ready = !document.fonts || document.fonts.status === 'loaded';
        if (ready && Math.abs(want / css - 1) > .015) htl.style.fontSize = `${want.toFixed(2)}px`;
        place();
      }
      htl.classList.remove('measure');
      hero.dispatchEvent(new Event('rot'));
    };
    // Where each letter sits, for the pointer.
    let letters: { el: HTMLElement; x: number; y: number }[] = [];
    const place = () => {
      const b = htl.getBoundingClientRect();
      letters = [...htl.querySelectorAll<HTMLElement>('.on .ch')].filter((el) => el.offsetWidth).map((el) => {
        const r = el.getBoundingClientRect(), ln = el.closest('.ln')!.getBoundingClientRect();
        return { el, x: r.left - b.left + r.width / 2, y: ln.top - b.top + ln.height / 2 };
      });
    };
    // With a mouse, the ink thins out under the pointer: letters close to it lose weight and swell back as it leaves.
    if (!still && matchMedia('(hover: hover) and (pointer: fine)').matches) {
      let px = -1e4, py = -1e4, pending = false;
      const thin = () => {
        pending = false;
        const b = htl.getBoundingClientRect(), reach = parseFloat(getComputedStyle(htl).fontSize) * 1.25;
        const off = intro.classList.contains('moving');
        letters.forEach(({ el, x, y }) => {
          const d = Math.hypot(px - b.left - x, py - b.top - y);
          const v = off ? 0 : Math.max(0, 1 - d / reach);
          const k = (v * v * (3 - 2 * v)).toFixed(2);
          if (el.style.getPropertyValue('--pull') !== k) el.style.setProperty('--pull', k);
        });
      };
      const ask = () => { if (!pending) { pending = true; requestAnimationFrame(thin); } };
      hero.addEventListener('pointermove', (e) => { px = e.clientX; py = e.clientY; ask(); });
      hero.addEventListener('pointerleave', () => { px = py = -1e4; ask(); });
    }
    let fitT = 0;
    addEventListener('resize', () => { clearTimeout(fitT); fitT = setTimeout(fitTitle, 120); });
    document.fonts?.ready.then(fitTitle);
    fitTitle();

  }
</script>

<style>
  @property --pull { syntax: '<number>'; inherits: false; initial-value: 0; }
  /* The landing: white, type only. The headline fills the screen, cut from one line to the
     next, and the formats we make run along the foot. */
  .intro { position: relative; }
  .stage { position: relative; }
  .hero { position: relative; display: flex; flex-direction: column; height: 100svh; min-height: 560px; overflow: hidden; background: var(--bg); color: var(--fg); }
  .h-in { flex: 1; min-height: 0; display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: minmax(0, 1fr);
    grid-template-areas: 'title'; padding-top: calc(var(--header) + clamp(10px, 3vh, 32px)); padding-bottom: clamp(18px, 3vh, 36px); }
  /* What Gecko makes, set beside the short last line of the headline on wide screens and under the label on phones. */
  .h-sub { grid-area: title; z-index: 1; justify-self: end; align-self: end; max-width: 23ch; margin: 0 0 .35em; font-size: clamp(18px, 1.45vw, 23px); line-height: 1.3; letter-spacing: -0.015em; text-wrap: balance; }
  .h-sub strong { font-weight: 650; color: var(--fg); }
  .h-sub span { font-weight: 450; color: var(--fg); }
  @media (max-width: 760px), (max-width: 960px) and (orientation: portrait) {
    .h-in { grid-template-areas: 'sub' 'title'; grid-template-rows: auto minmax(0, 1fr); }
    .h-sub { grid-area: sub; justify-self: start; align-self: start; max-width: 30ch; margin: 0; font-size: 16px; }
  }
  /* The headline takes whatever room is left: as wide as the longest line allows, as tall as the box. */
  .h-tbox { grid-area: title; container-type: size; display: flex; flex-direction: column; justify-content: flex-end; min-height: 0; padding-top: clamp(12px, 2.4vh, 28px); }
  .h-title { display: grid; margin: 0; font-weight: 700; letter-spacing: -0.06em; line-height: .86;
    font-size: min(calc((min(100vw, var(--wide)) - 2 * var(--gutter)) / 8), calc((100svh - 320px) / 2.3));
    font-size: calc(min(100cqw / var(--kwd, 8), 100cqh / var(--khd, 2.3)) * .995); }
  /* The three beats share one cell, set from the bottom, so the box never jumps when one hands over to the next. */
  .scene { grid-area: 1 / 1; align-self: end; display: block; pointer-events: none; }
  .ln { display: block; overflow: hidden; width: fit-content; white-space: nowrap; padding: .08em .1em .1em .06em; margin: -.05em 0 -.1em -.06em; }
  .ln.m { display: none; }
  /* Letter by letter. A beat's letters rise in one after another, thin, and fill with ink as they land (Inter's weight
     axis, 240 to 700); when the beat ends they leave upwards the same way. A mouse thins whatever it hovers. */
  .ch { display: inline-block; font-weight: calc(700 - var(--pull) * 460); transform: translateY(118%); transition: --pull 420ms cubic-bezier(.22, 1, .36, 1); }
  .scene.on .ch { transform: none; transition: transform 950ms cubic-bezier(.22, 1, .36, 1) calc(var(--l) * 110ms + var(--i) * 32ms), --pull 420ms cubic-bezier(.22, 1, .36, 1); }
  .scene.first .ch { animation: rise 1150ms cubic-bezier(.22, 1, .36, 1) both; animation-delay: calc(300ms + var(--l) * 130ms + var(--i) * 34ms); }
  @keyframes rise { from { transform: translateY(118%); } }
  .measure .ch { font-weight: 700 !important; }
  /* The last words of the last beat get the pink marker, and every beat ends on the green dot: the mat the work sits on. */
  .mark { position: relative; z-index: 0; }
  .mark::after { content: ''; position: absolute; z-index: -1; left: -.05em; right: -.02em; top: .58em; bottom: .12em; background: var(--pink); transform: scaleX(0); transform-origin: 0 50%; }
  .on .mark::after { transform: none; transition: transform 720ms cubic-bezier(.65, 0, .35, 1) 900ms; }
  .stop { display: inline-block; width: .2em; height: .2em; margin-left: .05em; border-radius: 50%; background: var(--ink); transform: scale(0); }
  .on .stop { transform: none; transition: transform 600ms cubic-bezier(.34, 1.56, .64, 1) 760ms; }
  .first .stop { animation: pop 650ms cubic-bezier(.34, 1.56, .64, 1) both 1250ms; }
  @keyframes pop { from { transform: translateY(-1.2em) scale(.4); opacity: 0; } 55% { opacity: 1; } }

  .stop-hit { position: absolute; z-index: 2; left: 0; top: 0; width: 72px; height: 72px; margin: -36px 0 0 -36px; padding: 0; border: 0; border-radius: 50%; background: transparent; cursor: pointer; }
  .stop-hit:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .moving .stop-hit { visibility: hidden; }
  .intro:not(.slide) .stop-hit { display: none; }
  .up { animation: fade-up 1000ms cubic-bezier(.22, 1, .36, 1) both; animation-delay: var(--d); }
  @keyframes fade-up { from { opacity: 0; transform: translateY(16px); } }

  /* The formats we make, running along the foot of the landing. */
  .ticker { flex: none; overflow: hidden; padding-block: 17px; background: var(--ink); color: #fff; }
  .ticker .track { display: flex; width: max-content; will-change: transform; }
  .ticker ul { display: flex; list-style: none; margin: 0; padding: 0; }
  .ticker li { display: flex; align-items: center; gap: 30px; white-space: nowrap; font-weight: 600; font-size: 16px; letter-spacing: -0.005em; padding-right: 30px; }
  .ticker svg { width: 13px; height: 13px; fill: none; stroke: var(--pink); stroke-width: 1.6; stroke-linecap: round; }

  /* The mat slides up over the landing with the scroll. The landing is held in place underneath and steps back a
