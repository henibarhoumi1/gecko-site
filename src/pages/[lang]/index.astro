---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import ApplyBlock from '../../components/ApplyBlock.astro';
import Anatomy from '../../components/Anatomy.astro';
import PlanPicker from '../../components/PlanPicker.astro';
import Stamp from '../../components/Stamp.astro';
import { t, type Locale } from '../../i18n/strings';
import { c } from '../../i18n/copy';
import { href } from '../../i18n/paths';
import { langPaths } from '../../i18n/static';
import { ads } from '../../data/work';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const s = t(lang);
const h = c(lang).home;
const tilts = [-4, 3, -2, 5];
---
<Base lang={lang}>
  <section class="on-pink hero">
    <div class="wrap hero-in">
      <p class="label rise" style="--d:0ms">{h.eyebrow}</p>
      <h1 class="h1 big">
        {h.title.map((line, i) => (
          <span class="line"><span class={`rise ${i === 1 ? 'hl' : ''}`} style={`--d:${120 + i * 110}ms`}>{line}</span></span>
        ))}
      </h1>
      <div class="hero-foot">
        <p class="text text-l rise" style="--d:520ms">{h.sub}</p>
        <div class="actions rise" style="--d:620ms">
          <a class="btn primary" href={href(lang, 'apply')}>{h.cta} <span class="arr" aria-hidden="true">→</span></a>
          <a class="btn" href={href(lang, 'process')}>{h.ctaAlt}</a>
        </div>
      </div>
      <div class="drag stamp-wrap" data-drag data-spin><Stamp kind="round" tilt={0} /></div>
      <p class="drag ticket label" data-drag>{s.line}</p>
    </div>
  </section>

  <section class="on-yellow marquee" aria-hidden="true">
    <div class="track">
      {[0, 1].map(() => <ul>{s.home.formats.map((f) => <li>{f}</li>)}</ul>)}
    </div>
  </section>

  <section class="on-white section">
    <div class="wrap">
      <div class="head rv"><p class="label">01 · {h.makeLabel}</p><h2 class="h2">{h.makeTitle}</h2></div>
      <ul class="formats" data-formats>
        {h.make.map((f, i) => (
          <li class="rv" style={`--d:${i * 60}ms`}>
            <button type="button" aria-expanded="false">
              <span class="label">0{i + 1}</span>
              <span class="name">{f.t}</span>
              <span class="plus" aria-hidden="true"></span>
            </button>
            <p class="desc text text-l">{f.d}</p>
          </li>
        ))}
      </ul>
      <div class="peek label" data-peek aria-hidden="true"><span></span></div>
    </div>
  </section>

  {ads.length > 0 && (
    <section class="on-pink section">
      <div class="wrap">
        <div class="head rv"><p class="label">02 · {h.workLabel}</p><div class="side"><h2 class="h2">{h.workTitle}</h2><a class="btn" href={href(lang, 'work')}>{h.workCta} <span class="arr" aria-hidden="true">→</span></a></div></div>
        <div class="prints">
          {ads.slice(0, 4).map((a, i) => (
            <a class="print rv" href={href(lang, 'work')} style={`--t:${tilts[i]}deg; --d:${i * 90}ms`}>
              <span class="tape" aria-hidden="true"></span>
              <img src={a.poster} alt={`${a.brand}, ${a.angle[lang]}`} loading="lazy" />
              <span class="label">{a.brand}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="on-yellow section">
    <div class="wrap steps-grid">
      <div class="sticky">
        <div class="head rv"><p class="label">03 · {h.stepsLabel}</p><h2 class="h2">{h.stepsTitle}</h2></div>
        <a class="btn rv" href={href(lang, 'process')}>{h.stepsCta} <span class="arr" aria-hidden="true">→</span></a>
      </div>
      <ol class="steps" data-steps>
        {h.steps.map((st, i) => (
          <li>
            <span class="num">0{i + 1}</span>
            <div class="stack" style="--gap:10px"><h3 class="h3">{st.t}</h3><p class="text text-l">{st.d}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="on-white section">
    <div class="wrap">
      <div class="head rv"><p class="label">04 · {h.anatomyLabel}</p><h2 class="h2">{h.anatomyTitle}</h2></div>
      <div class="rv"><Anatomy lang={lang} /></div>
    </div>
  </section>

  <section class="on-pink section">
    <div class="wrap">
      <div class="head rv"><p class="label">05 · {h.plansLabel}</p><div class="side"><h2 class="h2">{h.plansTitle}</h2><a class="link" href={href(lang, 'offers')}>{h.plansCta} →</a></div></div>
      <div class="rv"><PlanPicker lang={lang} /></div>
    </div>
  </section>

  <section class="on-white section" id="faq">
    <div class="wrap faq-grid">
      <div class="head rv"><p class="label">06 · {h.faqLabel}</p><h2 class="h2">{h.faqTitle}</h2></div>
      <div class="rv"><Faq items={s.faq.slice(0, 6)} /></div>
    </div>
  </section>

  <section class="on-yellow section" id="apply">
    <div class="wrap"><ApplyBlock lang={lang} /></div>
  </section>
</Base>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;

  // Formats: on desktop a card with the description follows the cursor; on phones a tap opens the row.
  document.querySelectorAll<HTMLElement>('[data-formats]').forEach((list) => {
    const peek = list.parentElement!.querySelector<HTMLElement>('[data-peek]')!;
    const text = peek.querySelector('span')!;
    list.querySelectorAll('li').forEach((li) => {
      const btn = li.querySelector('button')!;
      btn.addEventListener('click', () => { if (!fine) btn.setAttribute('aria-expanded', String(btn.getAttribute('aria-expanded') !== 'true')); });
      if (fine) li.addEventListener('mouseenter', () => { text.textContent = li.querySelector('.desc')!.textContent; peek.classList.add('on'); });
    });
    if (fine) {
      list.addEventListener('mouseleave', () => peek.classList.remove('on'));
      list.addEventListener('mousemove', (e) => { peek.style.transform = `translate(${e.clientX + 24}px, ${e.clientY - 20}px) rotate(-3deg)`; });
    }
  });

  // Steps light up as they pass the middle of the screen.
  document.querySelectorAll<HTMLElement>('[data-steps]').forEach((list) => {
    const items = [...list.querySelectorAll('li')];
    const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && items.forEach((li) => li.classList.toggle('on', li === e.target))), { rootMargin: '-45% 0px -45% 0px' });
    items.forEach((li) => io.observe(li));
    items[0].classList.add('on');
  });

  // The stamp turns as you scroll; the stamp and the label can be dragged around the hero.
  const spin = document.querySelector<HTMLElement>('[data-spin]');
  if (spin && !still) addEventListener('scroll', () => spin.style.setProperty('--r', `${scrollY * 0.25}deg`), { passive: true });
  document.querySelectorAll<HTMLElement>('[data-drag]').forEach((el) => {
    let x = 0, y = 0, sx = 0, sy = 0;
    el.addEventListener('pointerdown', (e) => {
      el.setPointerCapture(e.pointerId); sx = e.clientX - x; sy = e.clientY - y; el.classList.add('held');
      const move = (m: PointerEvent) => { x = m.clientX - sx; y = m.clientY - sy; el.style.translate = `${x}px ${y}px`; };
      const up = () => { el.classList.remove('held'); el.removeEventListener('pointermove', move); el.removeEventListener('pointerup', up); };
      el.addEventListener('pointermove', move); el.addEventListener('pointerup', up);
    });
  });
</script>

<style>
  .hero { min-height: 100svh; display: flex; align-items: flex-end; padding-top: calc(var(--header) + 56px); padding-bottom: clamp(40px, 6vw, 80px); overflow: hidden; }
  .hero-in { position: relative; display: grid; gap: clamp(24px, 3vw, 40px); }
  .big { font-size: clamp(56px, 11.5vw, 184px); line-height: .9; letter-spacing: -0.055em; }
  .line { display: block; position: relative; overflow: hidden; padding-bottom: .08em; width: fit-content; }
  .line .rise { display: inline-block; }
  .rise { animation: up 900ms var(--ease) both; animation-delay: var(--d); }
  .hl { position: relative; padding: 0 .1em; margin-left: -.1em; }
  .hl::before { content: ''; position: absolute; inset: .14em 0 .06em; background: var(--yellow); z-index: -1; transform-origin: left; animation: wipe 700ms 900ms var(--ease) both; }
  .line { isolation: isolate; }
  .hero-foot { display: grid; grid-template-columns: minmax(0, 34rem) auto; justify-content: space-between; align-items: end; gap: 24px 48px; border-top: var(--line) solid var(--ink); padding-top: 24px; }
  .drag { position: absolute; cursor: grab; touch-action: none; user-select: none; z-index: 3; }
  .drag.held { cursor: grabbing; }
  .stamp-wrap { right: 2%; top: -10px; transform: rotate(var(--r, 0deg)); }
  .stamp-wrap :global(.stamp) { width: clamp(110px, 13vw, 180px); }
  .ticket { right: 22%; top: 16%; background: var(--yellow); border: var(--line) solid var(--ink); padding: 10px 14px; transform: rotate(4deg); box-shadow: 3px 3px 0 var(--ink); }
  .ticket.held, .stamp-wrap.held { filter: drop-shadow(6px 8px 0 rgba(24, 22, 20, .18)); }
  @keyframes up { from { transform: translateY(105%); opacity: 0; } }
  @keyframes wipe { from { transform: scaleX(0); } }
  @media (prefers-reduced-motion: reduce) { .rise, .hl::before { animation: none; } }
  @media (max-width: 860px) {
    .hero { min-height: 92svh; }
    .hero-foot { grid-template-columns: 1fr; }
    .stamp-wrap { top: -64px; right: 0; }
    .ticket { display: none; }
  }

  .marquee { overflow: hidden; padding-block: clamp(18px, 2.4vw, 28px); border-block: var(--line) solid var(--ink); }
  .marquee .track { display: flex; width: max-content; animation: slide 40s linear infinite; }
  .marquee ul { display: flex; list-style: none; margin: 0; padding: 0; }
  .marquee li { font-weight: 700; font-size: clamp(28px, 3.6vw, 52px); letter-spacing: -0.03em; line-height: 1; white-space: nowrap; padding-right: 1.2em; }
  .marquee li::after { content: '✱'; padding-left: 1.2em; font-size: .6em; vertical-align: middle; }
  @keyframes slide { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .marquee .track { animation: none; } }

  .formats { list-style: none; margin: 0; padding: 0; border-top: var(--line) solid var(--ink); }
  .formats li { border-bottom: var(--line) solid var(--ink); }
  .formats button { width: 100%; display: grid; grid-template-columns: 56px 1fr auto; align-items: center; gap: 16px; padding: clamp(18px, 2.4vw, 30px) 0; background: none; border: 0; color: inherit; text-align: left; cursor: pointer; font-family: var(--font); }
  .formats .name { font-weight: 700; font-size: clamp(32px, 5vw, 76px); letter-spacing: -0.045em; line-height: 1; transition: transform 360ms var(--ease); }
  .formats li:hover .name { transform: translateX(18px); }
  .formats li:nth-child(odd):hover { background: linear-gradient(var(--pink), var(--pink)); }
  .formats li:nth-child(even):hover { background: linear-gradient(var(--yellow), var(--yellow)); }
  .plus { width: 22px; height: 22px; position: relative; }
  .plus::before, .plus::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 2px; background: currentColor; transition: transform 260ms var(--ease); }
  .plus::after { transform: rotate(90deg); }
  .desc { margin: 0; display: none; padding: 0 0 22px 72px; max-width: 40rem; }
  [aria-expanded='true'] + .desc { display: block; }
  [aria-expanded='true'] .plus::after { transform: none; }
  .peek { position: fixed; left: 0; top: 0; z-index: 40; pointer-events: none; max-width: 300px; padding: 16px 18px; background: var(--yellow); border: var(--line) solid var(--ink); box-shadow: 4px 4px 0 var(--ink); line-height: 1.5; opacity: 0; transition: opacity 200ms var(--ease); }
  .peek.on { opacity: 1; }
  @media (hover: hover) and (pointer: fine) { .plus { display: none; } }
  @media (max-width: 600px) { .formats button { grid-template-columns: 36px 1fr auto; } .desc { padding-left: 52px; } }

  .prints { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(16px, 3vw, 44px); padding-block: 12px 24px; }
  .print { position: relative; display: grid; gap: 12px; padding: 12px 12px 16px; background: var(--white); border: var(--line) solid var(--ink); text-decoration: none; transform: rotate(var(--t)); transition: transform 420ms var(--ease), box-shadow 420ms var(--ease); }
  .print.rv:not(.in) { transform: rotate(var(--t)) translateY(28px); }
  .print:hover { transform: rotate(0deg) translateY(-8px) scale(1.03); box-shadow: 8px 10px 0 var(--ink); z-index: 2; }
  .print img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .tape { position: absolute; top: -12px; left: 50%; width: 76px; height: 24px; background: var(--yellow); border: var(--line) solid var(--ink); transform: translateX(-50%) rotate(-3deg); opacity: .95; }
  @media (max-width: 860px) { .prints { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 36px; } }

  .steps-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(40px, 7vw, 120px); align-items: start; }
  .sticky { position: sticky; top: calc(var(--header) + 32px); display: grid; gap: 8px; justify-items: start; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; }
  .steps li { display: grid; grid-template-columns: auto 1fr; gap: 28px; padding-block: clamp(32px, 5vw, 64px); border-top: var(--line) solid var(--ink); }
  .steps li .num { color: transparent; -webkit-text-stroke: 1.5px var(--ink); transition: color 400ms var(--ease); }
  .steps li.on .num { color: var(--ink); }
  .steps .num { font-weight: 700; font-size: clamp(56px, 7vw, 104px); line-height: .85; letter-spacing: -0.05em; }
  @media (max-width: 860px) { .steps-grid { grid-template-columns: 1fr; } .sticky { position: static; } }

  .faq-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .faq-grid .head { margin-bottom: 0; }
  @media (max-width: 860px) { .faq-grid { grid-template-columns: 1fr; } }
</style>
