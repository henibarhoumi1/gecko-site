---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import ApplyFlow from '../../components/ApplyFlow.astro';
import PlanPicker from '../../components/PlanPicker.astro';
import Workspace from '../../components/Workspace.astro';
import Bands from '../../components/Bands.astro';
import ReelViewer from '../../components/ReelViewer.astro';
import { t, type Locale } from '../../i18n/strings';
import { c } from '../../i18n/copy';
import { href } from '../../i18n/paths';
import { langPaths } from '../../i18n/static';
import { ads } from '../../data/work';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const s = t(lang);
const h = c(lang).home;
const hx = h.hero;
// The hero plays a short silent cut of each case study reel; a click opens the full reel with sound.
const clips = ads.map((a, i) => {
  const slug = a.src!.replace(/^.*glucelia-|\.mp4$/g, '');
  return { i, src: `/work/clip-${slug}.mp4`, poster: a.poster!, brand: a.brand, cap: a.angle[lang] };
});
const pad = (n: number) => String(n).padStart(2, '0');
const mute = '<path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" /><path d="M16 10l4 4M20 10l-4 4" />';
---
<Base lang={lang} footerCta={false} page="home" theme="#000000">
  <section class="hero on-black" data-hero data-hero-dark>
    <div class="wall" data-wall>
      {clips.map((cl) => (
        <button type="button" class={`panel${cl.i === 0 ? ' on' : ''}`} style={`--i:${cl.i}`} data-cut={cl.i} aria-label={`${hx.sound}: ${cl.cap}`}>
          <img src={cl.poster} alt="" width="540" height="960" decoding="async" fetchpriority={cl.i === 0 ? 'high' : 'auto'} />
          <video muted playsinline loop preload="none" tabindex="-1" aria-hidden="true" data-src={cl.src}></video>
          <span class="p-cap" aria-hidden="true">
            <svg class="p-mute" viewBox="0 0 24 24" set:html={mute} />
            <b>{pad(cl.i + 1)}<i>/{pad(clips.length)}</i></b>
            <span>{cl.cap}</span>
          </span>
        </button>
      ))}
    </div>
    <div class="bars" aria-hidden="true">{clips.map(() => <i><b></b></i>)}</div>
    <span class="cursor" data-cursor aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M5 3.2v9.6L13 8z" /></svg>{hx.sound}</span>

    <div class="h-body">
      <div class="wrap wide h-grid">
        <div class="h-main">
          <p class="h-kick up" style="--d:420ms"><span class="dot" aria-hidden="true"></span>{h.kicker}</p>
          <h1 class="h-title" aria-label={h.title.join(' ')}>
            {h.title.map((line, i) => (
              <span class="ln" aria-hidden="true"><span class="rise" style={`--d:${520 + i * 110}ms`}>{line}</span></span>
            ))}
          </h1>
        </div>
        <div class="h-side up" style="--d:900ms">
          <p class="h-lede">{h.sub}</p>
          <div class="actions">
            <a class="btn primary big-btn" href={href(lang, 'apply')}>{h.cta} <span class="arr" aria-hidden="true">→</span></a>
            <a class="btn big-btn" href="#plans">{h.ctaAlt}</a>
          </div>
          <p class="h-from">{hx.from}</p>
        </div>
      </div>
      <div class="wrap wide h-foot up" style="--d:1050ms">
        <p class="h-credit">{hx.credit} <a class="link" href={href(lang, 'work')}>{hx.cta} <span aria-hidden="true">→</span></a></p>
      </div>
    </div>
    <button type="button" class="h-ctl" data-toggle aria-pressed="false" aria-label={hx.pause} data-pause={hx.pause} data-play={hx.play}>
      <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3h2v10H5zM9 3h2v10H9z" /></svg>
      <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.2v9.6L13 8z" /></svg>
    </button>
  </section>

  <div class="ticker" aria-hidden="true">
    <div class="track" data-marquee="45">
      {[0, 1, 2].map(() => <ul>{s.home.formats.map((f) => <li>{f}<svg viewBox="0 0 16 16"><path d="M8 1v14M1 8h14M3 3l10 10M13 3L3 13" /></svg></li>)}</ul>)}
    </div>
  </div>

  <Workspace lang={lang} />

  <Bands lang={lang} />

  <section class="section apply-sec" id="apply">
    <div class="wrap"><ApplyFlow lang={lang} /></div>
  </section>

  <section class="section plans-sec" id="plans">
    <div class="wrap">
      <PlanPicker lang={lang} />
    </div>
  </section>

  <section class="section faq-sec" id="faq">
    <div class="wrap faq-grid">
      <div class="faq-lead rv">
        <h2 class="h1 faq-h">{h.faqTitle}</h2>
      </div>
      <div class="rv"><Faq items={s.faq} limit={6} more={{ href: href(lang, 'faq'), label: h.faqAll }} /></div>
    </div>
  </section>

  <ReelViewer lang={lang} />
</Base>

<script>
  import '../../scripts/marquee';
  // The hero is a wall of the case study reels. On a wide screen the four short silent cuts play side by side; on a
  // phone or tablet the screen is one reel at a time, story style, with a bar per reel. Nothing plays until the page has
  // loaded, while the hero is off screen, while a dialog or the menu is open, with reduced motion or with data saver on.
  // A click on a reel opens it full screen with sound. As the page scrolls, the wall drifts and the copy lifts away.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const wall = hero.querySelector<HTMLElement>('[data-wall]')!;
    const panels = [...hero.querySelectorAll<HTMLButtonElement>('[data-cut]')];
    const vids = panels.map((p) => p.querySelector('video')!);
    const bars = [...hero.querySelectorAll<HTMLElement>('.bars b')];
    const toggle = hero.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const wide = matchMedia('(min-width: 961px)');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const save = !!(navigator as any).connection?.saveData;
    let k = 0, wanted = !still && !save, ready = false, seen = true, blocked = false, raf = 0;

    const load = (v: HTMLVideoElement) => { if (!v.getAttribute('src')) { v.preload = 'auto'; v.src = v.dataset.src!; } };
    const show = () => {
      panels.forEach((p, j) => p.classList.toggle('on', j === k));
      bars.forEach((b, j) => (b.style.transform = `scaleX(${j < k ? 1 : 0})`));
    };
    const frame = () => {
      const v = vids[k];
      bars[k].style.transform = `scaleX(${v.duration ? Math.min(1, v.currentTime / v.duration) : 0})`;
      raf = requestAnimationFrame(frame);
    };
    const stop = () => { vids.forEach((v) => v.pause()); cancelAnimationFrame(raf); raf = 0; };
    const go = () => {
      if (!ready || !seen || blocked || document.hidden || !wanted) return stop();
      if (wide.matches) {
        cancelAnimationFrame(raf); raf = 0;
        vids.forEach((v) => { v.loop = true; load(v); v.play().catch(() => {}); });
        return;
      }
      vids.forEach((v, j) => { v.loop = false; if (j !== k) v.pause(); });
      const v = vids[k];
      load(v);
      v.play().then(() => {
        if (!raf) raf = requestAnimationFrame(frame);
        load(vids[(k + 1) % vids.length]);
      }).catch(() => {});
    };
    vids.forEach((v, j) => {
      v.addEventListener('playing', () => panels[j].classList.add('live'));
      // On a phone each reel plays once, then the next one takes the screen.
      v.addEventListener('ended', () => {
        if (wide.matches || j !== k) return;
        k = (k + 1) % vids.length;
        vids[k].currentTime = 0;
        show(); go();
      });
    });
    wide.addEventListener('change', () => { show(); go(); });
    toggle.addEventListener('click', () => {
      wanted = !wanted;
      toggle.setAttribute('aria-pressed', String(!wanted));
      toggle.setAttribute('aria-label', wanted ? toggle.dataset.pause! : toggle.dataset.play!);
      hero.classList.toggle('held', !wanted);
      go();
    });
    if (!wanted) { hero.classList.add('held'); toggle.setAttribute('aria-pressed', 'true'); toggle.setAttribute('aria-label', toggle.dataset.play!); }
    // The player grows out of a 9:16 frame in the middle of the reel that was clicked.
    panels.forEach((p, j) => p.addEventListener('click', () => {
      const r = p.getBoundingClientRect();
      const w = Math.min(r.width, r.height * 9 / 16), hh = w * 16 / 9;
      const rect = new DOMRect(r.left + (r.width - w) / 2, r.top + (r.height - hh) / 2, w, hh);
      document.dispatchEvent(new CustomEvent('reel:play', { detail: { i: j, from: p, grow: rect } }));
    }));
    new IntersectionObserver(([e]) => { seen = e.isIntersecting; go(); }, { threshold: 0.1 }).observe(hero);
    new MutationObserver(() => { blocked = document.documentElement.classList.contains('locked'); go(); })
      .observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    document.addEventListener('visibilitychange', go);
    const start = () => { ready = true; go(); };
    const idle = () => ('requestIdleCallback' in window ? (window as any).requestIdleCallback(start, { timeout: 1200 }) : setTimeout(start, 300));
    if (document.readyState === 'complete') idle(); else addEventListener('load', idle, { once: true });

    // With a mouse, a "Watch with sound" badge trails the pointer across the reels.
    if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
      const cur = hero.querySelector<HTMLElement>('[data-cursor]')!;
      let x = 0, y = 0, tx = 0, ty = 0, glide = 0;
      const step = () => {
        x += (tx - x) * .22; y += (ty - y) * .22;
        cur.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0)`;
        glide = Math.abs(tx - x) + Math.abs(ty - y) > .4 ? requestAnimationFrame(step) : 0;
      };
      wall.addEventListener('pointermove', (e) => {
        const r = hero.getBoundingClientRect();
        tx = e.clientX - r.left; ty = e.clientY - r.top;
        if (!cur.classList.contains('on')) { x = tx; y = ty; cur.classList.add('on'); }
        if (!glide) glide = requestAnimationFrame(step);
      });
      wall.addEventListener('pointerleave', () => cur.classList.remove('on'));
    }

    // Scrolling away: the wall drifts down at a third of the speed and leans in, so the copy slides up over it.
    if (!still) {
      let queued = false;
      const drift = () => {
        queued = false;
        const r = hero.getBoundingClientRect();
        if (r.bottom < 0) return;
        const p = Math.min(1, Math.max(0, -r.top / r.height));
        wall.style.transform = p ? `translate3d(0, ${(p * r.height * .34).toFixed(1)}px, 0) scale(${(1 + p * .06).toFixed(4)})` : '';
      };
      addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(drift); } }, { passive: true });
      drift();
    }
  }
</script>

<style>
  /* The hero: four reels side by side, edge to edge on black, the headline over them. Each reel carries its number and
     title at the top; a soft shade at the top keeps the menu bar readable and a deep one at the bottom holds the copy. */
  .hero { position: relative; height: 100svh; min-height: 600px; max-height: 1400px; overflow: hidden; isolation: isolate; }
  :global(html:has([data-hero-dark])) { background: #000; }
  .wall { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 3px; transform-origin: 50% 0; }
  .panel { position: relative; display: block; overflow: hidden; margin: 0; padding: 0; border: 0; border-radius: 0; background: #0D0D0D; color: #fff; cursor: pointer;
    animation: wipe 1300ms cubic-bezier(.76, 0, .24, 1) both; animation-delay: calc(60ms + var(--i) * 120ms); }
  @keyframes wipe { from { clip-path: inset(100% 0 0 0); } }
  .panel img, .panel video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .panel img { animation: settle 2200ms cubic-bezier(.16, 1, .3, 1) both; animation-delay: calc(60ms + var(--i) * 120ms); }
  @keyframes settle { from { transform: scale(1.18); } }
  .panel video { opacity: 0; transition: opacity 600ms var(--ease); }
  .panel.live video { opacity: 1; }
  /* The shades are painted inside each reel so the titles can sit above them. */
  .panel::before { content: ''; position: absolute; inset: -2px; z-index: 1; pointer-events: none;
    background: linear-gradient(180deg, rgba(0, 0, 0, .62) 0, rgba(0, 0, 0, 0) 24%), linear-gradient(0deg, rgba(0, 0, 0, .97) 0, rgba(0, 0, 0, .9) 30%, rgba(0, 0, 0, .55) 46%, rgba(0, 0, 0, .14) 60%, rgba(0, 0, 0, 0) 70%); }
  .panel::after { content: ''; position: absolute; inset: -2px; z-index: 1; pointer-events: none; background: #000; opacity: .22; transition: opacity 500ms var(--ease); }
  @media (hover: hover) {
    .wall:hover .panel::after { opacity: .6; }
    .wall .panel:hover::after { opacity: 0; }
  }
  .panel:focus-visible { outline: none; }
  .wall .panel:focus-visible::after { opacity: 1; background: transparent; box-shadow: inset 0 0 0 5px var(--pink); }
  .p-cap { position: absolute; z-index: 2; left: clamp(16px, 1.6vw, 26px); right: 16px; top: calc(var(--header) + clamp(14px, 2.4vh, 26px)); display: flex; align-items: baseline; gap: 10px;
    font-weight: 600; font-size: 14px; line-height: 1.25; letter-spacing: -0.01em; text-align: left; color: rgba(255, 255, 255, .9); transition: color 300ms var(--ease); }
  .p-cap b { flex: none; font-size: 11px; font-weight: 700; letter-spacing: .1em; font-variant-numeric: tabular-nums; color: rgba(255, 255, 255, .6); }
  .p-cap i { font-style: normal; display: none; }
  .p-mute { display: none; flex: none; width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; align-self: center; }
  .p-mute path:first-child { fill: currentColor; }

  /* The badge that trails the pointer. */
  .cursor { position: absolute; z-index: 4; left: 0; top: 0; display: inline-flex; align-items: center; gap: 8px; margin: 18px 0 0 18px; padding: 11px 16px 11px 13px; border-radius: 999px; white-space: nowrap;
    background: var(--pink); color: var(--ink); font: 700 13px/1 var(--font); letter-spacing: -0.01em; pointer-events: none; opacity: 0; scale: .6; transition: opacity 220ms var(--ease), scale 300ms var(--ease); }
  .cursor svg { width: 12px; height: 12px; fill: currentColor; }
  .cursor.on { opacity: 1; scale: 1; }

  /* The copy, over the bottom of the reels. Only the copy itself takes the pointer, so the reels stay clickable around it. */
  .h-body { position: absolute; left: 0; right: 0; bottom: 0; z-index: 3; pointer-events: none; }
  .h-main, .h-side, .h-credit { pointer-events: auto; }
  .h-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, 400px); gap: clamp(32px, 5vw, 96px); align-items: end; padding-bottom: clamp(26px, 4.4vh, 48px); }
  .h-kick { display: inline-flex; align-items: center; gap: 10px; margin: 0 0 clamp(16px, 2.6vh, 28px); font-size: 14px; font-weight: 600; letter-spacing: -0.005em; color: rgba(255, 255, 255, .82); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--pink); box-shadow: 0 0 0 4px rgba(244, 193, 196, .18); }
  .h-title { margin: 0; font-weight: 700; font-size: min(8.4vw, 14svh); line-height: .88; letter-spacing: -0.058em; }
  .ln { display: block; overflow: hidden; padding: .02em .08em .1em 0; margin-bottom: -.1em; width: fit-content; white-space: nowrap; }
  .ln:last-child { color: var(--pink); }
  .rise { display: inline-block; animation: rise 1100ms cubic-bezier(.22, 1, .36, 1) both; animation-delay: var(--d); }
  @keyframes rise { from { transform: translateY(108%); } }
  .up { animation: fade-up 1000ms cubic-bezier(.22, 1, .36, 1) both; animation-delay: var(--d); }
  @keyframes fade-up { from { opacity: 0; transform: translateY(18px); } }
  .h-lede { margin: 0; font-size: clamp(16px, 1.2vw, 19px); line-height: 1.45; letter-spacing: -0.01em; color: rgba(255, 255, 255, .8); text-wrap: pretty; }
  .h-side .actions { margin-top: clamp(20px, 3vh, 28px); }
  .big-btn { padding: 17px 26px; font-size: 16px; }
  .hero .btn.primary { background: var(--pink); border-color: var(--pink); color: var(--ink); }
  .hero .btn.primary:hover { background: #fff; border-color: #fff; color: var(--ink); }
  .h-from { margin: 16px 0 0; font-size: 13px; letter-spacing: -0.005em; color: rgba(255, 255, 255, .56); }
  .h-foot { display: flex; align-items: center; min-height: 54px; border-top: 1px solid rgba(255, 255, 255, .16); }
  .h-credit { margin: 0; padding-right: 64px; font-size: 13px; color: rgba(255, 255, 255, .56); }
  .h-credit .link { margin-left: 6px; color: #fff; font-size: 13px; }

  /* Pause and play: bottom right on a wide screen, top right over the reel on a phone. */
  .h-ctl { position: absolute; z-index: 4; right: max(var(--gutter), calc((100% - var(--wide)) / 2 + var(--gutter))); bottom: 10px; display: grid; place-items: center; width: 34px; height: 34px; padding: 0;
    border: 1px solid rgba(255, 255, 255, .28); border-radius: 50%; background: rgba(0, 0, 0, .25); color: #fff; cursor: pointer; transition: background 200ms var(--ease), border-color 200ms var(--ease); }
  .h-ctl:hover { background: rgba(255, 255, 255, .16); border-color: rgba(255, 255, 255, .5); }
  .h-ctl:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .h-ctl svg { width: 12px; height: 12px; fill: currentColor; }
  .h-ctl .i-play, .held .h-ctl .i-pause { display: none; }
  .held .h-ctl .i-play { display: block; margin-left: 2px; }
  .bars { display: none; }

  @media (max-width: 1200px) and (min-width: 961px) {
    .h-grid { grid-template-columns: minmax(0, 1fr) minmax(300px, 350px); }
    .big-btn { padding: 15px 20px; font-size: 15px; }
  }
  /* Phones and tablets: one reel fills the screen, story style. */
  @media (max-width: 960px) {
    .wall { display: block; }
    .panel { position: absolute; inset: 0; width: 100%; visibility: hidden; opacity: 0; animation: none; transition: opacity 500ms var(--ease), visibility 0s 500ms; }
    .panel.on { visibility: visible; opacity: 1; transition: opacity 500ms var(--ease); }
    .wall { animation: wipe 1200ms cubic-bezier(.76, 0, .24, 1) both; }
    .panel::before { background: linear-gradient(180deg, rgba(0, 0, 0, .6) 0, rgba(0, 0, 0, 0) 26%), linear-gradient(0deg, rgba(0, 0, 0, .97) 0, rgba(0, 0, 0, .9) 34%, rgba(0, 0, 0, .5) 50%, rgba(0, 0, 0, .12) 62%, rgba(0, 0, 0, 0) 70%); }
    .panel::after { opacity: .08; }
    .p-cap { left: var(--gutter); right: 70px; top: calc(var(--header) + 26px); align-items: center; gap: 8px; font-size: 14px; }
    .p-cap i, .p-mute { display: inline; }
    .p-mute { display: block; }
    .bars { position: absolute; z-index: 3; left: var(--gutter); right: var(--gutter); top: calc(var(--header) + 12px); display: flex; gap: 4px; pointer-events: none; }
    .bars i { flex: 1; height: 2px; border-radius: 2px; overflow: hidden; background: rgba(255, 255, 255, .3); }
    .bars b { display: block; height: 100%; background: #fff; transform: scaleX(0); transform-origin: left; }
    .h-ctl { top: calc(var(--header) + 21px); bottom: auto; right: var(--gutter); width: 32px; height: 32px; }
    .h-grid { grid-template-columns: 1fr; gap: 18px; padding-bottom: max(22px, env(safe-area-inset-bottom)); }
    .h-title { font-size: min(13.4vw, 9.2svh, 112px); }
    .h-kick { margin-bottom: 14px; font-size: 13px; }
    .h-side { max-width: 34rem; }
    .h-lede { font-size: clamp(15px, 2.2vw, 18px); line-height: 1.45; }
    .h-side .actions { margin-top: 18px; }
    .h-from, .h-foot { display: none; }
  }
  @media (max-width: 560px) {
    .big-btn { padding: 15px 20px; font-size: 15px; } .h-side .actions { width: 100%; } .h-side .actions .btn { flex: 1 1 auto; }
  }
  @media (max-width: 960px) and (max-height: 700px) { .h-lede { display: none; } }
  @media (prefers-reduced-motion: reduce) {
    .panel, .panel img, .wall, .rise, .up { animation: none; }
  }

  /* The formats we make, running in a band under the hero. */
  .ticker { overflow: hidden; padding-block: 18px; background: var(--ink); color: #fff; }
  .ticker .track { display: flex; width: max-content; will-change: transform; }
  .ticker ul { display: flex; list-style: none; margin: 0; padding: 0; }
  .ticker li { display: flex; align-items: center; gap: 30px; white-space: nowrap; font-weight: 600; font-size: 16px; letter-spacing: -0.005em; padding-right: 30px; }
  .ticker svg { width: 13px; height: 13px; fill: none; stroke: var(--pink); stroke-width: 1.6; stroke-linecap: round; }

  .faq-grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .faq-lead { display: grid; gap: clamp(20px, 2.6vw, 34px); justify-items: start; position: sticky; top: 120px; }
  .faq-h { font-size: clamp(48px, 6.4vw, 104px); max-width: 8ch; }
  @media (max-width: 860px) { .faq-grid { grid-template-columns: 1fr; } .faq-lead { position: static; } }

  .apply-sec { border-top: 1px solid var(--hair); }

</style>
