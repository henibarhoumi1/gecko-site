---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import ApplyFlow from '../../components/ApplyFlow.astro';
import PlanPicker from '../../components/PlanPicker.astro';
import WhyGecko from '../../components/WhyGecko.astro';
import ReelCard from '../../components/ReelCard.astro';
import ReelViewer from '../../components/ReelViewer.astro';
import { t, type Locale } from '../../i18n/strings';
import { c } from '../../i18n/copy';
import { href } from '../../i18n/paths';
import { langPaths } from '../../i18n/static';
import { ads } from '../../data/work';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const s = t(lang);
const h = c(lang).home;
---
<Base lang={lang} footerCta={false}>
  <section class="on-white hero">
    <div class="wrap hero-in">
      <h1 class="h1 big">
        {h.title.map((line, i) => (
          <span class="line"><span class={`rise ${i === 1 ? 'hl' : ''}`} style={`--d:${80 + i * 110}ms`}>{line}</span></span>
        ))}
      </h1>
      <div class="hero-foot rise" style="--d:460ms">
        <p class="text text-l lede">{h.sub}</p>
        <div class="actions">
          <a class="btn primary" href={href(lang, 'apply')}>{h.cta} <span class="arr" aria-hidden="true">→</span></a>
          <a class="btn" href="#plans">{h.ctaAlt}</a>
        </div>
      </div>
    </div>
    <div class="ticker" aria-hidden="true">
      <div class="track">
        {[0, 1].map(() => <ul>{s.home.formats.map((f) => <li>{f}</li>)}</ul>)}
      </div>
    </div>
  </section>

  {ads.length > 0 && (
    <section class="on-black screen">
      <div class="wrap">
        <div class="head rv"><h2 class="h2 work-h">{h.workTitle}</h2><a class="btn" href={href(lang, 'work')}>{h.workCta} <span class="arr" aria-hidden="true">→</span></a></div>
        <div class="reels scroll-row" data-swipe>
          {ads.slice(0, 4).map((ad, i) => <div class="rv" style={`--d:${i * 70}ms`}><ReelCard ad={ad} i={i} lang={lang} /></div>)}
        </div>
      </div>
    </section>
  )}

  <WhyGecko lang={lang} />

  <section class="on-white screen" id="plans">
    <div class="wrap">
      <PlanPicker lang={lang} />
    </div>
  </section>

  <section class="on-white screen" id="faq">
    <div class="wrap faq-grid">
      <div class="faq-lead rv">
        <h2 class="h1 faq-h">{h.faqTitle}</h2>
        <a class="btn" href={href(lang, 'faq')}>{h.faqAll} <span class="arr" aria-hidden="true">→</span></a>
      </div>
      <div class="rv"><Faq items={s.faq} scroll hint={h.faqHint} /></div>
    </div>
  </section>

  <section class="on-paper section apply-sec" id="apply">
    <div class="wrap"><ApplyFlow lang={lang} /></div>
  </section>

  <ReelViewer lang={lang} />
</Base>

<style>
  .hero { min-height: 100svh; display: grid; grid-template-rows: 1fr auto; padding-top: calc(var(--header) + 40px); overflow: hidden; }
  .hero-in { align-self: end; display: grid; gap: clamp(28px, 3vw, 44px); padding-bottom: clamp(32px, 5vh, 56px); }
  .big { font-size: clamp(54px, 10.4vw, 172px); line-height: .92; letter-spacing: -0.055em; max-width: none !important; }
  .line { display: block; overflow: hidden; padding: .02em .06em .1em 0; width: fit-content; }
  .line .rise { display: inline-block; }
  .rise { animation: up 1000ms var(--ease) both; animation-delay: var(--d); }
  .hl { position: relative; isolation: isolate; padding: 0 .1em; margin-left: -.1em; }
  .hl::before { content: ''; position: absolute; inset: .16em -.02em .04em; background: var(--pink); border-radius: .12em; z-index: -1; transform-origin: left; animation: wipe 800ms 900ms var(--ease) both; }
  .hero-foot { display: grid; grid-template-columns: minmax(0, 42rem) auto; justify-content: space-between; align-items: end; gap: 24px 48px; padding-top: 24px; border-top: var(--line) solid var(--ink); }
  .lede { margin: 0; }
  @keyframes up { from { transform: translateY(100%); opacity: 0; } }
  @keyframes wipe { from { transform: scaleX(0); } }
  @media (max-width: 860px) { .hero { min-height: 86svh; } .hero-foot { grid-template-columns: 1fr; } }

  .ticker { overflow: hidden; padding-block: 14px; background: var(--mat); color: #fff; border-block: var(--line) solid var(--ink); }
  .ticker li::after { color: var(--pink); }
  .ticker .track { display: flex; width: max-content; animation: slide 60s linear infinite; }
  .ticker:hover .track { animation-play-state: paused; }
  .ticker ul { display: flex; list-style: none; margin: 0; padding: 0; }
  .ticker li { white-space: nowrap; font-weight: 700; font-size: 15px; padding-inline: 18px; }
  .ticker li::after { content: '✱'; padding-left: 36px; }
  @keyframes slide { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .rise, .hl::before, .ticker .track { animation: none; } }

  .reels { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(14px, 1.8vw, 24px); }
  @media (max-width: 760px) {
    .reels :global(.reel) { transform: translateY(calc((1 - var(--near, 1)) * 22px)) scale(calc(.86 + .14 * var(--near, 1))); opacity: calc(.55 + .45 * var(--near, 1)); transform-origin: 50% 60%; will-change: transform; }
    .reels > * { flex-basis: 72%; }
  }

  .work-h { max-width: 12ch; }

  .faq-grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .faq-lead { display: grid; gap: clamp(24px, 3vw, 40px); justify-items: start; position: sticky; top: 120px; }
  .faq-h { font-size: clamp(48px, 6.4vw, 104px); max-width: 8ch; }
  @media (max-width: 860px) { .faq-grid { grid-template-columns: 1fr; } .faq-lead { position: static; } }

  .apply-sec { border-top: var(--line) solid var(--ink); }
</style>
