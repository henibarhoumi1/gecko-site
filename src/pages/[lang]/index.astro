---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import ApplyFlow from '../../components/ApplyFlow.astro';
import Anatomy from '../../components/Anatomy.astro';
import Plans from '../../components/Plans.astro';
import ReelCard from '../../components/ReelCard.astro';
import ReelViewer from '../../components/ReelViewer.astro';
import { t, type Locale } from '../../i18n/strings';
import { c } from '../../i18n/copy';
import { href } from '../../i18n/paths';
import { langPaths } from '../../i18n/static';
import { ads } from '../../data/work';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const s = t(lang);
const h = c(lang).home;
---
<Base lang={lang}>
  <section class="hero">
    <div class="glow" aria-hidden="true"><i class="g1"></i><i class="g2"></i><i class="g3"></i></div>
    <div class="wrap hero-in center">
      <h1 class="h1 big">
        {h.title.map((line, i) => (
          <span class="line"><span class={`rise ${i === 1 ? 'hl' : ''}`} style={`--d:${80 + i * 110}ms`}>{line}</span></span>
        ))}
      </h1>
      <p class="text text-l soft lede rise" style="--d:460ms">{h.sub}</p>
      <div class="actions rise" style="--d:560ms">
        <a class="btn primary" href={href(lang, 'apply')}>{h.cta} <span class="arr" aria-hidden="true">→</span></a>
        <a class="btn" href={href(lang, 'process')}>{h.ctaAlt}</a>
      </div>
    </div>
    <div class="ticker rise" style="--d:700ms" aria-hidden="true">
      <div class="track">
        {[0, 1].map(() => <ul>{s.home.formats.map((f, i) => <li class={['', 'p', 'y'][i % 3]}>{f}</li>)}</ul>)}
      </div>
    </div>
  </section>

  <section class="on-paper screen">
    <div class="wrap">
      <div class="head rv"><div class="stack" style="--gap:14px"><h2 class="h2">{h.makeTitle}</h2><p class="text sub">{h.makeSub}</p></div></div>
      <ul class="formats">
        {h.make.map((f, i) => (
          <li class="fcard rv" style={`--d:${i * 60}ms`}>
            <span class={`dot ${['p', 'y', 'g'][i % 3]}`} aria-hidden="true"></span>
            <h3 class="h3">{f.t}</h3>
            <p class="text soft">{f.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {ads.length > 0 && (
    <section class="panel-wrap work-sec">
      <div class="panel-in mat screen-mat">
        <div class="wrap">
          <div class="head rv"><div class="stack" style="--gap:14px"><h2 class="h2">{h.workTitle}</h2><p class="text sub">{h.workSub}</p></div><a class="btn" href={href(lang, 'work')}>{h.workCta} <span class="arr" aria-hidden="true">→</span></a></div>
          <div class="reels scroll-row">
            {ads.slice(0, 4).map((a, i) => <div class="rv" style={`--d:${i * 90}ms`}><ReelCard ad={a} i={i} lang={lang} /></div>)}
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="on-white screen">
    <div class="wrap">
      <div class="head rv"><h2 class="h2">{h.stepsTitle}</h2><a class="link" href={href(lang, 'process')}>{h.stepsCta} →</a></div>
      <ol class="steps" data-steps>
        {h.steps.map((st, i) => (
          <li class="rv" style={`--d:${i * 110}ms`}>
            <span class="num">{i + 1}</span>
            <h3 class="h3">{st.t}</h3>
            <p class="text soft">{st.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="on-paper screen">
    <div class="wrap">
      <div class="head rv"><h2 class="h2">{h.anatomyTitle}</h2></div>
      <div class="rv"><Anatomy lang={lang} /></div>
    </div>
  </section>

  <section class="on-white screen">
    <div class="wrap">
      <div class="head rv"><div class="stack" style="--gap:14px"><h2 class="h2">{h.plansTitle}</h2><p class="text sub">{h.plansSub}</p></div><a class="link" href={href(lang, 'offers')}>{h.plansCta} →</a></div>
      <Plans lang={lang} />
    </div>
  </section>

  <section class="on-paper screen" id="faq">
    <div class="wrap faq-grid">
      <div class="head rv"><h2 class="h2">{h.faqTitle}</h2></div>
      <div class="rv"><Faq items={s.faq.slice(0, 6)} /></div>
    </div>
  </section>

  <section class="panel-wrap section apply-sec" id="apply">
    <div class="panel-in mat">
      <div class="wrap apply-in"><ApplyFlow lang={lang} /></div>
    </div>
  </section>

  <ReelViewer lang={lang} />
</Base>

<script>
  // The line between the steps draws itself when the row comes into view.
  document.querySelectorAll<HTMLElement>('[data-steps]').forEach((el) => {
    const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { el.classList.add('drawn'); io.disconnect(); } }, { threshold: .4 });
    io.observe(el);
  });
</script>

<style>
  .hero { position: relative; min-height: 100svh; display: grid; grid-template-rows: 1fr auto; padding-top: calc(var(--header) + 40px); overflow: hidden; }
  .hero-in { position: relative; z-index: 1; align-self: center; display: grid; gap: clamp(22px, 2.6vw, 32px); padding-block: 40px; }
  .big { font-size: clamp(52px, 9.6vw, 156px); line-height: .95; letter-spacing: -0.055em; max-width: none !important; }
  .line { display: block; overflow: hidden; padding: .02em .06em .1em; margin: 0 auto; width: fit-content; }
  .line .rise { display: inline-block; }
  .rise { animation: up 1000ms var(--ease) both; animation-delay: var(--d); }
  .hl { position: relative; isolation: isolate; padding: 0 .12em; }
  .hl::before { content: ''; position: absolute; inset: .16em -.02em .04em; background: var(--yellow); border-radius: .18em; z-index: -1; transform-origin: left; animation: wipe 800ms 900ms var(--ease) both; }
  .lede { max-width: 34rem; margin-inline: auto; }
  @keyframes up { from { transform: translateY(100%); opacity: 0; filter: blur(8px); } }
  @keyframes wipe { from { transform: scaleX(0); } }

  .glow { position: absolute; inset: 0; pointer-events: none; }
  .glow i { position: absolute; border-radius: 50%; filter: blur(80px); opacity: .55; animation: drift 18s ease-in-out infinite alternate; }
  .g1 { width: 46vw; height: 46vw; left: -12vw; top: -10vw; background: var(--pink); }
  .g2 { width: 40vw; height: 40vw; right: -10vw; top: 10vh; background: var(--yellow); animation-delay: -6s !important; }
  .g3 { width: 30vw; height: 30vw; left: 35vw; bottom: -18vw; background: #CFE3D6; animation-delay: -12s !important; }
  @keyframes drift { to { transform: translate(6vw, 4vh) scale(1.08); } }

  .ticker { position: relative; z-index: 1; overflow: hidden; padding-block: 18px 26px; -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .ticker .track { display: flex; width: max-content; animation: slide 60s linear infinite; }
  .ticker:hover .track { animation-play-state: paused; }
  .ticker ul { display: flex; gap: 10px; list-style: none; margin: 0; padding: 0 10px 0 0; }
  .ticker li { white-space: nowrap; font-size: 14px; font-weight: 500; padding: 9px 16px; border-radius: 999px; background: rgba(255, 255, 255, .7); border: 1px solid var(--hair); box-shadow: var(--shadow-1); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
  .ticker li.p::before, .ticker li.y::before { content: ''; display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 8px; vertical-align: 1px; background: var(--pink); }
  .ticker li.y::before { background: #E5C55A; }
  @keyframes slide { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .rise, .hl::before, .glow i, .ticker .track { animation: none; } }

  .formats { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(12px, 1.4vw, 18px); }
  .fcard { display: grid; gap: 10px; align-content: start; padding: clamp(22px, 2.2vw, 30px); min-height: 190px; background: var(--white); border-radius: var(--r); border: 1px solid var(--hair); box-shadow: var(--shadow-1); transition: transform 500ms var(--ease), box-shadow 500ms var(--ease), opacity 900ms var(--ease), filter 900ms var(--ease); }
  .fcard.in:hover { transform: translateY(-6px); box-shadow: var(--shadow-2); }
  .dot { width: 36px; height: 36px; border-radius: 12px; margin-bottom: 14px; transition: transform 500ms var(--spring); }
  .fcard:hover .dot { transform: rotate(-8deg) scale(1.1); }
  .dot.p { background: var(--pink); } .dot.y { background: var(--yellow); } .dot.g { background: var(--mat); }
  @media (max-width: 860px) { .formats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .formats { gap: 10px; } .fcard { min-height: 0; padding: 18px 16px; gap: 6px; } .fcard .h3 { font-size: 17px; } .fcard .text { font-size: 14px; line-height: 1.4; } .dot { width: 28px; height: 28px; border-radius: 9px; margin-bottom: 8px; } }

  .work-sec { padding-block: clamp(8px, 1.6vw, 20px); }
  .screen-mat { min-height: calc(100svh - 40px); display: grid; align-content: center; padding-block: clamp(72px, 9vh, 112px); }
  .screen-mat .h2 { color: #fff; }
  .screen-mat .btn { box-shadow: none; }
  .reels { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(14px, 1.8vw, 24px); }
  @media (max-width: 760px) { .screen-mat { min-height: 0; } }

  .steps { --g: clamp(16px, 2vw, 28px); list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--g); position: relative; }
  .steps::before { content: ''; position: absolute; left: 24px; width: calc((100% + var(--g)) * .75); top: 24px; height: 2px; background: var(--paper); }
  .steps::after { content: ''; position: absolute; left: 24px; width: calc((100% + var(--g)) * .75); top: 24px; height: 2px; background: var(--ink); transform: scaleX(0); transform-origin: left; transition: transform 1600ms var(--ease) 200ms; }
  .steps.drawn::after { transform: none; }
  .steps li { position: relative; z-index: 1; display: grid; gap: 10px; align-content: start; }
  .num { width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; font-weight: 700; font-size: 18px; background: var(--white); border: 1px solid var(--hair); box-shadow: var(--shadow-1); margin-bottom: 18px; transition: background 400ms var(--ease) var(--d), color 400ms var(--ease) var(--d); }
  .drawn .num { background: var(--ink); color: #fff; }
  @media (max-width: 860px) {
    .steps { grid-template-columns: 1fr; gap: 28px; }
    .steps::before, .steps::after { left: 23px; top: 24px; bottom: 24px; width: 2px; height: auto; }
    .steps::after { transform: scaleY(0); transform-origin: top; }
    .steps li { grid-template-columns: 48px 1fr; column-gap: 20px; }
    .steps li .num { grid-row: span 2; margin: 0; }
  }

  .faq-grid { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .faq-grid .head { margin-bottom: 0; }
  @media (max-width: 860px) { .faq-grid { grid-template-columns: 1fr; } }

  .apply-sec { padding-block: clamp(8px, 1.6vw, 20px) var(--section); }
  .apply-in { padding-block: clamp(72px, 10vw, 136px); }
  .apply-in :global(.h2) { color: #fff; }
  .apply-in :global(.soft), .apply-in :global(.direct a), .apply-in :global(.label) { color: rgba(255, 255, 255, .8); }
  .apply-in :global(.flow .soft) { color: var(--ink-2); }
</style>
