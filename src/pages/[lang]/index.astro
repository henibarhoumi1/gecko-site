---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import ApplyFlow from '../../components/ApplyFlow.astro';
import PlanPicker from '../../components/PlanPicker.astro';
import Workspace from '../../components/Workspace.astro';
import Bands from '../../components/Bands.astro';
import ReelViewer from '../../components/ReelViewer.astro';
import { t, type Locale } from '../../i18n/strings';
import { c } from '../../i18n/copy';
import { href } from '../../i18n/paths';
import { langPaths } from '../../i18n/static';
import { ads } from '../../data/work';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const s = t(lang);
const k = c(lang);
const h = k.home;
const hx = h.hero;
const w = k.work;
// The headline's full stop is drawn as a dot: it is where the landing opens onto the work.
// Wide screens set it in three lines; phones and upright tablets word by word (titleM), each as big as the screen allows.
const cut = (t: string[]) => t.map((l, i) => (i === t.length - 1 ? l.replace(/\.$/, '') : l));
const sets = [{ k: 'd', lines: cut(h.title) }, { k: 'm', lines: cut(h.titleM) }];
// The work stage plays a short silent cut of each case study reel; a click opens the full reel with sound.
const clips = ads.map((a, i) => {
  const slug = a.src!.replace(/^.*glucelia-|\.mp4$/g, '');
  return { i, src: `/work/clip-${slug}.mp4`, poster: a.poster!, cap: a.angle[lang] };
});
const pad = (n: number) => String(n).padStart(2, '0');
const mute = '<path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" /><path d="M16 10l4 4M20 10l-4 4" />';
---
<Base lang={lang} footerCta={false} page="home">
  <div class="intro" data-intro>
    <script is:inline>document.currentScript.parentElement.classList.toggle('iris', !matchMedia('(prefers-reduced-motion: reduce)').matches);</script>
    <div class="stage">
      <section class="hero" data-hero aria-labelledby="h-title">
        <div class="wrap wide h-in">
          <p class="h-kick up" style="--d:260ms"><span class="k-dot" aria-hidden="true"></span>{h.kicker}</p>
          <div class="h-tbox">
            <h1 class="h-title" id="h-title" aria-label={h.title.join(' ')} style={`--lm:${h.titleM.length}`}>
              {sets.map(({ k: set, lines }) => lines.map((line, i) => (
                <span class={`ln ${set}`} aria-hidden="true"><span class="rise" style={`--d:${340 + i * (set === 'd' ? 120 : 80)}ms`}>{i === lines.length - 1 ? <><span class="mark">{line}</span><span class="stop" data-stop></span></> : line}</span></span>
              )))}
            </h1>
          </div>
          <p class="h-lede up" style="--d:760ms">{h.sub}</p>
          <div class="h-cta up" style="--d:860ms">
            <div class="actions">
              <a class="btn primary big-btn" href={href(lang, 'apply')}>{h.cta} <span class="arr" aria-hidden="true">→</span></a>
              <a class="btn big-btn" href="#plans">{h.ctaAlt}</a>
            </div>
            <p class="h-from">{hx.from}</p>
          </div>
        </div>
        <div class="ticker" aria-hidden="true">
          <div class="track" data-marquee="45">
            {[0, 1, 2].map(() => <ul>{s.home.formats.map((f) => <li>{f}<svg viewBox="0 0 16 16"><path d="M8 1v14M1 8h14M3 3l10 10M13 3L3 13" /></svg></li>)}</ul>)}
          </div>
        </div>
        <button type="button" class="stop-hit" data-stop-hit aria-label={hx.dive}></button>
      </section>

      <section class="work on-black" id="work" data-work data-dark="0" aria-labelledby="w-title">
        <div class="wrap wide w-in">
          <div class="w-head" data-w-head>
            <h2 class="w-title" id="w-title" tabindex="-1" style={`--n:${k.nav.work.length}`}>{k.nav.work}</h2>
            <div class="w-meta">
              <p class="w-kick">{h.kicks.work} · 2026</p>
              <button type="button" class="w-ctl" data-toggle aria-pressed="false" aria-label={hx.pause} data-pause={hx.pause} data-play={hx.play}>
                <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3h2v10H5zM9 3h2v10H9z" /></svg>
                <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.2v9.6L13 8z" /></svg>
              </button>
            </div>
          </div>
          <ol class="deck" data-deck>
            {clips.map((cl) => (
              <li class="card">
                <button type="button" class="c-media" data-cut={cl.i} aria-label={`${hx.sound}: ${cl.cap}`}>
                  <img src={cl.poster} alt="" width="540" height="960" decoding="async" />
                  <video muted playsinline loop preload="none" tabindex="-1" aria-hidden="true" data-src={cl.src}></video>
                  <svg class="c-mute" viewBox="0 0 24 24" aria-hidden="true" set:html={mute} />
                </button>
                <p class="c-cap" aria-hidden="true"><b>{pad(cl.i + 1)}</b><span>{cl.cap}</span></p>
              </li>
            ))}
          </ol>
        </div>
        <span class="cursor" data-cursor aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M5 3.2v9.6L13 8z" /></svg>{hx.sound}</span>
      </section>
    </div>
    <div class="pin" data-pin aria-hidden="true"></div>
  </div>

  <section class="work-more on-black" data-dark="1">
    <div class="wrap wide wm">
      <p class="wm-intro rv">{w.intro}</p>
      <div class="wm-side rv" style="--d:120ms">
        <p class="wm-team"><span class="wm-k">{w.team}</span>{w.people.join(', ')}</p>
        <a class="btn wm-btn" href={href(lang, 'work')}>{hx.cta} <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <Workspace lang={lang} />

  <Bands lang={lang} />

  <section class="section apply-sec" id="apply">
    <div class="wrap"><ApplyFlow lang={lang} /></div>
  </section>

  <section class="section plans-sec" id="plans">
    <div class="wrap">
      <PlanPicker lang={lang} />
    </div>
  </section>

  <section class="section faq-sec" id="faq">
    <div class="wrap faq-grid">
      <div class="faq-lead rv">
        <h2 class="h1 faq-h">{h.faqTitle}</h2>
      </div>
      <div class="rv"><Faq items={s.faq} limit={6} more={{ href: href(lang, 'faq'), label: h.faqAll }} /></div>
    </div>
  </section>

  <ReelViewer lang={lang} />
</Base>

<script>
  import '../../scripts/marquee';
  // The landing is type only: the headline on white, its full stop drawn as a black dot, the formats we make running
  // along the bottom. Scrolling opens that dot like a camera iris: it lifts off the line and grows until it fills the
  // screen, and behind it is the work, the four case study reels fanning out of a stack. Scrolling back closes it.
  // With reduced motion there is no iris and the work simply follows the landing.
  const intro = document.querySelector<HTMLElement>('[data-intro]');
  const work = document.querySelector<HTMLElement>('[data-work]');
  if (intro && work) {
    const hero = intro.querySelector<HTMLElement>('[data-hero]')!;
    // Two versions of the headline exist (wide and phone); the dot that counts is the one on screen.
    const stops = [...hero.querySelectorAll<HTMLElement>('[data-stop]')];
    let stop = stops[0];
    const hit = hero.querySelector<HTMLButtonElement>('[data-stop-hit]')!;
    const head = work.querySelector<HTMLElement>('[data-w-head]')!;
    const title = head.querySelector<HTMLElement>('h2')!;
    const deck = work.querySelector<HTMLElement>('[data-deck]')!;
    const cards = [...deck.querySelectorAll<HTMLElement>('.card')];
    const media = cards.map((el) => el.querySelector<HTMLButtonElement>('[data-cut]')!);
    const vids = media.map((m) => m.querySelector('video')!);
    const toggle = work.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const iris = intro.classList.contains('iris');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const save = !!(navigator as any).connection?.saveData;
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    const span = (a: number, b: number, v: number) => clamp((v - a) / (b - a));
    const ease = (v: number) => v * v * (3 - 2 * v);
    if (!iris) work.dataset.dark = '1';

    // The reels play, silent and looping, while the work is in view. Nothing plays before the page has loaded, while a
    // dialog or the menu is open, with reduced motion, with data saver on or after the pause button.
    let wanted = !still && !save, ready = false, seen = false, blocked = false, shown = !iris, warm = false;
    const load = (v: HTMLVideoElement) => { if (!v.getAttribute('src')) { v.preload = 'auto'; v.src = v.dataset.src!; } };
    const go = () => {
      const on = ready && seen && shown && !blocked && !document.hidden && wanted;
      vids.forEach((v) => { if (on) { load(v); v.play().catch(() => {}); } else v.pause(); });
    };
    vids.forEach((v, j) => v.addEventListener('playing', () => cards[j].classList.add('live')));
    toggle.addEventListener('click', () => {
      wanted = !wanted;
      toggle.setAttribute('aria-pressed', String(!wanted));
      toggle.setAttribute('aria-label', wanted ? toggle.dataset.pause! : toggle.dataset.play!);
      work.classList.toggle('held', !wanted);
      go();
    });
    if (!wanted) { work.classList.add('held'); toggle.setAttribute('aria-pressed', 'true'); toggle.setAttribute('aria-label', toggle.dataset.play!); }
    // A click opens the reel full screen with sound, growing out of the card.
    media.forEach((m, j) => m.addEventListener('click', () => document.dispatchEvent(new CustomEvent('reel:play', { detail: { i: j, from: m, grow: m } }))));
    new IntersectionObserver(([e]) => { seen = e.isIntersecting; go(); }, { threshold: 0.15 }).observe(deck);
    new MutationObserver(() => { blocked = document.documentElement.classList.contains('locked'); go(); })
      .observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    document.addEventListener('visibilitychange', go);
    const start = () => { ready = true; go(); };
    const idle = () => ('requestIdleCallback' in window ? (window as any).requestIdleCallback(start, { timeout: 1200 }) : setTimeout(start, 300));
    if (document.readyState === 'complete') idle(); else addEventListener('load', idle, { once: true });

    // With a mouse, a "Watch with sound" badge trails the pointer across the reels.
    if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
      const cur = work.querySelector<HTMLElement>('[data-cursor]')!;
      let x = 0, y = 0, tx = 0, ty = 0, glide = 0;
      const step = () => {
        x += (tx - x) * .22; y += (ty - y) * .22;
        cur.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0)`;
        glide = Math.abs(tx - x) + Math.abs(ty - y) > .4 ? requestAnimationFrame(step) : 0;
      };
      deck.addEventListener('pointermove', (e) => {
        const r = work.getBoundingClientRect();
        tx = e.clientX - r.left; ty = e.clientY - r.top;
        const on = !!(e.target as HTMLElement).closest('[data-cut]');
        if (on && !cur.classList.contains('on')) { x = tx; y = ty; }
        cur.classList.toggle('on', on);
        if (!glide) glide = requestAnimationFrame(step);
      });
      deck.addEventListener('pointerleave', () => cur.classList.remove('on'));
    }

    // The dot is a button too: it takes you straight through to the work.
    const through = () => {
      const to = iris ? intro.offsetTop + intro.querySelector<HTMLElement>('[data-pin]')!.offsetHeight : work.getBoundingClientRect().top + scrollY;
      const done = () => title.focus({ preventScroll: true });
      const l = (window as any).lenis;
      if (l) l.scrollTo(to, { duration: 1.9, easing: (t: number) => (t < .5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2), onComplete: done });
      else { scrollTo({ top: to, behavior: still ? 'auto' : 'smooth' }); setTimeout(done, still ? 0 : 900); }
    };
    hit.addEventListener('click', through);

    if (iris) {
      const pin = intro.querySelector<HTMLElement>('[data-pin]')!;
      // How far each reel sits from the stack it fans out of, and how much it leans in the stack.
      const lean = [-9, -3, 3.5, 10];
      let W = 0, H = 0, D = 1, top = 0, ox = 0, oy = 0, r0 = 0, last = -1;
      let off: { x: number; y: number }[] = [];
      const frame = () => {
        const p = clamp((scrollY - top) / D);
        if (p === last) return;
        last = p;
        // The circle starts as the dot, drifts to the middle of the screen as it grows and ends past the far corner.
        const m = ease(span(0, .8, p));
        const cx = ox + (W / 2 - ox) * m, cy = oy + (H / 2 - oy) * m;
        const far = Math.hypot(Math.max(cx, W - cx), Math.max(cy, H - cy)) + 4;
        const r = p ? r0 + (far - r0) * p * p : 0;
        work.style.clipPath = p >= 1 ? 'none' : `circle(${r.toFixed(1)}px at ${cx.toFixed(1)}px ${cy.toFixed(1)}px)`;
        // The landing leans in towards the dot while it opens.
        hero.style.transform = p ? `scale(${(1 + p * p * .6).toFixed(4)})` : '';
        intro.classList.toggle('moving', p > 0);
        const q = ease(span(.45, .9, p));
        head.style.opacity = q < 1 ? q.toFixed(3) : '';
        head.style.transform = q < 1 ? `translate3d(0, ${((1 - q) * 40).toFixed(1)}px, 0)` : '';
        deck.style.opacity = p < .3 ? ease(span(.06, .3, p)).toFixed(3) : '';
        const f = ease(span(.3, 1, p));
        cards.forEach((el, i) => {
          el.style.transform = f < 1 ? `translate3d(${(off[i].x * (1 - f)).toFixed(1)}px, ${(off[i].y * (1 - f)).toFixed(1)}px, 0) rotate(${(lean[i % 4] * (1 - f)).toFixed(2)}deg) scale(${(.78 + .22 * f).toFixed(4)})` : '';
        });
        // The menu bar turns light on dark once the circle covers it.
        work.dataset.dark = p >= 1 || Math.hypot(Math.max(cx, W - cx), cy - 40) <= r ? '1' : '0';
        // The clips start loading as soon as the iris starts opening, and play once it is a third open.
        if (p > 0 && !warm && wanted) { warm = true; vids.forEach(load); }
        const was = shown;
        shown = p > .3;
        if (shown !== was) go();
      };
      const measure = () => {
        W = innerWidth; H = innerHeight;
        D = pin.offsetHeight || 1;
        top = intro.offsetTop;
        // Offsets leave out transforms, so the dot is found where it rests.
        stop = stops.find((el) => el.offsetWidth) ?? stops[0];
        let x = stop.offsetWidth / 2, y = stop.offsetHeight / 2;
        for (let el: HTMLElement | null = stop; el && el !== hero; el = el.offsetParent as HTMLElement | null) { x += el.offsetLeft; y += el.offsetTop; }
        ox = x; oy = y; r0 = stop.offsetWidth / 2;
        hero.style.setProperty('--ox', `${ox}px`);
        hero.style.setProperty('--oy', `${oy}px`);
        hit.style.left = `${ox}px`;
        hit.style.top = `${oy}px`;
        // The reels stack in the middle of the screen, under the title.
        const sx = W / 2, sy = (head.offsetTop + head.offsetHeight + Math.min(H, work.offsetHeight)) / 2;
        off = cards.map((el) => ({ x: sx - (deck.offsetLeft + el.offsetLeft + el.offsetWidth / 2), y: sy - (deck.offsetTop + el.offsetTop + el.offsetHeight / 2) }));
        last = -1;
        frame();
      };
      addEventListener('scroll', frame, { passive: true });
      // A phone's address bar showing or hiding only changes the height a little: keep the layout, follow the height.
      addEventListener('resize', () => { if (innerWidth !== W) measure(); else { H = innerHeight; last = -1; frame(); } });
      addEventListener('load', measure, { once: true });
      measure();

      // With a mouse the dot leans towards the pointer and swells as it comes close, like a button waiting to be pressed.
      if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
        let x = 0, y = 0, z = 1, tx = 0, ty = 0, tz = 1, raf = 0;
        const step = () => {
          x += (tx - x) * .16; y += (ty - y) * .16; z += (tz - z) * .16;
          stop.style.translate = `${x.toFixed(2)}px ${y.toFixed(2)}px`;
          stop.style.scale = z.toFixed(3);
          raf = Math.abs(tx - x) + Math.abs(ty - y) + Math.abs(tz - z) > .02 ? requestAnimationFrame(step) : 0;
        };
        const aim = (e?: PointerEvent) => {
          tx = ty = 0; tz = 1;
          if (e && !intro.classList.contains('moving')) {
            const r = hero.getBoundingClientRect();
            const dx = e.clientX - r.left - ox, dy = e.clientY - r.top - oy, d = Math.hypot(dx, dy), reach = 170;
            const pull = d < reach ? 1 - d / reach : 0;
            tx = dx * .3 * pull; ty = dy * .3 * pull; tz = 1 + pull * .8;
          }
          if (!raf) raf = requestAnimationFrame(step);
        };
        hero.addEventListener('pointermove', aim);
        hero.addEventListener('pointerleave', () => aim());
        addEventListener('scroll', () => { if (tz !== 1 && intro.classList.contains('moving')) aim(); }, { passive: true });
      }
    }
  }
</script>

<style>
  /* The landing: white, type only. The kicker and the pitch sit at the top, the headline fills the bottom and the
     formats we make run along the foot in a black band. */
  .intro { position: relative; }
  .stage { position: relative; }
  .hero { position: relative; display: flex; flex-direction: column; height: 100svh; min-height: 560px; overflow: hidden; background: var(--bg); color: var(--fg); }
  .h-in { flex: 1; min-height: 0; display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, 380px); grid-template-rows: auto auto minmax(0, 1fr); column-gap: clamp(32px, 4vw, 80px);
    grid-template-areas: 'kick lede' '. cta' 'title title'; padding-top: calc(var(--header) + clamp(6px, 2vh, 24px)); padding-bottom: clamp(20px, 4vh, 48px); }
  .h-kick { grid-area: kick; align-self: start; display: inline-flex; align-items: center; gap: 10px; margin: 0; font-size: 14px; font-weight: 600; letter-spacing: -0.005em; color: var(--fg-2); }
  .k-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--pink); box-shadow: 0 0 0 4px var(--pink-soft); }
  .h-lede { grid-area: lede; }
  .h-cta { grid-area: cta; margin-top: clamp(18px, 2.6vh, 26px); }
  /* The headline takes whatever room is left under the pitch: as wide as the longest line allows, as tall as the box. */
  .h-tbox { grid-area: title; container-type: size; display: flex; flex-direction: column; justify-content: flex-end; min-height: 0; padding-top: clamp(12px, 2.4vh, 28px); }
  .h-title { margin: 0; font-weight: 700; letter-spacing: -0.06em; line-height: .86;
    font-size: min(calc((min(100vw, var(--wide)) - 2 * var(--gutter)) / 6.9), calc((100svh - 440px) / 2.75));
    font-size: min(calc(100cqw / 6.9), calc(100cqh / 2.75)); }
  .ln { display: block; overflow: hidden; width: fit-content; white-space: nowrap; padding: .03em .1em .1em .06em; margin: 0 0 -.1em -.06em; }
  .ln.m { display: none; }
  .rise { display: inline-block; animation: rise 1100ms cubic-bezier(.22, 1, .36, 1) both; animation-delay: var(--d); }
  @keyframes rise { from { transform: translateY(108%); } }
  /* A pink marker stroke under the last word, and the full stop: a round black dot that drops into place. */
  .mark { position: relative; z-index: 0; }
  .mark::before { content: ''; position: absolute; z-index: -1; left: -.05em; right: -.02em; top: .58em; bottom: .12em; background: var(--pink); transform-origin: 0 50%;
    animation: swipe 850ms cubic-bezier(.65, 0, .35, 1) both; animation-delay: 950ms; }
  @keyframes swipe { from { transform: scaleX(0); } }
  .stop { display: inline-block; width: .2em; height: .2em; margin-left: .05em; border-radius: 50%; background: var(--ink); animation: pop 650ms cubic-bezier(.34, 1.56, .64, 1) both; animation-delay: 1250ms; }
  @keyframes pop { from { transform: translateY(-1.2em) scale(.4); opacity: 0; } 55% { opacity: 1; } }
  .stop-hit { position: absolute; z-index: 2; left: 0; top: 0; width: 72px; height: 72px; margin: -36px 0 0 -36px; padding: 0; border: 0; border-radius: 50%; background: transparent; cursor: pointer; }
  .stop-hit:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .moving .stop-hit, .moving .stop { visibility: hidden; }
  .intro:not(.iris) .stop-hit { display: none; }
  .up { animation: fade-up 1000ms cubic-bezier(.22, 1, .36, 1) both; animation-delay: var(--d); }
  @keyframes fade-up { from { opacity: 0; transform: translateY(16px); } }
  .h-lede { margin: 0; font-size: clamp(16px, 1.2vw, 19px); line-height: 1.45; letter-spacing: -0.01em; color: var(--fg-2); text-wrap: pretty; }
  .big-btn { padding: 17px 26px; font-size: 16px; }
  .hero .btn.primary:hover { background: var(--pink); border-color: var(--pink); color: var(--ink); }
  .hero .btn:not(.primary):hover { background: var(--tint-2); }
  .h-from { margin: 14px 0 0; font-size: 13px; letter-spacing: -0.005em; color: var(--fg-3); }

  /* The formats we make, running along the foot of the landing. */
  .ticker { flex: none; overflow: hidden; padding-block: 17px; background: var(--ink); color: #fff; }
  .ticker .track { display: flex; width: max-content; will-change: transform; }
  .ticker ul { display: flex; list-style: none; margin: 0; padding: 0; }
  .ticker li { display: flex; align-items: center; gap: 30px; white-space: nowrap; font-weight: 600; font-size: 16px; letter-spacing: -0.005em; padding-right: 30px; }
  .ticker svg { width: 13px; height: 13px; fill: none; stroke: var(--pink); stroke-width: 1.6; stroke-linecap: round; }

  /* The iris. The stage holds still for one screen of scrolling while the work, on top, is cut to a growing circle;
     the landing underneath leans in towards the dot. */
  .iris .stage { position: sticky; top: 0; overflow: hidden; background: var(--bg); }
  .iris .hero { position: absolute; z-index: 1; left: 0; right: 0; top: 0; transform-origin: var(--ox, 50%) var(--oy, 80%); }
  .iris.moving .hero { will-change: transform; }
  .iris .work { clip-path: circle(0 at 50% 50%); }
  .iris .pin { height: 100svh; }

  /* The work: the title, then the four reels side by side, sized to fit the screen with their captions. */
  .work { --wt: clamp(56px, min(9.4vw, 13.5svh), 176px); --gap: clamp(10px, 1.1vw, 18px); --cap: 46px; --pt: calc(var(--header) + clamp(0px, 1vh, 12px)); --pb: clamp(18px, 3.4vh, 38px);
    --hh: calc(var(--wt) * .86 + clamp(16px, 2.8vh, 30px)); position: relative; z-index: 2; min-height: 100lvh; }
  .w-in { display: flex; flex-direction: column; min-height: 100svh; padding-top: var(--pt); padding-bottom: var(--pb); }
  .w-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; min-height: var(--hh); padding-bottom: clamp(16px, 2.8vh, 30px); }
