---
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';
import Faq from '../../components/Faq.astro';
import ApplyBlock from '../../components/ApplyBlock.astro';
import AdDemo from '../../components/AdDemo.astro';
import Anatomy from '../../components/Anatomy.astro';
import PlanFinder from '../../components/PlanFinder.astro';
import Stamp from '../../components/Stamp.astro';
import Mark from '../../components/Mark.astro';
import Reel from '../../components/Reel.astro';
import { t, type Locale } from '../../i18n/strings';
import { href } from '../../i18n/paths';
import { langPaths } from '../../i18n/static';
import { hero, logos, numbers, cases, ads, photos } from '../../data/work';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const s = t(lang);
const h = s.home;
---
<Base lang={lang}>
  <section class="on-pink hero">
    <div class="wrap">
      <div class="hero-top">
        <div class="stack copy" style="--gap:24px">
          <p class="label">{s.hero.kicker}</p>
          <div class="title">
            <h1 class="h1">{s.hero.title}</h1>
            <Mark kind="swoosh" class="swoosh" />
          </div>
        </div>
        <div class="stack side-copy" style="--gap:24px">
          <Stamp kind="round" tilt={-9} class="hero-stamp" />
          <p class="text text-l">{s.hero.sub}</p>
          <div class="actions">
            <a class="btn primary" href={href(lang, 'apply')}>{s.nav.apply} <span class="arr" aria-hidden="true">→</span></a>
            <a class="btn" href="#work">{h.reelLabel} <span class="arr" aria-hidden="true">↓</span></a>
          </div>
        </div>
      </div>
      {ads.length > 0 ? (
        <div class="wall scroll-row" id="work">{ads.slice(0, 4).map((a, i) => <Reel ad={a} lang={lang} n={i + 1} />)}</div>
      ) : <AdDemo lang={lang} />}
    </div>
  </section>

  <section class="on-yellow marquee" aria-label={h.grid}>
    <div class="track">
      {[0, 1].map((dup) => (
        <ul aria-hidden={dup ? 'true' : undefined}>{h.formats.map((f) => <li>{f}</li>)}</ul>
      ))}
    </div>
  </section>

  {logos.length > 0 && (
    <section class="on-white logos">
      <div class="wrap">
        <p class="label">{h.logos}</p>
        <ul class="logo-row">
          {logos.map((l) => <li>{l.src ? <img src={l.src} alt={l.name} /> : <span class="h3">{l.name}</span>}</li>)}
        </ul>
      </div>
    </section>
  )}

  {numbers.length > 0 && (
    <section class="on-pink section numbers">
      <div class="wrap">
        <div class="head"><p class="label">{h.numbers}</p><p class="small muted side">{numbers.some((n) => n.sample) ? h.numbersEmpty : ''}</p></div>
        <div class="grid g3">
          {numbers.map((n) => (
            <div class="stat">
              <p class="big">{n.value}</p>
              <p class="label">{h.numberLabels[n.key]}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {ads.length > 0 && (
    <section class="on-white section">
      <div class="wrap">
        <div class="head"><p class="label">{h.grid}</p><div class="side"><h2 class="h2">{h.gridTitle}</h2><p class="small">{h.gridHint}</p></div></div>
        <ol class="rows ideas">
          {ads.slice(0, 4).map((a, i) => (
            <li>
              <span class="label">{String(i + 1).padStart(2, '0')}</span>
              <img src={a.poster} alt="" loading="lazy" width="72" height="128" />
              <div class="stack" style="--gap:10px">
                <p class="label">{a.brand} · {a.angle[lang]}</p>
                <h3 class="h3">{a.idea?.[lang]}</h3>
              </div>
              <p class="text">{a.how?.[lang]}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <section class="on-yellow section">
    <div class="wrap">
      <div class="head"><p class="label">{h.dayLabel}</p><div class="side"><h2 class="h2">{h.dayTitle}</h2></div></div>
      <ol class="day" data-count>
        {h.day.map((d) => <li><p class="big" data-to={d.n}>{d.n}</p><p class="text">{d.l}</p></li>)}
      </ol>
      <div class="actions more"><a class="btn" href={href(lang, 'offers')}>{h.dayCta} <span class="arr" aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section class="on-white section">
    <div class="wrap">
      <div class="head"><p class="label">{h.anatomyLabel}</p><div class="side"><h2 class="h2">{h.anatomyTitle}</h2><p class="small muted">{h.anatomyHint}</p></div></div>
      <Anatomy lang={lang} />
    </div>
  </section>

  {cases.length > 0 && (
    <section class="on-white section">
      <div class="wrap">
        <div class="head"><p class="label">{h.cases}</p><div class="side"><h2 class="h2">{h.casesTitle}</h2></div></div>
        <div class="grid g3 scroll-row">{cases.slice(0, 3).map((c) => <CaseCard c={c} lang={lang} />)}</div>
      </div>
    </section>
  )}

  <section class="on-white section">
    <div class="wrap">
      <div class="head"><p class="label">{h.howTitle}</p></div>
      <ol class="rows steps">
        {h.how.map((step, i) => (
          <li>
            <span class="label">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="h3">{step.t}</h3>
            <p class="text">{step.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="on-pink section">
    <div class="wrap">
      <div class="head"><p class="label">{h.finderLabel}</p><div class="side"><h2 class="h2">{h.finderTitle}</h2></div></div>
      <PlanFinder lang={lang} />
    </div>
  </section>

  {photos.length > 0 && (
    <section class="on-white section">
      <div class="wrap">
        <div class="head"><p class="label">{h.teamTitle}</p><div class="side"><p class="text text-l measure">{h.teamText}</p></div></div>
        <div class="grid g3 scroll-row">
          {photos.map((p) => (
            <figure class="photo">
              <div class="frame r45">{p.src ? <img src={p.src} alt={p.alt[lang]} loading="lazy" /> : <div class="empty"><span class="label muted">{s.sample} · {h.teamEmpty}</span></div>}</div>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="on-white section" id="faq">
    <div class="wrap">
      <div class="head"><p class="label">{h.faqTitle}</p></div>
      <div class="faq-wrap">
        <Faq items={s.faq} />
        <a class="link small" href={href(lang, 'offers')}>{h.allFaq} →</a>
      </div>
    </div>
  </section>

  <section class="on-yellow section" id="apply">
    <div class="wrap"><ApplyBlock lang={lang} /></div>
  </section>
</Base>

<script>
  // Count up the shoot-day numbers once, when they come into view. The final numbers are in the HTML.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((list) => {
      const io = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        list.querySelectorAll<HTMLElement>('[data-to]').forEach((el) => {
          const to = Number(el.dataset.to); const t0 = performance.now(); const dur = 900;
          const step = (now: number) => {
            const p = Math.min(1, (now - t0) / dur);
            el.textContent = String(Math.round(to * (1 - Math.pow(1 - p, 3))));
            if (p < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        });
      }, { threshold: 0.4 });
      io.observe(list);
    });
  }
</script>

<style>
  .hero { padding-top: calc(var(--header) + clamp(32px, 5vw, 64px)); padding-bottom: clamp(48px, 7vw, 96px); }
  .hero-top { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 80px); align-items: end; margin-bottom: clamp(40px, 6vw, 72px); }
  .title { position: relative; }
  .side-copy { position: relative; }
  .hero :global(.swoosh) { width: min(70%, 460px); margin-top: 10px; stroke-dasharray: 400; stroke-dashoffset: 400; animation: draw 900ms 300ms var(--ease) forwards; }
  .hero :global(.hero-stamp) { width: 130px; margin-bottom: 8px; }
  .wall { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 20px); }
  @media (max-width: 600px) { .wall { display: flex; } }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .hero :global(.swoosh) { animation: none; stroke-dashoffset: 0; } }
  @media (max-width: 860px) {
    .hero-top { grid-template-columns: 1fr; }
    .hero :global(.hero-stamp) { position: absolute; right: 0; top: -12px; width: 96px; }
    .side-copy > .text { padding-top: 8px; max-width: calc(100% - 100px); }
  }
  @media (max-width: 960px) and (min-width: 601px) { .wall { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .ideas { list-style: none; margin: 0; padding: 0; }
  .ideas li { display: grid; grid-template-columns: 48px 72px minmax(0, 1.3fr) minmax(0, 1.5fr); gap: 24px; padding-block: clamp(22px, 3vw, 36px); align-items: start; }
  .ideas img { width: 72px; height: 128px; object-fit: cover; border: var(--line) solid var(--ink); }
  @media (max-width: 760px) { .ideas li { grid-template-columns: 56px minmax(0, 1fr); gap: 12px 16px; } .ideas li > .label { display: none; } .ideas li > .text { grid-column: 1 / -1; } }

  .logos { padding-bottom: clamp(48px, 6vw, 80px); }
  .logo-row { list-style: none; padding: 0; margin: 20px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); border-top: var(--line) solid var(--ink); border-left: var(--line) solid var(--ink); }
  .logo-row li { display: grid; place-items: center; min-height: 112px; padding: 20px; border-right: var(--line) solid var(--ink); border-bottom: var(--line) solid var(--ink); }
  .logo-row img { max-height: 40px; width: auto; }

  .stat { border-top: var(--line) solid var(--ink); padding-top: 20px; display: grid; gap: 10px; }
  .big { margin: 0; font-weight: 700; font-size: clamp(56px, 7vw, 112px); line-height: .95; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }

  .more { margin-top: clamp(28px, 4vw, 48px); }

  .marquee { overflow: hidden; border-block: var(--line) solid var(--ink); padding-block: clamp(18px, 2.4vw, 28px); }
  .marquee .track { display: flex; width: max-content; animation: slide 38s linear infinite; }
  .marquee:hover .track { animation-play-state: paused; }
  .marquee ul { display: flex; list-style: none; margin: 0; padding: 0; }
  .marquee li { font-weight: 700; font-size: clamp(28px, 3.6vw, 52px); letter-spacing: -0.025em; line-height: 1; white-space: nowrap; padding-right: 1.2em; }
  .marquee li::after { content: '✱'; padding-left: 1.2em; font-size: .6em; vertical-align: middle; }
  @keyframes slide { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .marquee .track { animation: none; } }

  .day { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .day li { border-top: var(--line) solid var(--ink); padding: 20px 20px 0 0; display: grid; gap: 12px; align-content: start; position: relative; }
  .day li + li { padding-left: 20px; border-left: var(--line) solid var(--ink); }
  .day .big { font-size: clamp(72px, 10vw, 160px); }
  @media (max-width: 760px) {
    .day { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 28px; }
    .day li:nth-child(3) { border-left: 0; padding-left: 0; }
  }

  .steps { list-style: none; margin: 0; padding: 0; }
  .steps li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr) minmax(0, 1.5fr); gap: 24px; padding-block: clamp(22px, 3vw, 36px); align-items: baseline; }
  @media (max-width: 760px) { .steps li { grid-template-columns: 1fr; gap: 8px; } }

  .photo { margin: 0; }
  .faq-wrap { display: grid; gap: 28px; margin-left: calc(25% + 6px); }
  @media (max-width: 760px) { .faq-wrap { margin-left: 0; } }
</style>
