---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import ApplyFlow from '../../components/ApplyFlow.astro';
import Bands from '../../components/Bands.astro';
import Strip from '../../components/Strip.astro';
import WhatWeDo from '../../components/WhatWeDo.astro';
import PlansHome from '../../components/PlansHome.astro';
import WorkspaceHome from '../../components/WorkspaceHome.astro';
import ReelViewer from '../../components/ReelViewer.astro';
import { launch } from '../../i18n/launch';
import { t, type Locale } from '../../i18n/strings';
import { c } from '../../i18n/copy';
import { href } from '../../i18n/paths';
import { langPaths } from '../../i18n/static';
import { ads } from '../../data/work';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const s = t(lang);
const k = c(lang);
const h = k.home;
const hx = h.hero;
const L = launch(lang);
// The headline: three lines, the last one on the pink marker. Its widest line, in ems of Inter at full weight
// (tools/title-ratio.mjs, 4 Nov 2026), lets the stylesheet set it as big as its column allows from the first frame.
const lines = h.scenes[0].d;
const last = lines[lines.length - 1].replace(/\.$/, '');
const said = lines.join(' ');
// Width ratios measured for Inter; Cabinet Grotesk is not measured yet, so these are set a little wide (smaller type)
// so no line is ever cut. Re-measure with the real font and tighten (step 5 review).
// Measured on the live preview with Archivo Extrabold (11 Nov 2026): 5.86 em for the widest English line.
const widest: Record<string, number> = { en: 6.0, fr: 4.6 };
const kw = widest[lang] ?? widest.en;
// The work: a short silent loop of each reel plays on its card; a click plays the full reel with sound, in place.
const clips = ads.slice(0, 4).map((a, i) => ({ i, src: a.clip ?? a.src!, full: a.src ?? a.clip!, poster: a.poster!, cap: a.angle[lang], fmt: a.format?.[lang] ?? '' }));
const pad = (n: number) => String(n).padStart(2, '0');
// Right under the prices, the questions a first-time client is really asking.
const faqs = [1, 10, 3, 5].map((i) => s.faq[i]);
const mute = '<path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" /><path class="off" d="M16 10l4 4M20 10l-4 4" /><path class="on" d="M15.5 9.5a3.5 3.5 0 0 1 0 5M17.8 7.2a7 7 0 0 1 0 9.6" />';
---
<Base lang={lang} page="home">
  <section class="hero" aria-labelledby="h-title">
    <div class="wrap wide h-in">
      <div class="h-copy">
        <h1 class="h-title" id="h-title" aria-label={said} style={`--kw:${kw}`}>
          {lines.map((line, i) => (
            <span class="ln" style={`--l:${i}`} aria-hidden="true">
              <span class="ln-in">{i === lines.length - 1 ? <><span class="mk">{last}</span>.</> : line}</span>
            </span>
          ))}
        </h1>
        <div class="h-foot">
          <p class="h-sub up" style="--d:420ms">{L.hero.line}</p>
          <div class="h-act up" style="--d:520ms">
            <a class="btn primary lg" href={href(lang, 'apply')}>{k.nav.apply} <span class="arr" aria-hidden="true">→</span></a>
            <a class="btn lg" href="#work">{s.hero.work}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="cut"><Bands lang={lang} /></div>

  <section class="work on-black" id="work" data-work data-dark="1" aria-labelledby="w-title">
    <div class="wrap wide w-in">
      <div class="w-head rv">
        <h2 class="w-title" id="w-title" tabindex="-1">{h.kicks.workTitle}</h2>
        <a class="btn" href={href(lang, 'work')}>{hx.cta} <span class="arr" aria-hidden="true">→</span></a>
      </div>
      <ol class="deck" data-deck>
        {clips.map((cl) => (
          <li class="card rv" style={`--d:${cl.i * 80}ms`}>
            <button type="button" class="c-media" data-cut={cl.i} data-full={cl.full} aria-pressed="false" aria-label={`${k.work.sound}: ${cl.cap}`} data-on={`${k.work.sound}: ${cl.cap}`} data-off={`${k.work.mute}: ${cl.cap}`}>
              <img src={cl.poster} alt="" width="540" height="960" loading="lazy" decoding="async" />
              <video muted playsinline loop preload="none" tabindex="-1" aria-hidden="true" data-src={cl.src}></video>
              <svg class="c-mute" viewBox="0 0 24 24" aria-hidden="true" set:html={mute} />
            </button>
            <p class="c-cap" aria-hidden="true"><b>{pad(cl.i + 1)}</b><span>{cl.cap}</span>{cl.fmt && <i>{cl.fmt}</i>}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <WhatWeDo lang={lang} />

  <PlansHome lang={lang} />

  <WorkspaceHome lang={lang} />

  <section class="section apply-sec" id="apply">
    <div class="wrap"><ApplyFlow lang={lang} /></div>
  </section>

  <section class="section faq-sec" id="faq">
    <div class="wrap faq-col">
      <h2 class="h1 faq-h rv">{h.faqTitle}</h2>
      <div class="rv"><Faq items={faqs} more={{ href: href(lang, 'faq'), label: L.faqAll }} /></div>
    </div>
  </section>

  <Strip tone="pink" items={[L.strip.next]} href={href(lang, 'apply')} label={L.strip.next} speed={60} rev />

  <ReelViewer lang={lang} />
</Base>

<script>
  import '../../scripts/marquee';
  // Selected work: the four reels play, silent and looping, while they're in view. Nothing plays before the page has
  // loaded, while a dialog or the menu is open, with reduced motion or with data saver on. A click on a reel turns its
  // sound on, in place, with the full cut; another click turns it off. Only one reel plays with sound at a time.
  const work = document.querySelector<HTMLElement>('[data-work]');
  if (work) {
    const deck = work.querySelector<HTMLElement>('[data-deck]')!;
    const cards = [...deck.querySelectorAll<HTMLElement>('.card')];
    const media = cards.map((el) => el.querySelector<HTMLButtonElement>('[data-cut]')!);
    const vids = media.map((m) => m.querySelector('video')!);
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const save = !!(navigator as any).connection?.saveData;
    const wanted = !still && !save;
    let ready = false, seen = false, blocked = false, loud = -1;
    const load = (v: HTMLVideoElement) => { if (!v.getAttribute('src')) { v.preload = 'auto'; v.src = v.dataset.src!; } };
    const go = () => {
      const on = ready && seen && !blocked && !document.hidden && wanted;
      vids.forEach((v, j) => { if (on || (j === loud && seen && !document.hidden && !blocked)) { load(v); v.play().catch(() => {}); } else v.pause(); });
    };
    vids.forEach((v, j) => v.addEventListener('playing', () => cards[j].classList.add('live')));
    const fade = (v: HTMLVideoElement, to: number, ms: number, then?: () => void) => {
      const from = v.volume, t0 = performance.now();
      const step = (t: number) => { const q = Math.min(1, (t - t0) / ms); v.volume = Math.min(1, Math.max(0, from + (to - from) * q)); if (q < 1) requestAnimationFrame(step); else then?.(); };
      requestAnimationFrame(step);
    };
    const quiet = (j: number) => {
      const v = vids[j];
      media[j].setAttribute('aria-pressed', 'false');
      media[j].setAttribute('aria-label', media[j].dataset.on!);
      cards[j].classList.remove('loud');
      fade(v, 0, 250, () => { v.muted = true; });
      if (loud === j) loud = -1;
    };
    const sound = (j: number) => {
      if (loud > -1 && loud !== j) quiet(loud);
      loud = j;
      const v = vids[j], m = media[j];
      m.setAttribute('aria-pressed', 'true');
      m.setAttribute('aria-label', m.dataset.off!);
      cards[j].classList.add('loud', 'live');
      // Everything happens inside the click itself, so phones (iPhone above all) allow the sound.
      if (v.getAttribute('src') !== m.dataset.full) { v.preload = 'auto'; v.src = m.dataset.full!; } else v.currentTime = 0;
      v.muted = false;
      v.volume = 0;
      v.play().then(() => fade(v, 1, 600)).catch(() => { v.muted = true; quiet(j); });
    };
    media.forEach((m, j) => m.addEventListener('click', () => (loud === j ? quiet(j) : sound(j))));
    new IntersectionObserver(([e]) => { seen = e.isIntersecting; go(); }, { threshold: 0.15 }).observe(deck);
    new MutationObserver(() => { blocked = document.documentElement.classList.contains('locked'); if (blocked && loud > -1) quiet(loud); go(); })
      .observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    document.addEventListener('visibilitychange', go);
    const start = () => { ready = true; go(); };
    const idle = () => ('requestIdleCallback' in window ? (window as any).requestIdleCallback(start, { timeout: 2000 }) : setTimeout(start, 600));
    if (document.readyState === 'complete') idle(); else addEventListener('load', idle, { once: true });
  }
</script>

<style>
  /* The first screen: the headline across the full width, then the line and the two ways in. Text only.
     The reels live in Selected work, just below. */
  .hero { display: flex; flex-direction: column; min-height: min(100svh, 1040px); background: var(--bg); }
  .h-in { flex: 1; display: grid; align-items: center;
    padding-top: calc(var(--header) + clamp(24px, 4vh, 56px)); padding-bottom: clamp(32px, 5vh, 64px); }
  .h-copy { container-type: inline-size; display: grid; gap: clamp(28px, 4.4vh, 56px); align-content: center; min-width: 0; }
  .h-foot { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px 48px; }
  .h-sub { margin: 0; max-width: 34rem; font-weight: 500; font-size: clamp(18px, 1.45vw, 22px); line-height: 1.4; text-wrap: pretty; }
  .h-title { display: grid; margin: 0; font-weight: 800; letter-spacing: -0.05em; line-height: .88;
    font-size: min(calc(100cqw / var(--kw) * .97), 210px, 21svh); }
  .ln { display: block; overflow: hidden; padding: .06em .08em .1em .04em; margin: -.06em 0 -.1em -.04em; }
  .ln-in { display: inline-block; animation: rise 1100ms cubic-bezier(.22, 1, .36, 1) both; animation-delay: calc(140ms + var(--l) * 110ms); }
  @keyframes rise { from { transform: translateY(110%); } }
  .mk { position: relative; z-index: 0; }
  .mk::after { content: ''; position: absolute; z-index: -1; left: -.06em; right: -.04em; top: .5em; bottom: .02em; background: var(--pink); transform-origin: 0 50%; animation: mark 800ms cubic-bezier(.65, 0, .35, 1) both 820ms; }
  @keyframes mark { from { transform: scaleX(0); } }
  /* The crossed strips sit on the cut between the white first screen and the black work section. */
  .cut { position: relative; background: linear-gradient(#fff 50%, #000 50%); }
  .cut :global(.bands) { padding-block: clamp(72px, 8.5vw, 128px); }
  .work { padding-top: clamp(8px, 1.5vw, 24px) !important; }
  .h-act { display: flex; flex-wrap: wrap; gap: 12px; }
  .up { animation: fade-up 1000ms cubic-bezier(.22, 1, .36, 1) both; animation-delay: var(--d); }
  @keyframes fade-up { from { opacity: 0; transform: translateY(16px); } }

  /* Phones and upright tablets: the line, the headline, the buttons, then the reel. */
  @media (max-width: 860px) {
    .hero { min-height: 0; }
    .h-in { grid-template-columns: minmax(0, 1fr); gap: 36px; padding-top: calc(var(--header) + 20px); padding-bottom: 40px; }
    .h-act .btn { flex: 1 1 auto; }
  }

  /* Selected work, on black: the title and a way to all the work, then the four reels side by side. */
  .work { padding-block: var(--section); }
  .w-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px 32px; flex-wrap: wrap; margin-bottom: clamp(28px, 3.6vw, 52px); }
  .w-title { margin: 0; font-weight: 800; font-size: clamp(48px, 7.4vw, 128px); line-height: .9; letter-spacing: -0.04em; outline: none; }
  .deck { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(10px, 1.2vw, 20px); margin: 0; padding: 0; list-style: none; }
  .card { position: relative; min-width: 0; }
  .c-media { position: relative; display: block; width: 100%; aspect-ratio: 9 / 16; margin: 0; padding: 0; border: 0; border-radius: 24px; overflow: hidden; background: #000; color: #fff; cursor: pointer; transition: transform 500ms var(--ease); }
  .c-media:hover { transform: translateY(-4px); }
  .c-media img, .c-media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .c-media video { opacity: 0; transition: opacity 600ms var(--ease); }
  .live .c-media video { opacity: 1; }
  .c-mute { position: absolute; z-index: 1; left: 50%; bottom: 12px; width: 44px; height: 44px; margin-left: -22px; padding: 11px; border-radius: 50%; background: #000; fill: none; stroke: #fff; stroke-width: 1.8;
    stroke-linecap: round; stroke-linejoin: round; transition: background 200ms var(--ease), transform 200ms var(--ease); }
  .c-mute :global(.on) { display: none; }
  .loud .c-mute :global(.on) { display: inline; }
  .loud .c-mute :global(.off) { display: none; }
  .c-media:hover .c-mute, .loud .c-mute { background: var(--pink); stroke: var(--ink); transform: scale(1.06); }
  .c-media:focus-visible { outline: 3px solid var(--pink); outline-offset: 3px; }
  .c-cap { display: flex; align-items: baseline; gap: 10px; margin: 0; padding-top: 14px; white-space: nowrap; font-size: 16px; font-weight: 700; letter-spacing: 0; color: #fff; }
  .c-cap b { flex: none; font-size: 13px; letter-spacing: .06em; font-variant-numeric: tabular-nums; color: #fff; }
  .c-cap span { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .c-cap i { flex: none; margin-left: auto; font-style: normal; font-size: 14px; font-weight: 500; }
  @media (max-width: 960px) {
    .deck { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 12px; }
    .c-cap { font-size: 15px; }
    .c-cap i { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ln-in, .up, .mk::after { animation: none; }
    .c-media:hover { transform: none; }
  }

  /* Questions: the title centred, the answers in one column under it. */
  .faq-col { display: grid; gap: clamp(32px, 4vw, 56px); max-width: 860px; }
  .faq-h { margin: 0; text-align: center; font-size: clamp(48px, 6.4vw, 104px); }
  .faq-col :global(.faq-more) { display: flex; width: fit-content; margin: 32px auto 0; }

</style>
