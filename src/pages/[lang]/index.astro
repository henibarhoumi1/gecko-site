---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import ApplyFlow from '../../components/ApplyFlow.astro';
import PlanPicker from '../../components/PlanPicker.astro';
import Workspace from '../../components/Workspace.astro';
import Bands from '../../components/Bands.astro';
import ReelCarousel from '../../components/ReelCarousel.astro';
import ReelViewer from '../../components/ReelViewer.astro';
import { t, type Locale } from '../../i18n/strings';
import { c } from '../../i18n/copy';
import { href } from '../../i18n/paths';
import { langPaths } from '../../i18n/static';
import { ads } from '../../data/work';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const s = t(lang);
const h = c(lang).home;
const sc = h.why.script;
---
<Base lang={lang} footerCta={false}>
  <section class="hero" data-hero>
    <div class="wrap wide h-grid">
      <div class="h-copy">
        <p class="h-kick up" style="--d:40ms"><span class="pulse" aria-hidden="true"></span>{h.kicker}</p>
        <h1 class="h-title" aria-label={h.title.join(' ')}>
          {h.title.map((line, i) => (
            <span class="ln" aria-hidden="true"><span class={`rise ${i === h.title.length - 1 ? 'hl' : ''}`} style={`--d:${100 + i * 110}ms`}>{line}</span></span>
          ))}
        </h1>
        <p class="text text-l h-lede up" style="--d:440ms">{h.sub}</p>
        <div class="actions up" style="--d:520ms">
          <a class="btn primary big-btn" href={href(lang, 'apply')}>{h.cta} <span class="arr" aria-hidden="true">→</span></a>
          <a class="btn big-btn" href="#plans">{h.ctaAlt}</a>
        </div>
      </div>

      <div class="h-art up" style="--d:260ms" aria-hidden="true">
        <span class="art-mat mat"></span>
        <div class="paper">
          <p class="p-top">{sc.title}</p>
          <ol class="p-list">{sc.scenes.map((x, i) => <li><b>{i + 1}</b>{x}</li>)}</ol>
          <span class="stamp">{sc.stamp} ✓</span>
        </div>
        <span class="stick"><small>{h.stick[0]}</small><b>{h.stick[1]}</b></span>
      </div>
    </div>
  </section>

  <div class="ticker" aria-hidden="true">
    <div class="track" data-marquee="45">
      {[0, 1, 2].map(() => <ul>{s.home.formats.map((f) => <li>{f}<svg viewBox="0 0 16 16"><path d="M8 1v14M1 8h14M3 3l10 10M13 3L3 13" /></svg></li>)}</ul>)}
    </div>
  </div>

  {ads.length > 0 && (
    <section class="on-black section work-sec" id="work">
      <h2 class="work-h rv"><span>{h.workTitle}</span></h2>
      <ReelCarousel ads={ads.slice(0, 4)} lang={lang} />
      <p class="work-more rv"><a class="link" href={href(lang, 'work')}>{h.workCta} <span aria-hidden="true">→</span></a></p>
    </section>
  )}

  <Workspace lang={lang} />

  <Bands lang={lang} />

  <section class="section apply-sec" id="apply">
    <div class="wrap"><ApplyFlow lang={lang} /></div>
  </section>

  <section class="section plans-sec" id="plans">
    <div class="wrap">
      <PlanPicker lang={lang} />
    </div>
  </section>

  <section class="section faq-sec" id="faq">
    <div class="wrap faq-grid">
      <div class="faq-lead rv">
        <h2 class="h1 faq-h">{h.faqTitle}</h2>
        <a class="btn" href={href(lang, 'faq')}>{h.faqAll} <span class="arr" aria-hidden="true">→</span></a>
      </div>
      <div class="rv"><Faq items={s.faq} scroll hint={h.faqHint} /></div>
    </div>
  </section>

  <ReelViewer lang={lang} />
</Base>

<script>
  import '../../scripts/marquee';
  // The mat, the script page and the sticker drift a few pixels with the pointer, each by a different amount.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero && matchMedia('(hover: hover) and (pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let x = 0, y = 0, queued = false;
    const paint = () => { queued = false; hero.style.setProperty('--mx', x.toFixed(3)); hero.style.setProperty('--my', y.toFixed(3)); };
    const ask = () => { if (!queued) { queued = true; requestAnimationFrame(paint); } };
    hero.addEventListener('pointermove', (e) => { const r = hero.getBoundingClientRect(); x = (e.clientX - r.left) / r.width - .5; y = (e.clientY - r.top) / r.height - .5; ask(); });
    hero.addEventListener('pointerleave', () => { x = 0; y = 0; ask(); });
  }
</script>

<style>
  /* Hero: the headline big on white, and beside it the studio's desk: a green cutting mat with an approved script
     page and a price sticker on it. Everything settles in once; after that only the pointer moves it, a little. */
  .hero { position: relative; overflow: hidden; --mx: 0; --my: 0; }
  .h-grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, .7fr); gap: clamp(28px, 5vw, 88px); align-items: center;
    min-height: calc(100svh - 58px); padding-top: calc(var(--header) + clamp(20px, 4vh, 48px)); padding-bottom: clamp(40px, 7vh, 80px); }
  .h-copy { display: grid; gap: clamp(22px, 2.6vw, 34px); justify-items: start; container-type: inline-size; min-width: 0; }
  .h-kick { display: inline-flex; align-items: center; gap: 10px; margin: 0; padding: 7px 14px 7px 10px; border: 1px solid var(--ink); border-radius: 999px; font-weight: 700; font-size: 13px; letter-spacing: .02em; }
  .pulse { position: relative; width: 9px; height: 9px; border-radius: 50%; background: var(--mat); }
  .pulse::after { content: ''; position: absolute; inset: -5px; border-radius: 50%; border: 2px solid var(--mat); opacity: 0; animation: ping 2.4s var(--ease) infinite; }
  @keyframes ping { 0% { transform: scale(.5); opacity: .6; } 100% { transform: scale(1.3); opacity: 0; } }

  .h-title { margin: 0; font-weight: 700; font-size: min(clamp(52px, 8.4vw, 150px), 15.4cqi); line-height: .9; letter-spacing: -0.06em; }
  :global(html[lang='fr']) .h-title { font-size: min(clamp(50px, 8.4vw, 150px), 14.6cqi); }
  .ln { display: block; overflow: hidden; padding: .02em .1em .14em 0; margin-bottom: -.08em; width: fit-content; white-space: nowrap; }
  .ln > span { display: inline-block; }
  .hl { position: relative; isolation: isolate; padding: 0 .1em; margin-left: -.1em; }
  .hl::before { content: ''; position: absolute; inset: .2em 0 -.02em; z-index: -1; border-radius: .12em; background: var(--pink); transform-origin: left; animation: wipe 800ms 900ms var(--ease) both; }
  @keyframes wipe { from { transform: scaleX(0); } }
  .rise { animation: rise 1000ms cubic-bezier(.22, 1, .36, 1) both; animation-delay: var(--d); }
  @keyframes rise { from { transform: translateY(105%); } }
  .up { animation: fade-up 900ms cubic-bezier(.22, 1, .36, 1) both; animation-delay: var(--d); }
  @keyframes fade-up { from { opacity: 0; transform: translateY(18px); } }
  .h-lede { margin: 0; max-width: 34rem; color: var(--fg-2); }
  .big-btn { padding: 17px 26px; font-size: 16px; }

  /* The desk. */
  .h-art { position: relative; height: clamp(440px, 40vw, 620px); }
  .art-mat { position: absolute; inset: 0 0 4% 10%; border-radius: 24px; box-shadow: var(--lift-l); transform: rotate(-3deg) translate(calc(var(--mx) * -10px), calc(var(--my) * -8px)); transition: transform 900ms var(--ease); }
  .paper { position: absolute; left: 0; top: 13%; width: 72%; padding: clamp(18px, 1.8vw, 26px) clamp(18px, 1.8vw, 26px) clamp(26px, 2.6vw, 38px); background: var(--white); color: var(--ink); border: 1px solid var(--ink); border-radius: 16px; box-shadow: var(--lift-l);
    transform: rotate(2.5deg) translate(calc(var(--mx) * 14px), calc(var(--my) * 10px)); transition: transform 900ms var(--ease); }
  .p-top { margin: 0 0 10px; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--fg-3); }
  .p-list { list-style: none; margin: 0; padding: 0; }
  .p-list li { display: grid; grid-template-columns: 24px 1fr; align-items: baseline; gap: 8px; padding: 11px 0; border-top: 1px solid var(--hair); font-weight: 600; font-size: clamp(14px, 1.15vw, 17px); letter-spacing: -0.01em; }
  .p-list b { font-size: 12px; color: var(--fg-3); }
  .stamp { position: absolute; right: 16px; bottom: -14px; padding: 7px 12px; border: 2px solid var(--mat); border-radius: 8px; background: var(--white); color: var(--mat); font-weight: 700; font-size: 13px; letter-spacing: .08em; text-transform: uppercase; transform: rotate(-7deg); animation: stamp 500ms 1300ms cubic-bezier(.3, 1.6, .5, 1) both; }
  @keyframes stamp { from { opacity: 0; transform: rotate(-7deg) scale(1.6); } }
  .stick { position: absolute; right: 3%; bottom: 0; width: clamp(112px, 9vw, 144px); aspect-ratio: 1; border-radius: 50%; display: grid; place-content: center; gap: 2px; text-align: center; background: var(--yellow); color: var(--ink); border: 1px solid var(--ink); box-shadow: var(--lift);
    transform: rotate(-10deg) translate(calc(var(--mx) * 22px), calc(var(--my) * 16px)); transition: transform 900ms var(--ease); }
  .stick small { font-size: 12px; font-weight: 700; }
  .stick b { font-size: clamp(20px, 1.8vw, 27px); letter-spacing: -0.04em; line-height: 1; }

  @media (max-width: 960px) {
    .h-grid { grid-template-columns: 1fr; min-height: 0; gap: 36px; }
    .h-art { height: clamp(340px, 86vw, 470px); width: min(100%, 520px); justify-self: center; }
  }
  @media (max-width: 560px) {
    .big-btn { padding: 15px 20px; font-size: 15px; } .h-copy .actions { width: 100%; } .h-copy .actions .btn { flex: 1 1 auto; }
    .h-art { height: 350px; } .art-mat { inset: 0 0 6% 12%; }
    .paper { top: 9%; width: 80%; padding: 16px 16px 24px; } .p-list li { padding: 8px 0; font-size: 14px; }
    .stick { width: 96px; } .stick b { font-size: 19px; } .stick small { font-size: 11px; }
  }
  @media (prefers-reduced-motion: reduce) { .rise, .up, .hl::before, .pulse::after, .stamp { animation: none; } }

  /* The formats we make, running in a band under the hero. */
  .ticker { overflow: hidden; padding-block: 18px; background: var(--ink); color: #fff; }
  .ticker .track { display: flex; width: max-content; will-change: transform; }
  .ticker ul { display: flex; list-style: none; margin: 0; padding: 0; }
  .ticker li { display: flex; align-items: center; gap: 30px; white-space: nowrap; font-weight: 600; font-size: 16px; letter-spacing: -0.005em; padding-right: 30px; }
  .ticker svg { width: 13px; height: 13px; fill: none; stroke: var(--pink); stroke-width: 1.6; stroke-linecap: round; }

  /* Work: the word set huge across the page, fading as it goes down, and the reels standing in front of it. */
  .work-sec { position: relative; overflow-x: clip; padding-top: clamp(80px, 10vw, 150px); }
  .work-h { position: relative; z-index: 1; margin: 0 0 -.3em; text-align: center; font-weight: 700; font-size: min(26vw, 420px); line-height: .8; letter-spacing: -0.075em; white-space: nowrap; }
  .work-h span { display: inline-block; padding: 0 .08em .06em 0; background: linear-gradient(180deg, #fff 34%, rgba(255, 255, 255, .14) 92%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  :global(html[lang='fr']) .work-h { font-size: min(13.2vw, 220px); margin-bottom: -.24em; }
  .work-more { margin: clamp(18px, 2vw, 26px) 0 0; text-align: center; }
  .work-more .link { color: var(--fg-2); font-size: 15px; transition: color 200ms var(--ease); }
  .work-more .link:hover { color: var(--fg); }

  .faq-grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .faq-lead { display: grid; gap: clamp(20px, 2.6vw, 34px); justify-items: start; position: sticky; top: 120px; }
  .faq-h { font-size: clamp(48px, 6.4vw, 104px); max-width: 8ch; }
  @media (max-width: 860px) { .faq-grid { grid-template-columns: 1fr; } .faq-lead { position: static; } }

  .apply-sec { border-top: 1px solid var(--hair); }

</style>
