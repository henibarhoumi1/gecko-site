---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import ApplyFlow from '../../components/ApplyFlow.astro';
import PlanPicker from '../../components/PlanPicker.astro';
import Workspace from '../../components/Workspace.astro';
import Bands from '../../components/Bands.astro';
import ReelViewer from '../../components/ReelViewer.astro';
import { t, type Locale } from '../../i18n/strings';
import { c } from '../../i18n/copy';
import { href } from '../../i18n/paths';
import { langPaths } from '../../i18n/static';
import { ads } from '../../data/work';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const s = t(lang);
const h = c(lang).home;
const mo = h.monitor;
const w = c(lang).work;
// The hero monitor plays a short silent cut of each case study reel; a click opens the full reel with sound.
const clips = ads.map((a, i) => {
  const slug = a.src!.replace(/^.*glucelia-|\.mp4$/g, '');
  return { i, src: `/work/clip-${slug}.mp4`, poster: a.poster!, brand: a.brand, cap: a.angle[lang] };
});
---
<Base lang={lang} footerCta={false} page="home">
  <section class="hero" data-hero>
    <div class="pin" data-pin>
      <div class="dark" aria-hidden="true"></div>
      <div class="wrap wide h-grid">
        <div class="h-copy">
          <p class="h-kick up" style="--d:40ms"><span class="pulse" aria-hidden="true"></span>{h.kicker}</p>
          <h1 class="h-title" aria-label={h.title.join(' ')}>
            {h.title.map((line, i) => (
              <span class="ln" aria-hidden="true">
                {i < h.title.length - 1 ? (
                  <span class="rise" style={`--d:${100 + i * 110}ms`}>{line}</span>
                ) : (
                  <span class="rise fill" style={`--d:${100 + i * 110}ms`}>
                    <span class="fill-v"><video data-fill src="/work/hero-twice.mp4" poster="/work/hero-twice.jpg" muted loop playsinline preload="none" tabindex="-1"></video></span>
                    <span class="fill-t">{line}</span>
                    <span class="fill-o">{line}</span>
                    <span class="replay" data-replay><svg viewBox="0 0 24 24"><path d="M20 12a8 8 0 1 1-2.6-5.9M20 4v4.6h-4.6" /></svg></span>
                  </span>
                )}
              </span>
            ))}
          </h1>
          <p class="text text-l h-lede up" style="--d:440ms">{h.sub}</p>
          <div class="actions up" style="--d:520ms">
            <a class="btn primary big-btn" href={href(lang, 'apply')}>{h.cta} <span class="arr" aria-hidden="true">→</span></a>
            <a class="btn big-btn" href="#plans">{h.ctaAlt}</a>
          </div>
        </div>

        <div class="slot" data-slot>
          <div class="monitor" data-monitor role="group" aria-label={mo.label} data-clips={JSON.stringify(clips)}>
            <div class="m-frame">
              <div class="m-screen" data-screen>
                <img class="poster" src={clips[0].poster} alt="" width="540" height="960" fetchpriority="high" decoding="async" />
                <video class="v" data-v muted playsinline preload="none" tabindex="-1" aria-hidden="true"></video>
                <video class="v" data-v muted playsinline preload="none" tabindex="-1" aria-hidden="true"></video>
                <span class="shade" aria-hidden="true"></span>
                <span class="cur" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M5 3.2v9.6L13 8z" /></svg></span>
                <div class="bars" aria-hidden="true">{clips.map(() => <i><b></b></i>)}</div>
                <div class="m-top">
                  <p class="m-cap" aria-live="off"><small>{clips[0].brand} · <span data-count>01/{String(clips.length).padStart(2, '0')}</span></small><span data-cap>{clips[0].cap}</span></p>
                  <button type="button" class="ctl" data-toggle aria-pressed="false" aria-label={mo.pause} data-pause={mo.pause} data-play={mo.play}>
                    <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3h2v10H5zM9 3h2v10H9z" /></svg>
                    <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.2v9.6L13 8z" /></svg>
                  </button>
                </div>
                <button type="button" class="snd" data-sound>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" /><path class="w1" d="M15.5 9a4 4 0 0 1 0 6" /><path class="w2" d="M18 6.5a7.5 7.5 0 0 1 0 11" /></svg>
                  <span>{mo.sound}</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="credits on-black" data-credits>
        <div class="cr-l">
          <p class="cr-k">{mo.kick}</p>
          <h2 class="cr-h">{w.client}</h2>
          <p class="cr-line">{mo.line}</p>
          <a class="btn primary cr-cta" href={href(lang, 'work')}>{mo.cta} <span class="arr" aria-hidden="true">→</span></a>
        </div>
        <div class="cr-r">
          <p class="cr-k" id="picks-h">{mo.list}</p>
          <ol class="picks" aria-labelledby="picks-h">
            {clips.map((cl, i) => (
              <li><button type="button" data-pick={i} aria-current={i === 0 ? 'true' : undefined}><span class="pn">{String(i + 1).padStart(2, '0')}</span><span class="pt">{cl.cap}</span><i aria-hidden="true"><b></b></i></button></li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <div class="ticker" aria-hidden="true">
    <div class="track" data-marquee="45">
      {[0, 1, 2].map(() => <ul>{s.home.formats.map((f) => <li>{f}<svg viewBox="0 0 16 16"><path d="M8 1v14M1 8h14M3 3l10 10M13 3L3 13" /></svg></li>)}</ul>)}
    </div>
  </div>

  <Workspace lang={lang} />

  <Bands lang={lang} />

  <section class="section apply-sec" id="apply">
    <div class="wrap"><ApplyFlow lang={lang} /></div>
  </section>

  <section class="section plans-sec" id="plans">
    <div class="wrap">
      <PlanPicker lang={lang} />
    </div>
  </section>

  <section class="section faq-sec" id="faq">
    <div class="wrap faq-grid">
      <div class="faq-lead rv">
        <h2 class="h1 faq-h">{h.faqTitle}</h2>
      </div>
      <div class="rv"><Faq items={s.faq} limit={6} more={{ href: href(lang, 'faq'), label: h.faqAll }} /></div>
    </div>
  </section>

  <ReelViewer lang={lang} />
</Base>

<script>
  import '../../scripts/marquee';
  // The hero reel: short silent cuts of the case study reels play one after the other, with a progress bar per reel.
  // Two video elements take turns, so the next reel is loaded before it's needed and the cut is clean. Nothing plays
  // until the page has loaded, while the reel is off screen, while a dialog or the menu is open, with reduced motion
  // or with data saver on. "Watch with sound" opens the full reel.
  // Lights down: as the page scrolls, the reel moves to the middle and grows to the full height of the screen while a
  // black circle opens behind it and the headline steps back. On black, the case study and its four reels come up on
  // either side: the hero is the home page's Work section.
  // On a wide screen the hero holds still (sticky) while this plays; on a phone it happens as the reel scrolls up.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const mon = document.querySelector<HTMLElement>('[data-monitor]');
  if (hero && mon) {
    type Clip = { i: number; src: string; poster: string; brand: string; cap: string };
    const clips: Clip[] = JSON.parse(mon.dataset.clips!);
    const vids = [...mon.querySelectorAll<HTMLVideoElement>('[data-v]')];
    const bars = [...mon.querySelectorAll<HTMLElement>('.bars b')];
    const cap = mon.querySelector<HTMLElement>('[data-cap]')!;
    const count = mon.querySelector<HTMLElement>('[data-count]')!;
    const toggle = mon.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const sound = mon.querySelector<HTMLButtonElement>('[data-sound]')!;
    const screen = mon.querySelector<HTMLElement>('[data-screen]')!;
    const fill = hero.querySelector<HTMLVideoElement>('[data-fill]');
    const replay = hero.querySelector<HTMLElement>('[data-replay]');
    const credits = hero.querySelector<HTMLElement>('[data-credits]')!;
    const picks = [...credits.querySelectorAll<HTMLButtonElement>('[data-pick]')];
    const pbars = picks.map((b) => b.querySelector<HTMLElement>('b')!);
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const save = !!(navigator as any).connection?.saveData;
    const pad = (n: number) => String(n).padStart(2, '0');
    let k = 0, cur = 0, wanted = !still && !save, ready = false, seen = false, blocked = false, raf = 0;

    const load = (v: HTMLVideoElement, n: number) => {
      if (v.dataset.clip === String(n)) return;
      v.dataset.clip = String(n); v.preload = 'auto'; v.poster = clips[n].poster; v.src = clips[n].src; v.load();
    };
    const label = () => {
      cap.textContent = clips[k].cap; count.textContent = `${pad(k + 1)}/${pad(clips.length)}`;
      bars.forEach((b, j) => (b.style.transform = `scaleX(${j < k ? 1 : 0})`));
      picks.forEach((b, j) => (j === k ? b.setAttribute('aria-current', 'true') : b.removeAttribute('aria-current')));
      pbars.forEach((b) => (b.style.transform = 'scaleX(0)'));
    };
    const frame = () => {
      const v = vids[cur];
      bars[k].style.transform = pbars[k].style.transform = `scaleX(${v.duration ? Math.min(1, v.currentTime / v.duration) : 0})`;
      raf = requestAnimationFrame(frame);
    };
    const stop = () => { vids.forEach((v) => v.pause()); fill?.pause(); cancelAnimationFrame(raf); raf = 0; hero.classList.remove('playing'); };
    const go = () => {
      if (!ready || !seen || blocked || document.hidden || !wanted) return stop();
      const v = vids[cur];
      load(v, k);
      v.play().then(() => {
        hero.classList.add('live', 'playing');
        if (!raf) raf = requestAnimationFrame(frame);
        load(vids[1 - cur], (k + 1) % clips.length);
      }).catch(() => {});
      if (fill) { fill.preload = 'auto'; fill.play().catch(() => {}); }
    };
    vids.forEach((v, j) => v.addEventListener('ended', () => {
      if (j !== cur) return;
      k = (k + 1) % clips.length; cur = 1 - cur;
      const next = vids[cur];
      load(next, k); next.currentTime = 0;
      next.classList.add('on'); v.classList.remove('on');
      label(); go();
    }));
    vids[0].classList.add('on');
    // The replay mark next to "twice." turns once each time the clip inside the word starts over.
    if (fill && replay) {
      let last = 0;
      fill.addEventListener('timeupdate', () => {
        if (fill.currentTime < last) { replay.classList.remove('spin'); void replay.offsetWidth; replay.classList.add('spin'); }
        last = fill.currentTime;
      });
    }
    toggle.addEventListener('click', () => {
      wanted = !wanted;
      toggle.setAttribute('aria-pressed', String(!wanted));
      toggle.setAttribute('aria-label', wanted ? toggle.dataset.pause! : toggle.dataset.play!);
      hero.classList.toggle('held', !wanted);
      go();
    });
    // From the screen the player grows out of the picture; from the list it simply fades in.
    const open = (n = k, from: HTMLElement = sound, grow: HTMLElement | null = screen) => document.dispatchEvent(new CustomEvent('reel:play', { detail: { i: clips[n].i, from, grow } }));
    sound.addEventListener('click', () => open());
    screen.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('button')) open(); });
    // The list of reels beside the big screen: a click cuts to that reel. On a phone, or without the lights-down scene,
    // the list sits under the reel rather than beside it, so a click opens the reel full screen instead.
    picks.forEach((b, n) => b.addEventListener('click', () => {
      if (!hero.classList.contains('cine')) return open(n, b, null);
      if (n === k) return;
      const old = vids[cur], next = vids[1 - cur];
      old.pause();
      k = n; cur = 1 - cur;
      load(next, k); next.currentTime = 0;
      next.classList.add('on'); old.classList.remove('on');
      label(); go();
    }));
    new IntersectionObserver(([e]) => { seen = e.isIntersecting; go(); }, { threshold: 0.25 }).observe(mon);
    new MutationObserver(() => { blocked = document.documentElement.classList.contains('locked'); go(); })
      .observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    document.addEventListener('visibilitychange', go);
    const start = () => { ready = true; go(); };
    const idle = () => ('requestIdleCallback' in window ? (window as any).requestIdleCallback(start, { timeout: 1500 }) : setTimeout(start, 400));
    if (document.readyState === 'complete') idle(); else addEventListener('load', idle, { once: true });
    if (!wanted) { hero.classList.add('held'); toggle.setAttribute('aria-pressed', 'true'); toggle.setAttribute('aria-label', toggle.dataset.play!); }

    // With a mouse, a play badge follows the pointer over the picture.
    if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
      screen.addEventListener('pointermove', (e) => {
        const r = screen.getBoundingClientRect();
        screen.style.setProperty('--cx', `${(e.clientX - r.left) / r.width * 100}%`); screen.style.setProperty('--cy', `${(e.clientY - r.top) / r.height * 100}%`);
        screen.classList.toggle('hover', !(e.target as HTMLElement).closest('button'));
      });
      screen.addEventListener('pointerleave', () => screen.classList.remove('hover'));
    }

    // Lights down.
    if (!still) {
      const wide = matchMedia('(min-width: 961px)');
      const slot = hero.querySelector<HTMLElement>('[data-slot]')!;
      const clamp = (x: number) => Math.min(1, Math.max(0, x));
      const ease = (x: number) => (x < .5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
      const band = (x: number, a: number, b: number) => clamp((x - a) / (b - a));
      const pin = hero.querySelector<HTMLElement>('[data-pin]')!;
      const dark = hero.querySelector<HTMLElement>('.dark')!;
      let box = { x: 0, y: 0, w: 1, h: 1 }, queued = false;
      hero.classList.add('anim');
      const measure = () => {
        hero.classList.toggle('cine', wide.matches);
        // The slot is never transformed and the reel sits in its middle, so it gives the reel's resting place.
        const r = slot.getBoundingClientRect(), pr = pin.getBoundingClientRect();
        box = { x: r.left + r.width / 2 - pr.left, y: r.top + r.height / 2 - pr.top, w: mon.offsetWidth, h: mon.offsetHeight };
        paint();
      };
      const paint = () => {
        queued = false;
        const vh = innerHeight, r = hero.getBoundingClientRect();
        let p: number;
        if (wide.matches) p = clamp(-r.top / Math.max(1, r.height - vh));
        else { const s = slot.getBoundingClientRect(); p = scrollY <= 0 ? 0 : clamp((vh * .8 - s.top) / (vh * .6)); }
        const e = ease(band(p, 0, wide.matches ? .62 : 1));
        hero.style.setProperty('--p', p.toFixed(4));
        // The circle opens from the reel's middle, wherever the reel is at this point of the scroll.
        const m = mon.getBoundingClientRect(), pr = pin.getBoundingClientRect();
        const cx = m.left + m.width / 2 - pr.left, cy = m.top + m.height / 2 - pr.top;
        const far = Math.hypot(Math.max(cx, pr.width - cx), Math.max(cy, pr.height - cy));
        const d = ease(band(p, wide.matches ? .04 : .1, wide.matches ? .56 : .85));
        dark.style.clipPath = `circle(${(d * far).toFixed(1)}px at ${cx.toFixed(1)}px ${cy.toFixed(1)}px)`;
        const fade = wide.matches ? band(p, .06, .42) : band(p, .15, .6);
        hero.style.setProperty('--fade', fade.toFixed(3));
        const cr = band(p, .62, .9);
        hero.style.setProperty('--cred', cr.toFixed(3));
        hero.classList.toggle('cut', cr > .5);
        hero.classList.toggle('gone', fade >= .99);
        if (wide.matches) {
          // From where the reel stands beside the headline to the middle of the screen, as tall as the screen allows.
          const target = Math.min(vh - 112, innerWidth * .9 * 16 / 9);
          const s = 1 + (target / box.h - 1) * e;
          const dx = (innerWidth / 2 - box.x) * e, dy = (vh / 2 + 6 - box.y) * e;
          mon.style.transform = `translate(${dx.toFixed(1)}px, ${dy.toFixed(1)}px) scale(${s.toFixed(4)}) rotate(${(3 * (1 - e)).toFixed(2)}deg)`;
        } else {
          mon.style.transform = `scale(${(.9 + .1 * e).toFixed(4)})`;
        }
      };
      const ask = () => { if (!queued) { queued = true; requestAnimationFrame(paint); } };
      // Tabbing into the list before the lights are down jumps the scroll to where it shows.
      credits.addEventListener('focusin', () => {
        if (!wide.matches || hero.classList.contains('cut')) return;
        const y = scrollY + hero.getBoundingClientRect().top + .9 * (hero.offsetHeight - innerHeight);
        const l = (window as any).lenis; l ? l.scrollTo(y, { immediate: true, force: true }) : scrollTo(0, y);
        paint();
      });
      addEventListener('scroll', ask, { passive: true });
      addEventListener('resize', () => requestAnimationFrame(measure));
      wide.addEventListener('change', measure);
      measure();
      addEventListener('load', measure, { once: true });
    }
  }
</script>

<style>
  /* Hero: the headline big on white, the last word filled with moving footage, and beside it a reel playing on a phone
     in front of a pink disc. As the page scrolls, the lights go down: the reel takes the middle of the screen. */
  .hero { position: relative; --p: 0; --dark: 0; --fade: 0; --cred: 0; }
  .hero.cine { height: 230svh; }
  .pin { position: relative; isolation: isolate; }
  .cine .pin { position: sticky; top: 0; height: 100svh; overflow: hidden; }
  /* The lights going down: a black circle opening from behind the reel until it covers the screen. */
  .dark { position: absolute; inset: 0; z-index: 1; background: #000; clip-path: circle(0 at 75% 50%); pointer-events: none; }
  .h-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1.18fr) minmax(0, .82fr); gap: clamp(28px, 4vw, 72px); align-items: center;
    min-height: calc(100svh - 58px); padding-top: calc(var(--header) + clamp(16px, 3vh, 40px)); padding-bottom: clamp(36px, 6vh, 72px); }
  .cine .h-grid { min-height: 100svh; }
  .h-copy { display: grid; gap: clamp(22px, 2.6vw, 34px); justify-items: start; container-type: inline-size; min-width: 0;
    opacity: calc(1 - var(--fade)); transform: translateY(calc(var(--fade) * -48px)); }
  .gone .h-copy { visibility: hidden; }
  .h-kick { display: inline-flex; align-items: center; gap: 10px; margin: 0; padding: 7px 14px 7px 10px; border: 1px solid var(--ink); border-radius: 999px; font-weight: 700; font-size: 13px; letter-spacing: .02em; }
  .pulse { position: relative; width: 9px; height: 9px; border-radius: 50%; background: var(--mat); }
  .pulse::after { content: ''; position: absolute; inset: -5px; border-radius: 50%; border: 2px solid var(--mat); opacity: 0; animation: ping 2.4s var(--ease) infinite; }
  @keyframes ping { 0% { transform: scale(.5); opacity: .6; } 100% { transform: scale(1.3); opacity: 0; } }

  .h-title { margin: 0; font-weight: 700; font-size: min(clamp(52px, 8.6vw, 156px), 15.4cqi); line-height: .9; letter-spacing: -0.06em; }
  :global(html[lang='fr']) .h-title { font-size: min(clamp(50px, 8.6vw, 156px), 14.6cqi); }
  .ln { display: block; overflow: hidden; padding: .02em .1em .14em 0; margin-bottom: -.08em; width: fit-content; white-space: nowrap; }
  .ln > span { display: inline-block; }
  .rise { animation: rise 1000ms cubic-bezier(.22, 1, .36, 1) both; animation-delay: var(--d); }
  @keyframes rise { from { transform: translateY(105%); } }
  .up { animation: fade-up 900ms cubic-bezier(.22, 1, .36, 1) both; animation-delay: var(--d); }
  @keyframes fade-up { from { opacity: 0; transform: translateY(18px); } }

  /* The last word: white paper with the letters cut out, footage running behind it (screen blending turns black into
     whatever is underneath), and an ink outline so the letters always read. */
  .fill { position: relative; isolation: isolate; padding-right: .5em; }
  .fill-v { position: absolute; z-index: 0; left: 0; right: .5em; top: .1em; bottom: .02em; overflow: hidden; background: var(--ink); }
  .fill-v video { width: 100%; height: 100%; object-fit: cover; filter: saturate(1.4) contrast(1.15) brightness(.7); }
  .fill-t { position: relative; z-index: 1; display: inline-block; background: #fff; color: #000; mix-blend-mode: screen; }
  .fill-o { position: absolute; z-index: 2; left: 0; top: 0; color: transparent; -webkit-text-stroke: max(1px, .01em) var(--ink); pointer-events: none; }
  .replay { position: absolute; z-index: 2; right: .02em; top: .2em; width: .36em; aspect-ratio: 1; border-radius: 50%; background: var(--pink); border: max(1px, .012em) solid var(--ink); display: grid; place-items: center;
    animation: pop 700ms 1100ms cubic-bezier(.3, 1.6, .5, 1) both; }
  .replay svg { width: 58%; height: 58%; fill: none; stroke: var(--ink); stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .replay.spin svg { animation: spin 900ms cubic-bezier(.65, 0, .35, 1); }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes pop { from { opacity: 0; transform: scale(.3) rotate(-90deg); } }
  .h-lede { margin: 0; max-width: 34rem; color: var(--fg-2); }
  .big-btn { padding: 17px 26px; font-size: 16px; }

  /* Where the reel stands: a pink disc behind it, which fades as the lights go down. */
  .slot { position: relative; display: grid; place-items: center; height: clamp(520px, 74svh, 740px); }
  .slot::before { content: ''; position: absolute; left: 50%; top: 50%; width: 92%; max-width: 72svh; aspect-ratio: 1; border-radius: 50%; background: var(--pink); translate: -46% -50%;
    opacity: calc(1 - var(--fade)); scale: calc(1 - var(--fade) * .25); animation: disc 1200ms 150ms cubic-bezier(.16, 1, .3, 1) both; }
  @keyframes disc { from { scale: .6; opacity: 0; } }

  /* The phone: a black frame, the reel inside, story bars and the caption on top, "Watch with sound" at the bottom. */
  .monitor { position: relative; z-index: 2; height: 100%; aspect-ratio: 9 / 16; transform: rotate(3deg); transform-origin: 50% 50%;
    animation: stand 1300ms 320ms cubic-bezier(.16, 1, .3, 1) both; }
  @keyframes stand { from { opacity: 0; translate: 0 12svh; scale: .92; } 40% { opacity: 1; } }
  .m-frame { position: relative; height: 100%; padding: 9px; border-radius: 34px; background: #0B0B0B; border: 1px solid #2A2A2A;
    box-shadow: 0 1px 0 rgba(255, 255, 255, .08) inset, 0 30px 60px -24px rgba(0, 0, 0, .5), 0 70px 120px -50px rgba(0, 0, 0, .45); }
  .m-screen { position: relative; height: 100%; overflow: hidden; border-radius: 26px; background: #1a1a1a; cursor: pointer; isolation: isolate; }
  .poster, .v { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .v { opacity: 0; transition: opacity 280ms var(--ease); }
  .live .v.on { opacity: 1; }
  .cur { position: absolute; z-index: 3; left: var(--cx, 50%); top: var(--cy, 50%); width: 64px; height: 64px; margin: -32px 0 0 -32px; border-radius: 50%; display: grid; place-items: center; background: var(--pink); color: var(--ink);
