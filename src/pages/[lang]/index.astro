---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import ApplyFlow from '../../components/ApplyFlow.astro';
import Bands from '../../components/Bands.astro';
import Strip from '../../components/Strip.astro';
import SolutionsHome from '../../components/SolutionsHome.astro';
import ClientPortal from '../../components/ClientPortal.astro';
import { launch } from '../../i18n/launch';
import { t, type Locale } from '../../i18n/strings';
import { c } from '../../i18n/copy';
import { href } from '../../i18n/paths';
import { langPaths } from '../../i18n/static';
import { test, monthly, fmt } from '../../data/offers';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const s = t(lang);
const k = c(lang);
const h = k.home;
const hx = h.hero;
const L = launch(lang);
// The headline: three lines, the last one on the pink marker. Its widest line, in ems of Archivo at the headline's
// weight and width, lets the stylesheet set it as big as its column allows from the first frame.
const lines = h.scenes[0].d;
const last = lines[lines.length - 1].replace(/\.$/, '');
const said = lines.join(' ');
// The line under it: its first sentence in bold, the rest in regular weight (still black).
const [subA, ...subB] = L.hero.line.split(/(?<=\.)\s+/);
// Measured with Archivo Extrabold at 92% width (11 Nov 2026): 5.86 em for the widest English line, set a little wide
// so no line is ever cut.
const widest: Record<string, number> = { en: 6.0, fr: 4.6 };
const kw = widest[lang] ?? widest.en;
// Pricing lives on its own page (Heni, 21 Nov): home keeps one yellow band with the way in and the monthly floor.
const P = lang === 'fr'
  ? { k: 'Tarifs', t: 'Essayez-nous d’abord.', d: `Le Test\u00a0: 3 reels et 1 visuel d’un seul tournage, ${fmt(test.launch!, lang)} TND. Ensuite, des plans mensuels dès ${fmt(monthly[0].launch!, lang)} TND. Tout le reste, sur devis.`, a: 'Voir les tarifs', b: 'Commencer par le Test' }
  : { k: 'Pricing', t: 'Try us first.', d: `The Test: 3 reels and 1 static from one shoot, ${fmt(test.launch!, lang)} TND. Then monthly plans from ${fmt(monthly[0].launch!, lang)} TND. Everything else, quoted from your brief.`, a: 'See pricing', b: 'Start with the Test' };
// Right under the prices, the questions a first-time client is really asking.
const faqs = [1, 10, 3, 5].map((i) => s.faq[i]);
---
<Base lang={lang} page="home">
  <section class="hero" aria-labelledby="h-title">
    <div class="wrap wide h-in">
      <h1 class="h-title" id="h-title" aria-label={said} style={`--kw:${kw}`}>
        {lines.map((line, i) => (
          <span class="ln" style={`--l:${i}`} aria-hidden="true">
            <span class="ln-in">{i === lines.length - 1 ? <><span class="mk">{last}</span>.</> : line}</span>
          </span>
        ))}
      </h1>
      <div class="h-foot">
        <p class="h-sub up" style="--d:420ms"><strong>{subA}</strong> {subB.join(' ')}</p>
        <div class="h-act up" style="--d:520ms">
          <a class="btn primary lg" href={href(lang, 'apply')}>{k.nav.apply} <span class="arr" aria-hidden="true">→</span></a>
          <a class="btn lg" href={href(lang, 'work')}>{s.hero.work}</a>
        </div>
      </div>
    </div>
  </section>

  <div class="cut"><Bands lang={lang} /></div>

  <SolutionsHome lang={lang} />

  <section class="section price-sec" id="pricing" aria-labelledby="pr-t">
    <div class="wrap wide">
      <div class="pr rv">
        <div class="pr-l">
          <p class="pr-k">{P.k}</p>
          <h2 class="pr-t" id="pr-t">{P.t}</h2>
          <p class="pr-d">{P.d}</p>
        </div>
        <div class="pr-r">
          <a class="btn primary lg" href={href(lang, 'pricing')}>{P.a} <span class="arr" aria-hidden="true">→</span></a>
          <a class="btn lg" href={`${href(lang, 'apply')}?plan=test`}>{P.b}</a>
        </div>
      </div>
    </div>
  </section>

  <ClientPortal lang={lang} />

  <section class="section apply-sec" id="apply">
    <div class="wrap"><ApplyFlow lang={lang} /></div>
  </section>

  <section class="section faq-sec" id="faq">
    <div class="wrap wide faq-col">
      <h2 class="h1 faq-h rv">{h.faqTitle}</h2>
      <div class="faq-list rv" style="--d:80ms"><Faq items={faqs} more={{ href: href(lang, 'faq'), label: L.faqAll }} /></div>
    </div>
  </section>

  <Strip tone="pink" items={[L.strip.next]} href={href(lang, 'apply')} label={L.strip.next} speed={60} rev />
</Base>

<script>
  import '../../scripts/marquee';
</script>

<style>
  /* The first screen: the headline across the whole width, then the line and the two ways in. Text only: the reels
     live on the Work page (Heni, 21 Nov 2026). */
  .hero { display: flex; flex-direction: column; min-height: min(100svh, 1080px); background: var(--bg); }
  .h-in { flex: 1; display: grid; align-content: end; gap: clamp(36px, 6vh, 72px); container-type: inline-size;
    padding-top: calc(var(--header) + clamp(32px, 6vh, 88px)); padding-bottom: clamp(40px, 7vh, 88px); }
  .h-title { display: grid; margin: 0; font-weight: 800; letter-spacing: -0.055em; line-height: .86;
    font-size: min(calc(100cqw / var(--kw) * 1.02), 232px, 24svh); }
  .ln { display: block; overflow: hidden; padding: .06em .08em .1em .04em; margin: -.06em 0 -.1em -.04em; }
  .ln-in { display: inline-block; animation: rise 1100ms cubic-bezier(.22, 1, .36, 1) both; animation-delay: calc(140ms + var(--l) * 110ms); }
  @keyframes rise { from { transform: translateY(110%); } }
  .mk { position: relative; z-index: 0; }
  .mk::after { content: ''; position: absolute; z-index: -1; left: -.06em; right: -.04em; top: .5em; bottom: .02em; background: var(--pink); transform-origin: 0 50%; animation: mark 800ms cubic-bezier(.65, 0, .35, 1) both 820ms; }
  @keyframes mark { from { transform: scaleX(0); } }
  .h-foot { display: flex; align-items: flex-end; justify-content: space-between; gap: 28px 48px; flex-wrap: wrap; }
  .h-sub { margin: 0; max-width: 36rem; font-weight: 500; font-size: clamp(19px, 1.6vw, 24px); line-height: 1.4; text-wrap: pretty; }
  .h-sub strong { font-weight: 700; }
  .h-act { display: flex; flex-wrap: wrap; gap: 12px; }
  .up { animation: fade-up 1000ms cubic-bezier(.22, 1, .36, 1) both; animation-delay: var(--d); }
  @keyframes fade-up { from { opacity: 0; transform: translateY(16px); } }
  .cut { position: relative; background: #fff; }
  .cut :global(.bands) { padding-block: clamp(64px, 7.5vw, 112px); }
  @media (max-width: 860px) {
    .hero { min-height: 0; }
    .h-in { padding-top: calc(var(--header) + 28px); padding-bottom: 40px; }
    .h-title { font-size: min(calc(100cqw / var(--kw) * 1.02), 18vw); }
    .h-act { align-self: stretch; } .h-act .btn { flex: 1 1 auto; }
  }

  /* Pricing, in one yellow block: the way in, the monthly floor, and the page with everything. */
  .price-sec { padding-top: 0; }
  .pr { display: grid; grid-template-columns: minmax(0, 1.4fr) auto; gap: 28px clamp(32px, 5vw, 96px); align-items: end; padding: clamp(28px, 3.6vw, 64px); border-radius: 32px; background: var(--yellow); color: #000; }
  .pr-l { display: grid; gap: 14px; }
  .pr-k { margin: 0; font-weight: 700; font-size: 13px; }
  .pr-t { margin: 0; font-weight: 800; font-size: clamp(44px, 5.4vw, 92px); line-height: .92; letter-spacing: -0.05em; font-stretch: 92%; }
  .pr-d { margin: 0; max-width: 40rem; font-weight: 500; font-size: clamp(18px, 1.4vw, 22px); line-height: 1.45; }
  .pr-r { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (max-width: 960px) { .pr { grid-template-columns: 1fr; } }

  @media (prefers-reduced-motion: reduce) { .ln-in, .up, .mk::after { animation: none; } }

  /* Questions: the title on the left, held in place while the questions scroll past on the right. */
  .faq-col { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(40px, 6vw, 120px); align-items: start; }
  .faq-h { position: sticky; top: calc(var(--header) + 32px); margin: 0; max-width: 7ch; font-size: clamp(48px, 6vw, 104px); }
  .faq-list { min-width: 0; }
  .faq-col :global(.faq-more) { display: inline-flex; width: fit-content; margin: 32px 0 0; }
  @media (max-width: 860px) { .faq-col { grid-template-columns: 1fr; } .faq-h { position: static; max-width: none; } }
</style>
