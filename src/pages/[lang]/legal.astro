---
import Base from '../../layouts/Base.astro';
import { t, type Locale } from '../../i18n/strings';
import { langPaths } from '../../i18n/static';
import { site } from '../../data/site';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const l = t(lang).legal;
---
<Base lang={lang} title={l.title} noindex>
  <section class="on-white page-head body">
    <div class="wrap wide stack" style="--gap:32px">
      <h1 class="h2">{l.title}</h1>
      <h2 class="h3">{l.company}</h2>
      {site.company.name
        ? <dl class="facts measure">{(Object.keys(l.fields) as (keyof typeof l.fields)[]).filter((k) => site.company[k]).map((k) => <div><dt>{l.fields[k]}</dt><dd>{site.company[k]}</dd></div>)}</dl>
        : <p class="text text-l measure">{l.pending}</p>}
      <h2 class="h3">{l.host}</h2>
      <p class="text text-l measure">{l.hostValue}</p>
      <h2 class="h3">{l.privacyTitle}</h2>
      <p class="text text-l measure">{l.privacy} <a class="link" href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </div>
  </section>
</Base>
<style>.body { padding-bottom: var(--section); } .facts { margin: 0; display: grid; gap: 12px; } .facts div { display: grid; grid-template-columns: minmax(140px, 220px) 1fr; gap: 16px; } .facts dt { font-weight: 700; } .facts dd { margin: 0; } @media (max-width: 560px) { .facts div { grid-template-columns: 1fr; gap: 2px; } }</style>
