---
// Sends visitors to /fr/ or /en/ based on their browser language.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Gecko</title>
    <meta http-equiv="refresh" content="0; url=en/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try { if ((navigator.language || '').toLowerCase().startsWith('fr')) location.replace('fr/'); else location.replace('en/'); } catch (e) {}
    </script>
    <meta name="theme-color" content="#0A0A0B" />
    <style>html,body{margin:0;background:#0A0A0B;color-scheme:dark}</style>
  </head>
  <body><a href="en/" style="color:#F5F3EF;font-family:Helvetica,Arial,sans-serif;display:block;padding:24px">Gecko</a></body>
</html>
