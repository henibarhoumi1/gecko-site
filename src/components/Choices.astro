---
// A numbered list of short ideas as four blue blocks: how an ad gets made, on the Work
// page under the reels. It can end on text links.
interface Props { title: string; items: { t: string; d: string }[]; links?: { href: string; label: string }[] }
const { title, items, links = [] } = Astro.props;
// The last two words of the title carry the pink marker.
const words = title.split(' ');
const lead = words.slice(0, -2).join(' ');
const tail = words.slice(-2).join(' ');
---
<div class="head rv"><h2 class="h2 ch-h">{lead} <span class="hl">{tail}</span></h2></div>
<ol class="choices">
  {items.map((ch, i) => (
    <li class="rv" style={`--d:${i * 70}ms`}>
      <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <h3 class="t">{ch.t}</h3>
      <p class="text">{ch.d}</p>
    </li>
  ))}
</ol>
{links.length > 0 && (
  <p class="more-row rv">
    {links.map((l) => <a class="more" href={l.href}><span class="lb">{l.label}</span> <span class="ar" aria-hidden="true">→</span></a>)}
  </p>
)}

<style>
  .ch-h { max-width: 18ch; margin-bottom: clamp(28px, 3.6vw, 56px); }
  .choices { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(12px, 1.4vw, 20px); }
  .choices li { display: grid; gap: 14px; align-content: start; min-height: 240px; padding: clamp(24px, 2.6vw, 40px); border-radius: var(--r-lg); background: var(--blue); color: #000; }
  .n { font-weight: 800; font-size: 18px; font-variant-numeric: tabular-nums; }
  .t { margin: 0; font-weight: 800; font-size: clamp(28px, 2.8vw, 44px); line-height: 1; letter-spacing: -0.03em; max-width: 16ch; }
  .text { margin: 0; max-width: 30rem; font-weight: 500; font-size: 18px; color: #000; }
  .more-row { display: flex; flex-wrap: wrap; gap: 12px clamp(28px, 4vw, 64px); margin: clamp(32px, 4vw, 56px) 0 0; }
  .more { display: inline-flex; align-items: baseline; gap: .35em; font-weight: 800; font-size: clamp(24px, 2.8vw, 44px); line-height: 1; letter-spacing: -0.03em; color: var(--fg); text-decoration: none; }
  .lb { padding-inline: .04em; margin-inline: -.04em; background: linear-gradient(var(--pink), var(--pink)) 0 80% / 0 38% no-repeat; transition: background-size 520ms var(--ease); }
  .ar { transition: transform 360ms var(--ease); }
  .more:hover .lb { background-size: 100% 38%; color: #000; }
  .more:hover .ar { transform: translateX(12px); }
  .more:focus-visible { outline: 2px solid var(--fg); outline-offset: 6px; }
  @media (max-width: 860px) { .choices { grid-template-columns: 1fr; } }
</style>
