---
// What sets Gecko apart: four promises in one slider, each with a small moving picture of what it means.
// It moves on by itself while on screen, and can be swiped, tapped or stepped through with the arrows.
import { c } from '../i18n/copy';
import { href } from '../i18n/paths';
import type { Locale } from '../i18n/strings';
interface Props { lang: Locale }
const { lang } = Astro.props;
const h = c(lang).home;
const w = h.why;
---
<section class="on-yellow section why-sec">
  <div class="wrap">
    <div class="head rv">
      <h2 class="h2 why-h">{w.title}</h2>
      <div class="ctrl">
        <button type="button" class="arw" data-prev aria-label={w.prev}>←</button>
        <button type="button" class="arw" data-next aria-label={w.next}>→</button>
      </div>
    </div>
    <div class="tabs rv" role="tablist" aria-label={w.title}>
      {w.items.map((it, i) => (
        <button type="button" role="tab" aria-selected={String(i === 0)} data-tab={i}><span class="tn">{String(i + 1).padStart(2, '0')}</span><span class="tl">{it.short}</span><i aria-hidden="true"></i></button>
      ))}
    </div>
    <ol class="list rv" data-track>
      {w.items.map((it, i) => (
        <li class={`row ${i === 0 ? 'on' : ''}`} data-why role="tabpanel" aria-roledescription="slide">
          <div class="copy">
                        <h3 class="t">{it.t}</h3>
            <p class="text">{it.d}</p>
          </div>
          <div class="proof" aria-hidden="true">
            {i === 0 && (
              <div class="hooks">
                <div class="phone">
                  <span class="cap a">{w.hooks.lines[0]}</span>
                  <span class="cap b">{w.hooks.lines[1]}</span>
                  <span class="bar"><i></i></span>
                </div>
                <div class="side">
                  <p class="same">{w.hooks.same}</p>
                  <p class="opt a"><b>A</b>{w.hooks.a}</p>
                  <p class="opt b"><b>B</b>{w.hooks.b}</p>
                </div>
              </div>
            )}
            {i === 1 && (
              <div class="script">
                <p class="st">{w.script.title}</p>
                <ol>{w.script.scenes.map((sc, j) => <li style={`--j:${j}`}><span>{String(j + 1).padStart(2, '0')}</span>{sc}<i></i></li>)}</ol>
                <span class="stamp">{w.script.stamp}</span>
              </div>
            )}
            {i === 2 && (
              <div class="flow">
                <div class="track">
                  <span class="line"><i></i></span>
                  {w.flow.steps.map((st, j) => <span class="node" style={`--j:${j}`}><b></b>{st}</span>)}
                </div>
                <span class="days">{w.flow.days}</span>
              </div>
            )}
            {i === 3 && (
              <div class="review">
                <p class="st">{w.review.title}</p>
                {w.review.rows.map(([k, v], j) => (
                  <p class={`rr ${['keep', 'drop', 'next'][j]}`} style={`--j:${j}`}><span>{k}</span><b>{v}</b></p>
                ))}
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
    <a class="btn primary why-cta rv" href={href(lang, 'apply')}>{h.compareCta} <span class="arr" aria-hidden="true">→</span></a>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.why-sec').forEach((sec) => {
    const track = sec.querySelector<HTMLElement>('[data-track]')!;
    const slides = [...track.querySelectorAll<HTMLElement>('[data-why]')];
    const tabs = [...sec.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const WAIT = 6500;
    let at = 0, timer = 0, seen = false, held = false;

    const mark = (i: number) => {
      if (i === at && slides[i].classList.contains('on')) return;
      at = i;
      slides.forEach((s, k) => { s.classList.toggle('on', k === i); s.setAttribute('aria-hidden', String(k !== i)); });
      tabs.forEach((t, k) => t.setAttribute('aria-selected', String(k === i)));
      sec.style.setProperty('--wait', `${WAIT}ms`);
    };
    const go = (i: number) => {
      const n = (i + slides.length) % slides.length;
      track.scrollTo({ left: slides[n].offsetLeft - slides[0].offsetLeft, behavior: still ? 'auto' : 'smooth' });
      mark(n); restart();
    };
    // Auto-advance only while the section is on screen and nobody is touching or hovering it.
    const restart = () => {
      clearTimeout(timer);
      sec.classList.remove('run'); void sec.offsetWidth;
      if (still || !seen || held) return;
      sec.classList.add('run');
      timer = window.setTimeout(() => go(at + 1), WAIT);
    };
    // Swiping by hand: the slide that lands in place becomes the current one.
    let st = 0;
    track.addEventListener('scroll', () => {
      clearTimeout(st);
      st = window.setTimeout(() => {
        const x = track.scrollLeft;
        const i = slides.reduce((best, s, k) => Math.abs(s.offsetLeft - slides[0].offsetLeft - x) < Math.abs(slides[best].offsetLeft - slides[0].offsetLeft - x) ? k : best, 0);
        if (i !== at) { mark(i); restart(); }
      }, 90);
    }, { passive: true });
    tabs.forEach((t, i) => t.addEventListener('click', () => go(i)));
    sec.querySelector('[data-prev]')!.addEventListener('click', () => go(at - 1));
    sec.querySelector('[data-next]')!.addEventListener('click', () => go(at + 1));
    const hold = (v: boolean) => { held = v; restart(); };
    track.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && hold(true));
    track.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && hold(false));
    track.addEventListener('touchstart', () => hold(true), { passive: true });
    track.addEventListener('touchend', () => setTimeout(() => hold(false), 1200), { passive: true });
    new IntersectionObserver(([e]) => { seen = e.isIntersecting; if (seen) slides[at].classList.add('on'); restart(); }, { threshold: 0.45 }).observe(track);
    mark(0);
  });
</script>

<style>
  .why-sec { border-top: var(--line) solid var(--ink); }
  .why-h { max-width: 13ch; }
  .head { margin-bottom: clamp(24px, 3vw, 40px); }
  .ctrl { display: flex; gap: 10px; }
  .arw { width: 52px; height: 52px; border-radius: 50%; border: var(--line) solid var(--ink); background: var(--white); color: var(--ink); font: 700 20px/1 var(--font); cursor: pointer; transition: transform 220ms var(--ease), box-shadow 220ms var(--ease), background 200ms var(--ease); }
  .arw:hover { background: var(--pink); transform: translate(-2px, -2px); box-shadow: 3px 3px 0 var(--ink); }
  .tabs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin-bottom: clamp(20px, 2.4vw, 32px); }
  .tabs button { position: relative; display: flex; gap: 10px; align-items: baseline; padding: 12px 0 16px; border: 0; background: none; color: var(--ink); font: 700 15px/1.25 var(--font); text-align: left; cursor: pointer; opacity: .5; transition: opacity 240ms var(--ease); }
  .tabs button:hover, .tabs [aria-selected='true'] { opacity: 1; }
  .tn { font-size: 13px; }
  .tabs i { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; border-radius: 3px; background: rgba(0, 0, 0, .15); overflow: hidden; }
  .tabs i::after { content: ''; position: absolute; inset: 0; background: var(--ink); transform-origin: left; transform: scaleX(0); }
  .tabs [aria-selected='true'] i::after { transform: scaleX(1); }
  .run .tabs [aria-selected='true'] i::after { animation: prog var(--wait, 6500ms) linear both; }
  @keyframes prog { from { transform: scaleX(0); } }
  .list { list-style: none; margin: 0; padding: 0; display: flex; gap: 32px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; border-radius: var(--r-lg); }
  .list::-webkit-scrollbar { display: none; }
  .row { flex: 0 0 100%; scroll-snap-align: start; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 80px); align-items: center; padding: 4px 12px 14px 0; }
  .row { overflow: hidden; }
  .row .copy { transition: opacity 400ms var(--ease); }
  .row:not(.on) .copy { opacity: .3; }
  .copy { display: grid; gap: 14px; align-content: center; }
  .n { font-weight: 700; font-size: 15px; letter-spacing: .02em; }
  .t { margin: 0; font-weight: 700; font-size: clamp(30px, 3.4vw, 52px); line-height: 1.02; letter-spacing: -0.045em; max-width: 14ch; }
  .copy .text { margin: 0; max-width: 32rem; font-size: clamp(17px, 1.3vw, 19px); }
  .proof { position: relative; height: clamp(250px, 22vw, 300px); padding: clamp(20px, 2vw, 28px); background: var(--white); border: var(--line) solid var(--ink); border-radius: var(--r-lg); box-shadow: 8px 8px 0 var(--ink); overflow: hidden; display: grid; }
  .st { margin: 0 0 12px; font-weight: 700; font-size: 14px; }

  /* 1. Two hooks on the same reel */
  .hooks { height: 100%; min-height: 0; display: grid; grid-template-columns: auto 1fr; gap: clamp(18px, 2.4vw, 32px); align-items: center; }
  .phone { position: relative; height: min(100%, 250px); aspect-ratio: 9 / 16; border-radius: 16px; background: var(--ink); overflow: hidden; align-self: center; }
  .cap { position: absolute; left: 10px; right: 10px; top: 22%; padding: 8px 9px; border-radius: 8px; background: var(--white); color: var(--ink); font-weight: 700; font-size: 12px; line-height: 1.2; opacity: 0; }
  .cap.a { opacity: 1; }
  .phone .bar { position: absolute; left: 10px; right: 10px; bottom: 12px; height: 3px; border-radius: 3px; background: rgba(255, 255, 255, .25); overflow: hidden; }
  .phone .bar i { position: absolute; inset: 0; background: var(--pink); transform-origin: left; transform: scaleX(0); }
  .side { display: grid; gap: 10px; align-content: center; }
  .same { margin: 0 0 6px; font-weight: 700; font-size: clamp(18px, 1.6vw, 22px); letter-spacing: -0.02em; line-height: 1.15; }
  .opt { margin: 0; display: flex; align-items: center; gap: 10px; padding: 8px 12px 8px 8px; border: var(--line) solid var(--ink); border-radius: 999px; font-weight: 700; font-size: 14px; width: fit-content; background: var(--white); }
  .opt b { width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; font-size: 12px; background: var(--ink); color: #fff; }
  .opt.a { background: var(--pink); }
  .on .cap.a { animation: capA 6s infinite; }
  .on .cap.b { animation: capB 6s infinite; }
  .on .opt.a { animation: optA 6s infinite; }
  .on .opt.b { animation: optB 6s infinite; }
  .on .phone .bar i { animation: bar 3s linear infinite; }
  @keyframes capA { 0%, 44% { opacity: 1; transform: none; } 50%, 94% { opacity: 0; transform: translateY(-8px); } 100% { opacity: 1; transform: none; } }
  @keyframes capB { 0%, 44% { opacity: 0; transform: translateY(8px); } 50%, 94% { opacity: 1; transform: none; } 100% { opacity: 0; } }
  @keyframes optA { 0%, 46% { background: var(--pink); transform: translateX(6px); } 50%, 96% { background: var(--white); transform: none; } 100% { background: var(--pink); transform: translateX(6px); } }
  @keyframes optB { 0%, 46% { background: var(--white); transform: none; } 50%, 96% { background: var(--pink); transform: translateX(6px); } 100% { background: var(--white); transform: none; } }
  @keyframes bar { to { transform: scaleX(1); } }

  /* 2. The script, signed off */
  .script { position: relative; display: grid; align-content: start; }
  .script ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .script li { position: relative; display: flex; gap: 12px; align-items: baseline; padding: 7px 0; font-weight: 600; font-size: 15px; border-bottom: 1px dashed rgba(0, 0, 0, .25); }
  .script li span { font-weight: 700; font-size: 12px; width: 18px; }
  .script li i { flex: 1; height: 6px; margin-left: 8px; border-radius: 3px; background: var(--yellow-soft); align-self: center; transform-origin: left; }
  .stamp { position: absolute; right: clamp(16px, 2vw, 28px); bottom: clamp(16px, 2vw, 26px); padding: 10px 18px; border: 2.5px solid var(--ink); border-radius: 10px; background: var(--pink); font-weight: 700; font-size: clamp(20px, 2vw, 26px); letter-spacing: -0.02em; transform: rotate(-8deg); box-shadow: 4px 4px 0 var(--ink); }
  .on .script li { animation: lineIn 500ms var(--ease) both; animation-delay: calc(var(--j) * 140ms); }
  .on .script li i { animation: grow 700ms var(--ease) both; animation-delay: calc(var(--j) * 140ms + 120ms); }
  .on .stamp { animation: stamp 520ms var(--spring) 900ms both; }
  @keyframes lineIn { from { opacity: 0; transform: translateX(-10px); } }
  @keyframes grow { from { transform: scaleX(0); } }
  @keyframes stamp { from { opacity: 0; transform: rotate(-20deg) scale(1.8); } }

  /* 3. One team, one line from brief to ads */
  .flow { display: grid; align-content: center; gap: 28px; }
  .track { position: relative; display: grid; grid-template-columns: repeat(5, 1fr); }
  .line { position: absolute; left: 10%; right: 10%; top: 13px; height: 3px; border-radius: 3px; background: rgba(0, 0, 0, .12); }
  .line i { position: absolute; inset: 0; background: var(--ink); transform-origin: left; transform: scaleX(1); border-radius: 3px; }
  .node { position: relative; display: grid; justify-items: center; gap: 12px; font-weight: 700; font-size: clamp(13px, 1.1vw, 15px); text-align: center; }
  .node b { width: 28px; height: 28px; border-radius: 50%; border: var(--line) solid var(--ink); background: var(--pink); }
  .days { justify-self: end; margin-right: 2%; padding: 8px 14px; border-radius: 999px; background: var(--yellow); border: var(--line) solid var(--ink); font-weight: 700; font-size: 15px; position: relative; }
  .days::before { content: ''; position: absolute; top: -9px; right: 22%; width: 14px; height: 14px; background: var(--yellow); border-left: var(--line) solid var(--ink); border-top: var(--line) solid var(--ink); transform: rotate(45deg); }
  .on .line i { animation: fill 3.6s var(--ease) infinite; }
  .on .node b { animation: dot 3.6s var(--ease) infinite; animation-delay: calc(var(--j) * 0.62s); }
  .on .days { animation: pop 3.6s var(--ease) infinite; }
  @keyframes fill { 0% { transform: scaleX(0); } 75%, 100% { transform: scaleX(1); } }
  @keyframes dot { 0% { background: var(--white); transform: scale(.8); } 12%, 100% { background: var(--pink); transform: none; } }
  @keyframes pop { 0%, 60% { opacity: 0; transform: translateY(6px); } 72%, 100% { opacity: 1; transform: none; } }

  /* 4. The results review */
  .review { display: grid; align-content: start; gap: 10px; }
  .rr { margin: 0; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 14px; border: var(--line) solid var(--ink); border-radius: var(--r-sm); font-weight: 600; font-size: 15px; }
  .rr b { display: inline-flex; align-items: center; gap: 8px; padding: 5px 12px; border-radius: 999px; font-size: 14px; }
  .keep b { background: var(--yellow); }
  .drop b { background: var(--pink-soft); text-decoration: line-through; text-decoration-thickness: 1.5px; }
  .next { background: var(--ink); color: #fff; }
  .next b { background: var(--pink); color: var(--ink); }
  .on .rr { animation: lineIn 520ms var(--ease) both; animation-delay: calc(var(--j) * 260ms + 100ms); }
  .on .rr b { animation: stamp 460ms var(--spring) both; animation-delay: calc(var(--j) * 260ms + 380ms); }

  .why-cta { margin-top: clamp(20px, 2.4vw, 32px); }
  @media (max-width: 860px) {
    .row { grid-template-columns: 1fr; gap: 20px; align-content: start; padding-right: 10px; }
    .tabs { grid-template-columns: repeat(4, 1fr); gap: 6px; }
    .tl { display: none; }
    .tabs button { justify-content: center; padding-bottom: 12px; }
    .ctrl { display: none; }
    .t { font-size: clamp(26px, 7.4vw, 34px); }
    .copy { gap: 10px; }
    .copy .text { font-size: 16px; }
    .proof { min-height: 210px !important; }
    .phone { height: 180px !important; }
    .proof { height: auto; min-height: 236px; box-shadow: 6px 6px 0 var(--ink); }
    .phone { height: 220px; }
  }
  @media (max-width: 420px) { .node { font-size: 12px; } .node b { width: 22px; height: 22px; } .line { top: 10px; } }
  @media (prefers-reduced-motion: reduce) { .on *, .on .cap, .on .opt { animation: none !important; } }
</style>
