---
// Why brands switch: for each place where ads usually go wrong, the usual way crossed out and the Gecko way
// in bold underneath. Two columns on wide screens, one on phones.
import { c } from '../i18n/copy';
import type { Locale } from '../i18n/strings';
interface Props { lang: Locale }
const { lang } = Astro.props;
const k = c(lang).home.compare;
---
<section class="section cmp-sec">
  <div class="wrap wide">
    <h2 class="h2 cmp-title rv">{k.title}</h2>
    <ol class="cmp">
      {k.rows.map(([topic, usual, gecko], i) => (
        <li class="row rv" style={`--d:${(i % 2) * 90}ms`}>
          <p class="topic"><span class="i">{String(i + 1).padStart(2, '0')}</span>{topic}</p>
          <p class="usual"><span class="sr">{k.usual}: </span><s>{usual}</s></p>
          <p class="gecko"><span class="sr">{k.gecko}: </span>{gecko}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .cmp-sec { }
  .cmp-title { max-width: 12ch; margin-bottom: clamp(32px, 4vw, 64px); }
  .cmp { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(12px, 1.4vw, 20px); }
  .row { display: grid; gap: 14px; align-content: start; padding: clamp(22px, 2.6vw, 38px); border-radius: var(--r-lg); background: var(--yellow); color: #000; }
  .row:nth-child(4n+2) { background: var(--pink); } .row:nth-child(4n+3) { background: var(--blue); } .row:nth-child(4n) { background: #fff; outline: 0; }
  .topic { margin: 0; display: flex; gap: 12px; align-items: baseline; font-size: 13px; font-weight: 700; }
  .topic .i { font-variant-numeric: tabular-nums; }
  .usual { margin: 0; max-width: 34rem; font-size: 16px; line-height: 1.5; font-weight: 500; }
  /* The usual way gets struck through in pink as the row comes into view. */
  .usual s { text-decoration: none; background: linear-gradient(#000, #000) 0 60% / 0 .12em no-repeat; transition: background-size 900ms var(--ease) 300ms; }
  .row.in .usual s { background-size: 100% .12em; }
  .gecko { margin: 0; max-width: 28ch; font-weight: 700; font-size: clamp(21px, 1.9vw, 30px); line-height: 1.2; letter-spacing: -0.025em; text-wrap: pretty; }
  @media (max-width: 860px) { .cmp { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .usual s { background-size: 100% .12em; } }
</style>
