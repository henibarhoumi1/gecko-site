---
interface Props { src?: string; poster?: string; label?: string }
const { src, poster, label = '9:16' } = Astro.props;
---
<div class="reel">
  {src ? (
    <video src={src} poster={poster} muted loop playsinline preload="none" data-autoplay />
  ) : (
    <div class="ph"><span class="eyebrow">{label}</span></div>
  )}
</div>
