---
// Home: "Pick your plan." (Heni, 19 Nov, canvas Landing v2). The label and title on the left, the four plan cards,
// then the fine print with a way to every offer. The full detail of each plan stays on Offers.
import PlanCards from './PlanCards.astro';
import { type Locale } from '../i18n/strings';
import { launch } from '../i18n/launch';
import { href } from '../i18n/paths';
interface Props { lang: Locale }
const { lang } = Astro.props;
const L = launch(lang).plans;
---
<section class="section plans-sec" id="plans">
  <div class="wrap wide">
    <div class="top rv">
      <p class="lab">{L.label} <span aria-hidden="true">]</span></p>
      <h2 class="ttl">{L.pick}</h2>
    </div>
    <PlanCards lang={lang} />
    <div class="foot rv">
      <p class="fine">{L.fine}</p>
      <a class="btn" href={href(lang, 'offers')}>{L.all} <span class="arr" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .top { display: grid; gap: 22px; margin-bottom: clamp(36px, 4vw, 56px); }
  .lab { margin: 0; font-weight: 700; font-size: 13px; letter-spacing: .1em; text-transform: uppercase; }
  .ttl { margin: 0; font-weight: 800; font-size: clamp(40px, 4.8vw, 68px); line-height: 1; letter-spacing: -0.05em; }
  .foot { display: flex; align-items: center; justify-content: space-between; gap: 16px 32px; flex-wrap: wrap; margin-top: clamp(28px, 3vw, 40px); }
  .fine { margin: 0; max-width: 52rem; font-weight: 500; font-size: 15px; line-height: 1.5; }
</style>
