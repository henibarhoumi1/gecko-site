---
// Home: "Choose how we work together." Three ways in, left to right: try (Test), every month (Regular, Pro, Creative
// Partner), the whole brand (Brand World). First what every plan has, then the filled panels.
import PlanPanels from './PlanPanels.astro';
import { t, type Locale } from '../i18n/strings';
import { c } from '../i18n/copy';
import { launch } from '../i18n/launch';
import { href } from '../i18n/paths';
interface Props { lang: Locale }
const { lang } = Astro.props;
const L = launch(lang);
const o = t(lang).offers;
const p = c(lang).plans;
---
<section class="section plans-sec" id="plans">
  <div class="wrap wide">
    <h2 class="h2 rv">{L.plans.title}</h2>

    <div class="every rv">
      <h3 class="every-t">{L.plans.everyTitle}</h3>
      <ul>{L.plans.every.map((x) => <li>{x}</li>)}</ul>
    </div>

    <div class="ways">
      <div class="way w1 rv"><p class="way-k">{L.plans.ways[0]}</p><PlanPanels lang={lang} part="test" /></div>
      <div class="way w2 rv" style="--d:80ms"><p class="way-k">{L.plans.ways[1]}</p><PlanPanels lang={lang} part="monthly" /></div>
      <div class="way w3 rv" style="--d:160ms">
        <p class="way-k">{L.plans.ways[2]}</p>
        <div class="bw">
          <p class="tape flat">{L.bw.label}</p>
          <h3 class="bw-n">{L.bw.name}</h3>
          <p class="bw-t">{L.plans.bwText}</p>
          <a class="btn" href={href(lang, 'brand-world')}>{L.plans.quoteBW} <span class="arr" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>

    <p class="fine rv">{p.spec.out} {o.launchNote}</p>
  </div>
</section>

<style>
  .plans-sec .h2 { max-width: 14ch; margin-bottom: clamp(32px, 4vw, 56px); }
  .every { display: grid; grid-template-columns: minmax(0, .4fr) minmax(0, 1fr); gap: 16px clamp(24px, 4vw, 64px); margin-bottom: clamp(40px, 5vw, 72px); }
  .every-t { margin: 0; font-weight: 800; font-size: clamp(22px, 2vw, 30px); letter-spacing: -0.02em; }
  .every ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 14px 40px; font-weight: 500; font-size: clamp(18px, 1.5vw, 22px); line-height: 1.3; }
  .ways { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr) minmax(0, 1fr); gap: clamp(16px, 1.6vw, 24px); align-items: stretch; }
  .way { display: grid; grid-template-rows: auto 1fr; gap: 14px; min-width: 0; }
  .way-k { margin: 0; font-weight: 700; font-size: 13px; }
  .w1 :global(.pp) { height: 100%; }
  .w2 { grid-template-rows: auto auto; }
  .w2 { display: grid; grid-template-columns: 1fr 1fr; align-content: start; gap: 14px clamp(16px, 1.6vw, 24px); }
  .w2 .way-k { grid-column: 1 / -1; }
  .w2 :global(.k-partner) { grid-column: 1 / -1; }
  .bw { display: grid; align-content: start; justify-items: start; gap: 16px; padding: clamp(24px, 2.4vw, 36px) 0; }
  .bw-n { margin: 0; font-weight: 800; font-size: clamp(34px, 3.4vw, 54px); line-height: .95; letter-spacing: -0.03em; }
  .bw-t { margin: 0; font-size: 17px; line-height: 1.4; font-weight: 500; }
  .fine { margin: clamp(28px, 3vw, 44px) 0 0; font-size: 15px; font-weight: 500; max-width: 60rem; }
  @media (max-width: 1100px) {
    .ways { grid-template-columns: 1fr; }
    .every { grid-template-columns: 1fr; } .every ul { grid-template-columns: 1fr; }
    .w2 { grid-template-columns: 1fr; }
  }
</style>
