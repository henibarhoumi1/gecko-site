---
// Home: "Choose how we work together." What every plan has, then the four plans as equal filled panels in one row
// (their rows line up: name, price, what it works out to, what you get, button), in black and white.
import PlanPanels from './PlanPanels.astro';
import { t, type Locale } from '../i18n/strings';
import { c } from '../i18n/copy';
import { launch } from '../i18n/launch';
import { href } from '../i18n/paths';
interface Props { lang: Locale }
const { lang } = Astro.props;
const L = launch(lang);
const o = t(lang).offers;
const p = c(lang).plans;
---
<section class="section plans-sec" id="plans">
  <div class="wrap wide">
    <div class="top">
      <h2 class="h2 rv">{L.plans.title}</h2>
      <div class="every rv" style="--d:80ms">
        <h3 class="every-t">{L.plans.everyTitle}</h3>
        <ul>{L.plans.every.map((x) => <li>{x}</li>)}</ul>
      </div>
    </div>

    <div class="row rv"><PlanPanels lang={lang} part="all" /></div>

    <p class="fine rv">{p.spec.out} {o.launchNote}</p>
  </div>
</section>

<style>
  /* The title centred, and what every plan has as one centred row under it. */
  .top { display: grid; justify-items: center; gap: clamp(22px, 2.6vw, 34px); margin-bottom: clamp(40px, 4.6vw, 68px); text-align: center; }
  .top .h2 { margin: 0; }
  .every { display: grid; justify-items: center; gap: 14px; }
  .every-t { margin: 0; font-weight: 800; font-size: 15px; letter-spacing: .02em; text-transform: uppercase; }
  .every ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 30px; max-width: 64rem; font-weight: 600; font-size: clamp(16px, 1.2vw, 19px); line-height: 1.3; }
  .every li { padding-left: 18px; position: relative; }
  .every li::before { content: ''; position: absolute; left: 0; top: .45em; width: 8px; height: 8px; border-radius: 50%; background: #000; }
  /* Four panels, one row. Each panel borrows the row's five tracks, so prices, lists and buttons line up across them. */
  .row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-template-rows: repeat(5, auto); column-gap: clamp(12px, 1.2vw, 20px); }
  .row :global(.pp) { grid-row: span 5; grid-template-rows: subgrid; grid-template-columns: 1fr !important; align-content: stretch; }
  .row :global(.pp > *) { grid-column: 1 !important; grid-row: auto !important; }
  /* Every panel keeps a line for a flag, with or without one, so the four names sit on the same line. */
  .row :global(.pp > header) { align-self: start; }
  .row :global(.pp > header:not(:has(.flag))::before) { content: ''; display: block; height: 42px; }
  .row :global(.pp .flag) { display: flex; align-items: center; width: fit-content; height: 30px; margin: 0 0 12px; }
  .row :global(.pp .name) { min-height: 1.9em; }
  .row :global(.k-partner .price b) { font-size: clamp(30px, 3.1vw, 48px); line-height: 1; }
  .row :global(.pp .go) { justify-self: stretch; }
  .fine { margin: clamp(24px, 2.6vw, 40px) auto 0; text-align: center; font-size: 15px; font-weight: 500; max-width: 60rem; }
  @media (max-width: 1100px) {
    .row { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: none; row-gap: 12px; }
    .row :global(.pp) { grid-row: auto; grid-template-rows: none; align-content: start; }
  }
  @media (max-width: 640px) { .row { grid-template-columns: 1fr; } }
</style>
