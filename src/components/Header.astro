---
// The top bar. At the top of a page it sits open and borderless; once you scroll it becomes a floating dark glass bar,
// hides while you read down and slides back as soon as you scroll up. A soft pill glides under the links as the
// pointer moves across them and rests on the current page. The globe opens the language choice.
// "Menu" opens a full panel that drops from the top: numbered pages on the left, contacts and language on the right.
import Logo from './Logo.astro';
import { type Locale } from '../i18n/strings';
import { c } from '../i18n/copy';
import { href, swapLang } from '../i18n/paths';
import { site } from '../data/site';
interface Props { lang: Locale }
const { lang } = Astro.props;
const n = c(lang).nav;
const path = Astro.url.pathname;
const links = [
  [href(lang, 'work'), n.work], [href(lang, 'process'), n.process], [href(lang, 'offers'), n.offers], [href(lang, 'about'), n.about], [href(lang, 'contact'), n.contact],
] as const;
const panel = [
  [href(lang, 'work'), n.work, n.desc.work], [href(lang, 'process'), n.process, n.desc.process], [href(lang, 'offers'), n.offers, n.desc.offers],
  [href(lang, 'about'), n.about, n.desc.about], [href(lang, 'faq'), n.faq, n.desc.faq], [href(lang, 'contact'), n.contact, n.desc.contact],
] as const;
const langs = [
  { l: 'en', short: 'EN', name: 'English' },
  { l: 'fr', short: 'FR', name: 'Français' },
].map((x) => ({ ...x, url: !/^\/(en|fr)(\/|$)/.test(path) ? `/${x.l}/` : x.l === lang ? path : swapLang(path, x.l as Locale) }));
const here = langs.find((x) => x.l === lang)!;
const there = langs.find((x) => x.l !== lang)!;
const globe = '<circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.6 2.6 3.9 5.6 3.9 9s-1.3 6.4-3.9 9c-2.6-2.6-3.9-5.6-3.9-9S9.4 5.6 12 3z" />';
---
<header class="site-header" data-header>
  <nav class="bar" aria-label="Main">
    <a href={href(lang)} class="brand" aria-label="Gecko"><Logo /></a>
    <ul class="links" data-links>
      <li class="glide" aria-hidden="true" role="presentation"></li>
      {links.map(([p, label]) => (
        <li><a href={p} aria-current={path.startsWith(p) ? 'page' : undefined}>{label}</a></li>
      ))}
    </ul>
    <div class="right">
      <div class="lang" data-lang>
        <button type="button" class="lang-b" aria-expanded="false" aria-controls="lang-m" aria-label={n.lang} data-lang-b><svg class="globe" viewBox="0 0 24 24" aria-hidden="true" set:html={globe} /><span>{here.short}</span></button>
        <ul class="lang-m" id="lang-m" data-lang-m hidden>
          {langs.map((x) => <li><a href={x.url} hreflang={x.l} lang={x.l} aria-current={x.l === lang ? 'true' : undefined}>{x.name}<span class="tick" aria-hidden="true">✓</span></a></li>)}
        </ul>
      </div>
      <a class="btn primary cta" href={href(lang, 'apply')}>{n.apply}<span class="ca" aria-hidden="true">→</span></a>
      <button type="button" class="burger" aria-expanded="false" aria-controls="menu" data-burger>
        <span class="bl"><span class="b-open">{n.menu}</span><span class="b-close">{n.close}</span></span>
        <span class="bi" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </nav>

  <div class="menu on-black" id="menu" data-menu hidden>
    <div class="menu-in">
      <ol class="m-links">
        {panel.map(([p, label, d], i) => (
          <li style={`--i:${i}`}>
            <a href={p} aria-current={path.startsWith(p) ? 'page' : undefined}>
              <span class="m-t">{label}</span>
              <span class="m-d">{d}</span>
            </a>
          </li>
        ))}
      </ol>
      <aside class="m-side">
        <a class="btn m-cta" href={href(lang, 'apply')}>{n.apply} <span class="arr" aria-hidden="true">→</span></a>
        <div class="m-reach">
          <p class="m-k">{n.reach}</p>
          <a href={site.whatsapp} rel="noopener">WhatsApp {site.phone}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={site.instagram} rel="noopener">Instagram {site.instagramHandle}</a>
          <a class="m-hire" href={href(lang, 'join')}>{c(lang).join.nav} <span aria-hidden="true">→</span></a>
        </div>
        <a class="m-lang" href={there.url} hreflang={there.l} lang={there.l}><svg class="globe" viewBox="0 0 24 24" aria-hidden="true" set:html={globe} />{there.name}</a>
      </aside>
    </div>
  </div>
</header>
<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const burger = header.querySelector<HTMLButtonElement>('[data-burger]')!;
  const menu = header.querySelector<HTMLElement>('[data-menu]')!;
  // Solid once you leave the top; hidden while reading down, back on the way up. A few pixels of slack stop flicker.
  let last = scrollY, ticking = false;
  const update = () => {
    const y = scrollY, d = y - last;
    header.classList.toggle('solid', y > 24);
    if (y < 160 || header.classList.contains('open')) header.classList.remove('away');
    else if (d > 6) header.classList.add('away');
    else if (d < -6) header.classList.remove('away');
    if (Math.abs(d) > 6 || y < 160) last = y;
    ticking = false;
  };
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  update();
  // The bar takes its first state without animating; transitions switch on two frames later.
  requestAnimationFrame(() => requestAnimationFrame(() => document.documentElement.classList.remove('pre')));

  const setMenu = (open: boolean) => {
    burger.setAttribute('aria-expanded', String(open));
    header.classList.toggle('open', open);
    document.documentElement.classList.toggle('locked', open);
    if (open) { menu.hidden = false; requestAnimationFrame(() => requestAnimationFrame(() => menu.classList.add('in'))); }
    else { menu.classList.remove('in'); setTimeout(() => { if (!header.classList.contains('open')) menu.hidden = true; }, 520); }
  };
  burger.addEventListener('click', () => setMenu(menu.hidden));

  // The gliding pill: it follows the pointer from link to link and settles back on the current page.
  const list = header.querySelector<HTMLElement>('[data-links]')!;
  const glide = list.querySelector<HTMLElement>('.glide')!;
  const current = list.querySelector<HTMLElement>('a[aria-current="page"]');
  const place = (a: HTMLElement | null, mode: 'hot' | 'rest') => {
    if (!a) { glide.classList.remove('hot', 'rest'); return; }
    glide.style.setProperty('--x', `${a.offsetLeft}px`); glide.style.setProperty('--w', `${a.offsetWidth}px`);
    glide.classList.toggle('hot', mode === 'hot'); glide.classList.toggle('rest', mode === 'rest');
  };
  glide.classList.add('still'); place(current, 'rest');
  requestAnimationFrame(() => requestAnimationFrame(() => glide.classList.remove('still')));
  list.querySelectorAll<HTMLElement>('a').forEach((a) => a.addEventListener('pointerenter', () => place(a, 'hot')));
  list.addEventListener('pointerleave', () => place(current, 'rest'));

  // Language: the globe opens a small list; a click outside or Escape closes it.
  const lb = header.querySelector<HTMLButtonElement>('[data-lang-b]')!;
  const lm = header.querySelector<HTMLElement>('[data-lang-m]')!;
  const setLang = (open: boolean) => { lb.setAttribute('aria-expanded', String(open)); lm.hidden = !open; };
  lb.addEventListener('click', (e) => { e.stopPropagation(); setLang(lm.hidden); });
  addEventListener('click', (e) => { if (!lm.hidden && !(e.target as HTMLElement).closest('[data-lang]')) setLang(false); });
  // A link to another page leaves the panel open: the page change fades it out together with the old page,
  // instead of freezing it half closed. A link to this same page just closes it.
  menu.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest('a');
    if (a && (a.origin !== location.origin || a.pathname === location.pathname)) setMenu(false);
  });
  // Coming back with the browser's back button shows the page as it was left, so close the panel first.
  addEventListener('pageshow', (e) => {
    if (!(e as PageTransitionEvent).persisted || menu.hidden) return;
    document.documentElement.classList.add('pre');
    setMenu(false); menu.hidden = true;
    requestAnimationFrame(() => requestAnimationFrame(() => document.documentElement.classList.remove('pre')));
  });
  addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (!lm.hidden) { setLang(false); lb.focus(); }
    else if (!menu.hidden) { setMenu(false); burger.focus(); }
  });
</script>
<style>
  .site-header { --t: 560ms cubic-bezier(.16, 1, .3, 1); position: fixed; top: 0; left: 0; right: 0; z-index: 50; padding: 12px var(--gutter) 0; pointer-events: none; transition: transform var(--t); }
  .site-header.away { transform: translateY(calc(-100% - 12px)); }
  /* At the top of a page the bar lines up with the wide sections, edge to edge; once you scroll it gathers into a pill. */
  .bar { pointer-events: auto; position: relative; z-index: 3; max-width: calc(var(--wide) - 2 * var(--gutter)); margin-inline: auto; height: 60px; display: flex; align-items: center; gap: 20px; padding: 0; color: var(--fg);
    border: var(--line) solid transparent; border-radius: 999px; background: transparent;
    transition: background 400ms var(--ease), border-color 400ms var(--ease), box-shadow 400ms var(--ease), max-width var(--t), padding var(--t), color 300ms var(--ease); }
  .solid .bar { max-width: 1120px; padding: 0 8px 0 clamp(12px, 1.4vw, 20px); background: rgba(255, 255, 255, .92); -webkit-backdrop-filter: blur(20px) saturate(160%); backdrop-filter: blur(20px) saturate(160%); border-color: var(--hair); box-shadow: 0 14px 34px -22px rgba(0, 0, 0, .35); }
  .open .bar { background: transparent; border-color: transparent; box-shadow: none; color: #fff; max-width: calc(var(--wide) - 2 * var(--gutter)); padding: 0; }
  .brand { display: block; width: 66px; flex: none; transition: transform 400ms var(--ease); }
  .brand:hover { transform: rotate(-4deg) scale(1.04); }
  .links { position: relative; display: flex; gap: 2px; list-style: none; margin: 0 auto; padding: 0; transition: opacity 300ms var(--ease); }
  .open .links { opacity: 0; pointer-events: none; }
  .links a { position: relative; z-index: 1; display: block; font-weight: 500; font-size: 15px; letter-spacing: -0.01em; text-decoration: none; padding: 9px 15px; border-radius: 999px; opacity: .72; transition: opacity 260ms var(--ease); }
  .links a:hover, .links a[aria-current='page'] { opacity: 1; }
  .glide { position: absolute; left: 0; top: 0; bottom: 0; width: var(--w, 0); transform: translateX(var(--x, 0)); border-radius: 999px; background: var(--tint-2); opacity: 0; pointer-events: none;
    transition: transform 560ms cubic-bezier(.22, 1, .36, 1), width 560ms cubic-bezier(.22, 1, .36, 1), opacity 300ms var(--ease), background 300ms var(--ease); }
  .glide.hot { opacity: 1; }
  .glide.rest { opacity: 1; background: var(--tint); }
  .glide.still { transition: none; }
  .right { display: flex; align-items: center; gap: 8px; }
  .lang { position: relative; transition: opacity 300ms var(--ease); }
  .open .lang, .open .cta { opacity: 0; pointer-events: none; }
  .lang-b { display: inline-flex; align-items: center; gap: 6px; height: 40px; padding: 0 12px 0 10px; border: 0; border-radius: 999px; background: transparent; color: inherit; font: 600 13px/1 var(--font); letter-spacing: .04em; cursor: pointer; transition: background 220ms var(--ease); }
  .lang-b:hover, .lang-b[aria-expanded='true'] { background: var(--tint-2); }
  .globe { width: 18px; height: 18px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.4; transition: transform 700ms cubic-bezier(.22, 1, .36, 1); }
  .lang-b:hover .globe, .lang-b[aria-expanded='true'] .globe { transform: rotate(180deg); }
  .lang-m { position: absolute; right: 0; top: calc(100% + 10px); min-width: 168px; margin: 0; padding: 6px; list-style: none; background: var(--surface); color: var(--fg); border: 1px solid var(--edge); border-radius: 14px; box-shadow: var(--lift-l); transform-origin: top right; animation: lang-in 260ms cubic-bezier(.22, 1, .36, 1); }
  .lang-m[hidden] { display: none; }
  @keyframes lang-in { from { opacity: 0; transform: translateY(-6px) scale(.97); } }
  .lang-m a { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 9px; font-size: 14px; font-weight: 500; text-decoration: none; transition: background 180ms var(--ease); }
  .lang-m a:hover { background: var(--tint); }
  .lang-m .tick { opacity: 0; font-weight: 700; }
  .lang-m a[aria-current] .tick { opacity: 1; }
  .cta { padding: 12px 18px; font-size: 14px; border-radius: 999px; box-shadow: none; transition: opacity 300ms var(--ease), background 200ms var(--ease), padding 400ms cubic-bezier(.22, 1, .36, 1); }
  .ca { display: inline-block; width: 0; overflow: hidden; opacity: 0; transform: translateX(-6px); transition: width 400ms cubic-bezier(.22, 1, .36, 1), opacity 300ms var(--ease), transform 400ms cubic-bezier(.22, 1, .36, 1), margin 400ms cubic-bezier(.22, 1, .36, 1); }
  .cta:hover .ca { width: 1em; margin-left: 6px; opacity: 1; transform: none; }
  .burger { display: inline-flex; align-items: center; gap: 6px; height: 44px; padding: 0 10px 0 18px; border-radius: 999px; border: 1px solid var(--hair-2); background: transparent; color: inherit; font: 700 14px/1 var(--font); cursor: pointer; transition: background 220ms var(--ease), color 220ms var(--ease), border-color 220ms var(--ease); }
  @media (hover: hover) { .burger:hover { background: var(--fg); border-color: var(--fg); color: var(--bg); } .open .burger:hover { background: #fff; border-color: #fff; color: #000; } }
  .open .burger { border-color: rgba(255, 255, 255, .34); }
  .bl { position: relative; display: inline-grid; overflow: hidden; height: 1.1em; }
  .bl > span { grid-area: 1 / 1; transition: transform 420ms cubic-bezier(.7, 0, .2, 1); }
  .b-close { transform: translateY(110%); }
  .open .b-open { transform: translateY(-110%); }
  .open .b-close { transform: none; }
  .bi { position: relative; width: 26px; height: 26px; }
  .bi i { position: absolute; left: 6px; right: 6px; height: 1.5px; border-radius: 2px; background: currentColor; transition: transform 380ms var(--ease); }
  .bi i:first-child { top: 10px; } .bi i:last-child { top: 15px; }
  .open .bi i:first-child { transform: translateY(2.5px) rotate(45deg); }
  .open .bi i:last-child { transform: translateY(-2.5px) rotate(-45deg); }

  /* The expanded panel. */
  .menu { pointer-events: auto; position: fixed; inset: 0; z-index: 2; overflow-y: auto; background: var(--bg); color: var(--fg); clip-path: inset(0 0 100% 0); transition: clip-path 620ms cubic-bezier(.75, 0, .2, 1); }
  .menu.in { clip-path: inset(0 0 0 0); }
  .menu-in { max-width: var(--wide); margin-inline: auto; min-height: 100%; padding: calc(60px + 12px + clamp(32px, 6vh, 72px)) var(--gutter) clamp(28px, 5vh, 48px); display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(280px, .7fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .m-links { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(255, 255, 255, .18); }
  .m-links li { border-bottom: 1px solid rgba(255, 255, 255, .18); opacity: 0; transform: translateY(24px); transition: opacity 500ms var(--ease), transform 600ms var(--ease); }
  .menu.in .m-links li { opacity: 1; transform: none; transition-delay: calc(220ms + var(--i) * 55ms); }
  .m-links a { display: grid; grid-template-columns: auto 1fr; align-items: baseline; gap: 16px; padding: clamp(10px, 1.6vh, 16px) 0; text-decoration: none; }
  .m-t { font-weight: 700; font-size: clamp(34px, 4.6vw, 64px); line-height: 1; letter-spacing: -0.05em; transition: transform 420ms var(--ease), color 300ms var(--ease); }
  .m-d { justify-self: end; font-size: 15px; color: rgba(255, 255, 255, .55); opacity: 0; transform: translateX(-8px); transition: opacity 300ms var(--ease), transform 400ms var(--ease); }
  .m-links a:hover .m-t, .m-links a[aria-current='page'] .m-t { transform: translateX(14px); color: var(--pink); }
  .m-links a:hover .m-d { opacity: 1; transform: none; }
  .m-side { display: grid; gap: 28px; opacity: 0; transform: translateY(24px); transition: opacity 500ms var(--ease), transform 600ms var(--ease); }
  .menu.in .m-side { opacity: 1; transform: none; transition-delay: 420ms; }
  .m-k { margin: 0; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .m-reach { display: grid; gap: 10px; }
  .m-reach .m-k { color: rgba(255, 255, 255, .5); }
  .m-reach a { text-decoration: none; font-size: 16px; width: fit-content; background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size 300ms var(--ease); }
  .m-reach a:hover { background-size: 100% 1px; }
  .m-hire { margin-top: 6px; font-weight: 700; }
  .m-lang { display: inline-flex; align-items: center; gap: 10px; width: fit-content; padding: 10px 16px 10px 12px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, .3); text-decoration: none; font-size: 14px; font-weight: 600; transition: background 220ms var(--ease), color 220ms var(--ease); }
  .m-lang:hover { background: var(--fg); color: var(--bg); }
  .m-lang:hover .globe { transform: rotate(180deg); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  @media (max-width: 1080px) { .links { display: none; } .right { margin-left: auto; } }
  @media (max-width: 860px) {
    .menu-in { grid-template-columns: 1fr; gap: 32px; }
    .m-d { display: none; }
    .m-links a { grid-template-columns: 1fr; }
  }
  .m-cta { justify-self: start; padding: 16px 24px; font-size: 16px; background: var(--pink); border-color: var(--pink); color: var(--ink); }
  .m-cta:hover { background: #fff; border-color: #fff; color: var(--ink); }
  @media (max-width: 560px) {
    .lang { display: none; }
    .bar { height: 56px; gap: 12px; }
    .cta { padding: 11px 14px; font-size: 13px; }
    .burger { height: 40px; padding: 0 6px 0 14px; }
  }
  @media (max-width: 359px) { .cta { display: none; } }
  @media (prefers-reduced-motion: reduce) { .site-header, .bar, .menu, .m-links li, .m-side, .glide { transition: none; } }
</style>
