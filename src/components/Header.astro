---
import Logo from './Logo.astro';
import { t, other, type Locale } from '../i18n/strings';
import { href, swapLang } from '../i18n/paths';
interface Props { lang: Locale }
const { lang } = Astro.props;
const s = t(lang);
const path = Astro.url.pathname;
const links = [
  [href(lang, 'work'), s.nav.work], [href(lang, 'offers'), s.nav.offers], [href(lang, 'about'), s.nav.about], [`${href(lang)}#faq`, s.nav.faq],
] as const;
const isActive = (p: string) => !p.includes('#') && path.startsWith(p);
---
<header class="site-header">
  <nav class="wrap bar" aria-label="Main">
    <a href={href(lang)} class="brand" aria-label="Gecko, home"><Logo /></a>
    <ul class="links">
      {links.map(([p, label]) => <li><a href={p} aria-current={isActive(p) ? 'page' : undefined}>{label}</a></li>)}
    </ul>
    <div class="right">
      <a class="lang label" href={swapLang(path, other(lang))} hreflang={other(lang)} lang={other(lang)} aria-label={s.langName}>{s.langShort}</a>
      <a class="btn primary sm" href={href(lang, 'apply')}>{s.nav.apply}</a>
      <details class="menu">
        <summary class="btn sm" aria-label={s.nav.menu}>{s.nav.menu}</summary>
        <div class="sheet">
          {links.map(([p, label]) => <a href={p}>{label}</a>)}
          <a href={swapLang(path, other(lang))} lang={other(lang)}>{s.langName}</a>
        </div>
      </details>
    </div>
  </nav>
</header>
<style>
  .site-header { position: fixed; top: 0; left: 0; right: 0; z-index: 10; background: var(--white); color: var(--black); border-bottom: var(--line) solid transparent; transition: border-color 200ms var(--ease); }
  :global(.scrolled) .site-header { border-bottom-color: var(--black); }
  .bar { height: var(--header); display: flex; align-items: center; gap: 24px; }
  .brand { display: block; width: 76px; flex: none; }
  .links { display: flex; gap: 28px; list-style: none; margin: 0 0 0 auto; padding: 0; }
  .links a { font-weight: 500; font-size: 15px; text-decoration: none; padding-block: 6px; background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size 200ms var(--ease); }
  .links a:hover, .links a[aria-current='page'] { background-size: 100% 1px; }
  .right { display: flex; align-items: center; gap: 16px; }
  .lang { text-decoration: none; }
  .lang:hover { text-decoration: underline; text-underline-offset: 4px; }
  .btn.sm { padding: 11px 18px; font-size: 14px; }
  .menu { display: none; position: relative; }
  .menu summary { list-style: none; }
  .menu summary::-webkit-details-marker { display: none; }
  .sheet { position: absolute; right: 0; top: calc(100% + 12px); min-width: 220px; display: grid; background: var(--white); border: var(--line) solid var(--black); }
  .sheet a { padding: 14px 16px; text-decoration: none; font-weight: 500; border-bottom: var(--line) solid var(--black); }
  .sheet a:last-child { border-bottom: 0; }
  .sheet a:hover { background: var(--black); color: var(--white); }
  @media (max-width: 860px) {
    .links, .lang { display: none; }
    .menu { display: block; }
    .right { margin-left: auto; gap: 8px; }
  }
</style>
