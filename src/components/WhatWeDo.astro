---
// "One studio": the three Gecko divisions (Ads, Campaigns, Brand World), as a small show. The words stand on the left, drawn in outline; the one
// that is on fills with ink and sits on the pink marker, with its line under it. On the right a stage plays a short
// scene for it, built in code: a market study ticking itself off, a script being written and approved, a real reel on
// an edit timeline, a brand deck beside a back office taking orders. The show moves on by itself every few seconds;
// hovering or clicking a word holds it there. With reduced motion nothing moves and the first scene stays.
import { launch } from '../i18n/launch';
import { c } from '../i18n/copy';
import type { Locale } from '../i18n/strings';
import { ads } from '../data/work';
interface Props { lang: Locale }
const { lang } = Astro.props;
const L = launch(lang).what;
const why = c(lang).home.why;
const reel = ads[1] ?? ads[0];
const T = {
  en: { study: 'Market study', rows: ['Your business', 'Your market', 'Your strongest competitors'], angle: 'One written angle', rec: 'Shooting', edit: 'Edit', deck: 'Brand deck', bo: 'Back office', ex: 'Example', tabs: ['Orders', 'Products', 'Stock', 'Payments'], order: 'New order', st: ['Paid', 'Packed', 'Sent'] },
  fr: { study: 'Étude de marché', rows: ['Votre activité', 'Votre marché', 'Vos concurrents les plus forts'], angle: 'Un angle écrit', rec: 'Tournage', edit: 'Montage', deck: 'Brand deck', bo: 'Back-office', ex: 'Exemple', tabs: ['Commandes', 'Produits', 'Stock', 'Paiements'], order: 'Nouvelle commande', st: ['Payé', 'Emballé', 'Envoyé'] },
}[lang];
const tones = ['pink', 'black', 'blue'];
const check = '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10.5l3.2 3.2L15 6.8" /></svg>';
---
<section class="what-sec" id="what" aria-labelledby="what-t" data-what-wrap>
  <div class="pin">
  <div class="wrap wide what" data-what>
    <div class="left">
      <h2 class="h2 rv" id="what-t">{L.title}</h2>
      <ul class="words" role="tablist" aria-label={L.title}>
        {L.items.map(([w, k, d], i) => (
          <li class:list={[{ on: i === 0 }]} data-word={i}>
            <button type="button" role="tab" aria-selected={String(i === 0)} aria-controls={`what-s${i}`} id={`what-w${i}`}><span class="w">{w}</span></button>
            <p><b class="kick">{k}</b>{d}</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="stage" data-tone={tones[0]} data-stage>
      <ol class="steps" aria-hidden="true">{L.items.map((_, i) => <li><i style={`--n:${i}`}></i></li>)}</ol>
      <p class="count" aria-hidden="true"><b data-count>01</b><span>/ 0{L.items.length}</span></p>
      <!-- 1 Gecko Ads: a script writes itself, two hooks to test, then the stamp. -->
      <div class="scene on" id="what-s0" role="tabpanel" aria-labelledby="what-w0" data-scene="0">
        <div class="sheet script">
          <p class="k">{why.script.title}</p>
          <p class="hook" style="--i:0"><b>{why.hooks.a}</b><span>{why.hooks.lines[0]}</span></p>
          <p class="hook" style="--i:1"><b>{why.hooks.b}</b><span>{why.hooks.lines[1]}</span></p>
          <ol>{why.script.scenes.slice(1).map((x, i) => <li style={`--i:${i + 2}`}>{x}</li>)}</ol>
          <p class="stamp">{why.script.stamp}</p>
        </div>
      </div>

      <!-- 2 Gecko Campaigns: a real reel, recording, over an edit timeline with a moving playhead. -->
      <div class="scene" id="what-s1" role="tabpanel" aria-labelledby="what-w1" data-scene="1" hidden>
        <div class="shoot">
          <div class="frame">
            <img src={reel.poster} alt="" width="540" height="960" loading="lazy" decoding="async" />
            <video muted playsinline loop preload="none" tabindex="-1" aria-hidden="true" data-src={reel.clip ?? reel.src}></video>
            <span class="rec"><i aria-hidden="true"></i>{T.rec}</span>
          </div>
          <div class="timeline" aria-hidden="true">
            <span class="tl-k">{T.edit}</span>
            <div class="track"><i style="--w:22%"></i><i style="--w:14%"></i><i style="--w:30%"></i><i style="--w:12%"></i><i style="--w:18%"></i><b class="head"></b></div>
            <div class="track two"><i style="--w:40%"></i><i style="--w:24%"></i><i style="--w:32%"></i></div>
          </div>
        </div>
      </div>

      <!-- 3 Gecko Brand World: the brand deck, and a back office taking an order. -->
      <div class="scene" id="what-s2" role="tabpanel" aria-labelledby="what-w2" data-scene="2" hidden>
        <div class="brand">
          <div class="deck">
            <p class="k">{T.deck}</p>
            <p class="aa" aria-hidden="true">Aa</p>
            <div class="sw" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
          </div>
          <div class="office">
            <p class="k">{T.bo} <span>· {T.ex}</span></p>
            <ul class="tabs">{T.tabs.map((x, i) => <li class:list={[{ cur: i === 0 }]}>{x}</li>)}</ul>
            <ul class="orders" aria-hidden="true">
              {T.st.map((x, i) => <li style={`--i:${i}`}><span class="bar"></span><span class="chip">{x}</span></li>)}
            </ul>
            <p class="toast"><i aria-hidden="true"></i>{T.order}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  </div>
</section>

<script>
  const wrap = document.querySelector<HTMLElement>('[data-what-wrap]');
  const root = wrap?.querySelector<HTMLElement>('[data-what]');
  if (wrap && root) {
    const words = [...root.querySelectorAll<HTMLElement>('[data-word]')];
    const scenes = [...root.querySelectorAll<HTMLElement>('[data-scene]')];
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const tones = ['pink', 'black', 'blue'];
    const video = root.querySelector<HTMLVideoElement>('video')!;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wide = matchMedia('(min-width: 981px)');
    let at = 0, timer = 0, seen = false;
    const show = (i: number) => {
      at = Math.max(0, Math.min(words.length - 1, i));
      words.forEach((w, j) => { w.classList.toggle('on', j === at); w.classList.toggle('was', j < at); w.querySelector('button')!.setAttribute('aria-selected', String(j === at)); });
      scenes.forEach((s, j) => { s.hidden = j !== at; s.classList.remove('on'); });
      // The class goes on a frame later, so the scene's animations start from the top every time it comes up.
      requestAnimationFrame(() => requestAnimationFrame(() => scenes[at].classList.add('on')));
      stage.dataset.tone = tones[at];
      count.textContent = String(at + 1).padStart(2, '0');
      if (at === 1 && !still && seen) { if (!video.getAttribute('src')) video.src = video.dataset.src!; video.play().then(() => video.classList.add('live')).catch(() => {}); }
      else video.pause();
    };
    // Wide screens: the section pins and the scroll turns the page. Each word owns an equal share of the scroll.
    const span = () => wrap.offsetHeight - innerHeight;
    const onScroll = () => {
      if (!wide.matches) return;
      const p = Math.max(0, Math.min(0.999, -wrap.getBoundingClientRect().top / Math.max(1, span())));
      wrap.style.setProperty('--p', p.toFixed(4));
      wrap.style.setProperty('--q', ((p * words.length) % 1).toFixed(4));
      const i = Math.floor(p * words.length);
      if (i !== at) show(i);
    };
    let queued = false;
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(() => { queued = false; onScroll(); }); } }, { passive: true });
    addEventListener('resize', onScroll);
    // Narrow screens: no pin; it moves on by itself and a tap picks a word.
    const tick = (wait = 4200) => { clearTimeout(timer); if (!wide.matches && !still && seen && !document.hidden) timer = window.setTimeout(() => { show((at + 1) % words.length); tick(); }, wait); };
    words.forEach((w, j) => w.querySelector('button')!.addEventListener('click', () => {
      if (wide.matches) scrollTo({ top: wrap.getBoundingClientRect().top + scrollY + ((j + 0.5) / words.length) * span(), behavior: still ? 'auto' : 'smooth' });
      else { show(j); tick(9000); }
    }));
    document.addEventListener('visibilitychange', () => tick());
    new IntersectionObserver(([e]) => { seen = e.isIntersecting; if (seen) { tick(); if (at === 1) show(1); } else { clearTimeout(timer); video.pause(); } }, { threshold: 0.2 }).observe(root);
    onScroll();
  }
</script>

<style>
  /* Wide screens: the section is four screens tall and its content stays pinned while you scroll through it. */
  .what-sec { height: 300svh; }
  .pin { position: sticky; top: 0; height: 100svh; display: grid; align-items: center; padding-top: var(--header, 84px); overflow: hidden; }
  .what { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 96px); align-items: center; }
  .left { display: grid; gap: clamp(28px, 3.4vw, 56px); min-width: 0; }
  .left { gap: clamp(14px, 2.6svh, 40px); container-type: inline-size; }
  .left .h2 { max-width: 16ch; font-size: clamp(22px, min(2.6vw, 4.6svh), 44px); }

  /* The words: outline until they're on, then ink on the pink marker. */
  .words { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(2px, .5vw, 8px); }
  .words button { display: block; margin: 0; padding: 0; border: 0; background: none; color: inherit; font: inherit; text-align: left; cursor: pointer; }
  .w { display: inline-block; font-weight: 800; font-size: min(clamp(44px, min(7.2vw, 11svh), 128px), calc(100cqw / 6.6)); line-height: .98; white-space: nowrap; padding-inline: .04em; margin-inline: -.04em;
    color: transparent; -webkit-text-stroke: 2px #000; background: linear-gradient(var(--pink), var(--pink)) 0 84% / 0 36% no-repeat;
    transition: color 260ms var(--ease), background-size 620ms cubic-bezier(.65, 0, .35, 1); }
  .on .w { color: #000; -webkit-text-stroke-width: 0; background-size: 100% 36%; }
  .words li { transition: transform 520ms cubic-bezier(.2, .8, .2, 1); transform-origin: 0 50%; }
  .words li.on { transform: translateX(clamp(0px, 1vw, 16px)); }
  .words button:focus-visible .w { outline: 3px solid #000; outline-offset: 4px; }
  .words p .kick { display: block; margin-bottom: 4px; font-weight: 800; }
  .words p { margin: 0; max-width: 34rem; max-height: 0; overflow: hidden; opacity: 0; font-weight: 500; font-size: clamp(18px, 1.5vw, 22px); line-height: 1.4; transition: max-height 420ms var(--ease), opacity 300ms var(--ease), padding 420ms var(--ease); }
  .on p { max-height: 7em; opacity: 1; padding: 6px 0 14px; }
  /* Under the stage: where you are in the scroll, as four segments that fill. */
  .steps { position: absolute; z-index: 2; left: 22px; right: 22px; bottom: 20px; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: 6px; margin: 0; padding: 0; list-style: none; }
  .steps li { height: 6px; border-radius: 6px; box-shadow: inset 0 0 0 1.5px #000; overflow: hidden; }
  .steps li i { display: block; height: 100%; background: #000; transform-origin: 0 50%; transform: scaleX(clamp(0, calc(var(--p, 0) * 4 - var(--n)), 1)); }
  .stage[data-tone='black'] .steps li i { background: #fff; }
  .stage[data-tone='black'] .steps li { box-shadow: inset 0 0 0 1.5px #fff; }
  /* The scene drifts a little as you scroll through it. */
  .scene > * { transform: translateY(calc((var(--q, .5) - .5) * -28px)); transition: transform 120ms linear; }

  /* The stage: one filled block that changes colour with the scene. */
  .stage { position: relative; aspect-ratio: 1 / 1.02; width: min(100%, calc(min(700px, 100svh - var(--header, 84px) - 64px) / 1.02)); height: auto; justify-self: end; border-radius: 32px; overflow: hidden; background: var(--blue); color: #000; transition: background 520ms var(--ease); }
  .count { position: absolute; z-index: 2; right: 18px; top: 18px; margin: 0; display: inline-flex; align-items: baseline; gap: 6px; padding: 8px 14px; border-radius: 999px; background: #fff; color: #000; font-weight: 700; font-size: 13px; font-variant-numeric: tabular-nums; }
  .count b { font-weight: 800; font-size: 15px; }
  .stage[data-tone='pink'] { background: var(--pink); }
  .stage[data-tone='black'] { background: #000; color: #fff; }
  .scene { position: absolute; inset: 0; display: grid; place-items: center; padding: clamp(20px, 3vw, 48px); }
  .k { margin: 0; font-weight: 700; font-size: 13px; letter-spacing: .02em; }
  .sheet { width: min(100%, 440px); display: grid; gap: 18px; padding: clamp(22px, 2.4vw, 34px); border-radius: 24px; background: #fff; color: #000; }
  .scene.on .sheet, .scene.on .shoot, .scene.on .brand { animation: cut-in 520ms cubic-bezier(.2, .8, .2, 1) both; }
  @keyframes cut-in { from { opacity: 0; transform: translateY(18px) scale(.97); } }

  /* 1 Strategy */
  .tick { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: #000; }
  .tick :global(svg) { width: 16px; height: 16px; fill: none; stroke: #fff; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .fill { position: absolute; left: 40px; right: 0; bottom: 0; height: 4px; border-radius: 4px; background: #000; transform-origin: 0 50%; }
  .angle { margin: 4px 0 0; font-weight: 800; font-size: clamp(24px, 2.4vw, 34px); letter-spacing: -0.03em; }
  .angle span { padding-inline: .06em; background: linear-gradient(var(--pink), var(--pink)) 0 84% / 100% 38% no-repeat; }
  .scene.on .angle { animation: fade 300ms ease both 2000ms; }
  .scene.on .angle span { animation: mark 700ms cubic-bezier(.65, 0, .35, 1) both 2150ms; }
  @keyframes grow { from { transform: scaleX(0); } }
  @keyframes pop { from { transform: scale(0); } }
  @keyframes fade { from { opacity: 0; } }
  @keyframes mark { from { background-size: 0 38%; } }

  /* 2 Creative */
  .script { position: relative; }
  .hook { margin: 0; display: grid; gap: 4px; font-size: clamp(17px, 1.5vw, 21px); line-height: 1.3; font-weight: 500; }
  .hook b { font-size: 13px; font-weight: 700; }
  .hook span { width: fit-content; }
  .scene.on .hook span { animation: type 900ms steps(28) both; animation-delay: calc(300ms + var(--i) * 950ms); }
  .scene.on .hook b { animation: fade 200ms ease both; animation-delay: calc(250ms + var(--i) * 950ms); }
  @keyframes type { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  .script ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .script ol li { padding: 8px 14px; border-radius: 999px; background: #000; color: #fff; font-weight: 700; font-size: 14px; }
  .scene.on .script ol li { animation: pop 380ms cubic-bezier(.34, 1.56, .64, 1) both; animation-delay: calc(1500ms + var(--i) * 110ms); }
  .stamp { position: absolute; right: -10px; bottom: -16px; margin: 0; padding: 10px 18px; border-radius: 12px; background: var(--blue); font-weight: 800; font-size: clamp(22px, 2.2vw, 30px); letter-spacing: -0.02em; transform: rotate(-7deg); }
  .scene.on .stamp { animation: stamp 420ms cubic-bezier(.2, 1.4, .4, 1) both 2700ms; }
  @keyframes stamp { from { opacity: 0; transform: rotate(-7deg) scale(2.2); } }

  /* 3 Production */
  .shoot { height: 100%; width: 100%; display: grid; grid-template-rows: minmax(0, 1fr) auto; gap: clamp(14px, 1.6vw, 24px); justify-items: center; }
  .frame { position: relative; height: 100%; aspect-ratio: 9 / 16; border-radius: 22px; overflow: hidden; background: #000; }
  .frame img, .frame video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .frame video { opacity: 0; transition: opacity 400ms var(--ease); }
  .frame :global(video.live) { opacity: 1; }
  .rec { position: absolute; top: 12px; left: 12px; display: inline-flex; align-items: center; gap: 8px; padding: 7px 12px; border-radius: 999px; background: #fff; color: #000; font-weight: 700; font-size: 13px; }
  .rec i { width: 9px; height: 9px; border-radius: 50%; background: #000; animation: blink 1.1s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .timeline { width: 100%; display: grid; gap: 6px; }
  .tl-k { font-weight: 700; font-size: 13px; }
  .track { position: relative; display: flex; gap: 4px; height: 22px; }
  .track i { flex: 0 0 var(--w); border-radius: 6px; background: var(--pink); transform-origin: 0 50%; }
  .track i:nth-child(even) { background: #fff; }
  .track.two i { background: var(--blue); }
  .track.two { height: 12px; }
  .scene.on .track i { animation: grow 520ms cubic-bezier(.65, 0, .35, 1) both; animation-delay: calc(200ms + var(--n, 0) * 90ms); }
  .track i:nth-child(2) { --n: 1; } .track i:nth-child(3) { --n: 2; } .track i:nth-child(4) { --n: 3; } .track i:nth-child(5) { --n: 4; }
  .head { position: absolute; top: -5px; bottom: -22px; left: 0; width: 3px; border-radius: 3px; background: #fff; animation: play 4s linear infinite; }
  @keyframes play { to { left: 100%; } }

  /* 4 Brand and web */
  .brand { width: 100%; display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(10px, 1.2vw, 18px); align-items: center; }
  .deck, .office { display: grid; gap: 14px; padding: clamp(18px, 2vw, 28px); border-radius: 22px; background: #fff; }
  .deck { background: #000; color: #fff; transform: rotate(-4deg); }
  .aa { margin: 0; font-weight: 800; font-size: clamp(64px, 7vw, 120px); line-height: .9; letter-spacing: -0.05em; }
  .sw { display: flex; gap: 8px; }
  .sw i { width: 26px; height: 26px; border-radius: 50%; background: var(--pink); }
  .sw i:nth-child(2) { background: var(--blue); } .sw i:nth-child(3) { background: #fff; } .sw i:nth-child(4) { background: none; box-shadow: inset 0 0 0 2px #fff; }
  .scene.on .sw i { animation: pop 380ms cubic-bezier(.34, 1.56, .64, 1) both; animation-delay: calc(500ms + var(--n, 0) * 100ms); }
  .sw i:nth-child(2) { --n: 1; } .sw i:nth-child(3) { --n: 2; } .sw i:nth-child(4) { --n: 3; }
  .office { position: relative; }
  .office .k span { font-weight: 500; }
  .tabs { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; font-weight: 700; font-size: 13px; }
  .tabs li { padding: 7px 12px; border-radius: 999px; }
  .tabs .cur { background: #000; color: #fff; }
  .orders { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .orders li { display: flex; align-items: center; gap: 12px; }
  .orders .bar { flex: 1; height: 12px; border-radius: 12px; background: #000; transform-origin: 0 50%; }
  .orders li:nth-child(2) .bar { flex: .7; } .orders li:nth-child(3) .bar { flex: .85; }
  .orders .chip { flex: none; padding: 6px 12px; border-radius: 999px; background: var(--blue); font-weight: 700; font-size: 13px; }
  .orders li:nth-child(2) .chip { background: #000; color: #fff; } .orders li:nth-child(3) .chip { background: var(--pink); }
  .scene.on .orders .bar { animation: grow 600ms cubic-bezier(.65, 0, .35, 1) both; animation-delay: calc(500ms + var(--i) * 260ms); }
  .scene.on .orders .chip { animation: pop 380ms cubic-bezier(.34, 1.56, .64, 1) both; animation-delay: calc(900ms + var(--i) * 260ms); }
  .toast { position: absolute; right: -8px; top: -18px; margin: 0; display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border-radius: 999px; background: #000; color: #fff; font-weight: 700; font-size: 14px; }
  .toast i { width: 8px; height: 8px; border-radius: 50%; background: var(--pink); }
  .scene.on .toast { animation: toast 520ms cubic-bezier(.2, 1.4, .4, 1) both 1900ms; }
  @keyframes toast { from { opacity: 0; transform: translateY(-16px) scale(.9); } }

  @media (max-width: 980px) {
    .what-sec { height: auto; padding-block: var(--section); }
    .pin { position: static; height: auto; padding-top: 0; overflow: visible; }
    .what { grid-template-columns: 1fr; }
    .stage { width: 100%; }
    .stage { justify-self: stretch; aspect-ratio: 1 / 1.1; }
    .w { font-size: clamp(44px, 13vw, 84px); -webkit-text-stroke-width: 1.5px; }
  }
</style>
