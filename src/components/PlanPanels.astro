---
// The plans as large filled panels (plan rev 2, 3.5): Test in yellow, Regular in pink, Pro in black, Creative Partner as
// one wide blue panel under them. Prices come from data/offers.ts only. Used on the home page and on Offers.
import { t, type Locale } from '../i18n/strings';
import { c } from '../i18n/copy';
import { launch } from '../i18n/launch';
import { href } from '../i18n/paths';
import { test, monthly, fmt, type Offer } from '../data/offers';
interface Props { lang: Locale; part?: 'test' | 'monthly' | 'all' }
const { lang, part = 'all' } = Astro.props;
const o = t(lang).offers;
const p = c(lang).plans;
const L = launch(lang).plans;
const apply = href(lang, 'apply');
const perReel = (m: Offer) => Math.round(m.launch / (m.reels ?? 1));
const hooks = (m: Offer) => (m.key === 'regular' || m.key === 'pro' ? (m.reels ?? 0) * 2 : 0);
const [regular, pro, partner] = monthly;
const tone: Record<string, string> = { test: 'yellow', regular: 'pink', pro: 'black', partner: 'blue' };
const cards = part === 'test' ? [test] : part === 'monthly' ? [regular, pro, partner] : [test, regular, pro, partner];
const flag = (m: Offer) => (m.key === 'test' ? L.start : m.key === 'pro' ? L.lowest : '');
---
{cards.map((m) => (
  <article class={`pp ${tone[m.key]} k-${m.key}`}>
    <header>
      {flag(m) && <p class="flag">{flag(m)}</p>}
      <h3 class="name">{m.name}</h3>
      {m.for && <p class="for">{m.for[lang]}</p>}
    </header>
    <p class="price">
      {m.custom ? <b>{L.custom}</b> : <><b>{fmt(m.launch, lang)}</b> <span>{o.currency} {m.once ? p.once : p.month}</span></>}
    </p>
    <p class="works">
      {m.key === 'test' ? L.testWorks : m.custom ? p.customNote : L.perReel(perReel(m))}
    </p>
    <div class="gives">
      <p class="label">{L.gives}</p>
      <ul>
        {m.custom ? L.partnerGives.map((x) => <li>{x}</li>) : (
          <>
            <li>{m.max ? `${m.reels}–${m.max}` : m.reels} {m.once ? p.reelsOnce : p.reels}{hooks(m) ? ` · ${L.openings(hooks(m))}` : ''}</li>
            {m.shoot && m.once && <li>{m.shoot[lang]}</li>}
            {m.items[lang].map((x) => <li>{x}</li>)}
            {m.review && <li>{m.review[lang]}</li>}
          </>
        )}
      </ul>
    </div>
    <a class={`btn go ${m.key === 'pro' ? 'pink' : ''}`} href={`${apply}?plan=${m.key}`} aria-label={`${m.custom ? L.talk : L.choose}: ${m.name}`}>{m.custom ? L.talk : L.choose} {m.name} <span class="arr" aria-hidden="true">→</span></a>
  </article>
))}

<style>
  .pp { display: grid; align-content: start; gap: clamp(16px, 1.6vw, 24px); padding: clamp(24px, 2.4vw, 36px); border-radius: var(--r-lg); color: var(--ink); min-width: 0; --fg: #000; --bg: #fff; --hair-2: #000; }
  .pp.yellow { background: var(--yellow); }
  .pp.pink { background: var(--pink); }
  .pp.blue { background: var(--blue); }
  .pp.black { background: #000; color: #fff; --fg: #fff; --bg: #000; --hair-2: #fff; }
  .flag { display: inline-block; margin: 0 0 12px; padding: 6px 12px; border-radius: 999px; background: #000; color: #fff; font-weight: 700; font-size: 13px; }
  .black .flag { background: var(--pink); color: #000; }
  .name { margin: 0; font-weight: 800; font-size: clamp(34px, 3.4vw, 54px); line-height: .95; letter-spacing: -0.03em; }
  .for { margin: 10px 0 0; font-size: 17px; line-height: 1.4; font-weight: 500; }
  .price { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; }
  .price b { font-weight: 800; font-size: clamp(40px, 4.2vw, 68px); line-height: .9; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .price span { font-weight: 700; font-size: 16px; }
  .works { margin: -6px 0 0; font-weight: 700; font-size: 17px; }
  .gives ul { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 8px; font-weight: 500; font-size: 17px; line-height: 1.35; }
  .gives li { padding-left: 22px; position: relative; }
  .gives li::before { content: ''; position: absolute; left: 0; top: .72em; width: 10px; height: 2px; background: currentColor; }
  .go { justify-self: start; align-self: end; margin-top: 8px; }
  .black .go:hover { background: #fff; border-color: #fff; color: #000; }
  .pp.blue { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(24px, 4vw, 64px); }
  .pp.blue > header, .pp.blue > .go { grid-column: 1; }
  .pp.blue > .gives { grid-column: 2; grid-row: 1 / span 4; }
  @media (max-width: 900px) { .pp.blue { grid-template-columns: 1fr; } .pp.blue > .gives { grid-column: 1; grid-row: auto; } }
</style>
