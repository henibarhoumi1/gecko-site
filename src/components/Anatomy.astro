---
// The parts of a 30-second ad as a timeline. Each part is a button; the chosen one shows its note.
import { t, type Locale } from '../i18n/strings';
interface Props { lang: Locale }
const { lang } = Astro.props;
const h = t(lang).home;
const spans = [3, 5, 12, 6, 4]; // seconds per part, adds up to 30
---
<div class="anat" data-anat>
  <div class="track" role="tablist" aria-label={h.anatomyTitle}>
    {h.anatomy.map((p, i) => (
      <button type="button" role="tab" id={`anat-t${i}`} aria-controls={`anat-p${i}`} aria-selected={i === 0 ? 'true' : 'false'} style={`flex:${spans[i]}`}>
        <span class="label">{p.t}</span>
        <span class="small sec">{p.s}</span>
      </button>
    ))}
  </div>
  <div class="ticks small" aria-hidden="true"><span>0s</span><span>15s</span><span>30s</span></div>
  {h.anatomy.map((p, i) => (
    <div class="panel" role="tabpanel" id={`anat-p${i}`} aria-labelledby={`anat-t${i}`} hidden={i !== 0}>
      <p class="big">{p.s}</p>
      <div class="stack" style="--gap:10px">
        <h3 class="h3">{p.t}</h3>
        <p class="text text-l">{p.d}</p>
      </div>
    </div>
  ))}
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-anat]').forEach((el) => {
    const tabs = [...el.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panels = [...el.querySelectorAll<HTMLElement>('[role=tabpanel]')];
    const pick = (n: number) => {
      tabs.forEach((t, k) => t.setAttribute('aria-selected', String(k === n)));
      panels.forEach((p, k) => (p.hidden = k !== n));
    };
    tabs.forEach((t, k) => {
      t.addEventListener('click', () => pick(k));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          const n = (k + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length;
          pick(n); tabs[n].focus();
        }
      });
    });
  });
</script>
<style>
  .anat { display: grid; gap: 12px; }
  .track { display: flex; gap: 4px; padding: 4px; border-radius: 18px; background: var(--white); box-shadow: var(--shadow-1); border: 1px solid var(--hair); }
  .track button { min-width: 0; display: grid; align-content: space-between; gap: 20px; text-align: left; padding: 14px; min-height: 104px; font-family: var(--font); background: transparent; color: var(--ink); border: 0; border-radius: 14px; cursor: pointer; transition: background 260ms var(--ease), color 260ms var(--ease), transform 300ms var(--spring); }
  .track button:hover { background: var(--paper); }
  .track button[aria-selected='true'] { background: var(--ink); color: #fff; }
  .track button[aria-selected='true'] .label, .track button[aria-selected='true'] .sec { color: rgba(255, 255, 255, .7); }
  .track button[aria-selected='true'] .label { color: #fff; }
  .track .label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink); }
  .track .sec { color: var(--ink-2); }
  .ticks { display: flex; justify-content: space-between; color: var(--ink-2); padding-inline: 8px; }
  .panel { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 32px; align-items: start; padding-top: clamp(20px, 3vw, 40px); }
  .panel:not([hidden]) { animation: rise 420ms var(--ease); }
  .big { margin: 0; font-weight: 700; font-size: clamp(48px, 6vw, 96px); line-height: .95; letter-spacing: -0.05em; font-variant-numeric: tabular-nums; }
  .panel .text { color: var(--ink-2); max-width: 34rem; }
  @keyframes rise { from { opacity: 0; transform: translateY(10px); } }
  @media (max-width: 760px) {
    .track button { padding: 10px 6px; min-height: 84px; }
    .track .sec { display: none; }
    .track .label { font-size: 11px; }
    .panel { grid-template-columns: 1fr; gap: 12px; }
  }
</style>
