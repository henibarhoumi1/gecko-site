---
// Home: the client workspace. The pitch on top, then a close copy of the real client portal (the Gecko app at
// client.gecko-creative.com, 24 Nov 2026): the same sidebar, the stage rail, the three numbers, "what needs you",
// the approval cards, the production budget, notes on the exact second and the numbers per hook. Each screen is
// clickable; approving in Plan counts the badge down. It tours the screens while in view until someone clicks; with
// reduced motion it stays on Home. The brand in it, Nour, is invented. Under it, three reasons it changes the work.
import Logo from './Logo.astro';
import { href } from '../i18n/paths';
import type { Locale } from '../i18n/strings';
import { ads } from '../data/work';
interface Props { lang: Locale }
const { lang } = Astro.props;
const T = {
  en: {
    big: 'Watch your ads get made.', sub: 'Every idea, script, shoot day, cut, file and invoice lives in one private workspace. You see what we see, the moment we see it. Included in every plan, the Test too.',
    start: 'Start a project', cta: 'See how a project runs', ex: 'Example workspace',
    brand: 'Nour', camp: 'Spring launch', now: 'Now · Prep',
    nav: ['Home', 'Plan', 'Prep', 'Review', 'Results'], more: 'More',
    stages: ['Plan', 'Prep', 'Shoot', 'Edit', 'Delivery', 'Results'], when: 'Thursday 4 December · La Marsa',
    stats: [['Next', '4 Dec', 'Shoot day'], ['Scripts approved', '8 / 10', 'Read them, approve in one click'], ['Payment', '1,450 TND', 'Deposit, 50% to book the shoot']],
    needs: 'Here’s what needs you', todo: [['A script is ready for you', 'Pick the hook you like, comment on any line, then approve.'], ['An idea is waiting for you', 'Approve it or tell us what to change.'], ['Two faces for the shoot', 'See their fee and say yes or pass.']],
    links: [['Writing room', 'Every idea and script, where it’s at'], ['Tasks', 'One list with Gecko'], ['Brand sheet', 'Your brand on one page'], ['Numbers', 'What each video did']],
    planT: 'Scripts', planL: 'Each script is one reel, written the way we’ll film it. Pick the hook, comment on any line, then approve.', waiting: 'Waiting for your approval',
    s: { fmt: 'Problem → Fix', st: 'Waiting for you', ver: 'Version 3', t: 'The shelf of half-used serums', run: 'Runs about 28 s spoken · made for 30 s', hook: 'The hook', read: 'Read', bd: 'Breakdown', lines: ['Close-up: six half-used serums on a shelf.', '“I tried six. None of them lasted.”', 'One drop of Nour. The skin stays calm.'] },
    i: { fmt: 'Reel', st: 'Waiting for you', ver: 'Version 2', t: 'Same face, morning and evening', d: 'Split screen, 8:00 and 20:00. Nothing changes, and that’s the point.', by: 'By Gecko' },
    approve: 'Approve', changes: 'Ask for changes', comment: 'Comment', ok: 'Approved',
    prepT: 'Talent', budget: 'Production budget', cap: '1,300 TND', legend: [['Talent', '600 TND', 't'], ['Locations', '400 TND', 'l'], ['Props', '100 TND', 'p'], ['Costs and fees', '200 TND', 'c']], left: 'Left', leftV: '0 TND',
    note: 'Gecko pays these upfront and adds them to your balance invoice, each with its receipt.',
    people: [['Yasmine', 'Main role', '150 TND', 'Approved'], ['Karim', 'Voice', '120 TND', 'Waiting for you']], day: 'full day',
    revT: 'Reels', cut: 'Reel 02 · Cut 2', notesT: 'Your notes', notes: [['0:02', 'Logo one second earlier.'], ['0:11', 'Slower on the drop.']], fixed: 'Done in cut 2', approveCut: 'Approve this cut',
    resT: 'Numbers', resL: 'Each video read 7 and 30 days after it went live. Each number goes back to the hook that earned it.',
    hooks: [['Hook A · “Your serum isn’t the problem.”', 0.86, 'Keep'], ['Hook B · “I tried six serums.”', 0.58, 'Test again'], ['Hook C · The shelf, no words', 0.31, 'Drop']], next: 'Next month starts from Hook A.',
    feats: [['Nothing is filmed without your yes.', 'Every script, hook and call to action is written where you can read it. Approve in one click, or comment on the exact line.'], ['Notes on the exact second.', 'Pause any cut and leave a note at 0:02. The next version shows what changed.'], ['Results go back to each hook.', 'Your ad and store numbers sit next to the ads that earned them. The next scripts start from what sold.']],
  },
  fr: {
    big: 'Regardez vos pubs se faire.', sub: 'Chaque idée, script, journée de tournage, montage, fichier et facture vit dans un seul espace privé. Vous voyez ce qu’on voit, au moment où on le voit. Inclus dans chaque plan, le Test aussi.',
    start: 'Lancer un projet', cta: 'Voir comment un projet avance', ex: 'Exemple d’espace client',
    brand: 'Nour', camp: 'Lancement de printemps', now: 'Maintenant · Préparation',
    nav: ['Accueil', 'Plan', 'Préparation', 'Revue', 'Résultats'], more: 'Plus',
    stages: ['Plan', 'Prépa', 'Tournage', 'Montage', 'Livraison', 'Résultats'], when: 'Jeudi 4 décembre · La Marsa',
    stats: [['Ensuite', '4 déc.', 'Journée de tournage'], ['Scripts validés', '8 / 10', 'Lisez-les, validez en un clic'], ['Paiement', '1 450 TND', 'Acompte, 50 % pour réserver le tournage']],
    needs: 'Ce qui vous attend', todo: [['Un script est prêt pour vous', 'Choisissez l’accroche, commentez une ligne, puis validez.'], ['Une idée vous attend', 'Validez-la ou dites-nous quoi changer.'], ['Deux visages pour le tournage', 'Voyez leur cachet et dites oui ou non.']],
    links: [['Atelier d’écriture', 'Chaque idée et script, où il en est'], ['Tâches', 'Une seule liste avec Gecko'], ['Fiche de marque', 'Votre marque sur une page'], ['Chiffres', 'Ce que chaque vidéo a donné']],
    planT: 'Scripts', planL: 'Chaque script est un reel, écrit comme on va le tourner. Choisissez l’accroche, commentez une ligne, puis validez.', waiting: 'En attente de votre validation',
    s: { fmt: 'Problème → Solution', st: 'En attente de vous', ver: 'Version 3', t: 'L’étagère de sérums à moitié vides', run: 'Environ 28 s de texte · prévu pour 30 s', hook: 'L’accroche', read: 'Lire', bd: 'Découpage', lines: ['Gros plan : six sérums à moitié vides sur une étagère.', '« J’en ai essayé six. Aucun n’a tenu. »', 'Une goutte de Nour. La peau reste calme.'] },
    i: { fmt: 'Reel', st: 'En attente de vous', ver: 'Version 2', t: 'Le même visage, matin et soir', d: 'Écran partagé, 8 h et 20 h. Rien ne change, et c’est tout l’intérêt.', by: 'Par Gecko' },
    approve: 'Valider', changes: 'Demander des changements', comment: 'Commenter', ok: 'Validé',
    prepT: 'Talents', budget: 'Budget de production', cap: '1 300 TND', legend: [['Talents', '600 TND', 't'], ['Lieux', '400 TND', 'l'], ['Accessoires', '100 TND', 'p'], ['Coûts et frais', '200 TND', 'c']], left: 'Reste', leftV: '0 TND',
    note: 'Gecko les avance et les ajoute à votre facture de solde, chacun avec son reçu.',
    people: [['Yasmine', 'Rôle principal', '150 TND', 'Validé'], ['Karim', 'Voix', '120 TND', 'En attente de vous']], day: 'journée',
    revT: 'Reels', cut: 'Reel 02 · Montage 2', notesT: 'Vos notes', notes: [['0:02', 'Le logo une seconde plus tôt.'], ['0:11', 'Plus lent sur la goutte.']], fixed: 'Fait dans le montage 2', approveCut: 'Valider ce montage',
    resT: 'Chiffres', resL: 'Chaque vidéo lue 7 et 30 jours après sa mise en ligne. Chaque chiffre remonte à l’accroche qui l’a obtenu.',
    hooks: [['Accroche A · « Votre sérum n’est pas le problème. »', 0.86, 'On garde'], ['Accroche B · « J’ai testé six sérums. »', 0.58, 'À retester'], ['Accroche C · L’étagère, sans un mot', 0.31, 'On arrête']], next: 'Le mois prochain part de l’accroche A.',
    feats: [['Rien n’est tourné sans votre feu vert.', 'Chaque script, accroche et appel à l’action est écrit là où vous pouvez le lire. Validez en un clic, ou commentez la ligne exacte.'], ['Des notes à la seconde près.', 'Mettez un montage en pause et laissez une note à 0:02. La version suivante montre ce qui a changé.'], ['Les résultats remontent à chaque accroche.', 'Vos chiffres pub et boutique à côté des pubs qui les ont obtenus. Les scripts suivants partent de ce qui a vendu.']],
  },
}[lang];
const reel = ads[1];
const arrowR = '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5" /></svg>';
const tick = '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10.5l3.2 3.2L15 6.8" /></svg>';
const play = '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7 5l8 5-8 5z" /></svg>';
const at = 1; // the stage the example project is in: Prep
---
<section class="cp on-black" id="workspace" data-dark="1" aria-labelledby="cp-t">
  <div class="wrap wide cp-in">
    <div class="cp-head">
      <h2 class="ttl rv" id="cp-t">{T.big}</h2>
      <div class="cp-side rv" style="--d:80ms">
        <p class="line">{T.sub}</p>
        <div class="cp-act">
          <a class="btn pink lg" href={href(lang, 'apply')}>{T.start} <span class="arr" aria-hidden="true">→</span></a>
          <a class="btn lg" href={href(lang, 'process')}>{T.cta}</a>
        </div>
      </div>
    </div>

    <div class="app rv" style="--d:120ms" data-cp>
      <span class="cp-tag">{T.ex}</span>
      <div class="win">
        <div class="wbar"><i></i><i></i><i></i><span>client.gecko-creative.com</span></div>
        <div class="body">
          <nav class="side" aria-label={T.ex}>
            <span class="cp-logo"><Logo /></span>
            <b class="who">{T.brand}</b>
            {T.nav.map((x, i) => (
              <button type="button" class:list={['it', { on: i === 0 }]} data-go={i} aria-pressed={String(i === 0)}>
                {x}{i === 1 && <span class="badge" data-badge>2</span>}
              </button>
            ))}
            <span class="it more">{T.more}</span>
            <span class="lang"><b>EN</b><span>FR</span></span>
          </nav>

          <div class="screens">
            <!-- Home -->
            <div class="sc on" data-sc="0">
              <h3 class="big">{T.brand}</h3>
              <p class="camp">{T.camp}</p>
              <p class="now">{T.now}</p>
              <ol class="rail">
                {T.stages.map((x, i) => (
                  <li class:list={[{ done: i < at, cur: i === at }]}><i></i><b>{x}</b>{i === 2 && <span>{T.when}</span>}</li>
                ))}
              </ol>
              <div class="stats">{T.stats.map(([k, v, d]) => <div class="stat"><span class="k">{k}</span><b>{v}</b><span>{d}</span></div>)}</div>
              <div class="split">
                <div>
                  <h4 class="nh">{T.needs} <span class="cnt">3</span></h4>
                  <ul class="todo">
                    {T.todo.map(([t, d], i) => (
                      <li class:list={[{ first: i === 0 }]}><span class="n">{i + 1}</span><span class="tt"><b>{t}</b><span>{d}</span></span><span class="ar" set:html={arrowR} /></li>
                    ))}
                  </ul>
                </div>
                <ul class="links">{T.links.map(([t, d]) => <li><b>{t} →</b><span>{d}</span></li>)}</ul>
              </div>
            </div>

            <!-- Plan: an idea and a script, waiting -->
            <div class="sc" data-sc="1">
              <h3 class="pt">{T.planT}</h3>
              <p class="pl">{T.planL}</p>
              <h4 class="nh">{T.waiting} <span class="cnt" data-left>2</span></h4>
              <div class="cards">
                <article class="cd" data-card>
                  <p class="meta"><span class="tg y">{T.s.fmt}</span><b class="st"><span class="a">{T.s.st}</span><span class="b">{T.ok}</span></b><span>{T.s.ver}</span><span class="seg"><b>{T.s.read}</b><span>{T.s.bd}</span></span></p>
                  <h5>{T.s.t}</h5>
                  <p class="run">{T.s.run}</p>
                  <p class="hk">{T.s.hook}</p>
                  <div class="hbox">{T.s.lines.map((l, i) => <p class:list={[{ mark: i === 1 }]}>{l}</p>)}</div>
                  <div class="acts">
                    <button type="button" class="go" data-ok><span class="a">{T.approve}</span><span class="b"><Fragment set:html={tick} />{T.ok}</span></button>
                    <span class="ghost">{T.changes}</span><span class="txt">{T.comment}</span>
                  </div>
                </article>
                <article class="cd" data-card>
                  <p class="meta"><span class="tg y">{T.i.fmt}</span><b class="st"><span class="a">{T.i.st}</span><span class="b">{T.ok}</span></b><span>{T.i.ver}</span></p>
                  <h5>{T.i.t}</h5>
                  <p class="desc">{T.i.d}</p>
                  <p class="by">{T.i.by}</p>
                  <div class="acts">
                    <button type="button" class="go" data-ok><span class="a">{T.approve}</span><span class="b"><Fragment set:html={tick} />{T.ok}</span></button>
                    <span class="ghost">{T.changes}</span>
                  </div>
                </article>
              </div>
            </div>

            <!-- Prep: the production budget and the talent -->
            <div class="sc" data-sc="2">
              <h3 class="pt">{T.prepT}</h3>
              <div class="bud">
                <p class="bh"><b>{T.budget}</b><b class="cap">{T.cap}</b></p>
                <span class="bbar"><i class="t"></i><i class="l"></i><i class="p"></i><i class="c"></i></span>
                <dl class="leg">
                  {T.legend.map(([k, v, c]) => <div><dt><i class={c}></i>{k}</dt><dd>{v}</dd></div>)}
                  <div class="lf"><dt>{T.left}</dt><dd>{T.leftV}</dd></div>
                </dl>
                <p class="bn">{T.note}</p>
              </div>
              <ul class="ppl">
                {T.people.map(([n, r, f, st], i) => (
                  <li>
                    <span class={`face f${i}`}>{n.slice(0, 1)}</span>
                    <div><p class="pn"><b>{n}</b><span class:list={['tg', i === 0 ? 'bk' : 'y']}>{st}</span></p><p class="pr">{r} · <b>{f}</b> {T.day}</p></div>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Review: a cut with notes on the exact second -->
            <div class="sc" data-sc="3">
              <h3 class="pt">{T.revT}</h3>
              <div class="rev">
                <span class="vid"><img src={reel?.poster} alt="" width="270" height="480" loading="lazy" decoding="async" /><span class="pl2" set:html={play} /><span class="tbar"><i></i></span></span>
                <div class="rv-side">
                  <p class="meta"><b>{T.cut}</b></p>
                  <p class="hk">{T.notesT}</p>
                  <ul class="nts">{T.notes.map(([t, n]) => <li><b>{t}</b><span>{n}</span><em><Fragment set:html={tick} />{T.fixed}</em></li>)}</ul>
                  <span class="go solid">{T.approveCut}</span>
                </div>
              </div>
            </div>

            <!-- Results: the numbers per hook -->
            <div class="sc" data-sc="4">
              <h3 class="pt">{T.resT}</h3>
              <p class="pl">{T.resL}</p>
              <ul class="rs">
                {T.hooks.map(([h, v, verdict], i) => <li><b>{h}</b><span class="rs-bar"><i style={`--v:${v}`}></i></span><span class:list={['tg', i === 0 ? 'bk' : i === 1 ? 'y' : 'p']}>{verdict}</span></li>)}
              </ul>
              <p class="rs-next">{T.next}</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <ol class="feats">
      {T.feats.map(([t, d]) => <li class="rv"><b>{t}</b><p>{d}</p></li>)}
    </ol>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-cp]').forEach((app) => {
    const its = [...app.querySelectorAll<HTMLButtonElement>('[data-go]')];
    const scs = [...app.querySelectorAll<HTMLElement>('[data-sc]')];
    let at = 0, held = false, timer = 0, seen = false;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const show = (j: number) => {
      at = j;
      its.forEach((b, i) => { b.classList.toggle('on', i === j); b.setAttribute('aria-pressed', String(i === j)); });
      scs.forEach((s, i) => s.classList.toggle('on', i === j));
    };
    const tick = () => { clearTimeout(timer); if (held || still || !seen) return; timer = window.setTimeout(() => { show((at + 1) % scs.length); tick(); }, 4200); };
    its.forEach((b, i) => b.addEventListener('click', () => { held = true; clearTimeout(timer); show(i); }));
    app.querySelectorAll<HTMLButtonElement>('[data-ok]').forEach((b) => b.addEventListener('click', () => {
      held = true; clearTimeout(timer);
      b.closest('[data-card]')!.classList.toggle('ok');
      const left = app.querySelectorAll('[data-card]:not(.ok)').length;
      const badge = app.querySelector<HTMLElement>('[data-badge]')!;
      badge.textContent = String(left); badge.hidden = left === 0;
      const cnt = app.querySelector<HTMLElement>('[data-left]');
      if (cnt) cnt.textContent = String(left);
    }));
    new IntersectionObserver(([e]) => { seen = e.isIntersecting; if (seen) tick(); else clearTimeout(timer); }, { threshold: 0.4 }).observe(app);
  });
</script>

<style>
  .cp { background: #000; color: #fff; padding-block: clamp(96px, 9vw, 144px); }
  .cp-in { display: grid; gap: clamp(48px, 5vw, 80px); }
  .cp-head { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: 28px clamp(40px, 6vw, 120px); align-items: end; }
  .ttl { margin: 0; max-width: 11ch; font-weight: 800; font-size: clamp(56px, 7.2vw, 132px); line-height: .9; letter-spacing: -0.055em; font-stretch: 92%; }
  .cp-side { display: grid; justify-items: start; gap: 28px; }
  .line { margin: 0; font-weight: 500; font-size: clamp(18px, 1.35vw, 21px); line-height: 1.45; }
  .cp-act { display: flex; flex-wrap: wrap; gap: 12px; }
  .cp-act .btn:not(.pink) { color: #fff; border-color: #fff; background: transparent; }
  .cp-act .btn:not(.pink):hover { background: #fff; color: #000; }

  .feats { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(36px, 4vw, 64px) clamp(28px, 4vw, 72px); }
  .feats li { display: grid; gap: 12px; align-content: start; }
  .feats b { font-weight: 800; font-size: clamp(24px, 2.1vw, 34px); line-height: 1.04; letter-spacing: -0.035em; font-stretch: 94%; text-wrap: balance; }
  .feats p { margin: 0; font-weight: 500; font-size: 17px; line-height: 1.5; text-wrap: pretty; }

  /* The app: a copy of the client portal. White, thin black lines, pink for "you", yellow for "waiting". */
  .app { position: relative; min-width: 0; color: #000; }
  .cp-tag { position: absolute; z-index: 2; top: -15px; left: 22px; padding: 6px 12px; border-radius: 999px; background: var(--yellow); font-weight: 700; font-size: 13px; }
  .win { overflow: hidden; border-radius: 20px; background: #fff; }
  .wbar { display: flex; align-items: center; gap: 7px; height: 44px; padding: 0 16px; border-bottom: 1px solid #000; }
  .wbar i { width: 11px; height: 11px; border-radius: 50%; box-shadow: inset 0 0 0 1px #000; }
  .wbar span { margin-left: 10px; padding: 4px 14px; border-radius: 999px; box-shadow: inset 0 0 0 1px #000; font-weight: 600; font-size: 12.5px; }
  .body { display: grid; grid-template-columns: 200px minmax(0, 1fr); height: clamp(600px, 44vw, 700px); }

  .side { display: flex; flex-direction: column; gap: 4px; padding: 22px 14px 16px; border-right: 1px solid #000; }
  .cp-logo { display: block; width: 64px; margin: 0 0 18px 8px; }
  .cp-logo :global(svg) { display: block; width: 100%; height: auto; }
  .who { margin: 0 0 14px 8px; font-weight: 800; font-size: 19px; letter-spacing: -0.03em; }
  .it { display: flex; align-items: center; justify-content: space-between; height: 38px; padding: 0 12px; border: 0; border-radius: 10px; background: transparent; color: #000; font: 600 14px/1 var(--font); text-align: left; cursor: pointer; transition: background 200ms var(--ease); }
  .it:hover { background: var(--pink); }
  .it.on { background: #000; color: #fff; }
  .it.more { cursor: default; }
  .it.more:hover { background: none; }
  .badge { min-width: 20px; height: 20px; padding: 0 6px; border-radius: 999px; background: var(--pink); color: #000; font-size: 11.5px; font-weight: 700; display: grid; place-items: center; }
  .badge[hidden] { display: none; }
  .lang { margin-top: auto; display: inline-flex; width: fit-content; margin-left: 8px; padding: 3px; border-radius: 999px; box-shadow: inset 0 0 0 1px #000; font-size: 11px; font-weight: 700; }
  .lang > * { padding: 4px 9px; border-radius: 999px; }
  .lang b { background: var(--pink); }

  .screens { position: relative; min-width: 0; }
  .sc { position: absolute; inset: 0; padding: 30px 36px; display: flex; flex-direction: column; gap: 16px; overflow: hidden; opacity: 0; visibility: hidden; transition: opacity 300ms var(--ease), visibility 0s 300ms; }
  .sc.on { opacity: 1; visibility: visible; transition: opacity 360ms var(--ease); }
  .k { font-weight: 700; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
  .tg { display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; font-weight: 700; font-size: 12px; white-space: nowrap; }
  .tg.y { background: var(--yellow); } .tg.bk { background: #000; color: #fff; } .tg.p { background: var(--pink); }

  /* Home */
  .big { margin: 0; font-weight: 800; font-size: clamp(36px, 3.4vw, 52px); line-height: .95; letter-spacing: -0.05em; }
  .camp { margin: -6px 0 0; font-weight: 600; font-size: 16px; }
  .now { margin: -6px 0 0; font-weight: 700; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; }
  .rail { list-style: none; margin: 0; padding: 12px 0 0; border-top: 1px solid #000; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); }
  .rail li { position: relative; display: grid; gap: 6px; align-content: start; font-size: 12.5px; }
  .rail li::before { content: ''; position: absolute; top: 5px; left: 12px; right: 0; border-top: 2px dotted #000; }
  .rail li.done::before { border-top-style: solid; }
  .rail li:last-child::before { display: none; }
  .rail i { position: relative; z-index: 1; width: 12px; height: 12px; border-radius: 50%; background: #fff; box-shadow: inset 0 0 0 1.5px #000; }
  .rail .done i { background: #000; }
  .rail .cur i { background: var(--pink); box-shadow: inset 0 0 0 2px #000; animation: cur 2.2s var(--ease) infinite; }
  .rail span { font-size: 11.5px; line-height: 1.35; }
  @keyframes cur { 50% { transform: scale(1.35); } }
  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .stat { display: grid; gap: 4px; padding: 14px 16px; border-radius: 14px; box-shadow: inset 0 0 0 1px #000; }
  .stat b { font-weight: 800; font-size: 26px; letter-spacing: -0.04em; line-height: 1; }
  .stat > span:last-child { font-size: 12.5px; }
