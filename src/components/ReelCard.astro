---
// A reel as a rounded card. Plays muted on hover (desktop); a click opens it in the viewer.
import type { Ad } from '../data/work';
import type { Locale } from '../i18n/strings';
interface Props { ad: Ad; i: number; lang: Locale; eager?: boolean }
const { ad, i, lang, eager = false } = Astro.props;
---
<button type="button" class="reel" data-reel={i} data-src={ad.src} data-poster={ad.poster} data-title={ad.angle[lang]}>
  <span class="media">
    <img src={ad.poster} alt="" loading={eager ? 'eager' : 'lazy'} />
    <video muted loop playsinline preload="none" src={ad.src}></video>
    <span class="shade" aria-hidden="true"></span>
    <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"/></svg></span>
    <span class="title">{ad.angle[lang]}</span>
  </span>
</button>
<style>
  .reel { width: 100%; display: block; padding: 0; background: none; border: 0; color: #fff; text-align: left; cursor: pointer; font-family: var(--font); border-radius: var(--r); }
  .media { position: relative; display: block; aspect-ratio: 9 / 16; overflow: hidden; border-radius: var(--r); background: #111; box-shadow: var(--shadow-2); transform: translateZ(0); transition: transform 600ms var(--ease), box-shadow 600ms var(--ease); }
  .reel:hover .media, .reel:focus-visible .media { transform: translateY(-8px) scale(1.015); box-shadow: var(--shadow-3); }
  .media img, .media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 900ms var(--ease); }
  .reel:hover img { transform: scale(1.04); }
  .media video { opacity: 0; transition: opacity 400ms var(--ease); }
  .reel.live .media video { opacity: 1; }
  .shade { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgba(0, 0, 0, .55)); }
  .play { position: absolute; left: 14px; bottom: 14px; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; color: #fff; background: rgba(255, 255, 255, .22); -webkit-backdrop-filter: blur(14px) saturate(160%); backdrop-filter: blur(14px) saturate(160%); border: 1px solid rgba(255, 255, 255, .3); transition: transform 400ms var(--spring), background 300ms var(--ease); }
  .play svg { margin-left: 2px; }
  .reel:hover .play { transform: scale(1.12); background: rgba(255, 255, 255, .35); }
  .title { position: absolute; left: 70px; right: 14px; bottom: 25px; font-weight: 600; font-size: 15px; letter-spacing: -0.01em; text-shadow: 0 1px 8px rgba(0, 0, 0, .3); }
</style>
