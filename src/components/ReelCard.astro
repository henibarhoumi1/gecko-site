---
// A reel as a rounded card, no captions. Plays muted on hover (or while in view on phones),
// the round button at the bottom turns its sound on, and a click anywhere else opens it full screen.
import type { Ad } from '../data/work';
import { c } from '../i18n/copy';
import type { Locale } from '../i18n/strings';
interface Props { ad: Ad; i: number; lang: Locale; eager?: boolean }
const { ad, i, lang, eager = false } = Astro.props;
const w = c(lang).work;
const on = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9.5h3.5L12 6v12l-4.5-3.5H4z"/><path d="M15.5 9a4 4 0 010 6M18 6.5a7.5 7.5 0 010 11"/></svg>';
const off = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9.5h3.5L12 6v12l-4.5-3.5H4z"/><path d="M16 10l4 4M20 10l-4 4"/></svg>';
---
<div class="reel" data-reel={i} data-src={ad.src} data-poster={ad.poster}>
  <span class="media">
    <img src={ad.poster} alt="" loading={eager ? 'eager' : 'lazy'} />
    <video muted loop playsinline preload="none" src={ad.src}></video>
  </span>
  <button type="button" class="open" data-open aria-label={`${w.title1} ${i + 1}`}></button>
  <button type="button" class="snd" data-snd aria-pressed="false" aria-label={w.sound} data-on={w.sound} data-off={w.mute}>
    <span class="i-off" set:html={off} /><span class="i-on" set:html={on} />
  </button>
</div>
<script>
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const reels = [...document.querySelectorAll<HTMLElement>('.reel')];
  const vid = (r: HTMLElement) => r.querySelector('video')!;
  const btn = (r: HTMLElement) => r.querySelector<HTMLButtonElement>('[data-snd]')!;
  const play = (r: HTMLElement) => { const v = vid(r); v.preload = 'auto'; v.play().then(() => r.classList.add('live')).catch(() => {}); };
  const stop = (r: HTMLElement) => { vid(r).pause(); r.classList.remove('live'); setSound(r, false); };
  function setSound(r: HTMLElement, onNow: boolean) {
    const b = btn(r); vid(r).muted = !onNow;
    r.classList.toggle('loud', onNow); b.setAttribute('aria-pressed', String(onNow));
    b.setAttribute('aria-label', onNow ? b.dataset.off! : b.dataset.on!);
  }

  reels.forEach((r) => {
    if (fine) {
      r.addEventListener('mouseenter', () => { if (!still) play(r); });
      r.addEventListener('mouseleave', () => { if (!r.classList.contains('loud')) stop(r); });
    }
    btn(r).addEventListener('click', (e) => {
      e.stopPropagation();
      const turnOn = !r.classList.contains('loud');
      reels.forEach((x) => x !== r && x.classList.contains('loud') && stop(x));
      setSound(r, turnOn);
      if (turnOn) play(r);
    });
  });

  // Phones have no hover: each reel plays muted while it's mostly on screen. Any reel that leaves the screen stops.
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    const r = e.target as HTMLElement;
    if (e.isIntersecting && !fine && !still) play(r);
    else if (!e.isIntersecting) stop(r);
  }), { threshold: [0, .75] });
  reels.forEach((r) => io.observe(r));
  document.addEventListener('reel:open', () => reels.forEach(stop));
</script>
<style>
  .reel { position: relative; display: block; border-radius: var(--r); }
  .media { position: relative; display: block; aspect-ratio: 9 / 16; overflow: hidden; border-radius: var(--r); background: #000; border: var(--line) solid var(--reel-edge, var(--ink)); transform: translateZ(0); transition: transform 320ms cubic-bezier(.2, .7, .2, 1); }
  .reel:hover .media, .reel:focus-within .media { transform: scale(1.025); }
  .media img, .media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; background: #000; }
  .media video { opacity: 0; transition: opacity 300ms var(--ease); }
  .reel.live .media video { opacity: 1; }
  .open { position: absolute; inset: 0; z-index: 1; width: 100%; padding: 0; border: 0; background: none; border-radius: var(--r); cursor: pointer; }
  .snd { position: absolute; z-index: 2; left: 50%; bottom: 14px; width: 40px; height: 40px; margin-left: -20px; display: grid; place-items: center; padding: 0; border: 0; border-radius: 50%; color: #fff; background: rgba(0, 0, 0, .5); cursor: pointer; transition: background 200ms var(--ease), transform 200ms var(--ease); }
  .snd:hover { background: rgba(0, 0, 0, .72); }
  .snd:active { transform: scale(.94); }
  .snd span { display: grid; }
  .i-on, .loud .i-off { display: none !important; }
  .loud .i-on { display: grid !important; }
  @media (prefers-reduced-motion: reduce) { .media, .reel:hover .media { transition: none; transform: none; } }
</style>
