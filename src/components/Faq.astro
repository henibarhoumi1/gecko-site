---
// Questions on thin lines. With `scroll` the list scrolls inside itself until it reaches an end, then the page scrolls on,
// fades out at the bottom while there is more, and shows `hint` until the visitor reaches the end.
// With `limit` only the first questions show, as a plain list, and `more` adds a link to all of them underneath.
interface Props { items: readonly { q: string; a: string }[]; scroll?: boolean; hint?: string; limit?: number; more?: { href: string; label: string } }
const { items: all, scroll = false, hint, limit, more } = Astro.props;
const items = limit ? all.slice(0, limit) : all;
---
<div class={scroll ? 'faq-box' : undefined} data-faq-box={scroll ? '' : undefined}>
  <div class={`faq ${scroll ? 'scroll' : ''}`} tabindex={scroll ? 0 : undefined} role={scroll ? 'region' : undefined} aria-label={scroll ? 'FAQ' : undefined}>
    {items.map((f) => (
      <details>
        <summary><span>{f.q}</span><span class="pm" aria-hidden="true"></span></summary>
        <p class="text a">{f.a}</p>
      </details>
    ))}
  </div>
  {scroll && hint && <p class="hint" aria-hidden="true"><span>↓</span> {hint}</p>}
  {more && <a class="btn faq-more" href={more.href}>{more.label} <span class="arr" aria-hidden="true">→</span></a>}
</div>
{scroll && (
  <script>
    document.querySelectorAll<HTMLElement>('[data-faq-box]').forEach((box) => {
      const list = box.querySelector<HTMLElement>('.faq')!;
      const check = () => box.classList.toggle('end', list.scrollTop + list.clientHeight >= list.scrollHeight - 8);
      list.addEventListener('scroll', check, { passive: true });
      // The list scrolls on its own while it can; at either end the page takes over again, so the wheel never gets stuck here.
      list.addEventListener('wheel', (e) => {
        const can = e.deltaY < 0 ? list.scrollTop > 0 : list.scrollTop + list.clientHeight < list.scrollHeight - 1;
        if (can) e.stopPropagation();
      }, { passive: true });
      list.addEventListener('toggle', check, true);
      check();
    });
  </script>
)}
<style>
  .faq.scroll { max-height: min(62vh, 560px); overflow-y: auto; overscroll-behavior: contain; padding: 4px 10px 64px 2px; margin-right: -10px; scrollbar-width: thin; scrollbar-color: var(--hair-2) transparent;
    -webkit-mask-image: linear-gradient(#000 calc(100% - 72px), transparent); mask-image: linear-gradient(#000 calc(100% - 72px), transparent); }
  .faq.scroll::-webkit-scrollbar { width: 6px; }
  .faq.scroll::-webkit-scrollbar-thumb { background: var(--hair-2); border-radius: 6px; }
  .end .faq.scroll { -webkit-mask-image: none; mask-image: none; }
  .faq-more { margin-top: 18px; }
  .hint { margin: 10px 0 0; font-size: 15px; font-weight: 600; transition: opacity 240ms var(--ease); }
  .hint span { display: inline-block; animation: nudge 1.6s var(--ease) infinite; }
  .end .hint { opacity: 0; }
  @keyframes nudge { 50% { transform: translateY(3px); } }
  @media (prefers-reduced-motion: reduce) { .hint span { animation: none; } }
</style>
