---
// Home 3.4: the Brand World, in a blue section.
import { launch } from '../i18n/launch';
import { href } from '../i18n/paths';
import type { Locale } from '../i18n/strings';
interface Props { lang: Locale }
const { lang } = Astro.props;
const L = launch(lang).bw;
---
<section class="section bw-sec on-blue" id="brand-world" aria-labelledby="bw-t">
  <div class="wrap wide">
    <p class="tape flat rv">{L.label}</p>
    <h2 class="h1 bw-h rv" id="bw-t" style="--d:60ms">{L.title}</h2>
    <p class="lead text-l rv" style="--d:100ms">{L.lead}</p>

    <h3 class="sub rv">{L.startTitle}</h3>
    <ol class="start">
      {L.start.map((x, i) => <li class="rv" style={`--d:${i * 60}ms`}><span class="n">{i + 1}</span><p>{x}</p></li>)}
    </ol>

    <div class="cols">
      <div class="in rv">
        <h3 class="sub">{L.insideTitle}</h3>
        <ul>{L.inside.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div class="buy rv" style="--d:80ms">
        <p class="value">{L.value}</p>
        <p class="price">{L.price}</p>
        <div class="actions">
          <a class="btn primary lg" href={`${href(lang, 'apply')}?plan=brandworld`}>{L.quote} <span class="arr" aria-hidden="true">→</span></a>
          <a class="btn lg" href={href(lang, 'brand-world')}>{L.see} <span class="arr" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .bw-sec .bw-h { max-width: 14ch; margin-top: 18px; }
  .lead { margin: 22px 0 0; max-width: 40rem; font-weight: 500; }
  .sub { margin: clamp(40px, 5vw, 72px) 0 18px; font-weight: 800; font-size: clamp(22px, 2vw, 30px); letter-spacing: -0.02em; }
  .start { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(12px, 1.4vw, 20px); }
  .start li { display: grid; align-content: space-between; gap: 28px; min-height: 220px; padding: clamp(20px, 2vw, 28px); border-radius: var(--r); background: var(--white); }
  .start .n { font-weight: 800; font-size: 44px; line-height: 1; }
  .start p { margin: 0; font-weight: 700; font-size: clamp(18px, 1.5vw, 22px); line-height: 1.25; }
  .cols { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 96px); }
  .in ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; font-weight: 500; font-size: clamp(17px, 1.4vw, 20px); line-height: 1.35; }
  .in li { padding-left: 24px; position: relative; }
  .in li::before { content: ''; position: absolute; left: 0; top: .7em; width: 11px; height: 2px; background: #000; }
  .buy { display: grid; align-content: start; gap: 20px; margin-top: clamp(40px, 5vw, 72px); }
  .value { margin: 0; font-weight: 800; font-size: clamp(22px, 2vw, 30px); line-height: 1.15; letter-spacing: -0.02em; }
  .price { margin: 0; font-weight: 500; font-size: 18px; line-height: 1.4; }
  @media (max-width: 1100px) { .start { grid-template-columns: repeat(2, minmax(0, 1fr)); } .cols { grid-template-columns: 1fr; } .buy { margin-top: 0; } }
</style>
