---
import Logo from './Logo.astro';
import { c } from '../i18n/copy';
import { t, type Locale } from '../i18n/strings';
import { href } from '../i18n/paths';
import { site } from '../data/site';
interface Props { lang: Locale }
const { lang } = Astro.props;
const s = t(lang);
const n = c(lang).nav;
---
<footer class="site-footer">
  <div class="wrap inner">
    <div class="stack" style="--gap:14px">
      <a href={href(lang)} class="brand" aria-label="Gecko"><Logo /></a>
      <p class="text soft">{s.line}</p>
      <a class="btn primary" href={href(lang, 'apply')}>{n.apply} <span class="arr" aria-hidden="true">→</span></a>
    </div>
    <nav class="col" aria-label="Footer">
      <a href={href(lang, 'work')}>{n.work}</a>
      <a href={href(lang, 'process')}>{n.process}</a>
      <a href={href(lang, 'offers')}>{n.offers}</a>
      <a href={href(lang, 'about')}>{n.about}</a>
      <a href={href(lang, 'creators')}>{s.creators.footer}</a>
    </nav>
    <div class="col">
      <a href={site.whatsapp} rel="noopener">{s.contact.whatsapp} {site.phone}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.instagram} rel="noopener">{s.contact.instagram} {site.instagramHandle}</a>
      <span class="soft">{s.footer.address}</span>
    </div>
  </div>
  <div class="wrap base">
    <p class="small soft">© {new Date().getFullYear()} Gecko</p>
    <a class="small soft" href={href(lang, 'legal')}>{s.footer.legal}</a>
  </div>
</footer>
<style>
  .site-footer { padding-block: clamp(64px, 8vw, 104px) 28px; background: var(--paper); }
  .inner { display: grid; grid-template-columns: 1.6fr 1fr 1.2fr; gap: 40px; }
  .brand { display: block; width: 104px; }
  .stack .btn { justify-self: start; margin-top: 8px; }
  .col { display: grid; align-content: start; gap: 12px; font-size: 15px; }
  .col a { text-decoration: none; overflow-wrap: anywhere; color: var(--ink); }
  .col a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .base { margin-top: clamp(48px, 7vw, 80px); padding-top: 20px; border-top: 1px solid var(--hair); display: flex; justify-content: space-between; gap: 16px; }
  .base p { margin: 0; }
  .base a { text-decoration: none; }
  @media (max-width: 760px) { .inner { grid-template-columns: 1fr; } }
</style>
