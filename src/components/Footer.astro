---
// Dark footer, kept short: an optional call to action, then the monogram, pages, contact and socials in one row.
import { c } from '../i18n/copy';
import { t, type Locale } from '../i18n/strings';
import { href } from '../i18n/paths';
import { site } from '../data/site';
interface Props { lang: Locale; cta?: boolean }
const { lang, cta = true } = Astro.props;
const s = t(lang);
const k = c(lang);
const n = k.nav;
---
<footer class="site-footer on-black">
  {cta && <div class="wrap wide">
    <a class="big" href={href(lang, 'apply')}>{n.apply} <span aria-hidden="true">→</span></a>
  </div>}
  <div class="wrap wide inner">
    <a href={href(lang)} class="mark" aria-label="Gecko"><img src="/brand/monogram-white.svg" alt="" width="58" height="102" /></a>
    <nav class="col" aria-label="Footer">
      <p class="h">{k.footer.pages}</p>
      <div class="pages">
        <a href={href(lang, 'work')}>{n.work}</a>
        <a href={href(lang, 'offers')}>{n.offers}</a>
        <a href={href(lang, 'process')}>{n.process}</a>
        <a href={href(lang, 'about')}>{n.about}</a>
        <a href={href(lang, 'faq')}>{n.faq}</a>
        <a href={href(lang, 'contact')}>{n.contact}</a>
      </div>
    </nav>
    <div class="col">
      <p class="h">{k.footer.reach}</p>
      <a href={site.whatsapp} rel="noopener">WhatsApp {site.phone}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <span>{s.footer.address}</span>
    </div>
    <div class="col">
      <p class="h">{k.footer.follow}</p>
      {site.socials.map((x) => <a href={x.url} rel="noopener">{x.name} {x.handle}</a>)}
      <a href={href(lang, 'join')}>{k.join.nav}</a>
    </div>
  </div>
  <div class="wrap wide"><div class="base">
    <p>© {new Date().getFullYear()} Gecko</p>
    <span class="links">
      <a href={site.portal} rel="noopener">{s.footer.portal}</a>
      <a href={href(lang, 'legal')}>{s.footer.legal}</a>
    </span>
  </div></div>
</footer>
<style>
  .site-footer { padding-block: clamp(44px, 5vw, 72px) 22px; background: var(--bg); color: var(--fg); border-top: 1px solid var(--hair); }
  .big { display: block; font-weight: 700; font-size: clamp(36px, 6vw, 96px); letter-spacing: -0.05em; line-height: .95; text-decoration: none; color: var(--fg); padding-bottom: clamp(24px, 3vw, 40px); margin-bottom: clamp(28px, 3.5vw, 48px); border-bottom: 1px solid var(--hair); }
  .big span { display: inline-block; color: var(--pink); transition: transform 360ms var(--ease); }
  .big:hover span { transform: translateX(16px); }
  .inner { display: grid; grid-template-columns: 1fr auto auto auto; gap: 28px clamp(36px, 5vw, 96px); align-items: start; }
  .mark { display: block; width: clamp(34px, 3vw, 44px); }
  .mark img { width: 100%; height: auto; }
  .h { margin: 0 0 4px; font-weight: 700; font-size: 13px; color: var(--fg-3); }
  .col { display: grid; align-content: start; gap: 10px; font-size: 15px; }
  .pages { display: grid; grid-template-columns: repeat(2, auto); gap: 10px 36px; justify-content: start; }
  .col a { text-decoration: none; color: var(--fg); width: fit-content; white-space: nowrap; }
  .col a:hover { color: var(--pink); }
  .base { margin-top: clamp(32px, 4vw, 52px); padding-top: 16px; border-top: 1px solid var(--hair); display: flex; justify-content: space-between; gap: 16px; font-size: 13px; color: var(--fg-3); }
  .base p { margin: 0; }
  .base a { color: inherit; text-decoration: none; }
  .base a:hover { color: var(--fg); }
  .base .links { display: flex; gap: 20px; flex-wrap: wrap; }
  /* Narrow screens: the monogram steps aside (the bar already carries the logo) and the columns wrap. */
  @media (max-width: 860px) { .inner { grid-template-columns: repeat(3, auto); justify-content: start; } .mark { display: none; } }
  @media (max-width: 560px) { .inner { grid-template-columns: 1fr; gap: 28px; } .pages { grid-template-columns: repeat(3, auto); gap: 10px 28px; } .col { font-size: 15px; } .col a { white-space: nowrap; } }
</style>
