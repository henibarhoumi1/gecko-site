---
// Closing call to action: one big line and the two ways to reach us.
import { type Locale } from '../i18n/strings';
import { c } from '../i18n/copy';
import { href } from '../i18n/paths';
import { site } from '../data/site';
interface Props { lang: Locale; title: string }
const { lang, title } = Astro.props;
const n = c(lang).nav;
---
<section class="section cta-sec">
  <div class="wrap wide cta">
    <h2 class="h1 rv">{title}</h2>
    <div class="actions rv" style="--d:120ms">
      <a class="btn primary" href={href(lang, 'apply')}>{n.apply} <span class="arr" aria-hidden="true">→</span></a>
      <a class="btn" href={site.whatsapp} rel="noopener">WhatsApp</a>
    </div>
  </div>
</section>
<style>
  .cta-sec { border-top: 1px solid var(--hair); padding-block: clamp(80px, 10vw, 160px); }
  .cta { display: flex; justify-content: space-between; align-items: end; gap: 32px; flex-wrap: wrap; }
  .cta .h1 { max-width: 13ch; font-size: clamp(44px, 6.4vw, 104px); }
</style>
