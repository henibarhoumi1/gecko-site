---
// Home page pricing: pick a plan on the left, its card fills the right. The full comparison lives on Offers.
// When the brief above is sent, it opens on the plan that fits and marks it (the gecko:plan event).
import { t, type Locale } from '../i18n/strings';
import { c } from '../i18n/copy';
import { href } from '../i18n/paths';
import { plans, fmt } from '../data/offers';
interface Props { lang: Locale }
const { lang } = Astro.props;
const o = t(lang).offers;
const cur = o.currency;
const p = c(lang).plans;
const h = c(lang).home;
const start = 0;
---
<div class="picker" data-picker data-locale={lang === 'en' ? 'en-US' : 'fr-FR'}>
  <div class="side">
    <div class="intro rv">
      <h2 class="h2">{h.plansTitle}</h2>
    </div>
    <div class="tabs rv" style="--d:80ms" role="tablist" aria-label={h.plansTitle}>
      {plans.map((m, i) => (
        <button type="button" role="tab" id={`tab-${m.key}`} aria-controls={`panel-${m.key}`} aria-selected={String(i === start)} tabindex={i === start ? 0 : -1} data-tab={i} data-key={m.key}>
          <span class="nm">{m.name} <span class="you" hidden>{p.forYou}</span></span>
          <span class="meta">{m.max ? `${m.reels}–${m.max}` : m.reels} reels · {m.custom ? p.customShort : `${fmt(m.launch, lang)} ${cur}`}</span>
        </button>
      ))}
      <button type="button" role="tab" id="tab-bespoke" aria-controls="panel-bespoke" aria-selected="false" tabindex="-1" data-tab={plans.length} data-key="bespoke" class="bes">
        <span class="nm">{p.bespokeName} <span class="you" hidden>{p.forYou}</span></span>
        <span class="meta">{p.bespokeMeta}</span>
      </button>
    </div>
    <a class="all rv" style="--d:140ms" href={href(lang, 'offers')}>{h.plansCta} <span aria-hidden="true">→</span></a>
  </div>

  <div class="stage rv" style="--d:120ms">
    {plans.map((m, i) => (
      <div class={`card ${m.custom ? 'dark on-black' : ''}`} role="tabpanel" id={`panel-${m.key}`} aria-labelledby={`tab-${m.key}`} hidden={i !== start} data-panel={i}>
        {!m.custom && <span class={`sticker ${m.once ? 'once' : ''}`} aria-hidden="true">{m.once ? p.exclusive : o.launch}</span>}
        <header>
          <p class="fitb" hidden>✓ {p.fit}</p>
          <h3 class="name">{m.name}</h3>
          {m.for && <p class="for">{m.for[lang]}</p>}
        </header>
        <div class="price">
          {m.custom ? (
            <p class="amount"><span class="num word">{p.custom}</span></p>
          ) : (
            <p class="amount">
              <span class="num" data-num={m.launch}>{fmt(m.launch, lang)}</span>
              <span class="unit">{cur} {m.once ? p.once : p.month}</span>
            </p>
          )}
        </div>
        <p class="reels"><b>{m.max ? `${m.reels}–${m.max}` : m.reels}</b> {m.once ? p.reelsOnce : p.reels}</p>
        <dl class="spec">
          <div><dt>{p.spec.shoot}</dt><dd>{m.shoot?.[lang]}</dd></div>
          <div><dt>{p.spec.review}</dt><dd>{m.review?.[lang]}</dd></div>
        </dl>
        <ul class="ticks-list">{m.items[lang].map((it) => <li>{it}</li>)}</ul>
        <p class="out">{p.spec.out}</p>
        <a class={`btn ${m.custom ? '' : 'primary'}`} href={`${href(lang, 'apply')}?plan=${m.key}`}>{m.custom ? p.talk : `${p.choose} ${m.name}`} <span class="arr" aria-hidden="true">→</span></a>
      </div>
    ))}
    <div class="card bespoke" role="tabpanel" id="panel-bespoke" aria-labelledby="tab-bespoke" hidden data-panel={plans.length}>
      <header>
        <p class="fitb" hidden>✓ {p.fit}</p>
        <h3 class="name">{p.bespokeName}</h3>
        <p class="for">{p.bespokeFor}</p>
      </header>
      <div class="price"><p class="amount"><span class="num word">{p.bespokePrice}</span></p></div>
      <ul class="kinds">{c(lang).offers.beyond.items.map((it) => <li><b>{it.t}</b><span>{it.d}</span></li>)}</ul>
      <p class="out">{p.bespokeNote}</p>
      <a class="btn primary" href={`${href(lang, 'apply')}?plan=bespoke`}>{c(lang).offers.beyond.cta} <span class="arr" aria-hidden="true">→</span></a>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-picker]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const nf = new Intl.NumberFormat(root.dataset.locale);
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let at = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
    let shown = Number(panels[at].querySelector<HTMLElement>('[data-num]')?.dataset.num ?? 0);

    const count = (el: HTMLElement, from: number, to: number) => {
      if (still) return;
      const t0 = performance.now();
      const step = (now: number) => {
        const k = Math.min(1, (now - t0) / 520); const e = 1 - Math.pow(1 - k, 3);
        el.textContent = nf.format(k < 1 ? Math.round((from + (to - from) * e) / 10) * 10 : to).replace(/\s/g, ' ');
        if (k < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    const pick = (i: number, focus = false) => {
      if (i === at) return;
      const dir = i > at ? 1 : -1;
      tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === i)); t.tabIndex = k === i ? 0 : -1; });
      panels[at].hidden = true; panels[i].hidden = false;
      const num = panels[i].querySelector<HTMLElement>('[data-num]');
      if (num) { const to = Number(num.dataset.num); count(num, shown || to, to); shown = to; }
      if (!still) {
        panels[i].animate([{ opacity: 0, transform: `translateX(${dir * 24}px) rotate(${dir * 0.6}deg)` }, { opacity: 1, transform: 'none' }], { duration: 420, easing: 'cubic-bezier(.2,.7,.2,1)' });
        panels[i].querySelectorAll('.ticks-list li').forEach((li, k) => li.animate([{ opacity: 0, transform: 'translateY(6px)' }, { opacity: 1, transform: 'none' }], { duration: 360, delay: 80 + k * 45, easing: 'cubic-bezier(.2,.7,.2,1)', fill: 'backwards' }));
      }
      at = i;
      if (focus) tabs[i].focus();
    };
    addEventListener('gecko:plan', (e) => {
      const i = tabs.findIndex((t) => t.dataset.key === (e as CustomEvent).detail);
      if (i < 0) return;
      tabs.forEach((t, k) => (t.querySelector<HTMLElement>('.you')!.hidden = k !== i));
      panels.forEach((x, k) => (x.querySelector<HTMLElement>('.fitb')!.hidden = k !== i));
      pick(i);
    });
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => pick(i));
      t.addEventListener('keydown', (e) => {
        const n = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        if (n) { e.preventDefault(); pick((at + n + tabs.length) % tabs.length, true); }
      });
    });
  });
</script>

<style>
  .picker { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .picker .h2 { font-size: clamp(40px, 5.4vw, 80px); }
  .side { display: grid; gap: clamp(24px, 3vw, 36px); position: sticky; top: 110px; }
  .intro { display: grid; gap: 16px; }
  .intro .h2 { max-width: 10ch; }
  .you { display: inline-block; margin-left: 6px; padding: 3px 8px; border-radius: 999px; background: var(--yellow); color: var(--ink); font-size: 11px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; vertical-align: 2px; }
  .you[hidden] { display: none; }
  .fitb { margin: 0 0 4px; justify-self: start; padding: 6px 12px; border-radius: 999px; background: var(--pink); color: var(--ink); font-size: 13px; font-weight: 700; }
  .fitb[hidden] { display: none; }
  .tabs { display: grid; gap: 8px; }
  .tabs button { display: flex; justify-content: space-between; align-items: center; gap: 16px; width: 100%; padding: 18px 20px; text-align: left; font: inherit; color: var(--fg); background: transparent; border: 1px solid var(--edge); border-radius: 16px; cursor: pointer; transition: background 220ms var(--ease), border-color 220ms var(--ease), color 220ms var(--ease); }
  .tabs button:hover { border-color: var(--hair-2); background: var(--tint); }
  .tabs [aria-selected='true'], .tabs [aria-selected='true']:hover { background: var(--mat); border-color: var(--mat); color: #fff; }
  .tabs .bes { border-style: dashed; border-color: var(--hair-2); }
  .nm { font-weight: 700; font-size: clamp(19px, 1.6vw, 22px); letter-spacing: -0.02em; }
  .meta { font-size: 15px; font-weight: 600; white-space: nowrap; opacity: .62; }
  [aria-selected='true'] .meta { opacity: .75; }
  .all { font-weight: 600; text-decoration: none; width: fit-content; color: var(--fg-2); transition: color 200ms var(--ease); }
  .all:hover { color: var(--fg); }
  .all span { display: inline-block; transition: transform 260ms var(--ease); }
  .all:hover span { transform: translateX(4px); }

  .stage { display: grid; }
  .card { position: relative; display: grid; gap: 22px; padding: clamp(26px, 3vw, 44px); background: var(--surface); border: 1px solid var(--edge); border-radius: 24px; box-shadow: var(--lift-l); }
  .card header { display: grid; gap: 8px; padding-right: 150px; }
  .name { margin: 0; font-weight: 700; font-size: clamp(26px, 2.4vw, 34px); letter-spacing: -0.035em; }
  .for { margin: 0; font-size: 17px; line-height: 1.4; max-width: 28rem; color: var(--fg-2); }
  .sticker { position: absolute; top: clamp(22px, 2.4vw, 36px); right: clamp(22px, 2.4vw, 36px); padding: 7px 12px; border-radius: 999px; background: var(--pink); color: var(--ink); font-weight: 700; font-size: 11px; line-height: 1; letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; }
  .sticker.once { background: var(--yellow); }
  .price { display: grid; gap: 6px; padding-block: 18px; border-block: 1px solid var(--hair); }
  .amount { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; }
  .num.word { font-size: clamp(48px, 5vw, 80px); }
  .num { font-weight: 700; font-size: clamp(64px, 7vw, 112px); line-height: 1; letter-spacing: -0.06em; font-variant-numeric: tabular-nums; }
  .unit { font-weight: 600; font-size: clamp(17px, 1.4vw, 20px); color: var(--fg-2); }
  .reels { margin: 0; font-size: 17px; color: var(--fg-2); }
  .reels b { font-size: 22px; letter-spacing: -0.02em; color: var(--fg); }
  .card .ticks-list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 20px; font-size: 16px; }
  .spec { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0; border: 1px solid var(--edge); border-radius: 14px; overflow: hidden; }
  .spec div { padding: 12px 14px; display: grid; gap: 4px; }
  .spec div + div { border-left: 1px solid var(--hair); }
  .spec dt { font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--fg-3); }
  .spec dd { margin: 0; font-size: 16px; font-weight: 600; line-height: 1.3; }
  .out { margin: 0; font-size: 14px; line-height: 1.45; color: var(--fg-3); }
  .kinds { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 14px 22px; }
  .kinds li { display: grid; gap: 4px; padding-top: 12px; border-top: 1px solid var(--hair); }
  .kinds b { font-size: 17px; letter-spacing: -0.01em; }
  .kinds span { font-size: 15px; line-height: 1.45; color: var(--fg-2); }
  .card .btn { justify-self: start; }
  /* Creative Partner and bespoke projects carry a faint pink or yellow light. */
  .dark { background: radial-gradient(120% 70% at 100% 0%, rgba(244, 193, 196, .2), transparent 60%), #000; border-color: #000; }
  .dark .btn { background: var(--pink); border-color: var(--pink); color: var(--ink); }
  .dark .btn:hover { background: var(--fg); border-color: var(--fg); }
  .bespoke { background: radial-gradient(120% 70% at 100% 0%, rgba(243, 223, 158, .4), transparent 60%), var(--surface); }
  @media (max-width: 560px) { .spec, .kinds { grid-template-columns: 1fr; } .spec div + div { border-left: 0; border-top: 1px solid var(--hair); } }

  @media (max-width: 960px) {
    .picker { grid-template-columns: 1fr; gap: 28px; }
    .side { display: contents; }
    .stage { order: 3; }
    .tabs { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
    .tabs .bes { grid-column: 1 / -1; }
    .tabs button { flex-direction: column; align-items: flex-start; gap: 4px; padding: 12px 14px; }
    .nm { font-size: 16px; }
    .meta { font-size: 13px; white-space: normal; }
    .all { order: 4; }
  }
  @media (max-width: 560px) {
    .card { box-shadow: var(--lift); }
    .card header { padding-right: 76px; }
    .sticker { font-size: 10px; padding: 6px 9px; }
    .card .ticks-list { grid-template-columns: 1fr; }
    .card .btn { justify-self: stretch; }
  }
  @media (prefers-reduced-motion: reduce) { .tabs button { transition: none; } }
</style>
