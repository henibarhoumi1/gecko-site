---
// Two bands of tape across the full width, crossing like an X: the yellow one says how we work, the pink one what we
// make. They run at a steady speed and never react to scrolling.
import { c } from '../i18n/copy';
import type { Locale } from '../i18n/strings';
import { href } from '../i18n/paths';
interface Props { lang: Locale }
const { lang } = Astro.props;
const b = c(lang).home.bands;
const offers = href(lang, 'offers');
const star = '<path d="M8 1v14M1 8h14M3 3l10 10M13 3L3 13" />';
---
<div class="bands" data-bands>
  <div class="band back" aria-hidden="true">
    <div class="run" data-marquee="38" data-rev>{[0, 1, 2, 3, 4].map(() => <ul>{b.small.map((x) => <li>{x}<svg viewBox="0 0 16 16" set:html={star} /></li>)}</ul>)}</div>
  </div>
  <!-- The yellow strip is the launch offer, so it links to Offers. -->
  <a class="band front" href={offers} aria-label={b.big[0]}>
    <div class="run" data-marquee="70" aria-hidden="true">{[0, 1, 2].map(() => <ul>{b.big.map((x) => <li>{x}<svg viewBox="0 0 16 16" set:html={star} /></li>)}</ul>)}</div>
  </a>
</div>

<script>
  import '../scripts/marquee';
  // The bands keep their crossing angle; only the words run along them (marquee). Nothing is tied to the scroll.
</script>

<style>
  .bands { --tilt: 0; --hb: calc(28px + 1.3em); --hf: calc(clamp(30px, 4.6vw, 72px) + 2 * clamp(14px, 1.6vw, 22px)); position: relative; overflow: hidden; overflow: clip; padding-block: clamp(72px, 9vw, 136px); font-size: clamp(15px, 1.3vw, 19px); }
  .band { position: relative; display: block; width: 112%; margin-left: -6%; overflow: hidden; color: inherit; text-decoration: none; }
  /* The two bands share a centre line and lean opposite ways, so they cross like an X in the middle. */
  .front { z-index: 2; margin-top: calc(-1 * (var(--hb) / 2 + var(--hf) / 2)); background: var(--yellow); color: var(--ink); transform: rotate(calc(-3deg - var(--tilt) * 1.4deg)); }
  .back { z-index: 1; background: var(--pink); color: var(--ink); transform: rotate(calc(4deg + var(--tilt) * 1.2deg)); }
  .run { display: flex; width: max-content; will-change: transform; }
  .run ul { display: flex; list-style: none; margin: 0; padding: 0; }
  .run li { display: flex; align-items: center; white-space: nowrap; }
  .front li { gap: clamp(20px, 2.4vw, 36px); padding: clamp(14px, 1.6vw, 22px) clamp(20px, 2.4vw, 36px) clamp(14px, 1.6vw, 22px) 0; font-weight: 800; font-size: clamp(30px, 4.6vw, 72px); line-height: 1; letter-spacing: -0.035em; }
  .back li { gap: 22px; padding: 14px 22px 14px 0; font-weight: 700; font-size: 1em; line-height: 1.3; letter-spacing: 0; }
  .run svg { flex: none; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; animation: band-spin 6s linear infinite; }
  .front svg { width: .5em; height: .5em; }
  .back svg { width: 13px; height: 13px; animation-direction: reverse; }
  @keyframes band-spin { to { transform: rotate(360deg); } }


  /* Phones are narrow, so the bands lean more to still cross clearly. */
  @media (max-width: 760px) {
    .front { transform: rotate(calc(-6deg - var(--tilt) * 1.4deg)); }
    .back { transform: rotate(calc(8deg + var(--tilt) * 1.2deg)); }
    .bands { padding-block: 84px; }
  }
  @media (prefers-reduced-motion: reduce) { .run svg { animation: none; } }
</style>
