---
// The brief, one tap at a time. Questions branch on earlier answers (no ad budget question if they don't run ads,
// no "what do you sell" for an event), and the brief card fills in as they go and names the plan that fits.
// With a Web3Forms key it emails Gecko; without one it opens WhatsApp with the brief filled in. Once it is sent,
// the page glides down to pricing with that plan open (on the home page), or links to it.
// Numbers 1 to 9 answer from the keyboard.
import Wa from './Wa.astro';
import { t, type Locale } from '../i18n/strings';
import { c } from '../i18n/copy';
import { site } from '../data/site';
import { test, campaign, audit, monthly, fmt } from '../data/offers';
import { href } from '../i18n/paths';
interface Props { lang: Locale; heading?: 'h1' | 'h2'; dark?: boolean }
const { lang, heading = 'h2', dark = false } = Astro.props;
const a = c(lang).apply;
const s = t(lang).apply;
const ct = t(lang).contact;
const H = heading;
const qs = a.qs as { key: string; q: string; row: string; multi?: boolean; hint?: string; when?: Record<string, number[]>; opts: string[][] }[];
const fields = [
  { name: 'name', label: s.name, auto: 'name' },
  { name: 'brand', label: s.brand, auto: 'organization' },
  { name: 'link', label: s.link },
  { name: 'phone', label: s.phone, type: 'tel', auto: 'tel' },
];
const wa = site.whatsapp.replace('https://wa.me/', '');
// Plan links (?plan=pro) arrive with the matching answers filled in: [plan name, answers by question key].
const plans = Object.fromEntries([
  ...monthly.map((m) => [m.key, [m.name, { type: [0], make: [0], rhythm: [1] }]]),
  ['test', [test.name, { type: [0], make: [0], rhythm: [0] }]],
  ['campaign', [campaign.name, { make: [0], rhythm: [0] }]],
  ['audit', [audit.name, { make: [0] }]],
  ['bespoke', [a.bespoke, { rhythm: [0] }]],
]);
const meta = qs.map(({ key, row, multi, when }) => ({ key, row, multi: !!multi, when: when ?? null }));
// The plan each brief points to, as the brief card and the end screen name it.
const p = c(lang).plans;
const cur = t(lang).offers.currency;
const recs: Record<string, string> = {
  test: `${test.name} · ${test.reels} reels · ${fmt(test.launch, lang)} ${cur}`,
  ...Object.fromEntries(monthly.map((m) => [m.key, m.custom ? `${m.name} · ${m.reels}–${m.max} ${p.reels}` : `${m.name} · ${m.reels} ${p.reels} · ${fmt(m.launch, lang)} ${cur}`])),
  bespoke: a.bespoke,
};
---
<div class:list={['apply', { dark }]}>
  <div class="lead stack" style="--gap:22px">
    <p class="kicker rv"><span class="pulse" aria-hidden="true"></span>{a.kicker}</p>
    <H class={`${heading === 'h1' ? 'h1' : 'h2'} rv`} style="--d:60ms">{a.title}</H>
    <p class="text text-l soft rv" style="--d:120ms">{a.sub}</p>

    <aside class="brief paper rv" style="--d:180ms" data-brief aria-live="polite">
      <p class="label">{a.brief}</p>
      <p class="empty" data-brief-empty>{a.briefEmpty}</p>
      <ul data-rows></ul>
      <div class="sugg mat" data-sugg hidden>
        <p class="label">{a.start}</p>
        <p class="pick" data-sugg-text></p>
      </div>
    </aside>

    <div class="direct rv" style="--d:240ms">
      <p class="label">{a.direct}</p>
      <a href={site.whatsapp} rel="noopener">{ct.whatsapp} {site.phone}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>

  <form class="flow paper rv" style="--d:120ms" data-flow data-key={site.formKey} data-wa={wa} data-intro={s.waIntro}
    data-meta={JSON.stringify(meta)} data-plans={JSON.stringify(plans)} data-recs={JSON.stringify(recs)} data-cheers={JSON.stringify(a.cheers)} data-contact-row={a.contactRow}
    action="https://api.web3forms.com/submit" method="POST" novalidate>
    <input type="hidden" name="access_key" value={site.formKey} />
    <input type="hidden" name="subject" value="New brief from the Gecko website" />
    <input type="checkbox" name="botcheck" class="sr" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <input type="hidden" name="plan" data-label={a.plan} data-plan-input />
    <p class="plan-pill" data-plan-pill hidden><span>{a.plan}: <b data-plan-name></b></span><button type="button" data-plan-clear aria-label={a.clear}>×</button></p>
    <div class="top">
      <p class="count" aria-live="polite"><span class="sr">{a.step} </span><b data-count>1</b> / <span data-total></span></p>
      <p class="cheer" data-cheer aria-hidden="true"></p>
      <div class="bar" aria-hidden="true"><i data-fill></i></div>
    </div>

    {qs.map((q, k) => (
      <fieldset class="step" data-step={k} data-key={q.key} hidden={k !== 0}>
        <legend>{q.q}</legend>
        {q.hint && <p class="hint">{q.hint}</p>}
        <input type="hidden" name={q.key} data-label={q.row} />
        <div class={`chips ${q.opts.length > 6 ? 'many' : ''}`}>
          {q.opts.map(([em, label], j) => (
            <button type="button" class="chip" data-pick={label} data-i={j} aria-pressed="false"><kbd aria-hidden="true">{j + 1}</kbd>{em.startsWith('flag:') && <img class="flag" src={`/flags/${em.slice(5)}.svg`} alt="" width="24" height="16" />}{label}</button>
          ))}
        </div>
        {q.multi && <button type="button" class="btn primary next" data-next disabled>{a.next} <span class="arr" aria-hidden="true">→</span></button>}
      </fieldset>
    ))}

    <fieldset class="step" data-step={qs.length} data-last hidden>
      <legend>{a.contactQ}</legend>
      <div class="reach">
        <p class="rl">{a.reach}</p>
        <input type="hidden" name="reach" data-label={a.reach} value={a.reachOpts[0]} data-reach-input />
        <div class="seg" role="radiogroup" aria-label={a.reach}>
          {a.reachOpts.map((r, j) => <button type="button" role="radio" aria-checked={String(j === 0)} data-reach={j}>{r}</button>)}
        </div>
      </div>
      <div class="fields">
        {fields.map((f) => (
          <div class="field" data-f={f.name}>
            <label for={`flow-${f.name}`}>{f.label}</label>
            <input id={`flow-${f.name}`} name={f.name} type={f.type ?? 'text'} required autocomplete={f.auto} data-label={f.label} />
          </div>
        ))}
        <div class="field" data-f="email" hidden>
          <label for="flow-email">{a.mail}</label>
          <input id="flow-email" name="email" type="email" autocomplete="email" data-label={a.mail} disabled />
        </div>
        <div class="field wide">
          <label for="flow-note">{a.note} <span class="opt">({a.optional})</span></label>
          <textarea id="flow-note" name="note" rows="3" placeholder={a.notePh} data-label={a.note}></textarea>
        </div>
      </div>
      <button class="btn primary send" type="submit">{!site.formKey && <Wa />}{site.formKey ? a.send : a.wa} <span class="arr" aria-hidden="true">→</span></button>
    </fieldset>

    <div class="step done" data-done hidden>
      <span class="ok" aria-hidden="true"></span>
      <p class="h3" data-msg data-sent={a.done} data-wa-done={a.waDone} data-error={s.error}>{a.done}</p>
      <div class="fit-done" data-fit-done hidden>
        <p class="label">{a.fitLead}</p>
        <p class="fit-name" data-fit-name></p>
        <a class="btn primary" data-fit-go href={`${href(lang, 'offers')}`}>{a.fitSee} <span class="arr" aria-hidden="true">→</span></a>
      </div>
      <p class="text fallback" data-fallback hidden>{a.waFallback} <a data-wa-link href="#" target="_blank" rel="noopener">{a.waLink}</a> · <a href={`mailto:${site.email}`}>{site.email}</a></p>
      <button type="button" class="again" data-again>{a.again}</button>
    </div>

    <div class="foot">
      <button type="button" class="back" data-back hidden>← {a.back}</button>
      <p class="keys" aria-hidden="true">{a.keys}</p>
    </div>
  </form>
</div>

<script>
  type Meta = { key: string; row: string; multi: boolean; when: Record<string, number[]> | null };
  document.querySelectorAll<HTMLFormElement>('[data-flow]').forEach((form) => {
    const root = form.closest('.apply')!;
    const meta: Meta[] = JSON.parse(form.dataset.meta!);
    const recs: Record<string, string> = JSON.parse(form.dataset.recs!);
    const cheers: string[] = JSON.parse(form.dataset.cheers!);
    const steps = [...form.querySelectorAll<HTMLElement>('[data-step]')];
    const last = steps.length - 1;
    const $ = <T extends HTMLElement>(sel: string) => form.querySelector<T>(sel)!;
    const count = $('[data-count]'), total = $('[data-total]'), fill = $('[data-fill]'), cheer = $('[data-cheer]');
    const back = $<HTMLButtonElement>('[data-back]'), done = $('[data-done]'), msg = $('[data-msg]');
    const rows = root.querySelector<HTMLElement>('[data-rows]')!, empty = root.querySelector<HTMLElement>('[data-brief-empty]')!;
    const suggBox = root.querySelector<HTMLElement>('[data-sugg]')!, suggText = root.querySelector<HTMLElement>('[data-sugg-text]')!;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ans: Record<string, number[]> = {};
    const prefilled = new Set<string>();
    let at = 0, history: number[] = [];

    const has = (k: string, ...i: number[]) => (ans[k] ?? []).some((x) => i.includes(x));
    const shows = (k: number) => {
      if (k === last) return true;
      const w = meta[k].when; if (!w) return true;
      return Object.entries(w).every(([key, vals]) => has(key, ...vals));
    };
    // The questions this person will see, given what they've answered so far.
    const path = () => steps.map((_, k) => k).filter((k) => shows(k) && (k === last || !prefilled.has(meta[k].key)));
    const label = (k: number) => [...steps[k].querySelectorAll<HTMLButtonElement>('.chip')].filter((c) => (ans[meta[k].key] ?? []).includes(Number(c.dataset.i))).map((c) => c.dataset.pick).join(', ');

    const anim = (el: Element, kf: Keyframe[], o: KeyframeAnimationOptions) => { if (!still) el.animate(kf, o); };
    const progress = () => {
      const p = path(); const i = Math.max(0, p.indexOf(at));
      count.textContent = String(i + 1); total.textContent = String(p.length);
      fill.style.transform = `scaleX(${(i + 1) / p.length})`;
    };
    // Answers that no longer apply (switching from "a shop" to "an event") are dropped.
    const prune = () => meta.forEach((m, k) => { if (!shows(k) && ans[m.key]) { delete ans[m.key]; steps[k].querySelectorAll('.chip').forEach((c) => { c.classList.remove('picked'); c.setAttribute('aria-pressed', 'false'); }); steps[k].querySelector<HTMLInputElement>('input[type=hidden]')!.value = ''; } });

    const brief = () => {
      rows.innerHTML = '';
      meta.forEach((m, k) => {
        if (!ans[m.key]?.length || !shows(k)) return;
        const li = document.createElement('li'); const b = document.createElement('button'); b.type = 'button';
        b.innerHTML = '<span class="k"></span><span class="v"></span>';
        b.querySelector('.k')!.textContent = m.row; b.querySelector('.v')!.textContent = label(k);
        b.addEventListener('click', () => { if (done.hidden) go(k, -1); });
        li.append(b); rows.append(li);
      });
      const name = form.querySelector<HTMLInputElement>('#flow-name')!.value.trim();
      if (name) { const li = document.createElement('li'); li.innerHTML = '<button type="button"><span class="k"></span><span class="v"></span></button>'; li.querySelector('.k')!.textContent = form.dataset.contactRow!; li.querySelector('.v')!.textContent = name; rows.append(li); }
      empty.hidden = rows.children.length > 0;
      const pick = recs[rec()] ?? '';
      if (pick && suggText.textContent !== pick) { suggText.textContent = pick; suggBox.hidden = false; anim(suggBox, [{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'none' }], { duration: 420, easing: 'cubic-bezier(.2,.7,.2,1)' }); }
      if (!pick) suggBox.hidden = true;
    };
    // Where we'd start. Films, events and shoots are quoted; monthly ads follow the budget (or the ad spend when
    // the budget is open); one project, or not sure yet, starts with the Test.
    const rec = () => {
      if (!ans.make && !ans.rhythm) return '';
      const bigger = has('make', 2, 4, 5, 6) || has('type', 4);
      const ads = has('make', 0, 1, 7);
      if (has('rhythm', 1) && (ads || !bigger)) {
        if (has('budget', 0)) return 'test';
        if (has('budget', 3) || (has('budget', 4) && has('spend', 3))) return 'partner';
        if (has('budget', 2) || (has('budget', 4) && has('spend', 2))) return 'pro';
        return 'regular';
      }
      if (bigger || (has('make', 3) && !ads)) return 'bespoke';
      return 'test';
    };

    const go = (n: number, dir = 1) => {
      steps[at].hidden = true; at = n;
      const el = steps[at]; el.hidden = false;
      anim(el, [{ opacity: 0, transform: `translateX(${dir * 28}px)` }, { opacity: 1, transform: 'none' }], { duration: 420, easing: 'cubic-bezier(.2,.7,.2,1)' });
      back.hidden = history.length === 0;
      form.dataset.at = at === last ? 'last' : '';
      progress();
      if (el.hasAttribute('data-last')) el.querySelector<HTMLInputElement>('.fields input')?.focus({ preventScroll: true });
    };
    const forward = () => {
      prune(); brief();
      const p = path(); const next = p.find((k) => k > at) ?? last;
      history.push(at);
      if (!still && at < last) { cheer.textContent = cheers[Math.floor(Math.random() * cheers.length)]; cheer.classList.remove('show'); void cheer.offsetWidth; cheer.classList.add('show'); }
      setTimeout(() => go(next), meta[at]?.multi ? 0 : 280);
    };
    back.addEventListener('click', () => { const prev = history.pop(); if (prev !== undefined) go(prev, -1); });

    const setPick = (k: number, i: number[]) => {
      const key = meta[k].key; ans[key] = i;
      steps[k].querySelectorAll<HTMLButtonElement>('.chip').forEach((c) => { const on = i.includes(Number(c.dataset.i)); c.classList.toggle('picked', on); c.setAttribute('aria-pressed', String(on)); });
      steps[k].querySelector<HTMLInputElement>('input[type=hidden]')!.value = label(k);
      const nx = steps[k].querySelector<HTMLButtonElement>('[data-next]'); if (nx) nx.disabled = i.length === 0;
    };
    steps.slice(0, last).forEach((step, k) => {
      step.querySelectorAll<HTMLButtonElement>('.chip').forEach((chip) => chip.addEventListener('click', () => {
        const i = Number(chip.dataset.i);
        if (meta[k].multi) {
          const cur = ans[meta[k].key] ?? [];
          setPick(k, cur.includes(i) ? cur.filter((x) => x !== i) : [...cur, i]);
          anim(chip, [{ transform: 'scale(.96)' }, { transform: 'none' }], { duration: 260, easing: 'cubic-bezier(.34,1.4,.64,1)' });
          brief();
        } else { setPick(k, [i]); forward(); }
      }));
      step.querySelector('[data-next]')?.addEventListener('click', forward);
    });
    form.querySelector('#flow-name')!.addEventListener('input', brief);

    // WhatsApp or a call needs a number; email swaps the number for an address.
    const reachIn = $<HTMLInputElement>('[data-reach-input]');
    const phoneF = $('[data-f="phone"]'), mailF = $('[data-f="email"]');
    const setReach = (j: number) => {
      form.querySelectorAll<HTMLButtonElement>('[data-reach]').forEach((b) => b.setAttribute('aria-checked', String(Number(b.dataset.reach) === j)));
      reachIn.value = $<HTMLButtonElement>(`[data-reach="${j}"]`).textContent!.trim();
      const mail = j === 2;
      phoneF.hidden = mail; phoneF.querySelector('input')!.disabled = mail;
      mailF.hidden = !mail; mailF.querySelector('input')!.disabled = !mail; mailF.querySelector('input')!.required = mail;
      anim(mail ? mailF : phoneF, [{ opacity: 0, transform: 'translateY(6px)' }, { opacity: 1, transform: 'none' }], { duration: 300, easing: 'cubic-bezier(.2,.7,.2,1)' });
    };
    form.querySelectorAll<HTMLButtonElement>('[data-reach]').forEach((b) => b.addEventListener('click', () => setReach(Number(b.dataset.reach))));

    // Arriving from a plan or project button: keep that choice and answer the matching questions for them.
    const planIn = $<HTMLInputElement>('[data-plan-input]'), pill = $('[data-plan-pill]');
    const plans: Record<string, [string, Record<string, number[]>]> = JSON.parse(form.dataset.plans!);
    const key = new URLSearchParams(location.search).get('plan') ?? '';
    const applyPlan = () => {
      if (!plans[key]) return;
      const [name, pre] = plans[key];
      planIn.value = name; $('[data-plan-name]').textContent = name; pill.hidden = false;
      Object.entries(pre).forEach(([k, v]) => { const idx = meta.findIndex((m) => m.key === k); setPick(idx, v); prefilled.add(k); });
      const first = path()[0]; steps.forEach((x, i) => (x.hidden = i !== first)); at = first;
    };
    $('[data-plan-clear]').addEventListener('click', () => { planIn.value = ''; pill.hidden = true; prefilled.clear(); progress(); });

    // The end screen names the plan that fits. On the home page the pricing below opens on it and the page
    // glides there; elsewhere the button leads to the offers page.
    const fitBox = $('[data-fit-done]'), fitGo = $<HTMLAnchorElement>('[data-fit-go]');
    const pricing = document.querySelector<HTMLElement>('#plans [data-picker]') ? document.querySelector<HTMLElement>('#plans') : null;
    const glide = () => { if (!pricing) return; const l = (window as any).lenis; l ? l.scrollTo(pricing, { offset: -40, duration: 1.8, easing: (x: number) => 1 - Math.pow(1 - x, 4) }) : pricing.scrollIntoView({ behavior: still ? 'auto' : 'smooth' }); };
    if (pricing) fitGo.addEventListener('click', (e) => { e.preventDefault(); glide(); });
    let glideTimer = 0;
    const finish = (text: string) => {
      steps[at].hidden = true; back.hidden = true;
      msg.textContent = text; done.hidden = false; fill.style.transform = 'scaleX(1)'; form.dataset.at = 'done';
      const key = rec() || 'test';
      $('[data-fit-name]').textContent = recs[key]; fitBox.hidden = false;
      dispatchEvent(new CustomEvent('gecko:plan', { detail: key }));
      anim(done, [{ opacity: 0, transform: 'scale(.96)' }, { opacity: 1, transform: 'none' }], { duration: 480, easing: 'cubic-bezier(.34,1.4,.64,1)' });
      if (pricing) glideTimer = window.setTimeout(glide, 1800);
    };
    $('[data-again]').addEventListener('click', () => {
      form.reset(); Object.keys(ans).forEach((k) => delete ans[k]); prefilled.clear(); history = [];
      form.querySelectorAll('.chip').forEach((x) => { x.classList.remove('picked'); x.setAttribute('aria-pressed', 'false'); });
      form.querySelectorAll<HTMLButtonElement>('[data-next]').forEach((b) => (b.disabled = true));
      clearTimeout(glideTimer); fitBox.hidden = true;
      pill.hidden = true; setReach(0); done.hidden = true; $('[data-fallback]').hidden = true; brief();
      steps.forEach((x, i) => (x.hidden = i !== 0)); at = 0; go(0, -1);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const inputs = [...form.querySelectorAll<HTMLInputElement>('[data-last] .fields input:not(:disabled)')];
      const bad = inputs.find((i) => !i.value.trim() || (i.type === 'email' && !i.checkValidity()));
      if (bad) { bad.focus(); anim(bad.closest('.field')!, [{ transform: 'translateX(-6px)' }, { transform: 'translateX(6px)' }, { transform: 'none' }], { duration: 260 }); return; }
      if (!form.dataset.key) {
        const lines = [...form.querySelectorAll<HTMLInputElement>('input[data-label], textarea[data-label]')].filter((el) => !el.disabled && el.value.trim()).map((el) => `${el.dataset.label}: ${el.value.trim()}`);
        const url = `https://wa.me/${form.dataset.wa}?text=${encodeURIComponent([form.dataset.intro, '', ...lines].join('\n'))}`;
        open(url, '_blank', 'noopener');
        $<HTMLAnchorElement>('[data-wa-link]').href = url; $('[data-fallback]').hidden = false;
        finish(msg.dataset.waDone!);
        return;
      }
      try {
        const r = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!r.ok) throw new Error();
        finish(msg.dataset.sent!);
      } catch { finish(msg.dataset.error!); }
    });

    // Keyboard: a number picks that answer, Enter moves on from a question with several answers.
    addEventListener('keydown', (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey || (e.target as HTMLElement).closest('input, textarea, select, [contenteditable]')) return;
      const r = form.getBoundingClientRect(); if (r.bottom < 80 || r.top > innerHeight - 80 || at === last || !done.hidden) return;
      if (e.key === 'Enter' && meta[at].multi) { const nx = steps[at].querySelector<HTMLButtonElement>('[data-next]'); if (nx && !nx.disabled) { e.preventDefault(); nx.click(); } return; }
      const n = Number(e.key); if (!n) return;
      const chip = steps[at].querySelectorAll<HTMLButtonElement>('.chip')[n - 1];
      if (chip) { e.preventDefault(); chip.click(); }
    });

    applyPlan(); progress(); brief();
  });
</script>

<style>
  .apply { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); gap: clamp(32px, 6vw, 96px); align-items: center; }
  .lead .h1, .lead .h2 { max-width: 12ch; }
  .lead .h1 { font-size: clamp(44px, 5.4vw, 84px); }
  .kicker { margin: 0; display: inline-flex; align-items: center; gap: 10px; width: fit-content; padding: 8px 14px; border: var(--line) solid var(--ink); border-radius: 999px; background: var(--white); font-weight: 700; font-size: 14px; }
  .pulse { width: 9px; height: 9px; border-radius: 50%; background: var(--ink); box-shadow: 0 0 0 0 rgba(0, 0, 0, .4); animation: pulse 1.8s infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 9px rgba(0, 0, 0, 0); } 100% { box-shadow: 0 0 0 0 rgba(0, 0, 0, 0); } }

  .brief { display: grid; gap: 12px; padding: 18px 20px; max-width: 30rem; background: var(--white); border: 1px solid rgba(0, 0, 0, .12); border-radius: var(--r); box-shadow: var(--lift); }
  .brief ul { list-style: none; margin: 0; padding: 0; display: grid; }
  .brief :global(li + li) { border-top: 1px solid rgba(0, 0, 0, .08); }
  .brief :global(li button) { width: 100%; display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; background: none; border: 0; color: inherit; font: inherit; text-align: left; cursor: pointer; }
  .brief :global(.k) { font-weight: 700; font-size: 14px; flex: none; }
  .brief :global(.v) { font-size: 15px; text-align: right; font-weight: 700; }
  .brief :global(li button:hover .k) { text-decoration: underline; text-underline-offset: 3px; }
  .sugg { display: grid; gap: 4px; padding: 20px 16px 14px; border-radius: var(--r-sm); }
  .sugg[hidden] { display: none; }
  .sugg .pick { margin: 0; font-weight: 700; }
  .sugg :global(.label) { color: rgba(255, 255, 255, .8); }
  .direct { display: grid; gap: 6px; }
  .direct a { text-decoration: none; font-weight: 700; }
  .direct a:hover { text-decoration: underline; text-underline-offset: 4px; }

  /* On the lit mat (apply page): white type, the brief card stays white. */
