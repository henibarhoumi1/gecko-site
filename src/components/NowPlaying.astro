---
// The reel beside the home headline: one clean reel, large, playing silently and moving on to the next by itself. Only
// a small sound button and one line under it (title · format). A click opens the viewer with sound. Nothing plays with
// reduced motion or data saver: the first reel's picture stays.
import { c } from '../i18n/copy';
import type { Locale } from '../i18n/strings';
import { ads } from '../data/work';
import { launch } from '../i18n/launch';
interface Props { lang: Locale }
const { lang } = Astro.props;
const hx = c(lang).home.hero;
const reels = ads.slice(0, 4).map((a) => ({ clip: a.clip ?? a.src!, poster: a.poster!, t: a.angle[lang], f: a.format?.[lang] ?? '' }));
const first = reels[0];
const sound = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" /><path d="M15.5 9.5a3.5 3.5 0 0 1 0 5M17.8 7.2a7 7 0 0 1 0 9.6" /></svg>';
---
{first && (
  <figure class="np" data-np data-reels={JSON.stringify(reels)}>
    <button type="button" class="np-frame" data-np-open aria-label={`${hx.sound}: ${first.t}`} data-label={hx.sound}>
      <img src={first.poster} alt="" width="540" height="960" data-np-poster fetchpriority="high" />
      <video muted playsinline preload="none" tabindex="-1" aria-hidden="true" data-np-video></video>
      <span class="np-sound" aria-hidden="true" set:html={sound} />
    </button>
    <figcaption class="np-cap" aria-live="polite"><span data-np-line>{launch(lang).hero.caption(first.t, first.f)}</span></figcaption>
  </figure>
)}

<script>
  const np = document.querySelector<HTMLElement>('[data-np]');
  if (np) {
    const reels: { clip: string; poster: string; t: string; f: string }[] = JSON.parse(np.dataset.reels || '[]');
    const frame = np.querySelector<HTMLButtonElement>('[data-np-open]')!;
    const video = np.querySelector<HTMLVideoElement>('[data-np-video]')!;
    const poster = np.querySelector<HTMLImageElement>('[data-np-poster]')!;
    const line = np.querySelector<HTMLElement>('[data-np-line]')!;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const save = !!(navigator as any).connection?.saveData;
    let i = 0, ready = false, seen = true;
    const allowed = () => !still && !save && ready && seen && !document.hidden && !document.documentElement.classList.contains('locked');

    const run = () => {
      if (allowed()) {
        if (video.getAttribute('src') !== reels[i].clip) { video.src = reels[i].clip; }
        video.play().then(() => np.classList.add('live')).catch(() => {});
      } else video.pause();
    };
    const show = (k: number) => {
      i = (k + reels.length) % reels.length;
      const r = reels[i];
      line.textContent = r.f ? `${r.t} · ${r.f}` : r.t;
      frame.setAttribute('aria-label', `${frame.dataset.label}: ${r.t}`);
      poster.src = r.poster;
      np.classList.remove('live');
      video.removeAttribute('src');
      video.load();
      np.animate?.([{ opacity: .55 }, { opacity: 1 }], { duration: still ? 0 : 280, easing: 'ease-out' });
      run();
    };
    video.addEventListener('ended', () => show(i + 1));
    // The full reel with sound, in the viewer, growing out of this frame.
    frame.addEventListener('click', () => {
      video.pause();
      document.dispatchEvent(new CustomEvent('reel:play', { detail: { i, from: frame, grow: frame } }));
    });
    document.addEventListener('reel:close', () => setTimeout(run, 400));
    new IntersectionObserver(([e]) => { seen = e.isIntersecting; run(); }, { threshold: 0.2 }).observe(np);
    new MutationObserver(run).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    document.addEventListener('visibilitychange', run);
    const start = () => { ready = true; run(); };
    const idle = () => ('requestIdleCallback' in window ? (window as any).requestIdleCallback(start, { timeout: 1500 }) : setTimeout(start, 400));
    if (document.readyState === 'complete') idle(); else addEventListener('load', idle, { once: true });
  }
</script>

<style>
  .np { --r: 24px; margin: 0; display: grid; gap: 14px; width: 100%; }
  .np-frame { position: relative; display: block; width: 100%; aspect-ratio: 9 / 16; padding: 0; border: 0; border-radius: var(--r); overflow: hidden; background: #000; color: #fff; cursor: pointer; transition: transform 500ms var(--ease); }
  .np-frame:hover { transform: translateY(-3px); }
  .np-frame:focus-visible { outline: 3px solid var(--ink); outline-offset: 4px; }
  .np-frame img, .np-frame video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .np-frame video { opacity: 0; transition: opacity 500ms var(--ease); }
  .live .np-frame video { opacity: 1; }
  .np-sound { position: absolute; z-index: 1; right: 14px; bottom: 14px; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: #fff; color: var(--ink); transition: transform 240ms var(--ease), background 240ms var(--ease); }
  .np-sound :global(svg) { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
  .np-frame:hover .np-sound { transform: scale(1.08); background: var(--pink); }
  .np-cap { margin: 0; font-weight: 700; font-size: 16px; letter-spacing: 0; }
  @media (prefers-reduced-motion: reduce) { .np-frame, .np-frame:hover { transform: none; } }
</style>
