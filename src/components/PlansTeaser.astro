---
// Home page pricing, short: the four plans side by side (name, who it's for, reels and price) and one way on to the
// full Offers page, where each plan is spelled out with bespoke projects and payment terms.
import { t, type Locale } from '../i18n/strings';
import { c } from '../i18n/copy';
import { href } from '../i18n/paths';
import { plans, fmt } from '../data/offers';
interface Props { lang: Locale }
const { lang } = Astro.props;
const o = t(lang).offers;
const p = c(lang).plans;
const h = c(lang).home;
const offers = href(lang, 'offers');
---
<section class="section pt-sec" id="plans">
  <div class="wrap wide">
    <div class="head rv">
      <h2 class="h2">{h.plansTitle}</h2>
      <p class="sub">{h.plansSub}</p>
    </div>
    <ul class="pt">
      {plans.map((m, i) => (
        <li class="rv" style={`--d:${i * 60}ms`} data-key={m.key}>
          <a href={offers} class:list={['pt-card', { once: m.once }]}>
            <span class="pt-name">{m.name}</span>
            {m.for && <span class="pt-for">{m.for[lang]}</span>}
            <span class="pt-n"><b>{m.max ? `${m.reels}–${m.max}` : m.reels}</b> {m.once ? p.reelsOnce : p.reels}</span>
            <span class="pt-price">
              {m.custom ? <b>{p.custom}</b> : <><b>{fmt(m.launch, lang)}</b> {o.currency} {m.once ? p.once : o.month}</>}
            </span>
          </a>
        </li>
      ))}
    </ul>
    <div class="pt-foot rv">
      <p>{o.launchNote}</p>
      <a class="btn" href={offers}>{h.plansCta} <span class="arr" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<script>
  // When the brief above names the plan that fits, that plan turns pink here.
  addEventListener('gecko:plan', (e) => {
    const key = (e as CustomEvent<string>).detail;
    document.querySelectorAll<HTMLElement>('#plans [data-key]').forEach((li) => li.classList.toggle('fit', li.dataset.key === key));
  });
</script>

<style>
  .fit .pt-card { background: var(--pink); }
  .pt-sec { border-top: 1px solid var(--hair); }
  .pt { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(10px, 1.2vw, 16px); }
  .pt li { display: flex; }
  .pt-card { flex: 1; display: grid; grid-template-rows: auto 1fr auto auto; gap: 14px; padding: clamp(20px, 2vw, 28px); border: 1px solid var(--ink); border-radius: var(--r); background: var(--bg); color: var(--fg); text-decoration: none;
    transition: background 240ms var(--ease), transform 300ms var(--ease); }
  .pt-card:hover { background: var(--pink); transform: translateY(-3px); }
  .pt-card.once { background: var(--yellow); }
  .pt-card.once:hover { background: var(--pink); }
  .pt-card:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .pt-name { font-weight: 700; font-size: clamp(24px, 2.2vw, 32px); letter-spacing: -0.04em; line-height: 1; }
  .pt-for { font-size: 15px; line-height: 1.45; color: var(--fg-2); }
  .pt-card:hover .pt-for, .pt-card.once .pt-for { color: var(--ink); }
  .pt-n { padding-top: 14px; border-top: 1px solid var(--hair); font-size: 15px; }
  .pt-n b { font-size: clamp(30px, 3vw, 44px); letter-spacing: -0.05em; margin-right: 4px; }
  .pt-price { font-size: 15px; font-weight: 500; }
  .pt-price b { font-size: 20px; letter-spacing: -0.03em; }
  .pt-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 32px; margin-top: clamp(24px, 3vw, 40px); }
  .pt-foot p { margin: 0; max-width: 40rem; font-size: 15px; color: var(--fg-2); }
  @media (max-width: 1080px) { .pt { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) {
    .pt { grid-template-columns: 1fr; }
    .pt-card { grid-template-columns: 1fr auto; grid-template-rows: auto; gap: 6px 16px; }
    .pt-name { grid-column: 1; }
    .pt-for { display: none; }
    .pt-n { grid-column: 1; padding-top: 0; border: 0; }
    .pt-n b { font-size: 26px; }
    .pt-price { grid-column: 2; grid-row: 1 / 3; align-self: center; text-align: right; display: grid; }
  }
  @media (prefers-reduced-motion: reduce) { .pt-card:hover { transform: none; } }
</style>
