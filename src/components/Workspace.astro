---
// The client workspace: what every client works from. Copy on the left, and on the right a working model of the
// workspace (example data) whose sidebar tabs switch between overview, approvals, files and payments. It wears the
// same look as the real app (white sidebar, the logo, a pink pill on the open tab), so the site and the portal match.
// As a story (home page), it is a short guided tour: the five steps of a project play through one after another (a
// line fills under the step that is on), and the workspace beside them opens the matching tab. Click a step to stay on
// it. No long scroll: the whole tour fits in about one screen. On the home page the workspace is the hero: big, running
// off the right edge of the page, with a pointer that does what a client does (opens the tab, approves the script,
// plays the preview, downloads the file) as each step comes on.
import Logo from './Logo.astro';
import { c } from '../i18n/copy';
import { href } from '../i18n/paths';
import type { Locale } from '../i18n/strings';
interface Props { lang: Locale; cta?: boolean; story?: boolean }
const { lang, cta = true, story = false } = Astro.props;
const k = c(lang).space;
const m = k.mock;
const icons = [
  '<svg viewBox="0 0 20 20"><rect x="3" y="3" width="6" height="6" rx="1.5"/><rect x="11" y="3" width="6" height="6" rx="1.5"/><rect x="3" y="11" width="6" height="6" rx="1.5"/><rect x="11" y="11" width="6" height="6" rx="1.5"/></svg>',
  '<svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="7"/><path d="M6.8 10.2l2.2 2.2 4.2-4.6"/></svg>',
  '<svg viewBox="0 0 20 20"><path d="M5 3h7l3 3v11H5z"/><path d="M12 3v3h3"/></svg>',
  '<svg viewBox="0 0 20 20"><rect x="3" y="5" width="14" height="10" rx="2"/><path d="M3 9h14"/></svg>',
];
---
<section class="section ws-sec" id="workspace">
  <div class:list={['wrap ws', { story }]} data-ws-story={story ? '' : undefined}>
    <div class="ws-copy">
      {story ? (
        <h2 class="h2 ws-title rv"><span>{k.storyTitle[0]}</span> <span><span class="mk">{k.storyTitle[1]}</span></span></h2>
      ) : <h2 class="h2 rv">{k.title}</h2>}
      <p class="text text-l rv" style="--d:80ms">{story ? k.storySub : k.sub}</p>
      {story ? (
        <ol class="steps">
          {k.story.map((st, i) => (
            <li class:list={['rv', { on: i === 0 }]} style={`--d:${120 + i * 60}ms`} data-step={st.pane}>
              <button type="button" class="st-b" aria-label={`${String(i + 1).padStart(2, '0')} ${st.t}`}>
                <span class="sn" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="sb"><b>{st.t}</b><span class="sd"><span>{st.d}</span></span></span>
              </button>
            </li>
          ))}
        </ol>
      ) : (
        <ul class="pts">
          {k.points.map(([t, d], i) => (
            <li class="rv" style={`--d:${120 + i * 60}ms`}><b>{t}</b><span>{d}</span></li>
          ))}
        </ul>
      )}
      {cta && <a class="btn rv" href={href(lang, 'process')}>{k.cta} <span class="arr" aria-hidden="true">→</span></a>}
    </div>

    <div class="app-wrap rv" style="--d:120ms" data-ws-wrap>
      <p class="eg"><span class="tape">{k.example}</span></p>
      <div class="app" data-ws data-live={JSON.stringify(m.live)} data-now={m.now}>
        {story && <span class="cur" aria-hidden="true" data-ws-cur><svg viewBox="0 0 20 20"><path d="M3 2l14 7.5-6.2 1.7L8 17.6z" /></svg></span>}
        <div class="chrome" aria-hidden="true"><i></i><i></i><i></i><span>gecko / {m.project}</span></div>
        <div class="body">
          <div class="side" role="tablist" aria-label={k.title}>
            <span class="mono" aria-hidden="true"><Logo /></span>
            {m.tabs.map((t, i) => (
              <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-ws-tab={i}><span class="ic" set:html={icons[i]} aria-hidden="true" /><span class="tl">{t}</span>{i === 1 && <em>2</em>}</button>
            ))}
          </div>
          <div class="main">
            <div class="top">
              <div><p class="pn">{m.project}</p><p class="pm">{m.meta}</p></div>
              <span class="st"><i></i>{m.status}</span>
            </div>

            <div class="pane" data-ws-pane="0">
              <ol class="tl-steps">
                {m.steps.map((st, i) => <li class={i < 3 ? 'done' : i === 3 ? 'now' : ''}><i></i><span>{st}</span></li>)}
              </ol>
              <div class="tiles">
                <div class="tile"><p class="tk">{m.next}</p><p class="tv">{m.nextV}</p></div>
                <div class="tile y"><p class="tk">{m.need}</p><p class="tv">{m.needV}</p></div>
              </div>
              <div class="bar-row"><p class="tk">{m.progress}</p><span class="meter"><i></i></span><b><span data-ws-count>7</span> / 10</b></div>
              <div><p class="tk">{m.latest}</p><ul class="rows act" data-ws-feed>{m.activity.map(([t, w]) => <li><span>{t}</span><em>{w}</em></li>)}</ul></div>
            </div>

            <div class="pane" data-ws-pane="1" hidden>
              <ul class="rows">
                {m.approvals.map(([t, s], i) => (
                  <li><span>{t}</span>{i < 2 ? <button type="button" class="ok" data-approve>{m.approve}</button> : <em class="done-chip">{s}</em>}</li>
                ))}
              </ul>
              <div class="pv">
                <div class="pv-frame" data-ws-pv><video src="/work/clip-vs-the-world.mp4" poster="/work/glucelia-vs-the-world.jpg" muted playsinline loop preload="none" width="540" height="960" aria-hidden="true"></video><span class="wm">PREVIEW</span><span class="play" aria-hidden="true">▶</span></div>
                <div class="pv-note"><p class="tk">{m.preview}</p><p class="cm" data-ws-cm><b>{m.at}</b> {m.comment}</p></div>
              </div>
            </div>

            <div class="pane" data-ws-pane="2" hidden>
              <ul class="rows">
                {m.files.map(([t, s]) => <li><span>{t}</span><em>{s}</em><span class="dl" aria-hidden="true" data-dl>↓</span></li>)}
              </ul>
              <p class="lock">{m.locked}</p>
            </div>

            <div class="pane" data-ws-pane="3" hidden>
              <ul class="rows">
                {m.invoices.map(([t, s], i) => <li><span>{t}</span><em class={['paid', 'adv', 'due'][i]}>{s}</em></li>)}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-ws]').forEach((app) => {
    const tabs = [...app.querySelectorAll<HTMLButtonElement>('[data-ws-tab]')];
    const panes = [...app.querySelectorAll<HTMLElement>('[data-ws-pane]')];
    const show = (i: number) => {
      tabs.forEach((t, j) => t.setAttribute('aria-selected', String(i === j)));
      panes.forEach((p, j) => { p.hidden = i !== j; if (i === j) p.animate([{ opacity: 0, transform: 'translateY(6px)' }, { opacity: 1, transform: 'none' }], { duration: 320, easing: 'cubic-bezier(.2,.7,.2,1)' }); });
    };
    tabs.forEach((t, i) => t.addEventListener('click', () => show(i)));
    let cur = 0;
    app.addEventListener('ws:show', (e) => { const i = (e as CustomEvent<number>).detail; if (i !== cur) { cur = i; show(i); } });
    tabs.forEach((t, i) => t.addEventListener('click', () => { cur = i; }));
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // It comes alive once it is on screen: the timeline and the meter fill, then new activity drops in every few
    // seconds, the way it does for a client during a project.
    const feed = app.querySelector<HTMLUListElement>('[data-ws-feed]')!;
    const count = app.querySelector<HTMLElement>('[data-ws-count]')!;
    const live: string[] = JSON.parse(app.dataset.live || '[]');
    let n = 0, timer = 0, seen = false;
    const drop = () => {
      if (panes[0].hidden || document.hidden) return;
      const text = live[n++ % live.length];
      const li = document.createElement('li');
      li.innerHTML = '<span></span><em></em>';
      li.firstElementChild!.textContent = text; li.lastElementChild!.textContent = app.dataset.now!;
      li.classList.add('new');
      feed.prepend(li);
      feed.lastElementChild?.remove();
      [...feed.children].forEach((x, j) => { if (j > 0) x.classList.remove('new'); });
      const c = Number(count.textContent);
      count.textContent = String(c >= 10 ? 7 : c + 1);
      app.style.setProperty('--fill', `${(Number(count.textContent) / 10) * 100}%`);
    };
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting) {
        if (!seen) { seen = true; app.classList.add('live'); }
        if (!still && !timer) timer = window.setInterval(drop, 3800);
      } else if (timer) { clearInterval(timer); timer = 0; }
    }, { threshold: 0.35 }).observe(app);
    app.querySelectorAll<HTMLButtonElement>('[data-approve]').forEach((b) => b.addEventListener('click', () => {
      if (b.classList.contains('yes')) return;
      b.dataset.label ??= b.textContent ?? '';
      b.classList.add('yes'); b.disabled = true; b.textContent = '✓';
      const badge = app.querySelector<HTMLElement>('[data-ws-tab="1"] em');
      if (badge) { const n = Number(badge.textContent) - 1; badge.textContent = String(n); badge.hidden = n <= 0; }
    }));
    // The preview plays (muted) when clicked.
    const pv = app.querySelector<HTMLElement>('[data-ws-pv]');
    pv?.addEventListener('click', () => { const v = pv.querySelector('video')!; pv.classList.add('playing'); void v.play().catch(() => pv.classList.remove('playing')); });
  });

  // The tour: while the section is on screen, each step stays on for a few seconds (a line fills under it), then the
  // next one comes on and the workspace opens its tab; after the last it starts again. Pointing at the section pauses
  // it; clicking a step stays on that step. With reduced motion nothing plays by itself: click to move through.
  document.querySelectorAll<HTMLElement>('[data-ws-story]').forEach((root) => {
    const app = root.querySelector<HTMLElement>('[data-ws]')!;
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let at = 0, manual = still, seen = false, hover = false;
    const cur = still ? null : app.querySelector<HTMLElement>('[data-ws-cur]');
    const cm = app.querySelector<HTMLElement>('[data-ws-cm]');
    if (!cur) cm?.classList.add('show');
    // The pointer: glides to an element of the workspace and taps it.
    let timers: number[] = [];
    const later = (ms: number, f: () => void) => timers.push(window.setTimeout(f, ms));
    const point = (el: Element | null) => {
      if (!cur || !el) return;
      const a = app.getBoundingClientRect(), r = el.getBoundingClientRect();
      cur.style.transform = `translate(${(r.left - a.left + r.width * .5).toFixed(0)}px, ${(r.top - a.top + r.height * .55).toFixed(0)}px)`;
      cur.classList.add('on');
    };
    const tap = () => { if (!cur) return; cur.classList.remove('tap'); void cur.offsetWidth; cur.classList.add('tap'); };
    const q = <T extends Element = HTMLElement>(sel: string) => app.querySelector<T>(sel);
    // Back to the start of the project: scripts waiting, preview not played, files not downloaded.
    const reset = () => {
      app.querySelectorAll<HTMLButtonElement>('[data-approve]').forEach((b) => { if (b.dataset.label) b.textContent = b.dataset.label; b.classList.remove('yes'); b.disabled = false; });
      const badge = q('[data-ws-tab="1"] em'); if (badge) { badge.textContent = '2'; badge.hidden = false; }
      const pv = q('[data-ws-pv]'); const v = pv?.querySelector('video'); if (v) { v.pause(); v.currentTime = 0; } pv?.classList.remove('playing');
      cm?.classList.remove('show');
      app.querySelectorAll('.got, .pop').forEach((x) => x.classList.remove('got', 'pop'));
    };
    // What the pointer does on each step, after it has opened the tab.
    const acts: [() => Element | null, (el: Element) => void][] = [
      [() => q('[data-ws-pane="3"] .rows li:first-child em'), (el) => el.classList.add('pop')],
      [() => q('[data-approve]:not(.yes)'), (el) => (el as HTMLButtonElement).click()],
      [() => q('[data-ws-pane="0"] .tl-steps .now i'), (el) => el.classList.add('pop')],
      [() => q('[data-ws-pv]'), (el) => { (el as HTMLElement).click(); later(500, () => cm?.classList.add('show')); }],
      [() => q('[data-dl]'), (el) => el.classList.add('got')],
    ];
    const pick = (i: number) => {
      at = i;
      timers.forEach(clearTimeout); timers = [];
      steps.forEach((x, j) => { x.classList.toggle('on', j === i); x.classList.remove('run'); });
      const pane = Number(steps[i].dataset.step);
      if (!cur) app.dispatchEvent(new CustomEvent('ws:show', { detail: pane }));
      else {
        if (i === 0) reset();
        point(q(`[data-ws-tab="${pane}"]`));
        later(700, () => { tap(); app.dispatchEvent(new CustomEvent('ws:show', { detail: pane })); });
        later(1300, () => point(acts[i]?.[0]() ?? null));
        later(2150, () => { tap(); const el = acts[i]?.[0](); if (el) acts[i][1](el); });
      }
      if (!manual) { void steps[i].offsetWidth; steps[i].classList.add('run'); }
    };
    const sync = () => root.classList.toggle('paused', !seen || hover || document.hidden);
    steps.forEach((el, i) => {
      el.querySelector('button')!.addEventListener('click', () => { manual = true; root.classList.add('chosen'); pick(i); });
      el.addEventListener('animationend', (e) => { if ((e as AnimationEvent).animationName.startsWith('tour') && !manual) pick((at + 1) % steps.length); });
    });
    new IntersectionObserver(([e]) => { seen = e.isIntersecting; sync(); }, { threshold: .4 }).observe(root);
    if (matchMedia('(hover: hover)').matches) {
      root.addEventListener('pointerenter', () => { hover = true; sync(); });
      root.addEventListener('pointerleave', () => { hover = false; sync(); });
    }
    document.addEventListener('visibilitychange', sync);
    sync();
    pick(0);
  });
</script>

<style>
  .ws { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(36px, 6vw, 96px); align-items: center; }
  .ws-copy { display: grid; gap: 20px; justify-items: start; }
  .ws-copy .h2 { max-width: 12ch; }
  .ws-copy .text { margin: 0; max-width: 32rem; }
  .pts { list-style: none; margin: 6px 0 4px; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 18px 24px; }
  .pts li { display: grid; gap: 4px; padding-top: 14px; border-top: 1px solid var(--hair); }
  .pts b { font-size: 16px; letter-spacing: -0.01em; }
  .pts span { font-size: 15px; line-height: 1.45; color: var(--fg-2); }

  .ws-sec { overflow-x: clip; border-top: 1px solid var(--hair); }

  /* The tour: five steps on thin lines. The one that is on shows its sentence and the pink marker, and a black line
     fills along its bottom edge while it plays; the others show their title only, so the list stays short. */
  .steps { list-style: none; margin: 8px 0 4px; padding: 0; display: grid; width: 100%; border-top: 1px solid var(--hair); }
  .steps li { position: relative; border-bottom: 1px solid var(--hair); }
  .steps li::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--ink); transform: scaleX(0); transform-origin: 0 50%; }
  .steps li.run::after { animation: tour-fill 5.4s linear forwards; }
  .paused .steps li.run::after { animation-play-state: paused; }
  .chosen .steps li.on::after { transform: scaleX(1); }
  @keyframes tour-fill { to { transform: scaleX(1); } }
  .st-b { display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 4px 12px; width: 100%; padding: 16px 0; border: 0; background: none; color: var(--fg); font: inherit; text-align: left; cursor: pointer; }
  .sn { font-weight: 700; font-size: 14px; padding-top: 4px; font-variant-numeric: tabular-nums; }
  .sb { display: grid; grid-template-rows: auto 0fr; transition: grid-template-rows 420ms cubic-bezier(.22, 1, .36, 1); }
  .steps li.on .sb { grid-template-rows: auto 1fr; }
  .sb b { justify-self: start; font-size: clamp(22px, 2vw, 30px); line-height: 1.05; letter-spacing: -0.035em; }
  .sd { min-height: 0; overflow: hidden; }
  .sd > span { display: block; padding-top: 8px; font-size: 16px; line-height: 1.45; max-width: 30rem; opacity: 0; transition: opacity 300ms var(--ease); }
  .steps li.on .sd > span { opacity: 1; transition-delay: 120ms; }
  /* Room for three lines whichever step is on, so the list keeps one height as the tour moves. */
  .story .steps li.on .sd > span { min-height: calc(8px + 2 * 1.45em); }
  .steps li.on .sb b { background: linear-gradient(var(--pink), var(--pink)) 0 88% / 100% 30% no-repeat; }
  .steps li:not(.on) .st-b:hover .sb b { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .st-b:focus-visible { outline: 2px solid var(--fg); outline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) { .sb, .sd > span { transition: none; } }
  /* Phones and tablets: the title, the workspace, then the steps under it. */
  @media (max-width: 1060px) {
    .ws.story { gap: 22px; }
    .story .ws-copy { display: contents; }
    .story .ws-copy .h2 { order: 1; } .story .ws-copy .text { order: 2; }
    .story .app-wrap { order: 3; margin-top: 18px; }
    .story .steps { order: 4; } .story .ws-copy .btn { order: 5; justify-self: start; }
  }
  .ws-copy .text { color: var(--fg-2); }
  .app-wrap { position: relative; }
  .eg { position: absolute; z-index: 2; top: -14px; right: 18px; margin: 0; }
  .app { position: relative; z-index: 1; border: 1px solid var(--ink); border-radius: 18px; background: var(--white); color: var(--ink); overflow: hidden; font-size: 14px; --fill: 70%; }
  .act li.new { animation: ws-in 600ms cubic-bezier(.2, .9, .3, 1.1) both; }
  .act li.new > span:first-child::before { content: ''; display: inline-block; width: 7px; height: 7px; margin-right: 8px; border-radius: 50%; background: var(--pink); vertical-align: 1px; }
  @keyframes ws-in { from { opacity: 0; transform: translateY(-10px); background: var(--yellow-soft); } }
  .chrome { display: flex; align-items: center; gap: 6px; padding: 11px 14px; border-bottom: 1px solid rgba(0, 0, 0, .12); background: var(--white); }
  .chrome i { width: 10px; height: 10px; border-radius: 50%; background: rgba(0, 0, 0, .15); }
  .chrome span { margin-left: 10px; padding: 4px 12px; border-radius: 999px; border: 1px solid rgba(0, 0, 0, .12); background: var(--white); font-size: 12px; color: var(--ink-2); }
  .body { display: grid; grid-template-columns: 168px 1fr; min-height: 420px; }
  .act li { padding: 9px 0; }
  .act li:last-child { border-bottom: 0; }
  .side { display: grid; align-content: start; gap: 2px; padding: 16px 10px; border-right: 1px solid rgba(0, 0, 0, .12); background: var(--white); color: var(--ink); }
  .mono { display: block; width: 64px; margin: 2px 12px 16px; }
  .side button { display: flex; align-items: center; gap: 10px; padding: 9px 10px; border: 0; border-radius: 999px; background: transparent; color: var(--ink-2); font: 500 14px/1 var(--font); text-align: left; cursor: pointer; transition: background 200ms var(--ease), color 200ms var(--ease); }
  .side button:hover { color: var(--ink); background: var(--yellow-soft); }
  .side button[aria-selected='true'] { background: var(--pink); color: var(--ink); font-weight: 600; }
  .side button[aria-selected='true'] em { background: var(--white); }
  .side em { margin-left: auto; min-width: 20px; height: 20px; display: grid; place-items: center; border-radius: 999px; background: var(--pink); color: var(--ink); font-style: normal; font-size: 11px; font-weight: 700; }
  .ic { width: 18px; height: 18px; flex: none; }
  .ic :global(svg) { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .main { padding: 18px 20px 22px; display: grid; gap: 16px; align-content: start; min-width: 0; }
  .top { display: flex; justify-content: space-between; align-items: start; gap: 12px; }
  .pn { margin: 0; font-weight: 700; font-size: 20px; letter-spacing: -0.03em; }
  .pm { margin: 2px 0 0; color: var(--ink-2); font-size: 13px; }
  .st { display: inline-flex; align-items: center; gap: 7px; padding: 6px 11px; border-radius: 999px; background: var(--mat-soft); color: var(--mat-deep); font-weight: 700; font-size: 12px; white-space: nowrap; }
  .st i { width: 7px; height: 7px; border-radius: 50%; background: var(--mat); animation: blink 1.6s ease-in-out infinite; }
  @keyframes blink { 50% { opacity: .3; } }
  .tl-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); }
  .tl-steps li { position: relative; display: grid; gap: 8px; justify-items: start; font-size: 12px; font-weight: 600; color: var(--ink-2); }
  .tl-steps li::before { content: ''; position: absolute; left: 14px; right: 0; top: 6px; height: 2px; background: rgba(0, 0, 0, .1); }
  .tl-steps li:last-child::before { display: none; }
  .tl-steps i { position: relative; width: 14px; height: 14px; border-radius: 50%; border: 2px solid rgba(0, 0, 0, .2); background: var(--white); }
  .tl-steps .done i { background: var(--mat); border-color: var(--mat); }
  .tl-steps .now i { border-color: var(--mat); box-shadow: 0 0 0 4px var(--mat-soft); }
  .tl-steps .done, .tl-steps .now { color: var(--ink); }
  .tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .tile { padding: 14px; border-radius: 12px; border: 1px solid rgba(0, 0, 0, .12); }
  .tile.y { background: var(--yellow-soft); border-color: transparent; }
  .tk { margin: 0; font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-2); }
  .tv { margin: 6px 0 0; font-weight: 700; font-size: 16px; letter-spacing: -0.01em; }
  .bar-row { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px; }
  .meter { height: 8px; border-radius: 999px; background: rgba(0, 0, 0, .08); overflow: hidden; }
  .meter i { display: block; height: 100%; width: 0; border-radius: inherit; background: var(--ink); transition: width 1200ms var(--ease); }
  .live .meter i { width: var(--fill); }
  .tl-steps li::after { content: ''; position: absolute; left: 14px; top: 6px; height: 2px; width: 0; background: var(--mat); transition: width 700ms var(--ease); }
  .tl-steps li.done::before { background: rgba(0, 0, 0, .1); }
  .live .tl-steps li.done::after { width: calc(100% - 14px); }
