---
// The three monthly plans side by side. Creative Partner is the dark card.
import { t, type Locale } from '../i18n/strings';
import { c } from '../i18n/copy';
import { href } from '../i18n/paths';
import { monthly, fmt } from '../data/offers';
interface Props { lang: Locale }
const { lang } = Astro.props;
const cur = t(lang).offers.currency;
const p = c(lang).plans;
---
<div class="plans">
  {monthly.map((o, i) => (
    <article class={`plan rv ${o.from ? 'dark' : ''}`} style={`--d:${i * 90}ms`}>
      <header>
        <h3 class="h3">{o.name}</h3>
        <p class="reels"><span class="n">{o.reels}{o.more && '+'}</span> <span class="soft">{o.more ? p.more : p.reels}</span></p>
      </header>
      <div class="price">
        {o.from && <span class="from soft">{p.from}</span>}
        <p><span class="num">{fmt(o.launch, lang)}</span> <span class="soft">{cur} {p.month}</span></p>
        <p class="small soft">{o.standard ? `${p.usually} ${fmt(o.standard, lang)} ${cur}` : `${p.sized}. ${p.vip}.`}</p>
      </div>
      <ul class="ticks-list">{o.items[lang].map((it) => <li>{it}</li>)}</ul>
      <a class={`btn ${o.from ? '' : 'primary'}`} href={href(lang, 'apply')}>{o.from ? p.talk : p.choose} <span class="arr" aria-hidden="true">→</span></a>
    </article>
  ))}
</div>
<style>
  .plans { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(14px, 1.6vw, 22px); align-items: stretch; }
  .plan { display: grid; grid-template-rows: auto auto 1fr auto; gap: 20px; padding: clamp(24px, 2.4vw, 34px); background: var(--white); border-radius: var(--r-lg); border: 1px solid var(--hair); box-shadow: var(--shadow-1); transition: transform 500ms var(--ease), box-shadow 500ms var(--ease), opacity 900ms var(--ease), filter 900ms var(--ease); }
  .plan.in:hover { transform: translateY(-6px); box-shadow: var(--shadow-2); }
  .plan header { display: grid; gap: 6px; }
  .reels { margin: 0; display: flex; align-items: baseline; gap: 8px; }
  .reels .n { font-weight: 700; font-size: clamp(40px, 3.8vw, 56px); line-height: 1; letter-spacing: -0.05em; }
  .price { display: grid; gap: 4px; padding-block: 14px; border-block: 1px solid var(--hair); }
  .price p { margin: 0; }
  .from { font-size: 14px; font-weight: 500; }
  .num { font-weight: 700; font-size: clamp(28px, 2.4vw, 36px); letter-spacing: -0.03em; }
  .plan .btn { width: 100%; box-shadow: none; }
  .dark { background: var(--ink); color: #fff; border-color: var(--ink); box-shadow: var(--shadow-2); }
  .dark .soft { color: rgba(255, 255, 255, .62); }
  .dark .price { border-color: rgba(255, 255, 255, .14); }
  .dark :global(.ticks-list li::before) { background-color: var(--yellow); }
  .dark .btn { background: var(--yellow); border-color: var(--yellow); }
  @media (max-width: 960px) { .plans { grid-template-columns: 1fr; max-width: 520px; margin-inline: auto; } }
</style>
