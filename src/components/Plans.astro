---
// The Test and the three monthly plans side by side. Creative Partner carries a faint pink light.
import { t, type Locale } from '../i18n/strings';
import { c } from '../i18n/copy';
import { href } from '../i18n/paths';
import { plans, fmt } from '../data/offers';
interface Props { lang: Locale }
const { lang } = Astro.props;
const cur = t(lang).offers.currency;
const p = c(lang).plans;
const launch = t(lang).offers.launch;
---
<div class="plans">
  {plans.map((o, i) => (
    <article class={`plan rv ${o.custom ? 'dark' : ''} ${o.once ? 'once' : ''}`} style={`--d:${i * 90}ms`}>
      <header class="top">
        <h3 class="h3">{o.name}</h3>
        <span class={`pill ${o.once ? 'ex' : ''} ${o.custom ? 'vip' : ''}`}>{o.custom ? 'VIP' : o.once ? p.exclusive : launch}</span>
      </header>
      <div class="price">
        <p class="reels"><span class={`n ${o.max ? 'sm' : ''}`}>{o.max ? `${o.reels}–${o.max}` : o.reels}</span> {o.once ? p.reelsOnce : p.reels}</p>
        {o.custom
          ? <p class="amount"><span class="num">{p.custom}</span></p>
          : <p class="amount"><span class="num">{fmt(o.launch, lang)}</span>{' '}<span class="unit">{cur} {o.once ? p.once : p.month}</span></p>}
      </div>
      <p class="spec"><span>{o.shoot?.[lang]}</span><span>{o.review?.[lang]}</span></p>
      <ul class="ticks-list">{o.items[lang].map((it) => <li>{it}</li>)}</ul>
      <a class={`btn ${o.custom ? '' : 'primary'}`} href={`${href(lang, 'apply')}?plan=${o.key}`}>{o.custom ? p.talk : p.choose} <span class="arr" aria-hidden="true">→</span></a>
    </article>
  ))}
</div>
<style>
  .plans { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(12px, 1.2vw, 18px); align-items: stretch; }
  .plan { display: grid; grid-template-rows: auto auto auto 1fr auto; gap: 18px; padding: clamp(22px, 2vw, 30px); background: var(--surface); border-radius: 24px; border: 1px solid var(--hair); transition: transform 500ms var(--ease), border-color 300ms var(--ease), opacity 900ms var(--ease); }
  .plan.in:hover { transform: translateY(-4px); border-color: var(--hair-2); }
  .top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .top .h3 { font-size: clamp(20px, 1.6vw, 24px); }
  .pill { padding: 5px 10px; border-radius: 999px; border: 1px solid rgba(244, 193, 196, .45); color: var(--pink); font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; }
  .pill.ex { background: var(--yellow); border-color: var(--yellow); color: var(--ink); }
  .pill.vip { background: var(--pink); border-color: var(--pink); color: var(--ink); }
  .price { display: grid; gap: 6px; padding-block: 16px; border-block: 1px solid var(--hair); }
  .price p { margin: 0; }
  .reels { display: flex; align-items: baseline; gap: 8px; font-size: 14px; color: var(--fg-2); }
  .reels .n { font-weight: 700; font-size: clamp(44px, 4vw, 64px); line-height: 1; letter-spacing: -0.055em; color: var(--fg); }
  .reels .n.sm { font-size: clamp(34px, 3vw, 48px); white-space: nowrap; }
  .amount { margin: 0; }
  .num { font-weight: 700; font-size: clamp(22px, 1.9vw, 28px); letter-spacing: -0.03em; }
  .unit { font-weight: 600; font-size: 14px; color: var(--fg-2); }
  /* What the plan includes in production and after delivery. */
  .spec { margin: 0; display: grid; gap: 6px; }
  .spec span { position: relative; padding-left: 16px; font-size: 14px; font-weight: 600; line-height: 1.35; color: var(--fg-2); }
  .spec span::before { content: ''; position: absolute; left: 0; top: .5em; width: 6px; height: 6px; border-radius: 50%; background: var(--fg-3); }
  .plan .ticks-list { gap: 9px; font-size: 15px; }
  .plan .btn { width: 100%; }
  .dark { background: radial-gradient(130% 60% at 100% 0%, rgba(244, 193, 196, .16), transparent 60%), var(--surface); border-color: rgba(244, 193, 196, .3); }
  .dark.in:hover { border-color: rgba(244, 193, 196, .6); }
  .dark .btn { background: var(--pink); border-color: var(--pink); color: var(--ink); }
  .dark .btn:hover { background: var(--fg); border-color: var(--fg); }
  .once { background: radial-gradient(130% 60% at 100% 0%, rgba(243, 223, 158, .09), transparent 60%), var(--surface); }
  @media (max-width: 1180px) and (min-width: 761px) { .plans { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) {
    .plans { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); gap: 12px; margin-inline: calc(-1 * var(--gutter)); padding: 4px var(--gutter) 14px; scrollbar-width: none; }
    .plans::-webkit-scrollbar { display: none; }
    .plan { flex: 0 0 84%; scroll-snap-align: start; }
    .dark { margin-right: 8px; }
  }
</style>
