---
// The Test and the monthly plans as one price list: a row per plan, read across like a menu.
import { t, type Locale } from '../i18n/strings';
import { c } from '../i18n/copy';
import { href } from '../i18n/paths';
import { plans, fmt } from '../data/offers';
interface Props { lang: Locale }
const { lang } = Astro.props;
const o = t(lang).offers;
const p = c(lang).plans;
---
<div class="menu">
  {plans.map((m, i) => (
    <article class="row rv" style={`--d:${i * 70}ms`}>
      <header class="who">
        <h3 class="name"><span>{m.name}</span></h3>
        {m.for && <p class="for">{m.for[lang]}</p>}
      </header>
      <p class="qty"><span class={`n ${m.max ? 'sm' : ''}`}>{m.max ? `${m.reels}–${m.max}` : m.reels}</span><span class="u">{m.once ? p.reelsOnce : p.reels}</span></p>
      <ul class="ticks-list inc">
        <li>{m.shoot?.[lang]}</li>
        {m.items[lang].map((it) => <li>{it}</li>)}
        <li>{m.review?.[lang]}</li>
      </ul>
      <div class="buy">
        {m.custom
          ? <p class="price"><span class="num">{p.custom}</span></p>
          : <p class="price"><span class="num">{fmt(m.launch, lang)}</span> <span class="unit">{o.currency} {m.once ? p.once : p.month}</span></p>}
        {m.monthly && !m.custom && <p class="lp"><span class="tape">{c(lang).plans.launchTape}</span></p>}
        <a class="btn go" href={`${href(lang, 'apply')}?plan=${m.key}`} aria-label={`${m.custom ? p.talk : p.choose}: ${m.name}`}>{m.custom ? p.talk : p.choose} <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </article>
  ))}
</div>
<style>
  .menu { border-top: 1px solid var(--hair-2); }
  .row { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr) minmax(0, 1.25fr) minmax(200px, .75fr); grid-template-areas: 'who qty inc buy';
    gap: clamp(20px, 3vw, 56px); align-items: start; padding-block: clamp(28px, 3.2vw, 48px); border-bottom: 1px solid var(--hair); }
  .who { grid-area: who; display: grid; gap: 12px; }
  .name { margin: 0; font-weight: 700; font-size: clamp(30px, 3vw, 48px); line-height: 1; letter-spacing: -0.045em; }
  /* The pink marker from the headline swipes under the plan you point at. */
  .name span { padding-inline: .04em; margin-inline: -.04em; background: linear-gradient(var(--pink), var(--pink)) 0 80% / 0 38% no-repeat; transition: background-size 520ms var(--ease); }
  .row:hover .name span { background-size: 100% 38%; }
  .for { margin: 0; max-width: 28ch; font-size: 16px; line-height: 1.45; color: var(--fg-2); }
  .qty { grid-area: qty; margin: 0; display: grid; gap: 10px; justify-items: start; }
  .qty .n { font-weight: 700; font-size: clamp(64px, 6.8vw, 120px); line-height: .8; letter-spacing: -0.065em; font-variant-numeric: tabular-nums; }
  .qty .n.sm { font-size: clamp(40px, 3.9vw, 68px); line-height: .9; white-space: nowrap; }
  .qty .u { font-size: 14px; font-weight: 600; color: var(--fg-2); }
  .inc { grid-area: inc; gap: 8px; padding-top: 4px; font-size: 15px; color: var(--fg-2); }
  .inc li:first-child { color: var(--fg); font-weight: 600; }
  .buy { grid-area: buy; display: grid; gap: 8px; justify-items: start; }
  .price { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 8px; }
  .num { font-weight: 700; font-size: clamp(26px, 2.3vw, 36px); line-height: 1; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  .unit { font-size: 14px; font-weight: 600; color: var(--fg-2); }
  .lp { margin: 8px 0 4px; }
  .lp .tape { font-size: 12px; white-space: normal; max-width: 100%; }
  .go { margin-top: 12px; }
  @media (max-width: 1100px) and (min-width: 761px) {
    .row { grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr) minmax(190px, .8fr); grid-template-areas: 'who qty buy' 'inc inc buy'; }
    .inc { columns: 2; column-gap: 32px; display: block; }
    .inc li { break-inside: avoid; margin-bottom: 8px; }
  }
  @media (max-width: 760px) {
    .row { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'who qty' 'inc inc' 'buy buy'; gap: 20px 16px; padding-block: 28px; }
    .name { font-size: clamp(30px, 9vw, 40px); }
    .qty { justify-items: end; text-align: right; }
    .qty .n { font-size: clamp(56px, 17vw, 80px); }
    .qty .n.sm { font-size: clamp(36px, 10vw, 48px); }
    .buy { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'price go' 'lp go'; align-items: center; gap: 4px 16px; padding-top: 18px; border-top: 1px solid var(--hair); }
    .price { grid-area: price; } .lp { grid-area: lp; }
    .go { grid-area: go; margin: 0; }
  }
</style>
