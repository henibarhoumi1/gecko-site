---
// The launch offer as one straight yellow band: what you get and for how much, who it's for, and the way in.
import { c } from '../i18n/copy';
import { href } from '../i18n/paths';
import type { Locale } from '../i18n/strings';
interface Props { lang: Locale }
const { lang } = Astro.props;
const [title, who, until, cta] = c(lang).home.bands.big;
---
<section class="offer on-yellow" aria-labelledby="offer-t">
  <div class="wrap wide o-in">
    <div class="o-copy rv">
      <p class="o-k">{who} · {until}</p>
      <h2 class="o-t" id="offer-t">{title}</h2>
    </div>
    <a class="btn primary lg rv" style="--d:80ms" href={href(lang, 'offers')}>{cta} <span class="arr" aria-hidden="true">→</span></a>
  </div>
</section>

<style>
  .offer { border-block: 1px solid var(--ink); }
  .o-in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px 48px; padding-block: clamp(36px, 4.4vw, 64px); }
  .o-copy { display: grid; gap: 10px; min-width: 0; }
  .o-k { margin: 0; font-weight: 700; font-size: 13px; letter-spacing: .08em; text-transform: uppercase; }
  .o-t { margin: 0; max-width: 22ch; font-weight: 700; font-size: clamp(30px, 3.8vw, 58px); line-height: 1; letter-spacing: -0.045em; text-wrap: balance; }
  .offer .btn.primary { background: var(--ink); border-color: var(--ink); color: #fff; }
  .offer .btn.primary:hover { background: #fff; border-color: var(--ink); color: var(--ink); }
</style>
