# Security headers, served by Cloudflare. Cloudflare Web Analytics is allowed.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' https://api.web3forms.com https://cloudflareinsights.com https://ryusfpyxozqmsjoirxgm.supabase.co https://arzjqtysedaxktzyoxuf.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self' mailto: https://wa.me https://api.web3forms.com; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# Caching. Pages stay fresh on every visit (Cloudflare's default). Files whose names change when they change are kept
# for a year; the font keeps its name, so rename it if it is ever replaced. Reels, photos and brand files: one week.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/work/*
  Cache-Control: public, max-age=604800
/brand/*
  Cache-Control: public, max-age=604800
/team/*
  Cache-Control: public, max-age=604800
/flags/*
  Cache-Control: public, max-age=604800
