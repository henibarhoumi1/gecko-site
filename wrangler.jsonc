// Cloudflare Workers: serves the built site from dist/ (security headers in public/_headers, redirects in public/_redirects).
{
  "name": "gecko-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
